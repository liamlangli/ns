mod dynamic

use std
use simd

// Box3D-backed 3D rigid-body dynamics. The public Nano Script surface remains
// data-oriented: bodies and configuration are plain structs, while the native
// world is an opaque u64 handle. A host-side state image is kept in sync for
// renderers and for the existing body/hull/contact query helpers.

lit DYNAMIC_MAX_CONTACTS = 4
lit DYNAMIC_MAX_HULL_VERTICES = 16

lit DYNAMIC_ROW_CONFIG = 0
lit DYNAMIC_ROW_POSITION = 1
lit DYNAMIC_ROW_ORIENTATION = 2
lit DYNAMIC_ROW_VELOCITY = 3
lit DYNAMIC_ROW_ANGULAR = 4
lit DYNAMIC_ROW_MATERIAL = 5
lit DYNAMIC_ROW_INERTIA = 6
lit DYNAMIC_ROW_PAIR = 7
lit DYNAMIC_ROW_CONTACT = DYNAMIC_ROW_PAIR + DYNAMIC_MAX_CONTACTS
lit DYNAMIC_ROW_POINT = DYNAMIC_ROW_CONTACT + DYNAMIC_MAX_CONTACTS
lit DYNAMIC_ROW_HULL = DYNAMIC_ROW_POINT + DYNAMIC_MAX_CONTACTS
lit DYNAMIC_ROW_COUNT = DYNAMIC_ROW_HULL + DYNAMIC_MAX_HULL_VERTICES

lit DYNAMIC_CONFIG_STEP = 0
lit DYNAMIC_CONFIG_GRAVITY = 1
lit DYNAMIC_CONFIG_BOUNDS_MIN = 2
lit DYNAMIC_CONFIG_BOUNDS_MAX = 3
lit DYNAMIC_CONFIG_COLUMNS = 4

// The old CPU value remains an alias so existing backend checks keep working.
lit DYNAMIC_BACKEND_BOX3D = 0
lit DYNAMIC_BACKEND_CPU = DYNAMIC_BACKEND_BOX3D
// Kept for source compatibility; Box3D is the only dynamic backend.
lit DYNAMIC_BACKEND_GPU = 1

lit DYNAMIC_SHAPE_SPHERE = 0
lit DYNAMIC_SHAPE_BOX = 1
lit DYNAMIC_SHAPE_HULL = 2
lit DYNAMIC_EPSILON = 0.000001

struct dynamic_body {
    position: float3,
    orientation: float4,
    velocity: float3,
    angular_velocity: float3,
    inv_mass: f32,
    inv_inertia: float3,
    // One point plus a margin becomes a Box3D sphere; two points plus a
    // margin become a capsule. Margins on larger hulls are not supported by
    // Box3D v0.1 and the hull is used without rounding.
    margin: f32,
    restitution: f32,
    friction: f32,
    damping: f32,
    angular_damping: f32
}

struct dynamic_config {
    gravity: float3,
    dt: f32,
    substeps: i32,
    // Box3D exposes substeps instead of a separate iteration count. The
    // adapter multiplies substeps by iterations to preserve the old default
    // solver budget of four passes.
    iterations: i32,
    // Legacy tuning fields retained in the struct for source compatibility.
    // Box3D owns its contact slop, bias, relaxation, and broad-phase margin.
    slop: f32,
    bias: f32,
    relaxation: f32,
    margin: f32,
    bounds_min: float3,
    bounds_max: float3,
    bounds_enabled: bool,
    bounds_restitution: f32,
    // Ignored. Box3D is a native CPU backend.
    prefer_gpu: bool
}

struct dynamic_step_params {
    dt: f32,
    slop: f32,
    bias: f32,
    relaxation: f32,
    gravity: float3,
    margin: f32,
    bounds_min: float3,
    bounds_max: float3,
    bounds_enabled: f32,
    bounds_restitution: f32
}

struct dynamic_contact {
    normal: float3,
    point: float3,
    depth: f32,
    hit: f32
}

struct dynamic_world {
    capacity: i32,
    count: i32,
    config: dynamic_config,
    backend: i32,
    native: u64,
    state: [f32],
    // Legacy fields stay present so code compiled against the previous world
    // layout can still inspect them. They are unused by the Box3D backend.
    next: [f32],
    root: [f32],
    read_texture: u32,
    write_texture: u32,
    broad_shader: u32,
    narrow_shader: u32,
    solve_shader: u32,
    integrate_shader: u32
}

// Scalar/array-only FFI bridge implemented by lib/src/dynamic.c.
ref fn dynamic_native_world_create(capacity: i32, gravity_x: f32, gravity_y: f32, gravity_z: f32) u64
ref fn dynamic_native_world_release(handle: u64)
ref fn dynamic_native_world_clear(handle: u64)
ref fn dynamic_native_body_add(handle: u64, index: i32, position_x: f32, position_y: f32, position_z: f32, orientation_x: f32, orientation_y: f32, orientation_z: f32, orientation_w: f32, velocity_x: f32, velocity_y: f32, velocity_z: f32, angular_x: f32, angular_y: f32, angular_z: f32, inverse_mass: f32, inverse_inertia_x: f32, inverse_inertia_y: f32, inverse_inertia_z: f32, margin: f32, restitution: f32, friction: f32, damping: f32, angular_damping: f32) i32
ref fn dynamic_native_body_set(handle: u64, index: i32, position_x: f32, position_y: f32, position_z: f32, orientation_x: f32, orientation_y: f32, orientation_z: f32, orientation_w: f32, velocity_x: f32, velocity_y: f32, velocity_z: f32, angular_x: f32, angular_y: f32, angular_z: f32, inverse_mass: f32, inverse_inertia_x: f32, inverse_inertia_y: f32, inverse_inertia_z: f32, margin: f32, restitution: f32, friction: f32, damping: f32, angular_damping: f32)
ref fn dynamic_native_body_set_hull(handle: u64, index: i32, vertices: [f32], count: i32) i32
ref fn dynamic_native_world_step(handle: u64, time_step: f32, sub_step_count: i32, gravity_x: f32, gravity_y: f32, gravity_z: f32, bounds_enabled: i32, bounds_min_x: f32, bounds_min_y: f32, bounds_min_z: f32, bounds_max_x: f32, bounds_max_y: f32, bounds_max_z: f32, bounds_restitution: f32)
ref fn dynamic_native_world_sync(handle: u64, state: [f32], capacity: i32, row_count: i32, count: i32)

// ---------------------------------------------------------------------------
// vector and quaternion helpers
// ---------------------------------------------------------------------------

fn dynamic_v3(x: f32, y: f32, z: f32) float3 {
    return float3 { x: x, y: y, z: z }
}

fn dynamic_add3(a: float3, b: float3) float3 {
    return dynamic_v3(a.x + b.x, a.y + b.y, a.z + b.z)
}

fn dynamic_sub3(a: float3, b: float3) float3 {
    return dynamic_v3(a.x - b.x, a.y - b.y, a.z - b.z)
}

fn dynamic_scale3(v: float3, s: f32) float3 {
    return dynamic_v3(v.x * s, v.y * s, v.z * s)
}

fn dynamic_mul3(a: float3, b: float3) float3 {
    return dynamic_v3(a.x * b.x, a.y * b.y, a.z * b.z)
}

fn dynamic_dot3(a: float3, b: float3) f32 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn dynamic_cross3(a: float3, b: float3) float3 {
    return dynamic_v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

fn dynamic_length3(v: float3) f32 {
    return sqrt(dynamic_dot3(v, v) as f64) as f32
}

fn dynamic_normalize3(v: float3) float3 {
    let length = dynamic_length3(v)
    if length <= DYNAMIC_EPSILON {
        return dynamic_v3(0.0, 0.0, 0.0)
    }
    return dynamic_scale3(v, 1.0 / length)
}

fn dynamic_min(a: f32, b: f32) f32 {
    if a < b {
        return a
    }
    return b
}

fn dynamic_max(a: f32, b: f32) f32 {
    if a > b {
        return a
    }
    return b
}

fn dynamic_abs(v: f32) f32 {
    return dynamic_max(v, 0.0 - v)
}

fn dynamic_clamp(v: f32, low: f32, high: f32) f32 {
    return dynamic_min(dynamic_max(v, low), high)
}

fn dynamic_xyz(v: float4) float3 {
    return dynamic_v3(v.x, v.y, v.z)
}

fn dynamic_float4(v: float3, w: f32) float4 {
    return float4 { x: v.x, y: v.y, z: v.z, w: w }
}

fn dynamic_quat_identity() float4 {
    return float4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
}

fn dynamic_quat_mul(a: float4, b: float4) float4 {
    return float4 {
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
    }
}

fn dynamic_quat_normalize(q: float4) float4 {
    let length = sqrt((q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w) as f64) as f32
    if length <= DYNAMIC_EPSILON {
        return dynamic_quat_identity()
    }
    return float4 { x: q.x / length, y: q.y / length, z: q.z / length, w: q.w / length }
}

fn dynamic_quat_rotate(q: float4, v: float3) float3 {
    let axis = dynamic_xyz(q)
    let inner = dynamic_add3(dynamic_cross3(axis, v), dynamic_scale3(v, q.w))
    return dynamic_add3(v, dynamic_scale3(dynamic_cross3(axis, inner), 2.0))
}

fn dynamic_quat_rotate_inverse(q: float4, v: float3) float3 {
    let conjugate = float4 { x: 0.0 - q.x, y: 0.0 - q.y, z: 0.0 - q.z, w: q.w }
    return dynamic_quat_rotate(conjugate, v)
}

fn dynamic_quat_from_axis_angle(axis: float3, angle: f32) float4 {
    let direction = dynamic_normalize3(axis)
    let half = angle * 0.5
    let sine = sin(half as f64) as f32
    return float4 {
        x: direction.x * sine,
        y: direction.y * sine,
        z: direction.z * sine,
        w: cos(half as f64) as f32,
    }
}

// ---------------------------------------------------------------------------
// state image and shapes
// ---------------------------------------------------------------------------

fn dynamic_state_index(capacity: i32, column: i32, row: i32) i32 {
    return (row * capacity + column) * 4
}

fn dynamic_state_read(data: [f32], capacity: i32, column: i32, row: i32) float4 {
    let base = dynamic_state_index(capacity, column, row)
    return float4 { x: data[base], y: data[base + 1], z: data[base + 2], w: data[base + 3] }
}

fn dynamic_state_write(data: [f32], capacity: i32, column: i32, row: i32, value: float4) {
    let base = dynamic_state_index(capacity, column, row)
    data[base] = value.x
    data[base + 1] = value.y
    data[base + 2] = value.z
    data[base + 3] = value.w
}

fn dynamic_state_floats(capacity: i32) i32 {
    return capacity * DYNAMIC_ROW_COUNT * 4
}

fn dynamic_body_default() dynamic_body {
    return dynamic_body {
        dynamic_v3(0.0, 0.0, 0.0),
        dynamic_quat_identity(),
        dynamic_v3(0.0, 0.0, 0.0),
        dynamic_v3(0.0, 0.0, 0.0),
        1.0,
        dynamic_v3(6.0, 6.0, 6.0),
        0.0,
        0.2,
        0.5,
        0.02,
        0.05,
    }
}

fn dynamic_body_sphere(radius: f32, mass: f32) dynamic_body {
    let body = dynamic_body_default()
    body.margin = radius
    if mass <= 0.0 {
        body.inv_mass = 0.0
        body.inv_inertia = dynamic_v3(0.0, 0.0, 0.0)
        return body
    }
    body.inv_mass = 1.0 / mass
    let inertia = 0.4 * mass * radius * radius
    body.inv_inertia = dynamic_v3(1.0 / inertia, 1.0 / inertia, 1.0 / inertia)
    return body
}

fn dynamic_body_box(half_extents: float3, mass: f32) dynamic_body {
    let body = dynamic_body_default()
    if mass <= 0.0 {
        body.inv_mass = 0.0
        body.inv_inertia = dynamic_v3(0.0, 0.0, 0.0)
        return body
    }
    body.inv_mass = 1.0 / mass
    let x2 = half_extents.x * half_extents.x * 4.0
    let y2 = half_extents.y * half_extents.y * 4.0
    let z2 = half_extents.z * half_extents.z * 4.0
    let scale = mass / 12.0
    body.inv_inertia = dynamic_v3(1.0 / (scale * (y2 + z2)), 1.0 / (scale * (x2 + z2)), 1.0 / (scale * (x2 + y2)))
    return body
}

fn dynamic_body_hull(extents: float3, mass: f32) dynamic_body {
    return dynamic_body_box(extents, mass)
}

// ---------------------------------------------------------------------------
// world
// ---------------------------------------------------------------------------

fn dynamic_config_default() dynamic_config {
    return dynamic_config {
        dynamic_v3(0.0, 0.0 - 9.81, 0.0),
        1.0 / 60.0,
        1,
        4,
        0.005,
        0.2,
        0.8,
        0.08,
        dynamic_v3(0.0 - 3.0, 0.0, 0.0 - 3.0),
        dynamic_v3(3.0, 7.0, 3.0),
        true,
        1.0,
        false,
    }
}

fn dynamic_world_params(w: dynamic_world) dynamic_step_params {
    let steps = w.config.substeps
    if steps < 1 {
        steps = 1
    }
    let iterations = w.config.iterations
    if iterations < 1 {
        iterations = 1
    }
    let enabled = 0.0
    if w.config.bounds_enabled {
        enabled = 1.0
    }
    return dynamic_step_params {
        w.config.dt / ((steps * iterations) as f32),
        w.config.slop,
        w.config.bias,
        w.config.relaxation,
        w.config.gravity,
        w.config.margin,
        w.config.bounds_min,
        w.config.bounds_max,
        enabled,
        w.config.bounds_restitution,
    }
}

fn dynamic_write_config_row(w: ref dynamic_world) {
    let params = dynamic_world_params(w)
    dynamic_state_write(w.state, w.capacity, DYNAMIC_CONFIG_STEP, DYNAMIC_ROW_CONFIG, float4 { x: params.dt, y: params.slop, z: params.bias, w: params.relaxation })
    dynamic_state_write(w.state, w.capacity, DYNAMIC_CONFIG_GRAVITY, DYNAMIC_ROW_CONFIG, dynamic_float4(params.gravity, params.margin))
    dynamic_state_write(w.state, w.capacity, DYNAMIC_CONFIG_BOUNDS_MIN, DYNAMIC_ROW_CONFIG, dynamic_float4(params.bounds_min, params.bounds_enabled))
    dynamic_state_write(w.state, w.capacity, DYNAMIC_CONFIG_BOUNDS_MAX, DYNAMIC_ROW_CONFIG, dynamic_float4(params.bounds_max, params.bounds_restitution))
}

fn dynamic_world_create(capacity: i32, config: dynamic_config) dynamic_world {
    let columns = capacity
    if columns < DYNAMIC_CONFIG_COLUMNS {
        columns = DYNAMIC_CONFIG_COLUMNS
    }
    let w = dynamic_world {
        columns,
        0,
        config,
        DYNAMIC_BACKEND_BOX3D,
        dynamic_native_world_create(columns, config.gravity.x, config.gravity.y, config.gravity.z),
        [f32](dynamic_state_floats(columns)),
        [f32](0),
        [f32](0),
        0u,
        0u,
        0u,
        0u,
        0u,
        0u,
    }
    dynamic_write_config_row(w)
    return w
}

fn dynamic_world_release(w: ref dynamic_world) {
    if w.native != (0 as u64) {
        dynamic_native_world_release(w.native)
        w.native = 0 as u64
    }
}

fn dynamic_world_backend(w: dynamic_world) i32 {
    return w.backend
}

fn dynamic_world_backend_name(w: dynamic_world) str {
    return "box3d"
}

fn dynamic_world_state_texture(w: dynamic_world) u32 {
    return 0u
}

fn dynamic_world_write_body_state(w: ref dynamic_world, index: i32, body: dynamic_body) {
    let bound = body.margin
    let hull_count = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA).w as i32
    for i in 0 to hull_count {
        let vertex = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_HULL + i)
        let reach = dynamic_length3(dynamic_xyz(vertex)) + body.margin
        if reach > bound {
            bound = reach
        }
    }
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_POSITION, dynamic_float4(body.position, bound))
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_ORIENTATION, dynamic_quat_normalize(body.orientation))
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_VELOCITY, dynamic_float4(body.velocity, body.inv_mass))
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_ANGULAR, dynamic_float4(body.angular_velocity, body.margin))
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_MATERIAL, float4 { x: body.restitution, y: body.friction, z: body.damping, w: body.angular_damping })
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA, dynamic_float4(body.inv_inertia, hull_count as f32))
}

fn dynamic_world_native_set_body(w: ref dynamic_world, index: i32, body: dynamic_body) {
    dynamic_native_body_set(w.native, index, body.position.x, body.position.y, body.position.z, body.orientation.x, body.orientation.y, body.orientation.z, body.orientation.w, body.velocity.x, body.velocity.y, body.velocity.z, body.angular_velocity.x, body.angular_velocity.y, body.angular_velocity.z, body.inv_mass, body.inv_inertia.x, body.inv_inertia.y, body.inv_inertia.z, body.margin, body.restitution, body.friction, body.damping, body.angular_damping)
}

fn dynamic_world_set_body(w: ref dynamic_world, index: i32, body: dynamic_body) {
    if index < 0 || index >= w.count || w.native == (0 as u64) {
        return
    }
    dynamic_world_write_body_state(w, index, body)
    dynamic_world_native_set_body(w, index, body)
}

fn dynamic_world_set_hull(w: ref dynamic_world, index: i32, vertices: [f32], count: i32) {
    if index < 0 || index >= w.count || w.native == (0 as u64) {
        return
    }
    let hull_count = count
    if hull_count > DYNAMIC_MAX_HULL_VERTICES {
        hull_count = DYNAMIC_MAX_HULL_VERTICES
    }
    if hull_count < 1 || vertices.len < hull_count * 3 {
        return
    }

    let inertia = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA)
    let position = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_POSITION)
    let angular = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_ANGULAR)
    let bound = angular.w
    for i in 0 to hull_count {
        let vertex = dynamic_v3(vertices[i * 3], vertices[i * 3 + 1], vertices[i * 3 + 2])
        dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_HULL + i, dynamic_float4(vertex, 0.0))
        let reach = dynamic_length3(vertex) + angular.w
        if reach > bound {
            bound = reach
        }
    }
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA, dynamic_float4(dynamic_xyz(inertia), hull_count as f32))
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_POSITION, dynamic_float4(dynamic_xyz(position), bound))
    dynamic_native_body_set_hull(w.native, index, vertices, hull_count)
}

fn dynamic_world_add(w: ref dynamic_world, body: dynamic_body) i32 {
    if w.count >= w.capacity || w.native == (0 as u64) {
        return 0 - 1
    }
    let index = w.count
    for slot in 0 to DYNAMIC_MAX_CONTACTS {
        let empty = float4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
        dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_PAIR + slot, empty)
        dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_CONTACT + slot, empty)
        dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_POINT + slot, empty)
    }
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_HULL, float4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 })
    dynamic_state_write(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA, dynamic_float4(body.inv_inertia, 1.0))
    dynamic_world_write_body_state(w, index, body)

    let added = dynamic_native_body_add(w.native, index, body.position.x, body.position.y, body.position.z, body.orientation.x, body.orientation.y, body.orientation.z, body.orientation.w, body.velocity.x, body.velocity.y, body.velocity.z, body.angular_velocity.x, body.angular_velocity.y, body.angular_velocity.z, body.inv_mass, body.inv_inertia.x, body.inv_inertia.y, body.inv_inertia.z, body.margin, body.restitution, body.friction, body.damping, body.angular_damping)
    if added == 0 {
        return 0 - 1
    }
    w.count = index + 1
    return index
}

fn dynamic_world_body(w: dynamic_world, index: i32) dynamic_body {
    if index < 0 || index >= w.count {
        return dynamic_body_default()
    }
    let position = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_POSITION)
    let orientation = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_ORIENTATION)
    let velocity = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_VELOCITY)
    let angular = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_ANGULAR)
    let material = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_MATERIAL)
    let inertia = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA)
    return dynamic_body {
        dynamic_xyz(position),
        orientation,
        dynamic_xyz(velocity),
        dynamic_xyz(angular),
        velocity.w,
        dynamic_xyz(inertia),
        angular.w,
        material.x,
        material.y,
        material.z,
        material.w,
    }
}

fn dynamic_world_hull_count(w: dynamic_world, index: i32) i32 {
    if index < 0 || index >= w.count {
        return 0
    }
    return dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_INERTIA).w as i32
}

fn dynamic_world_hull_vertex(w: dynamic_world, index: i32, vertex: i32) float3 {
    if index < 0 || index >= w.count || vertex < 0 || vertex >= dynamic_world_hull_count(w, index) {
        return dynamic_v3(0.0, 0.0, 0.0)
    }
    return dynamic_xyz(dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_HULL + vertex))
}

fn dynamic_world_contact_count(w: dynamic_world, index: i32) i32 {
    if index < 0 || index >= w.count {
        return 0
    }
    let contacts = 0
    for slot in 0 to DYNAMIC_MAX_CONTACTS {
        let manifold = dynamic_state_read(w.state, w.capacity, index, DYNAMIC_ROW_CONTACT + slot)
        if manifold.w > 0.0 {
            contacts = contacts + 1
        }
    }
    return contacts
}

fn dynamic_world_clear(w: ref dynamic_world) {
    if w.native != (0 as u64) {
        dynamic_native_world_clear(w.native)
    }
    let floats = dynamic_state_floats(w.capacity)
    for i in 0 to floats {
        w.state[i] = 0.0
    }
    w.count = 0
    dynamic_write_config_row(w)
}

// Reapply body transforms, velocities, and material values after callers edit
// the host state image directly. Hull geometry is changed with set_hull.
fn dynamic_world_upload(w: ref dynamic_world) {
    if w.native == (0 as u64) {
        return
    }
    for index in 0 to w.count {
        dynamic_world_native_set_body(w, index, dynamic_world_body(w, index))
    }
}

fn dynamic_world_step(w: ref dynamic_world) {
    if w.native == (0 as u64) || w.count == 0 || w.config.dt <= 0.0 {
        return
    }
    let substeps = w.config.substeps
    if substeps < 1 {
        substeps = 1
    }
    let iterations = w.config.iterations
    if iterations < 1 {
        iterations = 1
    }
    let bounds_enabled = 0
    if w.config.bounds_enabled {
        bounds_enabled = 1
    }
    dynamic_write_config_row(w)
    dynamic_native_world_step(w.native, w.config.dt, substeps * iterations, w.config.gravity.x, w.config.gravity.y, w.config.gravity.z, bounds_enabled, w.config.bounds_min.x, w.config.bounds_min.y, w.config.bounds_min.z, w.config.bounds_max.x, w.config.bounds_max.y, w.config.bounds_max.z, w.config.bounds_restitution)
    dynamic_native_world_sync(w.native, w.state, w.capacity, DYNAMIC_ROW_COUNT, w.count)
}
