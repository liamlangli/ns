mod simd

use std

// Concrete float vectors. ns_shader lowers these structs to the target's
// native vector types (floatN / vecN). Arithmetic is overloaded below so
// `a + b` and `v * s` stay binary expressions; the transpiler emits them as
// native SIMD ops instead of component-wise helpers. Named fns (dot, cross,
// normalize, length, ...) match the shader builtin table in ns_shader.c.

struct float2 {
    x: f32,
    y: f32
}

struct float3 {
    x: f32,
    y: f32,
    z: f32
}

struct float4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32
}

type quatf = float4

struct mat4 {
    col0: float4,
    col1: float4,
    col2: float4,
    col3: float4
}

fn ops(+)(a: float2, b: float2) float2 {
    return float2 { a.x + b.x, a.y + b.y }
}

fn ops(-)(a: float2, b: float2) float2 {
    return float2 { a.x - b.x, a.y - b.y }
}

fn ops(*)(a: float2, b: float2) float2 {
    return float2 { a.x * b.x, a.y * b.y }
}

fn ops(/)(a: float2, b: float2) float2 {
    return float2 { a.x / b.x, a.y / b.y }
}

fn ops(+)(a: float2, s: f32) float2 {
    return float2 { a.x + s, a.y + s }
}

fn ops(-)(a: float2, s: f32) float2 {
    return float2 { a.x - s, a.y - s }
}

fn ops(*)(a: float2, s: f32) float2 {
    return float2 { a.x * s, a.y * s }
}

fn ops(/)(a: float2, s: f32) float2 {
    return float2 { a.x / s, a.y / s }
}

fn ops(+)(s: f32, a: float2) float2 {
    return float2 { s + a.x, s + a.y }
}

fn ops(*)(s: f32, a: float2) float2 {
    return float2 { s * a.x, s * a.y }
}

fn ops(+)(a: float3, b: float3) float3 {
    return float3 { a.x + b.x, a.y + b.y, a.z + b.z }
}

fn ops(-)(a: float3, b: float3) float3 {
    return float3 { a.x - b.x, a.y - b.y, a.z - b.z }
}

fn ops(*)(a: float3, b: float3) float3 {
    return float3 { a.x * b.x, a.y * b.y, a.z * b.z }
}

fn ops(/)(a: float3, b: float3) float3 {
    return float3 { a.x / b.x, a.y / b.y, a.z / b.z }
}

fn ops(+)(a: float3, s: f32) float3 {
    return float3 { a.x + s, a.y + s, a.z + s }
}

fn ops(-)(a: float3, s: f32) float3 {
    return float3 { a.x - s, a.y - s, a.z - s }
}

fn ops(*)(a: float3, s: f32) float3 {
    return float3 { a.x * s, a.y * s, a.z * s }
}

fn ops(/)(a: float3, s: f32) float3 {
    return float3 { a.x / s, a.y / s, a.z / s }
}

fn ops(+)(s: f32, a: float3) float3 {
    return float3 { s + a.x, s + a.y, s + a.z }
}

fn ops(*)(s: f32, a: float3) float3 {
    return float3 { s * a.x, s * a.y, s * a.z }
}

fn ops(+)(a: float4, b: float4) float4 {
    return float4 { a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w }
}

fn ops(-)(a: float4, b: float4) float4 {
    return float4 { a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w }
}

fn ops(*)(a: float4, b: float4) float4 {
    return float4 { a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w }
}

fn ops(/)(a: float4, b: float4) float4 {
    return float4 { a.x / b.x, a.y / b.y, a.z / b.z, a.w / b.w }
}

fn ops(+)(a: float4, s: f32) float4 {
    return float4 { a.x + s, a.y + s, a.z + s, a.w + s }
}

fn ops(-)(a: float4, s: f32) float4 {
    return float4 { a.x - s, a.y - s, a.z - s, a.w - s }
}

fn ops(*)(a: float4, s: f32) float4 {
    return float4 { a.x * s, a.y * s, a.z * s, a.w * s }
}

fn ops(/)(a: float4, s: f32) float4 {
    return float4 { a.x / s, a.y / s, a.z / s, a.w / s }
}

fn ops(+)(s: f32, a: float4) float4 {
    return float4 { s + a.x, s + a.y, s + a.z, s + a.w }
}

fn ops(*)(s: f32, a: float4) float4 {
    return float4 { s * a.x, s * a.y, s * a.z, s * a.w }
}

fn min(a: f32, b: f32) f32 {
    if a < b { return a }
    return b
}

fn max(a: f32, b: f32) f32 {
    if a > b { return a }
    return b
}

fn clamp(value: f32, lo: f32, hi: f32) f32 {
    return min(hi, max(lo, value))
}

fn abs(value: f32) f32 {
    if value < 0.0 { return 0.0 - value }
    return value
}

// Integer overloads (stored as min_i32, max_i64, ...). Without them a call
// such as `max(n, 0)` falls back to the f32 version and yields f32.
fn min(a: i32, b: i32) i32 {
    if a < b { return a }
    return b
}

fn max(a: i32, b: i32) i32 {
    if a > b { return a }
    return b
}

fn clamp(value: i32, lo: i32, hi: i32) i32 {
    return min(hi, max(lo, value))
}

fn abs(value: i32) i32 {
    if value < 0 { return 0 - value }
    return value
}

fn min(a: i64, b: i64) i64 {
    if a < b { return a }
    return b
}

fn max(a: i64, b: i64) i64 {
    if a > b { return a }
    return b
}

fn clamp(value: i64, lo: i64, hi: i64) i64 {
    return min(hi, max(lo, value))
}

fn abs(value: i64) i64 {
    if value < 0 { return 0 - value }
    return value
}

fn lerp(a: f32, b: f32, t: f32) f32 {
    return a + (b - a) * t
}

fn mix(a: float3, b: float3, t: f32) float3 {
    return a * (1.0 - t) + b * t
}

fn dot(a: float3, b: float3) f32 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn cross(a: float3, b: float3) float3 {
    return float3 { a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x }
}

fn length(v: float3) f32 {
    return sqrt((v.x * v.x + v.y * v.y + v.z * v.z) as f64) as f32
}

fn length(v: float2) f32 {
    return sqrt((v.x * v.x + v.y * v.y) as f64) as f32
}

fn length(v: float4) f32 {
    return sqrt((v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w) as f64) as f32
}

fn distance(a: float3, b: float3) f32 {
    return length(a - b)
}

fn distance(a: float2, b: float2) f32 {
    return length(a - b)
}

fn distance(a: float4, b: float4) f32 {
    return length(a - b)
}

fn normalize(v: float3) float3 {
    let len = length(v)
    if len < 0.000001 { return float3 { 0.0, 1.0, 0.0 } }
    return v * (1.0 / len)
}

fn normalize(v: float2) float2 {
    let len = length(v)
    if len < 0.000001 { return float2 { 0.0, 1.0 } }
    return v * (1.0 / len)
}

fn normalize(v: float4) float4 {
    let len = length(v)
    if len < 0.000001 { return float4 { 0.0, 1.0, 0.0, 0.0 } }
    return v * (1.0 / len)
}

fn dot(a: float2, b: float2) f32 {
    return a.x * b.x + a.y * b.y
}

fn dot(a: float4, b: float4) f32 {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
}

// Reverse-Z perspective, the default depth convention (gpu.ns): the near
// plane maps to depth 1 and the far plane, or infinity, to 0. Draw with
// GPU_COMPARE_NEARER and clear to GPU_DEPTH_CLEAR. Clip w is the distance
// in front of the eye, so the hardware divide gives the depth below.
// The _finite forms keep a far plane; the others put it at infinity, which
// spends the float's precision where reverse-Z has the most to give.

// Clip z for a point `distance` in front of the eye with a far plane; with
// the far plane at infinity clip z is `near` itself.
fn reverse_z_clip_depth_finite(distance: f32, near: f32, far: f32) f32 {
    return near * (far - distance) / (far - near)
}

// Depth after the divide: 1 at `near`, falling toward 0 far away.
fn reverse_z_depth(distance: f32, near: f32) f32 {
    return near / distance
}

fn reverse_z_depth_finite(distance: f32, near: f32, far: f32) f32 {
    return reverse_z_clip_depth_finite(distance, near, far) / distance
}

// The clip position of a point already projected to NDC (x, y), `distance`
// in front of the eye.
fn reverse_z_clip(x: f32, y: f32, distance: f32, near: f32) float4 {
    return float4 { x * distance, y * distance, near, distance }
}

fn reverse_z_clip_finite(x: f32, y: f32, distance: f32, near: f32, far: f32) float4 {
    return float4 { x * distance, y * distance, reverse_z_clip_depth_finite(distance, near, far), distance }
}

// Right-handed reverse-Z projection matrices: the eye looks down -z, and
// `tan_half_fov_y` is the tangent of half the vertical field of view.
fn mat4_perspective_reverse_z(tan_half_fov_y: f32, aspect: f32, near: f32, far: f32) mat4 {
    let range = far - near
    return mat4 {
        float4 { 1.0 / (tan_half_fov_y * aspect), 0.0, 0.0, 0.0 },
        float4 { 0.0, 1.0 / tan_half_fov_y, 0.0, 0.0 },
        float4 { 0.0, 0.0, near / range, -1.0 },
        float4 { 0.0, 0.0, near * far / range, 0.0 }
    }
}

fn mat4_perspective_reverse_z_infinite(tan_half_fov_y: f32, aspect: f32, near: f32) mat4 {
    return mat4 {
        float4 { 1.0 / (tan_half_fov_y * aspect), 0.0, 0.0, 0.0 },
        float4 { 0.0, 1.0 / tan_half_fov_y, 0.0, 0.0 },
        float4 { 0.0, 0.0, 0.0, -1.0 },
        float4 { 0.0, 0.0, near, 0.0 }
    }
}

// `m` as 16 column-major floats at out[at], the layout gpu roots and
// ui_set_panel read.
fn mat4_write(out: [f32], at: i32, m: mat4) {
    mat4_write_column(out, at, m.col0)
    mat4_write_column(out, at + 4, m.col1)
    mat4_write_column(out, at + 8, m.col2)
    mat4_write_column(out, at + 12, m.col3)
}

fn mat4_write_column(out: [f32], at: i32, col: float4) {
    out[at] = col.x
    out[at + 1] = col.y
    out[at + 2] = col.z
    out[at + 3] = col.w
}
