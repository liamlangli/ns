mod view

use std

struct view {
    title: str,
    width: i32,
    height: i32,
    framebuffer_width: i32,
    framebuffer_height: i32,
    mouse_x: f64,
    mouse_y: f64,
    // Wheel travel accumulated since the last view_input_reset. Positive y is
    // the wheel turning away from the hand and positive x is it turning right,
    // on every backend; the browser's opposite convention is normalized in the
    // shell. The unit is the platform's own - notches on Windows, points on
    // macOS, pixels in a browser - so read the direction and treat the size as
    // a share of a turn rather than as a count.
    scroll_x: f64,
    scroll_y: f64,
    mouse_down: bool,
    mouse_pressed: bool,
    mouse_released: bool,
    mouse_right_down: bool,
    mouse_right_pressed: bool,
    mouse_right_released: bool,
    mouse_middle_down: bool,
    mouse_middle_pressed: bool,
    mouse_middle_released: bool,
    display_ratio: f64,
    ui_scale: f64,
    // Device safe-area insets in logical points: the margins of the drawable
    // that platform chrome (notch, status bar, home indicator, rounded display
    // corners) may cover. Platforms without such chrome report 0. The ui module
    // applies them automatically; see ui_safe_area.
    safe_area_top: f64,
    safe_area_right: f64,
    safe_area_bottom: f64,
    safe_area_left: f64,
    native_window: any,
    gpu_device: any,
    capture_required: bool,
    capture_started: bool,
    on_launch: view_on_launch,
    on_frame: view_on_frame,
    on_terminate: view_on_terminate
}

type view_on_launch = (ref view) -> void
type view_on_frame = (ref view) -> void
type view_on_terminate = (ref view) -> void

// Unified pointer/device identifiers.
lit VIEW_INPUT_DEVICE_MOUSE = 0
lit VIEW_INPUT_DEVICE_TOUCH = 1
lit VIEW_INPUT_DEVICE_PENCIL = 2
lit VIEW_INPUT_DEVICE_INDIRECT = 3
lit VIEW_INPUT_DEVICE_TOOL = 4

lit VIEW_INPUT_PHASE_HOVER = 0
lit VIEW_INPUT_PHASE_BEGAN = 1
lit VIEW_INPUT_PHASE_MOVED = 2
lit VIEW_INPUT_PHASE_ENDED = 3
lit VIEW_INPUT_PHASE_CANCELLED = 4
lit VIEW_INPUT_PHASE_TOOL_ACTION = 5

lit VIEW_TOOL_ACTION_NONE = 0
lit VIEW_TOOL_ACTION_PENCIL_DOUBLE_TAP = 1
lit VIEW_TOOL_ACTION_PENCIL_SQUEEZE = 2

// Standard gamepad layout, matching the browser Gamepad API. Axes use -1..1:
// X grows to the right and Y grows down. Button values use 0..1 so analog
// triggers remain available, while the pressed helpers expose digital state.
lit VIEW_GAMEPAD_CAPACITY = 4
lit VIEW_GAMEPAD_AXIS_LEFT_X = 0
lit VIEW_GAMEPAD_AXIS_LEFT_Y = 1
lit VIEW_GAMEPAD_AXIS_RIGHT_X = 2
lit VIEW_GAMEPAD_AXIS_RIGHT_Y = 3

lit VIEW_GAMEPAD_BUTTON_SOUTH = 0
lit VIEW_GAMEPAD_BUTTON_EAST = 1
lit VIEW_GAMEPAD_BUTTON_WEST = 2
lit VIEW_GAMEPAD_BUTTON_NORTH = 3
lit VIEW_GAMEPAD_BUTTON_LEFT_SHOULDER = 4
lit VIEW_GAMEPAD_BUTTON_RIGHT_SHOULDER = 5
lit VIEW_GAMEPAD_BUTTON_LEFT_TRIGGER = 6
lit VIEW_GAMEPAD_BUTTON_RIGHT_TRIGGER = 7
lit VIEW_GAMEPAD_BUTTON_SELECT = 8
lit VIEW_GAMEPAD_BUTTON_START = 9
lit VIEW_GAMEPAD_BUTTON_LEFT_STICK = 10
lit VIEW_GAMEPAD_BUTTON_RIGHT_STICK = 11
lit VIEW_GAMEPAD_BUTTON_DPAD_UP = 12
lit VIEW_GAMEPAD_BUTTON_DPAD_DOWN = 13
lit VIEW_GAMEPAD_BUTTON_DPAD_LEFT = 14
lit VIEW_GAMEPAD_BUTTON_DPAD_RIGHT = 15
lit VIEW_GAMEPAD_BUTTON_HOME = 16

struct view_input_event {
    device: i32,
    phase: i32,
    pointer_id: i32,
    modifiers: i32,
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
    pressure: f64,
    altitude: f64,
    azimuth: f64,
    timestamp: f64,
    tool_action: i32
}

// What the fingers did since the last view_input_reset: pan and orbit travel in
// points, a zoom factor around 1, and a rotation in radians with counterclockwise
// positive. iOS fills pan and zoom from a two-finger drag and pinch, rotation
// from a two-finger turn, and orbit from a one-finger drag. macOS trackpads fill
// zoom from a pinch, rotation from a two-finger turn, and orbit from a
// three-finger drag; their one and two finger travel stays with the mouse
// position and the scroll fields. A browser fills zoom from a two-finger touch
// pinch and from the ctrl-held wheel a trackpad pinch arrives as.
struct view_gesture_state {
    pan_x: f64,
    pan_y: f64,
    zoom_factor: f64,
    rotation: f64,
    orbit_x: f64,
    orbit_y: f64
}

// On a Wasm project this returns the generated HTML canvas's view record. The
// browser owns the event loop and keeps its metrics and input fields current.
ref fn view_create(title: str, width: i32, height: i32) ref view
// Compatibility alias; native backends use platform titlebars and controls.
ref fn view_create_no_title(title: str, width: i32, height: i32) ref view
// Native targets enter their platform event loop. The browser implementation
// is nonblocking because the generated shell drives the exported frame fn.
ref fn view_run(v: ref view)
ref fn view_close(v: ref view)
// Replace the window title after creation. A browser canvas sets the page's
// document title; an iOS scene has no title bar and ignores it.
ref fn view_set_title(v: ref view, title: str)
// Rename this running application where the platform shows its name apart
// from the window title: on macOS the Dock icon's tooltip, the app menu and
// Activity Monitor, through LaunchServices' display name for this process
// (a private call, skipped when the system lacks it). Other platforms show
// the window title there already and ignore it.
ref fn view_set_app_name(v: ref view, name: str)
// Ask the platform window to enter or leave fullscreen. Wayland requests
// xdg_toplevel.set_fullscreen, macOS toggles the window's fullscreen state and
// Windows covers the monitor without decorations. A browser canvas asks the
// page for fullscreen, and a host that is already fullscreen ignores it.
ref fn view_set_fullscreen(v: ref view, fullscreen: bool)
// Pointer shapes for view_set_cursor. The resize shapes are the ones a
// draggable edge or corner shows: EW for a left/right edge, NS for top/bottom,
// NWSE for the top-left/bottom-right corners and NESW for the other two.
lit VIEW_CURSOR_ARROW = 0
lit VIEW_CURSOR_TEXT = 1
lit VIEW_CURSOR_POINTER = 2
lit VIEW_CURSOR_RESIZE_EW = 3
lit VIEW_CURSOR_RESIZE_NS = 4
lit VIEW_CURSOR_RESIZE_NWSE = 5
lit VIEW_CURSOR_RESIZE_NESW = 6
lit VIEW_CURSOR_MOVE = 7
// Show `cursor` (a VIEW_CURSOR_* shape) while the pointer is over the view. The
// shape stays until the next call, so an immediate-mode program sets it every
// frame from what is under the pointer, ARROW included. macOS uses NSCursor,
// Windows the system cursors, Wayland the cursor theme and a browser canvas
// its CSS cursor; iOS and a host without a pointer ignore it.
ref fn view_set_cursor(v: ref view, cursor: i32)
// Publish safe-area insets in logical points. Native backends call this from
// their metric sync; applications only need it when they host the view inside
// their own chrome. Negative values are clamped to 0.
ref fn view_set_safe_area(v: ref view, top: f64, right: f64, bottom: f64, left: f64)
ref fn view_capture_require(v: ref view)

// Items for the application's dock menu (right-click on the macOS Dock icon),
// one title per line; a line containing "-" is a separator, and "" removes
// them. Indices count every line, including separators and empty lines.
// view_take_dock_menu returns the index
// of the item picked since the last call, or -1, and a pick requests a frame
// so an on-demand program sees it. Other backends keep the titles and never
// report a pick.
ref fn view_set_dock_menu(v: ref view, items: str)
ref fn view_take_dock_menu(v: ref view) i32

// True when this window is in the foreground and can be seen.
// Uses the platform's activation and available visibility state; macOS also
// reports minimized and fully occluded windows as inactive.
ref fn view_is_active(v: ref view) bool

// Frames are drawn on demand. Queue `frames` more of them, or one after a
// delay; an animation or a simulation asks for the next frame from inside the
// current one to keep running.
ref fn view_request_frame(v: ref view, frames: i32)
ref fn view_request_frame_after(v: ref view, milliseconds: i32)
// Cap presentation at this many frames per second. A positive value switches
// the backend to vsync-paced drawing at that rate. Zero restores on-demand
// drawing, unless NS_VIEW_CONTINUOUS is set.
ref fn view_set_frame_per_second(v: ref view, frames: i32)

ref fn view_on_scroll(v: ref view, x: f64, y: f64)
ref fn view_on_resize(v: ref view, width: i32, height: i32)
ref fn view_on_mouse_move(v: ref view, x: f64, y: f64)
ref fn view_on_mouse_btn(v: ref view, button: i32, action: i32)
ref fn view_on_key_action(v: ref view, key: i32, action: i32)
ref fn view_is_key_pressed(v: ref view, key: i32) bool
ref fn view_take_key_press(v: ref view, key: i32) i32
ref fn view_clear_key_presses(v: ref view)

// Up to four standard-layout gamepads are exposed as stable slots. A button
// press stays latched until it is taken or view_input_reset clears the frame's
// edges; held state and analog values survive input reset.
ref fn view_gamepad_count(v: ref view) i32
ref fn view_gamepad_connected(v: ref view, gamepad: i32) bool
ref fn view_gamepad_axis(v: ref view, gamepad: i32, axis: i32) f32
ref fn view_gamepad_button(v: ref view, gamepad: i32, button: i32) f32
ref fn view_gamepad_button_pressed(v: ref view, gamepad: i32, button: i32) bool
ref fn view_take_gamepad_button_press(v: ref view, gamepad: i32, button: i32) bool

ref fn view_on_pointer_event(v: ref view, device: i32, phase: i32, pointer_id: i32, x: f64, y: f64, pressure: f64, altitude: f64, azimuth: f64, timestamp: f64, modifiers: i32)
ref fn view_on_tool_action(v: ref view, action: i32, timestamp: f64)
ref fn view_on_gesture(v: ref view, pan_x: f64, pan_y: f64, zoom_factor: f64, rotation: f64)
ref fn view_input_count(v: ref view) i32
ref fn view_input_at(v: ref view, index: i32) ref view_input_event
ref fn view_gesture(v: ref view) ref view_gesture_state
// True while an unconsumed pointer, gesture, scroll, button, or key edge is
// waiting for the next application frame.
ref fn view_input_pending(v: ref view) bool
ref fn view_input_reset(v: ref view)

ref fn view_get_clipboard(v: ref view) str
ref fn view_set_clipboard(v: ref view, text: str)

// Native immersive host availability; false on window-only and web hosts.
ref fn view_immersive_supported() bool
ref fn view_immersive_request(enabled: bool) bool
// 0 closed, 1 opening, 2 active, 3 closing, -1 failed/cancelled.
ref fn view_immersive_status() i32
// -1 for window frames, otherwise the eye index; update simulation on eye 0.
ref fn view_immersive_eye() i32
// Eye transform [0,16), projection [16,32), head transform [32,48).
// Matrices are column-major; tracking positions are in metres.
ref fn view_immersive_value(index: i32) f64

// Hand skeleton snapshots. Supported by generated visionOS apps; other native
// hosts and browsers report VIEW_HANDS_UNSUPPORTED, with no tracked joints.
// Start schedules authorization on the main thread; snapshot reports progress.
// Call snapshot once before reading either hand. Readings stay fixed until the
// next snapshot. Stop invalidates live data immediately. No data is persisted.
lit VIEW_HAND_LEFT = 0
lit VIEW_HAND_RIGHT = 1
lit VIEW_HANDS_STOPPED = 0
lit VIEW_HANDS_STARTING = 1
lit VIEW_HANDS_RUNNING = 2
lit VIEW_HANDS_FAILED = -1
lit VIEW_HANDS_UNSUPPORTED = -2
lit VIEW_HAND_AXIS_X = 0
lit VIEW_HAND_AXIS_Y = 1
lit VIEW_HAND_AXIS_Z = 2
lit VIEW_HAND_JOINT_WRIST = 0
lit VIEW_HAND_JOINT_THUMB_KNUCKLE = 1
lit VIEW_HAND_JOINT_THUMB_INTERMEDIATE_BASE = 2
lit VIEW_HAND_JOINT_THUMB_INTERMEDIATE_TIP = 3
lit VIEW_HAND_JOINT_THUMB_TIP = 4
lit VIEW_HAND_JOINT_INDEX_FINGER_METACARPAL = 5
lit VIEW_HAND_JOINT_INDEX_FINGER_KNUCKLE = 6
lit VIEW_HAND_JOINT_INDEX_FINGER_INTERMEDIATE_BASE = 7
lit VIEW_HAND_JOINT_INDEX_FINGER_INTERMEDIATE_TIP = 8
lit VIEW_HAND_JOINT_INDEX_FINGER_TIP = 9
lit VIEW_HAND_JOINT_MIDDLE_FINGER_METACARPAL = 10
lit VIEW_HAND_JOINT_MIDDLE_FINGER_KNUCKLE = 11
lit VIEW_HAND_JOINT_MIDDLE_FINGER_INTERMEDIATE_BASE = 12
lit VIEW_HAND_JOINT_MIDDLE_FINGER_INTERMEDIATE_TIP = 13
lit VIEW_HAND_JOINT_MIDDLE_FINGER_TIP = 14
lit VIEW_HAND_JOINT_RING_FINGER_METACARPAL = 15
lit VIEW_HAND_JOINT_RING_FINGER_KNUCKLE = 16
lit VIEW_HAND_JOINT_RING_FINGER_INTERMEDIATE_BASE = 17
lit VIEW_HAND_JOINT_RING_FINGER_INTERMEDIATE_TIP = 18
lit VIEW_HAND_JOINT_RING_FINGER_TIP = 19
lit VIEW_HAND_JOINT_LITTLE_FINGER_METACARPAL = 20
lit VIEW_HAND_JOINT_LITTLE_FINGER_KNUCKLE = 21
lit VIEW_HAND_JOINT_LITTLE_FINGER_INTERMEDIATE_BASE = 22
lit VIEW_HAND_JOINT_LITTLE_FINGER_INTERMEDIATE_TIP = 23
lit VIEW_HAND_JOINT_LITTLE_FINGER_TIP = 24
lit VIEW_HAND_JOINT_FOREARM_WRIST = 25
lit VIEW_HAND_JOINT_FOREARM_ARM = 26
lit VIEW_HAND_JOINT_COUNT = 27

ref fn view_hands_start() i32
ref fn view_hands_stop()
ref fn view_hands_snapshot() i32
ref fn view_hand_tracked(hand: i32) bool
ref fn view_hand_joint_tracked(hand: i32, joint: i32) bool
// Position in metres in the immersive world's right-handed origin: +X right,
// +Y up, +Z back. Invalid/untracked hands, joints or axes return zero.
// Samples older than 0.20 seconds are untracked; zero alone is not validity.
ref fn view_hand_joint_position(hand: i32, joint: i32, axis: i32) f64
