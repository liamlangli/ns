mod os

// Runtime platform identifiers. Compare os_platform() directly with one of
// these values, for example `os_platform()==OS_PLATFORM_IOS`.
lit OS_PLATFORM_UNKNOWN = 0
lit OS_PLATFORM_MACOS = 1
lit OS_PLATFORM_IOS = 2
lit OS_PLATFORM_VISIONOS = 3
lit OS_PLATFORM_WINDOWS = 4
lit OS_PLATFORM_LINUX = 5

ref fn os_platform() i32
// Number of online logical CPUs, always at least one.
ref fn os_cpu_count() i32
// Current process resident memory and total physical RAM, in bytes.
// Returns 0 when the platform cannot provide the measurement.
ref fn os_process_memory() u64
ref fn os_memory_total() u64

struct os_date {
    year: i32,
    month: i32,
    day: i32,
    hour: i32,
    minute: i32,
    second: i32,
    millisecond: i32,
    microsecond: i32,
    nanosecond: i32,
    utc_offset_minutes: i32
}

// Opaque native synchronization handles. Locks are non-recursive. Destroy a
// handle only after every task/native thread has stopped using it.
struct os_lock {
    handle: any
}

struct os_semaphore {
    handle: any
}

ref fn os_lock_create() ref os_lock
ref fn os_lock_acquire(lock: ref os_lock) bool
ref fn os_lock_try_acquire(lock: ref os_lock) bool
ref fn os_lock_release(lock: ref os_lock) bool
ref fn os_lock_destroy(lock: ref os_lock)

// Create an unbounded semaphore, or a bounded semaphore whose count never
// exceeds max_count. Invalid counts return a nil handle.
ref fn os_semaphore_create(initial_count: i32) ref os_semaphore
ref fn os_semaphore_create_bounded(initial_count: i32, max_count: i32) ref os_semaphore
ref fn os_semaphore_wait(semaphore: ref os_semaphore) bool
ref fn os_semaphore_try_wait(semaphore: ref os_semaphore) bool
// Signal returns false rather than exceeding a bounded semaphore's maximum.
ref fn os_semaphore_signal(semaphore: ref os_semaphore) bool
ref fn os_semaphore_destroy(semaphore: ref os_semaphore)

// Current Unix time in seconds with sub-second precision.
ref fn os_time() f64

// Current Unix time since 1970-01-01T00:00:00Z.
ref fn os_time_ms() u64
ref fn os_time_us() u64
ref fn os_time_ns() u64

// Current local date/time, including sub-second fields and UTC offset. The
// record is reused after 15 more calls on the same thread; copy what you keep.
ref fn os_date_now() ref os_date

// Local formatted strings.
ref fn os_time_string() str
ref fn os_date_string() str
ref fn os_locale_date_string() str
ref fn os_locale_date_time_string() str

// Start a continuous device vibration, replacing any vibration already playing.
// Intensity is clamped to 0.0...1.0 and duration is measured in seconds.
// Non-positive values and unsupported platforms/devices are silently ignored.
ref fn os_vibrate(intensity: f64, duration: f64)

// Prepare and play the platform's standard medium impact feedback. On iOS
// this uses UIImpactFeedbackGenerator; unsupported platforms silently ignore it.
ref fn os_impact_prepare()
ref fn os_impact()

// Device motion: the gyroscope fused with the accelerometer. os_motion_start
// begins updates at hz samples a second (clamped to 10...120) and returns
// false where the device has no motion sensors, as on desktops. Calling it
// again while running only changes the rate.
ref fn os_motion_start(hz: f64) bool
ref fn os_motion_stop()
// Writes the latest attitude quaternion x, y, z, w into values[0...3]: the
// rotation from the device frame (x right, y toward the top of the screen in
// portrait, z out of the screen) into a fixed frame with z vertical and an
// arbitrary, slowly drifting heading. Returns false until a sample arrives.
ref fn os_motion_attitude(values: [f64]) bool

// File access. os_file_size returns -1 on failure. Ranged reads truncate at
// EOF and return an empty string when the file or requested range is invalid.
ref fn os_file_size(path: str) i64
// Streamed UTF-8 byte-column metrics, including the final empty line.
// Writes line count, maximum byte-column count, the byte-column count that
// covers 90% of the non-empty lines, and the row count when every line wraps
// at that width to values[0...3].
// False means failure; the caller supplies at least four elements.
ref fn os_file_text_metrics(path: str, values: [i64]) bool
// SHA-256 in lowercase hex; file hashing streams through a 64 KiB buffer.
// Empty string means failure, including a file that changed during hashing.
ref fn os_file_hash(path: str) str
ref fn os_text_hash(text: str) str
// Desktop Git helpers (Git on PATH). Revision identifies HEAD; an unborn
// repository returns "unborn". Empty revision means unavailable/non-repository.
// Base returns HEAD's file contents (empty for an untracked/empty file).
// Diff compares two supplied texts, returning a unified zero-context patch.
// Changes lists staged, unstaged and untracked paths relative to `path`, one
// per line; a rename contributes its new path. An empty string with status 0
// is a clean work tree. Change kinds is the same listing with each line led
// by "M " (modified), "A " (added or untracked; a rename's or copy's new
// path) or "D " (deleted; a rename also lists its old path as deleted).
// Output is bounded; empty means no differences or unavailable/oversized
// data. Apple mobile and Windows currently return empty strings. Last Git
// operation exit status on this thread, or -1 on failure/truncation.
ref fn os_git_status() i32
ref fn os_git_revision(path: str) str
ref fn os_git_base(path: str, max_bytes: i32) str
ref fn os_git_diff_text(before: str, after: str, max_bytes: i32) str
ref fn os_git_changes(path: str) str
ref fn os_git_change_kinds(path: str) str
// Run `git -C folder` with one argument per line of `args` (empty lines are
// skipped, so an argument cannot hold a newline), never through a shell.
// Git runs without a controlling terminal and with GIT_TERMINAL_PROMPT=0, so
// a missing credential fails rather than waiting on a prompt. Takes up to
// 8192 arguments. Returns stdout and stderr together, keeping the last 64 KiB;
// os_git_status() is the exit status, -1 when Git could not run. Blocking:
// call it from a worker task. Embedded iOS Git implements the Lens command
// subset in-process; first-use SSH host trust can show a native confirmation.
ref fn os_git_run(folder: str, args: str) str
// The last percentage the running os_git_run printed (pass `--progress` for
// push/fetch), or -1 before any. Readable from any thread.
ref fn os_git_progress() i32
ref fn os_read_file(path: str) str
ref fn os_read_file_part(path: str, offset: i64, size: i64) str
// Atomically replace a UTF-8 text file and return 1 on success.
ref fn os_write_file_atomic(path: str, text: str) i32
// Read up to capacity raw bytes into data. Returns bytes read, or -1 on error.
ref fn os_read_file_bytes(path: str, data: [u8], capacity: i32) i64
// Atomically replace a binary file with size raw bytes from data.
ref fn os_write_file_bytes_atomic(path: str, data: [u8], size: i32) i32
// Writable per-user application-support directory; it is created on demand.
ref fn os_app_data_dir(app_name: str) str
// Writable user-visible documents directory, created on demand: the app's own
// Documents folder on iOS/visionOS (app_name is unused there), otherwise
// ~/Documents/<app_name>. Calling it makes `ns project` publish that folder
// to the Files app, so the user can browse and edit what the app keeps there.
ref fn os_documents_dir(app_name: str) str

// Recursively snapshot a directory in stable, directories-first name order.
// Root .gitignore matches and .git metadata are omitted. Entry accessors are
// valid until the next os_dir_scan call. On macOS/Linux, bin/ns_lens/ignore
// adds one POSIX extended regex per line, matched against relative paths.
// Empty lines and # comments are skipped; invalid rules are logged and skipped.
// Matching directories are pruned, including all descendants.
ref fn os_dir_scan(path: str) i32
ref fn os_entry_name(index: i32) str
ref fn os_entry_path(index: i32) str
ref fn os_entry_depth(index: i32) i32
ref fn os_entry_parent(index: i32) i32
ref fn os_entry_is_dir(index: i32) i32
// The names directly inside one directory, one per line, unordered and
// without "." or ".."; "" when it is empty, missing or unreadable.
ref fn os_dir_list(path: str) str

// Recursively watch one workspace root. poll is non-blocking and returns 1
// after the operating system reports any file-tree change.
ref fn os_watch_start(path: str) i32
ref fn os_watch_poll() i32
ref fn os_watch_stop()

// Show a native open-file dialog when the platform backend supports one.
// Returns an empty string when the dialog is cancelled or unavailable.
ref fn os_open_file_dialog(title: str) str
// Native save-file panel. Returns an empty string when cancelled/unavailable.
ref fn os_save_file_dialog(title: str, suggested_name: str) str

// Show the platform share sheet for an existing local file (iOS/macOS).
// Returns 1 when scheduled, 0 when unsupported/invalid. Completion is user-owned.
ref fn os_share_file(path: str) i32

// Project/window helpers. Folder selection is native where the platform UI
// backend supports it. os_launch_ns_project starts this interpreter again with
// `run entry`, using `folder` as the child process working directory.
ref fn os_open_folder_dialog(title: str) str
ref fn os_cwd() str
ref fn os_env(name: str) str

// The over-the-air patch the host installed before this program started
// (doc/patch.md), which the host publishes as NS_PATCH_VERSION. 0 when the
// program runs the files it shipped with, or its host takes no patches.
ref fn os_patch_version() i32
// The running patch's label (`ns patch --label`), published as NS_PATCH_LABEL:
// free text such as a build date for telling builds apart. "" when the patch
// has none, or no patch runs.
ref fn os_patch_label() str
ref fn os_make_dirs(path: str) i32
// Rename or move a file or directory. Returns 1 on success and 0 on failure;
// an existing target is never replaced.
ref fn os_rename_path(from_path: str, to_path: str) i32
ref fn os_launch_ns_project(folder: str, entry: str) i32

// Interactive shell over a pseudo-terminal, rooted at `folder`. os_pty_open
// starts the user's $SHELL as a login shell with the given size and returns a
// handle above zero, or 0 when this platform has no terminal. os_pty_read
// returns up to `capacity` bytes of output (empty when none arrived) and
// os_pty_write sends input; both are non-blocking. os_pty_running is 1 while
// the shell runs. os_pty_resize updates the size the shell sees, and
// os_pty_close hangs up the shell and releases the handle.
ref fn os_pty_open(folder: str, cols: i32, rows: i32) i32
ref fn os_pty_read(handle: i32, capacity: i32) str
ref fn os_pty_write(handle: i32, data: str) i32
ref fn os_pty_resize(handle: i32, cols: i32, rows: i32) i32
ref fn os_pty_running(handle: i32) i32
ref fn os_pty_close(handle: i32)

// Interactive shell on a remote host over SSH, for platforms without a local
// shell (iOS apps that opt in with os_git_embedded()). It uses the identity
// os_git_identity_import stored and the same first-use host pins as Git, so a
// first connection can show a native fingerprint confirmation. os_ssh_open
// starts connecting in the background and returns a handle above zero, or 0
// when unavailable or given an invalid host/user. A non-empty `folder` is the
// remote start directory (`~/` is the remote home). os_ssh_state is one of
// the OS_SSH_* values below; os_ssh_error explains a failure or the exit.
// Read, write and resize never block: input typed while connecting is sent
// once the shell starts, and input still queued when the session ends is
// dropped, never replayed. Output can be read after the shell exits until it
// is drained. NUL output bytes are dropped. os_ssh_close disconnects and
// releases the handle.
lit OS_SSH_FAILED = -1
lit OS_SSH_CLOSED = 0
lit OS_SSH_CONNECTING = 1
lit OS_SSH_VERIFYING = 2
lit OS_SSH_OPEN = 3
ref fn os_ssh_open(host: str, port: i32, user: str, folder: str, cols: i32, rows: i32) i32
ref fn os_ssh_state(handle: i32) i32
ref fn os_ssh_error(handle: i32) str
ref fn os_ssh_read(handle: i32, capacity: i32) str
ref fn os_ssh_write(handle: i32, data: str) i32
ref fn os_ssh_resize(handle: i32, cols: i32, rows: i32) i32
ref fn os_ssh_close(handle: i32)

// Live profiling: start `<exe> profile --live-port <port> [entry]` with
// `folder` as the child working directory, so a viewer that owns the TCP
// listener can run, restart, and stop the program it measures. `exe` is the
// `ns` executable (NS_PROFILE_NS names it for a viewer the CLI launched), and
// an empty `entry` lets the child resolve its own project entry. Returns the
// child process id, or 0 when the process could not be started.
ref fn os_launch_ns_profile(exe: str, folder: str, entry: str, port: i32) i32
ref fn os_process_alive(pid: i32) i32
ref fn os_process_stop(pid: i32) i32

// Start another instance of this program, detached, the way this one was
// started (a native build relaunches itself, an interpreted program reruns
// `ns run`). The new instance reads `arg` as its first program argument
// through os_env("NS_ARG0"). Returns 1 when it was started, 0 where a program
// cannot start itself (iOS, the browser).
ref fn os_launch_self(arg: str) i32

// Opt in to in-process Git in generated iOS projects. ns project detects this
// call and builds pinned libgit2/libssh2/OpenSSL static dependencies. Desktop
// returns false and continues to use its installed Git command.
ref fn os_git_embedded() bool
// Apple mobile Keychain only. Stores an OpenSSH/PEM key and its passphrase;
// false on invalid input or unavailable secure storage. Never writes key files.
ref fn os_git_identity_import(key: str, passphrase: str) bool
ref fn os_git_identity_delete() bool
// Whether a stored identity exists. Generate creates an unencrypted ed25519
// key in OpenSSH format and stores it like an imported one; it refuses to
// replace an existing identity. Public returns the stored key's
// authorized_keys line ("" for a PEM key or none), for the user to add to
// their Git host or development machine. The private key never leaves Keychain.
ref fn os_git_identity_exists() bool
ref fn os_git_identity_generate(comment: str) bool
ref fn os_git_identity_public() str
// Nonblocking native dialogs (iOS). One active dialog per process; begin
// returns 1 if scheduled, 0 if busy/unavailable. Poll: 0 pending, 1 accepted,
// -1 cancelled/unavailable. Values persist until the next begin. File picker
// kind 0/1 copies a file/folder into private application support and returns
// its path. Kind 2 reads a secret file (max 64 KiB) directly into memory;
// value 0 is its content, with no copy made on disk.
// A prompt has one field label per line (up to 4); bit i masks field i.
ref fn os_dialog_file_begin(title: str, kind: i32) i32
ref fn os_dialog_prompt_begin(title: str, fields: str, secret_mask: i32) i32
ref fn os_dialog_poll() i32
ref fn os_dialog_value(index: i32) str

// Wipe completed dialog values, including temporary secret text.
ref fn os_dialog_clear()
