mod shader

use simd

// Resource values carried by strongly typed user bind-group structs. Slots are
// supplied by the resource definition; neither shader nor gpu assigns them
// from builtin names or declaration order. `value_type` is a first-class type
// value (u8, i8, f32, ...), represented as i32 at the ABI boundary.
struct shader_texture {
    object: u32,
    slot: i32,
    value_type: type
}

struct shader_buffer {
    object: u64,
    slot: i32,
    value_type: type
}

// Structural bind-group reflection. `group` must be a user struct and every
// field must be a shader_texture or shader_buffer-shaped resource definition.
// The functions reject negative/duplicate slots rather than repairing them.
ref fn shader_group_binding_count(group: any) i32
ref fn shader_group_binding_object(group: any, index: i32) u64
ref fn shader_group_binding_slot(group: any, index: i32) i32
ref fn shader_group_binding_value_type(group: any, index: i32) type
ref fn shader_group_binding_is_texture(group: any, index: i32) bool

// Transcode ns fns to shader source text at runtime. These fns are VM-internal
// intrinsics (like std): the transpiler walks the fn-body ast inside the
// interpreter, so there is no shader dylib.
//
// Targets: "msl" (Metal), "glsl" (Vulkan GLSL 450, one source per stage),
// "hlsl" (DirectX 12).
//
// A shader entry is an ordinary ns fn over simd/user structs:
//   - vertex:   fn vs_main(in: VertexData) FragmentInput  (return struct needs
//                a `position: float4` field)
//   - fragment: fn fs_main(in: FragmentInput) float4
// Numbers are emitted as 32-bit floats (f64 `d` literals are demoted). str,
// containers, closures, ref types and native fns are rejected with a
// source-located error.

// Transpile fn `f` for `target`; the stage is inferred from the fn name
// (vs_* / fs_* / ps_*) or its signature.
ref fn shader_transpile(f: any, target: str) str

// Transpile with an explicit stage: "vertex" | "fragment" | "compute".
// Compute entries take no parameters and return void. GPU resources and the
// root argument are accessed through the stage intrinsics below.
ref fn shader_transpile_stage(f: any, target: str, stage: str) str

// Entry-point name for gpu_shader_stage_desc.entry: the fn name for msl/hlsl,
// "main" for glsl (the generated wrapper).
ref fn shader_entry(f: any, target: str) str

// The ns fn name behind a shader entry, whatever the target. gpu names its
// compiled-shader cache entries with it, so the cache file for a shader is
// recognizable rather than a bare hash.
ref fn shader_name(f: any) str

// FNV-1a 64 over transpiled shader text. Transpiling a fn emits the source and
// this hash together identifies it: the same source always hashes the same, and
// editing a shader fn, one of its callees, or the transpiler changes it. gpu
// keys its compiled-shader cache on shader_name plus this hash so a stale
// binary is never reused.
ref fn shader_source_hash(source: str) u64

// Vertex-layout reflection over a vertex fn's input struct, for pipeline
// creation without hand-written layout tables. Offsets and the stride assume
// tightly packed 32-bit float data (the layout gpu vertex buffers upload), so
// input fields must be f32 or float2/3/4; attr sizes are component counts.
ref fn shader_vertex_stride(f: any) i32
ref fn shader_vertex_attr_count(f: any) i32
ref fn shader_vertex_attr_offset(f: any, index: i32) i32
ref fn shader_vertex_attr_size(f: any, index: i32) i32

// Fragment-only shadow-map lookup. `coord.xy` is normalized texture space and
// `coord.z` is the already-biased receiver depth in the light projection. The
// transpiler lowers this to one linearly filtered hardware depth comparison:
// the comparison sampler's bilinear footprint is a 2x2 PCF kernel against the
// depth texture bound as `ns_shadow_map`. It is not evaluated by the Nano
// Script VM.
ref fn shader_sample_shadow(coord: float3) f32

// Scene transform intrinsics backed by the `ns_uniforms` buffer supplied by a
// generic gpu binding. They keep application-owned vertex shaders in ns while
// moving model/camera/light matrix work onto the GPU.
ref fn shader_transform_position(position: float3) float4
ref fn shader_transform_normal(normal: float3) float3
ref fn shader_shadow_clip_position(position: float3) float4
ref fn shader_scene_selected() f32
ref fn shader_scene_textured() f32
ref fn shader_scene_receives_shadow() f32

// Legacy regular-RGBA texture sampling intrinsic.
ref fn shader_sample_texture(coord: float2) float4
// Read the nearest texel from `ns_texture_map`. Use this when a one-to-one
// fullscreen pass must preserve high-frequency source pixels.
ref fn shader_sample_texture_nearest(coord: float2) float4
// Legacy single-channel mask sampling intrinsic. The value is returned in `.x`
// on every backend.
ref fn shader_sample_mask(coord: float2) float4

// Fragment-only screen-space derivatives. The VM returns 0; the transpiler
// lowers them to dfdx/dFdx/ddx/dpdx and dfdy/dFdy/ddy/dpdy.
ref fn ddx(value: f32) f32
ref fn ddy(value: f32) f32
// Fragment-only early termination. Pixels discarded this way update neither
// color nor depth. The VM treats it as a no-op; shader backends lower it to
// discard_fragment() / discard.
ref fn shader_discard()

// ---- host execution of compute fns -----------------------------------------
//
// A compute fn is an ordinary ns fn, so the interpreter can run it directly
// once the resources its stage intrinsics read are bound host-side: a float4
// image pair (four f32 per texel, row-major, `width` texels per row), the 16
// root words, and the invocation coordinate. Calling the fn then executes one
// invocation, which is how compute kernels are tested without a device and
// how a gpu-less backend runs the same kernels the device would.
//
// `shader_host_bind` fails when either image is shorter than width * height
// texels. Bind an optional secondary output after the primary image pair. The
// bindings are process-wide, so release them when done.
ref fn shader_host_bind(read: [f32], write: [f32], width: i32, height: i32) bool
ref fn shader_host_bind_secondary(write: [f32]) bool
ref fn shader_host_root(words: [f32]) bool
ref fn shader_host_invocation(x: i32, y: i32, z: i32)
// Swap the bound read and write images, as a dispatch boundary does.
ref fn shader_host_swap()
ref fn shader_host_release()

// v2 stage intrinsics. Invocation coordinates identify the current compute
// thread. The read/primary-write/secondary-write texture IDs live in root
// words 0, 1 and 2; the portable
// WebGPU tier patches those bindless IDs into the shader's bind group.
// shader_root_f32 addresses the root as tightly packed 32-bit words.
ref fn shader_global_id_x() i32
ref fn shader_global_id_y() i32
ref fn shader_global_id_z() i32
ref fn shader_vertex_id() i32
ref fn shader_root_f32(index: i32) f32
// Random-access signed 32-bit storage buffers. `buffer_index` is a compile-time
// index into the stage's storage-buffer parameters; indices address i32
// elements rather than bytes so writes never race adjacent packed values. A
// buffer no fn in the transpiled program stores to is declared read-only, which
// a vertex stage needs: Metal warns about a writable resource in a non-void
// vertex fn and WebGPU rejects a read_write storage buffer there outright.
ref fn shader_buffer_i32(buffer_index: i32, index: i32) i32
ref fn shader_buffer_store_i32(buffer_index: i32, index: i32, value: i32)
ref fn shader_read_texture(x: i32, y: i32) float4
ref fn shader_write_texture(x: i32, y: i32, color: float4)
// Write the secondary compute output texture. Its bindless texture ID is root
// word 2; this lets one invocation produce color and auxiliary geometry data.
ref fn shader_write_texture_secondary(x: i32, y: i32, color: float4)
