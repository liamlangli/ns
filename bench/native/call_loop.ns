use std

fn mix(x: i32, y: i32) i32 {
    return (x * 3 + y * 5 + 7) % 1000003
}

// Native-backend call loop: one direct call per iteration.
fn main() i32 {
    let total = 1
    let i = 0
    loop i < 20000000 {
        total = mix(total, i)
        i += 1
    }
    print(`{total}\n`)
    return 0
}
