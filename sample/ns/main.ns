use std

struct point {
    x: f32,
    y: f32
}

fn ops(+)(lhs: point, rhs: point): point {
    return point(lhs.x + rhs.x, lhs.y + rhs.y)
}

fn to_str(p: point): str {
    return `{p.x}, {p.y}`
}

enum os_platform: u8 {
    unknown = 0,
    macos,
}

let platform = os_platform.macos
let raw: u8 = platform
let restored = raw as os_platform

fn main() {
    let a = point(0, 0)
    let b = point(1, 1)
    print(`{a + b}\n`)
}
