use std
use io

fn main() i32 {
    let image = io_load_image("lib/assets/latin_mono.png")
    assert image.width > 0
    assert image.height > 0
    assert image.channels >= 3
    let bytes = image.width * image.height * image.channels
    let pixels = [u8](bytes)
    assert io_image_copy_data(image, pixels, bytes) == bytes
    io_image_destroy(image)
    return 0
}
