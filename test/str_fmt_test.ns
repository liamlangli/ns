// Backtick interpolation at statement boundaries. A str-format expression is
// an operand like any other, so a statement ending in one terminates at the
// newline: the following statement must parse independently. Regression for a
// bug where NS_AST_STR_FMT_EXPR was not recognized as an operand, so the parser
// treated the newline as a trailing-operator continuation and swallowed the
// next statement (crashing or mis-parsing).
use std

fn noop() {
}

// ---- a backtick-let followed by an expression statement --------------------
// (the exact shape that used to crash / mis-parse)
let s = "z"
let one = `{s}`
noop()
print("after backtick-let ")
assert one == "z"

// followed by a bare call
let two = `v={s}`
noop()
assert two == "v=z"

// ---- backtick as the right operand of a concatenation assignment -----------
let acc = ""
acc = acc + `{s};`
acc = acc + `{s};`
assert acc == "z;z;"

// ---- accumulate interpolated pieces across a loop --------------------------
struct point { x: i32, y: i32 }
fn to_str(p: point) str {
    return `({p.x},{p.y})`
}
let pts = [point(1, 1), point(2, 2), point(3, 3)]
let joined = ""
for p in pts {
    let piece = `{p};`
    joined = joined + piece
}
assert joined == "(1,1);(2,2);(3,3);"

// ---- consecutive backtick statements, then other statement kinds -----------
let a = `a{s}`
let b = `b{s}`
noop()
if a == "az" {
    print("branch ok ")
}
assert a == "az" && b == "bz"

// ---- a backtick expression statement on its own, then more -----------------
print(`standalone {s}\n`)
let after = 42
assert after == 42

print("str fmt boundary test passed\n")

// ---- a format string used as a call argument -------------------------------
// A format string chains its embedded expressions, and so does an argument
// list. When both used the node's `next` field, an enclosing call linked its
// following argument over the head of the format's own chain: the format read
// the call's later arguments as its holes, printing the wrong value when the
// types happened to line up and dereferencing a bool as a string when they did
// not. Every argument position is covered because only a format in the last
// one was ever safe.
fn fmt_two(head: str, flag: bool) str {
    return `{head}/{flag}`
}

fn fmt_four(head: str, flag: bool, tail: str, count: i32) str {
    return `{head}/{flag}/{tail}/{count}`
}

fn fmt_three(a: str, b: str, c: str) str {
    return `{a}|{b}|{c}`
}

let n = 7
let word = "host"
assert fmt_two(`a{n}b`, true) == "a7b/true"
assert fmt_two("plain", true) == "plain/true"
assert fmt_four(`{word}:{n}`, true, word, n) == "host:7/true/host/7"
assert fmt_three("first", `x{n}y`, "last") == "first|x7y|last"
assert fmt_three(`p{n}q`, `r{n}s`, `t{n}u`) == "p7q|r7s|t7u"

// The same collision through other chained parents: an array literal and a
// nested call argument both link their elements with `next`.
let pieces = [`one{n}`, `two{n}`, `three{n}`]
assert pieces[0] == "one7"
assert pieces[1] == "two7"
assert pieces[2] == "three7"
assert fmt_three(fmt_two(`i{n}`, false), `m{n}`, "last") == "i7/false|m7|last"

print("str fmt argument test passed\n")
