// Box3D backend coverage. Run from the repository root so the debug ref/lib
// paths resolve lib/dynamic.ns and bin/dynamic.dylib.
use std
use simd
use dynamic

fn cube_hull(half: f32) [f32] {
    let hull = [f32](24)
    for corner in 0 to 8 {
        let sx = 0.0 - 1.0
        let sy = 0.0 - 1.0
        let sz = 0.0 - 1.0
        if (corner & 1) != 0 {
            sx = 1.0
        }
        if (corner & 2) != 0 {
            sy = 1.0
        }
        if (corner & 4) != 0 {
            sz = 1.0
        }
        hull[corner * 3] = sx * half
        hull[corner * 3 + 1] = sy * half
        hull[corner * 3 + 2] = sz * half
    }
    return hull
}

fn add_box(w: ref dynamic_world, half: f32, position: float3, mass: f32) i32 {
    let body = dynamic_body_box(dynamic_v3(half, half, half), mass)
    body.position = position
    let index = dynamic_world_add(w, body)
    dynamic_world_set_hull(w, index, cube_hull(half), 8)
    return index
}

fn add_sphere(w: ref dynamic_world, radius: f32, position: float3, mass: f32) i32 {
    let body = dynamic_body_sphere(radius, mass)
    body.position = position
    return dynamic_world_add(w, body)
}

fn free_world(capacity: i32) dynamic_world {
    let config = dynamic_config_default()
    config.gravity = dynamic_v3(0.0, 0.0, 0.0)
    config.bounds_enabled = false
    return dynamic_world_create(capacity, config)
}

// Stable compatibility layout for render/query code.
assert DYNAMIC_ROW_CONTACT == DYNAMIC_ROW_PAIR + DYNAMIC_MAX_CONTACTS
assert DYNAMIC_ROW_POINT == DYNAMIC_ROW_CONTACT + DYNAMIC_MAX_CONTACTS
assert DYNAMIC_ROW_HULL == DYNAMIC_ROW_POINT + DYNAMIC_MAX_CONTACTS
assert DYNAMIC_ROW_COUNT == DYNAMIC_ROW_HULL + DYNAMIC_MAX_HULL_VERTICES

let tiny = dynamic_world_create(1, dynamic_config_default())
assert tiny.capacity == DYNAMIC_CONFIG_COLUMNS
assert tiny.native != (0 as u64)
assert dynamic_world_backend(tiny) == DYNAMIC_BACKEND_BOX3D
assert dynamic_world_backend(tiny) == DYNAMIC_BACKEND_CPU
assert dynamic_world_backend_name(tiny) == "box3d"
assert dynamic_world_state_texture(tiny) == 0u
dynamic_world_release(tiny)
assert tiny.native == (0 as u64)

// Bodies retain the old data-oriented representation while Box3D owns motion.
let world = dynamic_world_create(8, dynamic_config_default())
let box_index = add_box(world, 0.5, dynamic_v3(0.0, 4.0, 0.0), 2.0)
assert box_index == 0
assert world.count == 1
assert dynamic_world_hull_count(world, box_index) == 8
assert dynamic_world_hull_vertex(world, box_index, 0).x == 0.0 - 0.5
let stored = dynamic_world_body(world, box_index)
assert stored.position.y == 4.0
assert stored.inv_mass == 0.5
assert stored.orientation.w == 1.0
let bound = dynamic_state_read(world.state, world.capacity, box_index, DYNAMIC_ROW_POSITION).w
assert bound > 0.86 && bound < 0.87

let sphere_index = add_sphere(world, 0.4, dynamic_v3(2.0, 4.0, 0.0), 1.0)
assert dynamic_world_hull_count(world, sphere_index) == 1
assert dynamic_world_body(world, sphere_index).margin == 0.4

// Capacity failure never overwrites an existing native body.
let small = dynamic_world_create(4, dynamic_config_default())
for i in 0 to 4 {
    assert add_sphere(small, 0.2, dynamic_v3((i as f32) * 0.6, 1.0, 0.0), 1.0) == i
}
assert add_sphere(small, 0.2, dynamic_v3(0.0, 2.0, 0.0), 1.0) == 0 - 1
assert small.count == 4
dynamic_world_release(small)

// Gravity and semi-implicit integration are now supplied by Box3D.
let falling = dynamic_world_create(4, dynamic_config_default())
add_sphere(falling, 0.3, dynamic_v3(0.0, 6.0, 0.0), 1.0)
dynamic_world_step(falling)
let dropped = dynamic_world_body(falling, 0)
assert dropped.position.y < 6.0
assert dropped.velocity.y < 0.0

// Runtime configuration changes are forwarded before every step.
falling.config.gravity = dynamic_v3(0.0, 9.81, 0.0)
for step in 0 to 10 {
    dynamic_world_step(falling)
}
assert dynamic_world_body(falling, 0).velocity.y > 0.0
dynamic_world_release(falling)

// Angular state uses the same x/y/z/w quaternion convention as Box3D.
let spinning = free_world(4)
let spinner = dynamic_body_box(dynamic_v3(0.4, 0.4, 0.4), 1.0)
spinner.position = dynamic_v3(0.0, 2.0, 0.0)
spinner.angular_velocity = dynamic_v3(0.0, 4.0, 0.0)
spinner.angular_damping = 0.0
let spin_index = dynamic_world_add(spinning, spinner)
dynamic_world_set_hull(spinning, spin_index, cube_hull(0.4), 8)
for step in 0 to 10 {
    dynamic_world_step(spinning)
}
let turned = dynamic_world_body(spinning, 0)
let quat_length = turned.orientation.x * turned.orientation.x + turned.orientation.y * turned.orientation.y +
    turned.orientation.z * turned.orientation.z + turned.orientation.w * turned.orientation.w
assert quat_length > 0.999 && quat_length < 1.001
assert dynamic_abs(turned.orientation.y) > 0.1
assert turned.position.y == 2.0
dynamic_world_release(spinning)

// A zero-mass body maps to a Box3D static body.
let anchored = dynamic_world_create(4, dynamic_config_default())
add_box(anchored, 0.5, dynamic_v3(0.0, 5.0, 0.0), 0.0)
for step in 0 to 20 {
    dynamic_world_step(anchored)
}
let held = dynamic_world_body(anchored, 0)
assert held.position.y == 5.0
assert held.velocity.y == 0.0
dynamic_world_release(anchored)

// Box3D supplies broad phase, manifold generation, and the Soft Step solver.
let boxes = free_world(4)
add_box(boxes, 0.5, dynamic_v3(0.0, 3.0, 0.0), 1.0)
add_box(boxes, 0.5, dynamic_v3(0.8, 3.0, 0.0), 1.0)
dynamic_world_step(boxes)
assert dynamic_world_contact_count(boxes, 0) >= 1
assert dynamic_world_contact_count(boxes, 1) >= 1
let left_contact = dynamic_state_read(boxes.state, boxes.capacity, 0, DYNAMIC_ROW_CONTACT)
let right_contact = dynamic_state_read(boxes.state, boxes.capacity, 1, DYNAMIC_ROW_CONTACT)
assert left_contact.x < 0.0 - 0.9
assert right_contact.x > 0.9

for step in 0 to 20 {
    dynamic_world_step(boxes)
}
let left = dynamic_world_body(boxes, 0)
let right = dynamic_world_body(boxes, 1)
assert right.position.x - left.position.x > 0.9
dynamic_world_release(boxes)

// Two points plus a margin select Box3D's capsule primitive.
let capsules = free_world(4)
let capsule_body = dynamic_body_sphere(0.2, 1.0)
let capsule_index = dynamic_world_add(capsules, capsule_body)
let capsule_points = [0.0, 0.0 - 0.5, 0.0, 0.0, 0.5, 0.0]
dynamic_world_set_hull(capsules, capsule_index, capsule_points, 2)
add_sphere(capsules, 0.3, dynamic_v3(0.4, 0.0, 0.0), 1.0)
dynamic_world_step(capsules)
assert dynamic_world_contact_count(capsules, capsule_index) >= 1
dynamic_world_release(capsules)

// The configured bounds are six static Box3D hulls.
let resting = dynamic_world_create(4, dynamic_config_default())
add_box(resting, 0.4, dynamic_v3(0.0, 3.0, 0.0), 1.0)
for step in 0 to 180 {
    dynamic_world_step(resting)
}
let settled = dynamic_world_body(resting, 0)
assert settled.position.y > 0.38 && settled.position.y < 0.43
assert dynamic_abs(settled.velocity.y) < 0.05
assert dynamic_abs(settled.orientation.w) > 0.99
dynamic_world_release(resting)

// Persistent dynamic-body contacts are mirrored into the compatibility rows.
let stacked = dynamic_world_create(4, dynamic_config_default())
add_box(stacked, 0.4, dynamic_v3(0.0, 0.4, 0.0), 0.0)
add_sphere(stacked, 0.35, dynamic_v3(0.05, 2.0, 0.0), 1.0)
for step in 0 to 180 {
    dynamic_world_step(stacked)
}
let base = dynamic_world_body(stacked, 0)
let top = dynamic_world_body(stacked, 1)
assert top.position.y > base.position.y + 0.65
assert dynamic_world_contact_count(stacked, 1) >= 1
dynamic_world_release(stacked)

// Host edits followed by upload update the Box3D body.
let uploaded = free_world(4)
add_sphere(uploaded, 0.25, dynamic_v3(0.0, 1.0, 0.0), 1.0)
let edited = dynamic_world_body(uploaded, 0)
edited.position = dynamic_v3(2.0, 3.0, 4.0)
edited.velocity = dynamic_v3(1.0, 0.0, 0.0)
dynamic_world_set_body(uploaded, 0, edited)
dynamic_world_step(uploaded)
let moved = dynamic_world_body(uploaded, 0)
assert moved.position.x > 2.0
assert moved.position.y == 3.0
assert moved.position.z == 4.0

dynamic_world_clear(uploaded)
assert uploaded.count == 0
assert dynamic_world_contact_count(uploaded, 0) == 0
add_sphere(uploaded, 0.2, dynamic_v3(0.0, 1.0, 0.0), 1.0)
assert uploaded.count == 1
dynamic_world_release(uploaded)

dynamic_world_release(world)
print("dynamic Box3D tests passed\n")
