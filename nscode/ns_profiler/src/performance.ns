// The status bar's FPS and RAM readouts, sampled the way ns_lens samples its
// own: frames are counted as they render and the rate and resident memory
// are re-read once a second. The labels are composed only when a sample
// lands, so an idle status bar allocates nothing per frame.

use os
use std

let g_status_started = false
let g_status_time: f64 = 0.0
let g_status_frames: i32 = 0
let g_status_fps: i32 = 0
let g_status_memory: u64 = 0
let g_status_memory_total: u64 = 0
let g_status_fps_text = "0 FPS"
let g_status_memory_text = "RAM unavailable"

fn status_sample(now: f64) {
    if !g_status_started || now < g_status_time {
        g_status_started = true
        g_status_time = now
        g_status_frames = 0
        g_status_fps = 0
        g_status_memory = os_process_memory()
        g_status_memory_total = os_memory_total()
        status_compose()
        return
    }
    g_status_frames = g_status_frames + 1
    let elapsed = now - g_status_time
    if elapsed >= 1.0 {
        g_status_fps = (g_status_frames as f64 / elapsed + 0.5) as i32
        g_status_memory = os_process_memory()
        g_status_time = now
        g_status_frames = 0
        status_compose()
    }
}

fn status_compose() {
    g_status_fps_text = `{g_status_fps} FPS`
    g_status_memory_text = status_memory_text(g_status_memory, g_status_memory_total)
}

// A full meter represents 60 rendered frames per second; faster displays
// retain their actual rate in the adjacent numeric readout.
fn status_fps_fraction(fps: i32) f64 {
    return status_clamp(fps as f64 / 60.0)
}

fn status_memory_fraction(used: u64, total: u64) f64 {
    if total == 0 {
        return 0.0
    }
    return status_clamp(used as f64 / total as f64)
}

fn status_memory_text(used: u64, total: u64) str {
    if used == 0 {
        return "RAM unavailable"
    }
    let mib = ((used as f64 / 1048576.0) + 0.5) as i64
    if total == 0 {
        return `RAM {mib} MiB`
    }
    let tenths = (status_memory_fraction(used, total) * 1000.0 + 0.5) as i32
    return `RAM {mib} MiB ({tenths / 10}.{tenths % 10}%)`
}

fn status_clamp(v: f64) f64 {
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}
