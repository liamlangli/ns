    assert os_write_file_atomic(`{directory}/cs_cnn_dense_reduce.wgsl`, shader_transpile_stage(cs_cnn_dense_reduce, "wgsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_fold.metal`, shader_transpile_stage(cs_cnn_conv_gradient_fold, "msl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_fold.comp`, shader_transpile_stage(cs_cnn_conv_gradient_fold, "glsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_fold.hlsl`, shader_transpile_stage(cs_cnn_conv_gradient_fold, "hlsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_fold.wgsl`, shader_transpile_stage(cs_cnn_conv_gradient_fold, "wgsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_finish.metal`, shader_transpile_stage(cs_cnn_conv_gradient_finish, "msl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_finish.comp`, shader_transpile_stage(cs_cnn_conv_gradient_finish, "glsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_finish.hlsl`, shader_transpile_stage(cs_cnn_conv_gradient_finish, "hlsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient_finish.wgsl`, shader_transpile_stage(cs_cnn_conv_gradient_finish, "wgsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_prepare_batch.metal`, shader_transpile_stage(cs_cnn_prepare_batch, "msl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_prepare_batch.comp`, shader_transpile_stage(cs_cnn_prepare_batch, "glsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_prepare_batch.hlsl`, shader_transpile_stage(cs_cnn_prepare_batch, "hlsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_prepare_batch.wgsl`, shader_transpile_stage(cs_cnn_prepare_batch, "wgsl", "compute")) == 1
    print(`CNN: exported {CNN_PROGRAMS} kernels for MSL, GLSL, HLSL and WGSL to {directory}\n`)
}
