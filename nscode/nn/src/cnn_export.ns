    assert os_write_file_atomic(`{directory}/cs_cnn_conv_gradient.wgsl`, shader_transpile_stage(cs_cnn_conv_gradient, "wgsl", "compute")) == 1
    assert os_write_file_atomic(`{directory}/cs_cnn_adam.metal`, shader_transpile_stage(cs_cnn_adam, "msl", "compute")) == 1
