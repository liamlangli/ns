// nscode/dynamic/shapes.ns
// ---------------------------------------------------------------------------
// The convex shapes the sample simulates and draws. Each shape appears twice:
// as the point set Box3D turns into a convex hull and as the triangle list the
// renderer transforms. Both come from the same vertex table, so what is drawn
// is what is simulated.

use std
use simd
use dynamic

lit SHAPE_CUBE = 0
lit SHAPE_TETRA = 1
lit SHAPE_SPHERE = 2
lit SHAPE_PRISM = 3
lit SHAPE_KINDS = 4

// Triangles of one shape, in body space. `vertices` is 3 floats per corner and
// `normals` is 3 floats per triangle, for flat shading.
struct shape_mesh {
    vertices: [f32],
    normals: [f32],
    triangle_count: i32,
    // Point hull handed to the physics module: 3 floats per point.
    hull: [f32],
    hull_count: i32,
    // Sphere-swept radius of the hull; only the sphere uses it.
    margin: f32,
    extent: float3
}

fn shape_v3(x: f32, y: f32, z: f32) float3 {
    return float3 { x: x, y: y, z: z }
}

fn shape_cross(a: float3, b: float3) float3 {
    return shape_v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

fn shape_normalize(v: float3) float3 {
    let length = sqrt((v.x * v.x + v.y * v.y + v.z * v.z) as f64) as f32
    if length <= 0.000001 {
        return shape_v3(0.0, 1.0, 0.0)
    }
    return shape_v3(v.x / length, v.y / length, v.z / length)
}

// Append triangle (a, b, c) and its flat normal.
fn shape_push_triangle(mesh: ref shape_mesh, a: float3, b: float3, c: float3) {
    let base = mesh.triangle_count * 9
    mesh.vertices[base] = a.x
    mesh.vertices[base + 1] = a.y
    mesh.vertices[base + 2] = a.z
    mesh.vertices[base + 3] = b.x
    mesh.vertices[base + 4] = b.y
    mesh.vertices[base + 5] = b.z
    mesh.vertices[base + 6] = c.x
    mesh.vertices[base + 7] = c.y
    mesh.vertices[base + 8] = c.z
    let edge0 = shape_v3(b.x - a.x, b.y - a.y, b.z - a.z)
    let edge1 = shape_v3(c.x - a.x, c.y - a.y, c.z - a.z)
    let normal = shape_normalize(shape_cross(edge0, edge1))
    let normal_base = mesh.triangle_count * 3
    mesh.normals[normal_base] = normal.x
    mesh.normals[normal_base + 1] = normal.y
    mesh.normals[normal_base + 2] = normal.z
    mesh.triangle_count = mesh.triangle_count + 1
}

fn shape_empty(triangles: i32, hull_points: i32) shape_mesh {
    return shape_mesh {
        [f32](triangles * 9),
        [f32](triangles * 3),
        0,
        [f32](hull_points * 3),
        0,
        0.0,
        shape_v3(0.0, 0.0, 0.0),
    }
}

fn shape_set_hull(mesh: ref shape_mesh, index: i32, point: float3) {
    mesh.hull[index * 3] = point.x
    mesh.hull[index * 3 + 1] = point.y
    mesh.hull[index * 3 + 2] = point.z
    if index + 1 > mesh.hull_count {
        mesh.hull_count = index + 1
    }
}

fn shape_hull_point(mesh: shape_mesh, index: i32) float3 {
    return shape_v3(mesh.hull[index * 3], mesh.hull[index * 3 + 1], mesh.hull[index * 3 + 2])
}

// A box of `half` extents: eight hull corners, twelve triangles.
fn shape_box(half: float3) shape_mesh {
    let mesh = shape_empty(12, 8)
    mesh.extent = half
    for corner in 0 to 8 {
        let sx = 0.0 - 1.0
        let sy = 0.0 - 1.0
        let sz = 0.0 - 1.0
        if (corner & 1) != 0 {
            sx = 1.0
        }
        if (corner & 2) != 0 {
            sy = 1.0
        }
        if (corner & 4) != 0 {
            sz = 1.0
        }
        shape_set_hull(mesh, corner, shape_v3(sx * half.x, sy * half.y, sz * half.z))
    }
    // Faces wound counter-clockwise seen from outside: -z, +z, -y, +y, -x, +x.
    let quads = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
    for face in 0 to 6 {
        let a = shape_hull_point(mesh, quads[face * 4])
        let b = shape_hull_point(mesh, quads[face * 4 + 1])
        let c = shape_hull_point(mesh, quads[face * 4 + 2])
        let d = shape_hull_point(mesh, quads[face * 4 + 3])
        shape_push_triangle(mesh, a, b, c)
        shape_push_triangle(mesh, a, c, d)
    }
    return mesh
}

// A regular tetrahedron inscribed in the box of `radius`: four hull points.
fn shape_tetrahedron(radius: f32) shape_mesh {
    let mesh = shape_empty(4, 4)
    mesh.extent = shape_v3(radius, radius, radius)
    shape_set_hull(mesh, 0, shape_v3(radius, radius, radius))
    shape_set_hull(mesh, 1, shape_v3(radius, 0.0 - radius, 0.0 - radius))
    shape_set_hull(mesh, 2, shape_v3(0.0 - radius, radius, 0.0 - radius))
    shape_set_hull(mesh, 3, shape_v3(0.0 - radius, 0.0 - radius, radius))
    let p0 = shape_hull_point(mesh, 0)
    let p1 = shape_hull_point(mesh, 1)
    let p2 = shape_hull_point(mesh, 2)
    let p3 = shape_hull_point(mesh, 3)
    shape_push_triangle(mesh, p0, p1, p2)
    shape_push_triangle(mesh, p0, p2, p3)
    shape_push_triangle(mesh, p0, p3, p1)
    shape_push_triangle(mesh, p1, p3, p2)
    return mesh
}

// A hexagonal prism: Box3D constructs a convex hull from these twelve points.
fn shape_prism(radius: f32, half_height: f32) shape_mesh {
    let mesh = shape_empty(20, 12)
    mesh.extent = shape_v3(radius, half_height, radius)
    for i in 0 to 6 {
        let angle = (i as f32) * 1.0471976
        let x = cos(angle as f64) as f32 * radius
        let z = sin(angle as f64) as f32 * radius
        shape_set_hull(mesh, i, shape_v3(x, 0.0 - half_height, z))
        shape_set_hull(mesh, i + 6, shape_v3(x, half_height, z))
    }
    for i in 0 to 6 {
        let next = (i + 1) % 6
        let bottom0 = shape_hull_point(mesh, i)
        let bottom1 = shape_hull_point(mesh, next)
        let top0 = shape_hull_point(mesh, i + 6)
        let top1 = shape_hull_point(mesh, next + 6)
        shape_push_triangle(mesh, bottom0, top0, top1)
        shape_push_triangle(mesh, bottom0, top1, bottom1)
    }
    for i in 1 to 5 {
        let cap0 = shape_hull_point(mesh, 0)
        let cap1 = shape_hull_point(mesh, i)
        let cap2 = shape_hull_point(mesh, i + 1)
        shape_push_triangle(mesh, cap0, cap2, cap1)
        let top0 = shape_hull_point(mesh, 6)
        let top1 = shape_hull_point(mesh, i + 6)
        let top2 = shape_hull_point(mesh, i + 7)
        shape_push_triangle(mesh, top0, top1, top2)
    }
    return mesh
}

// Append a triangle wound so its normal points away from the body origin,
// which is what a convex shape centred on the origin needs for flat shading.
fn shape_push_outward(mesh: ref shape_mesh, a: float3, b: float3, c: float3) {
    let center = shape_v3((a.x + b.x + c.x) / 3.0, (a.y + b.y + c.y) / 3.0, (a.z + b.z + c.z) / 3.0)
    let edge0 = shape_v3(b.x - a.x, b.y - a.y, b.z - a.z)
    let edge1 = shape_v3(c.x - a.x, c.y - a.y, c.z - a.z)
    let normal = shape_cross(edge0, edge1)
    if normal.x * center.x + normal.y * center.y + normal.z * center.z < 0.0 {
        shape_push_triangle(mesh, a, c, b)
        return
    }
    shape_push_triangle(mesh, a, b, c)
}

fn shape_sphere_point(radius: f32, theta: f32, phi: f32) float3 {
    let sin_theta = sin(theta as f64) as f32
    return shape_v3(sin_theta * (cos(phi as f64) as f32) * radius, (cos(theta as f64) as f32) * radius, sin_theta * (sin(phi as f64) as f32) * radius)
}

// A sphere: one hull point plus `radius` maps to Box3D's sphere primitive. It
// is drawn as a latitude/longitude shell of 32 triangles.
fn shape_sphere(radius: f32) shape_mesh {
    let segments = 8
    let bands = 3
    let mesh = shape_empty(segments * bands * 2, 1)
    mesh.extent = shape_v3(radius, radius, radius)
    mesh.margin = radius
    shape_set_hull(mesh, 0, shape_v3(0.0, 0.0, 0.0))

    for band in 0 to bands {
        let theta0 = 3.1415927 * (band as f32) / (bands as f32)
        let theta1 = 3.1415927 * ((band + 1) as f32) / (bands as f32)
        for segment in 0 to segments {
            let phi0 = 6.2831853 * (segment as f32) / (segments as f32)
            let phi1 = 6.2831853 * ((segment + 1) as f32) / (segments as f32)
            let top0 = shape_sphere_point(radius, theta0, phi0)
            let top1 = shape_sphere_point(radius, theta0, phi1)
            let low0 = shape_sphere_point(radius, theta1, phi0)
            let low1 = shape_sphere_point(radius, theta1, phi1)
            if band == 0 {
                shape_push_outward(mesh, top0, low0, low1)
            } else if band == bands - 1 {
                shape_push_outward(mesh, top0, low0, top1)
            } else {
                shape_push_outward(mesh, top0, low0, low1)
                shape_push_outward(mesh, top0, low1, top1)
            }
        }
    }
    return mesh
}

// The body the physics module needs for `mesh`, with its hull already sized.
fn shape_body(mesh: shape_mesh, mass: f32) dynamic_body {
    if mesh.margin > 0.0 {
        return dynamic_body_sphere(mesh.margin, mass)
    }
    return dynamic_body_hull(mesh.extent, mass)
}
