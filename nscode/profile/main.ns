fn min_span_ms(view_span: f64) f64 {
    if view_span <= 0.0 {
        return 0.0
    }
    // Drop spans shorter than ~1 pixel of the current view. Dense dumps
    // otherwise try to fill hundreds of thousands of rects per frame.
    let cut = view_span * 0.001
    if cut < 0.0001 {
        return 0.0
    }
    return cut
}

// Duration-pixel LOD: farther zoom keeps only bars wide enough on screen.
fn lod_min_ms(view_span: f64, plot_w: f64) f64 {
    if view_span <= 0.0 {
        return 0.0
    }
    if plot_w <= 0.0 {
        return view_span
    }
    let full = time_full_span()
    let zoom: f64 = 1.0
    if view_span > 0.0 {
        zoom = full / view_span
    }
    let lod_px: f64 = 4.0
    if zoom >= 8.0 {
        lod_px = 2.0
    }
    if zoom >= 32.0 {
        lod_px = 1.0
    }
    let cut = lod_px * view_span / plot_w
    let floor_cut = min_span_ms(view_span)
    if cut < floor_cut {
        return floor_cut
    }
    return cut
}

// First index with start >= t. Events are sorted by start_ms.
fn event_lower_bound(t: f64) i32 {
    let lo = 0
    let hi = g_ev_count
    loop lo < hi {
        let mid = lo + (hi - lo) / 2
        if g_ev_start[mid] < t {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn long_span_min_ms() f64 { return 1.0 }

// Draw one event if it overlaps [t0,t1] and passes duration-pixel LOD.
// Only skip when the bar is completely outside the view; partial overlap is kept
// and the drawn rect is clamped into the plot.
// Returns false when the draw budget is exhausted.
fn timeline_try_draw_event(r: ref ui_renderer, v: ref view, ev: i32, x: f64, w: f64, plot_y: f64, plot_h: f64, row_h: f64, scale: f64) bool {
    g_tl_scanned = g_tl_scanned + 1
    let ev_end = g_ev_start[ev] + g_ev_duration[ev]
    // Completely outside the time window.
    if ev_end <= g_t0 {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    if g_ev_start[ev] >= g_t1 {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    if g_ev_duration[ev] < g_tl_min_ms {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    if g_tl_drawn >= g_tl_budget {
        g_tl_skipped = g_tl_skipped + 1
        return false
    }
    let lane = g_ev_lane[ev]
    let lane_y0: f64 = 0.0
    if lane >= 0 {
        if lane < g_lane_count {
            lane_y0 = g_lane_y0[lane] + lane_label_h()
        }
    }
    let by = plot_y + lane_y0 + g_ev_depth[ev] as f64 * row_h - g_scroll
    let bh = row_h - 1.0
    // Completely outside the vertical plot.
    if by + bh <= plot_y {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    if by >= plot_y + plot_h {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    let bx0 = x + (g_ev_start[ev] - g_t0) * scale
    let bx1 = x + (ev_end - g_t0) * scale
    // Completely outside the horizontal plot.
    if bx1 <= x {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    if bx0 >= x + w {
        g_tl_skipped = g_tl_skipped + 1
        return true
    }
    // Clamp the visible portion into the plot; keep original left for hit/label.
    let draw_x = max_f(bx0, x)
    let draw_r = min_f(bx1, x + w)
    let draw_w = max_f(1.0, draw_r - draw_x)
    let color = g_ev_color[ev]
    let selected = ev == g_selected_ev
    if hit(v, draw_x, by, draw_w, bh) {
        g_tl_hovered = ev
        ui_fill_rect(r, draw_x, by, draw_w, bh, col_warn(), 0.0)
        if v.mouse_released {
            if g_drag_moved == false {
                g_selected_ev = ev
                g_selected = -1
            }
        }
    } else {
        if selected {
            ui_fill_rect(r, draw_x, by, draw_w, bh, col_accent(), 0.0)
        } else {
            ui_fill_rect(r, draw_x, by, draw_w, bh, color, 0.0)
        }
    }
    // Skip label formatting for skinny bars - backtick strings allocate and the
    // native heap never frees, so per-bar labels across 158k events are fatal.
    if draw_w >= 28.0 {
        draw_bar_label(r, bx0, by, max_f(1.0, bx1 - bx0), bh, x, w, ev_name(ev))
    }
    g_tl_drawn = g_tl_drawn + 1
    return true
}

fn ensure_long_capacity(need: i32) {
    if need <= g_long_idx.len {
        return
    }
    let next = g_long_idx.len
    if next < 4096 {
        next = 4096
    }
    loop next < need {
        next = next * 2
    }
    let ni = [i32](next)
    let i = 0
    loop i < g_long_count {
        ni[i] = g_long_idx[i]
        i = i + 1
    }
    g_long_idx = ni
}

fn push_long_span(ev: i32) {
    ensure_long_capacity(g_long_count + 1)
    g_long_idx[g_long_count] = ev
    g_long_count = g_long_count + 1
}

fn ensure_event_capacity(need: i32) {
    if need <= g_ev_start.len {
        return
    }
    let next = g_ev_start.len
    if next < 4096 {
        next = 4096
    }
    loop next < need {
        next = next * 2
        // Guard against runaway growth on a corrupt blob header.
        if next >= 4194304 {
            next = 4194304
            break
        }
    }
    if need > next {
        return
    }
    let ns = [f64](next)
    let nd = [f64](next)
    let nself = [f64](next)
    let ndepth = [i32](next)
    let ncalls = [i32](next)
    let nlane = [i32](next)
    let nsym = [i32](next)
    let ncolor = [u32](next)
    let i = 0
    loop i < g_ev_count {
        ns[i] = g_ev_start[i]
        nd[i] = g_ev_duration[i]
        nself[i] = g_ev_self[i]
        ndepth[i] = g_ev_depth[i]
        ncalls[i] = g_ev_calls[i]
        nlane[i] = g_ev_lane[i]
        nsym[i] = g_ev_sym[i]
        ncolor[i] = g_ev_color[i]
        i = i + 1
    }
    g_ev_start = ns
    g_ev_duration = nd
    g_ev_self = nself
    g_ev_depth = ndepth
    g_ev_calls = ncalls
    g_ev_lane = nlane
    g_ev_sym = nsym
    g_ev_color = ncolor
}

fn ensure_str_pool_capacity(need: i32) {
    if need <= g_str_pool.len {
        return
    }
    let next = g_str_pool.len
    if next < 256 {
        next = 256
    }
    loop next < need {
        next = next * 2
        if next >= 65536 {
            next = 65536
            break
        }
    }
    if need > next {
        return
    }
    let nname = [str](next)
    let i = 0
    loop i < g_str_pool_count {
        nname[i] = g_str_pool[i]
        i = i + 1
    }
    g_str_pool = nname
}

fn str_pool_intern(name: str) i32 {
    let i = 0
    loop i < g_str_pool_count {
        if g_str_pool[i] == name {
            return i
        }
        i = i + 1
    }
    ensure_str_pool_capacity(g_str_pool_count + 1)
    let id = g_str_pool_count
    g_str_pool[id] = name
    g_str_pool_count = g_str_pool_count + 1
    return id
}

fn ev_name(ev: i32) str {
    let sid = g_ev_sym[ev]
    if sid < 0 {
        return "?"
    }
    if sid >= g_str_pool_count {
        return "?"
    }
    return g_str_pool[sid]
}

fn ensure_lane_capacity(need: i32) {
    if need <= g_lane_max_depth.len {
        return
    }
    let next = g_lane_max_depth.len
    if next < 64 {
        next = 64
    }
    loop next < need {
        next = next * 2
    }
    let nname = [str](next)
    let ndepth = [i32](next)
    let ny0 = [f64](next)
    let nh = [f64](next)
    let i = 0
    loop i < g_lane_count {
        nname[i] = g_lane_name[i]
        ndepth[i] = g_lane_max_depth[i]
        ny0[i] = g_lane_y0[i]
        nh[i] = g_lane_h[i]
        i = i + 1
    }
    g_lane_name = nname
    g_lane_max_depth = ndepth
    g_lane_y0 = ny0
    g_lane_h = nh
}

fn lane_find_or_add(name: str) i32 {
    let i = 0
    loop i < g_lane_count {
        if g_lane_name[i] == name {
            return i
        }
        i = i + 1
    }
    ensure_lane_capacity(g_lane_count + 1)
    let lane = g_lane_count
    g_lane_name[lane] = name
    g_lane_max_depth[lane] = 0
    g_lane_y0[lane] = 0.0
    g_lane_h[lane] = 0.0
    g_lane_count = g_lane_count + 1
    return lane
}

fn lane_label_h() f64 { return 18.0 }

fn rebuild_lane_layout(row_h: f64) {
    let label_h = lane_label_h()
    let gap = 8.0
    let y: f64 = 0.0
    let i = 0
    loop i < g_lane_count {
        let rows = g_lane_max_depth[i] + 1
        if rows < 1 {
            rows = 1
        }
        let h = label_h + rows as f64 * row_h
        g_lane_y0[i] = y
        g_lane_h[i] = h
        y = y + h + gap
        i = i + 1
    }
    g_lane_content_h = y
    if g_lane_content_h < row_h + label_h {
        g_lane_content_h = row_h + label_h
    }
}

fn col_bg() u32 { return ui_pack_color("#101418") }
fn col_panel() u32 { return ui_pack_color("#182026") }
fn col_panel_hi() u32 { return ui_pack_color("#22303a") }
fn col_line() u32 { return ui_pack_color("#34424d") }
fn col_text() u32 { return ui_pack_color("#d8e0e7") }
fn col_muted() u32 { return ui_pack_color("#8b98a5") }
fn col_accent() u32 { return ui_pack_color("#66d39a") }
fn col_warn() u32 { return ui_pack_color("#f0bd5f") }
fn clear_color() ui_color_rgba {
    return ui_color_rgba { r: 0.063, g: 0.078, b: 0.094, a: 1.0 }
}

fn min_f(a: f64, b: f64) f64 {
    if a < b {
        return a
    }
    return b
}

fn max_f(a: f64, b: f64) f64 {
    if a > b {
        return a
    }
    return b
}

fn hit(v: ref view, x: f64, y: f64, w: f64, h: f64) bool {
    if g_mouse_x < x {
        return false
    }
    if g_mouse_x >= (x + w) {
        return false
    }
    if g_mouse_y < y {
        return false
    }
    if g_mouse_y >= (y + h) {
        return false
    }
    return true
}

fn reset_view_input(v: ref view) {
    v.mouse_pressed = false
    v.mouse_released = false
    v.mouse_right_pressed = false
    v.mouse_right_released = false
    v.mouse_middle_pressed = false
    v.mouse_middle_released = false
    v.scroll_x = 0.0
    v.scroll_y = 0.0
}

fn starts_with(s: str, prefix: str) bool {
    if s.len < prefix.len {
        return false
    }
    return substr(s, 0, prefix.len) == prefix
}

fn trim_left(s: str) str {
    let i = 0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c != 32 {
            if c != 9 {
                return substr(s, i, s.len - i)
            }
        }
        i = i + 1
    }
    return ""
}

fn is_space_code(c: i32) bool {
    if c == 32 {
        return true
    }
    return c == 9
}

fn skip_spaces(s: str, i: i32) i32 {
    let p = i
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) == false {
            return p
        }
        p = p + 1
    }
    return p
}

fn word_at(s: str, i: i32) str {
    let start = skip_spaces(s, i)
    let p = start
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) {
            return substr(s, start, p - start)
        }
        p = p + 1
    }
    return substr(s, start, p - start)
}

fn parse_f64(s: str) f64 {
    let i = skip_spaces(s, 0)
    let sign = 1.0
    if i < s.len {
        if ((s[i] as i32) & 255) == 45 {
            sign = -1.0
            i = i + 1
        }
    }

    let value = 0.0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c < 48 {
            break
        }
        if c > 57 {
            break
        }
        value = value * 10.0 + ((c - 48) as f64)
        i = i + 1
    }

    if i < s.len {
        if ((s[i] as i32) & 255) == 46 {
            i = i + 1
            let scale = 0.1
            loop i < s.len {
                let c = (s[i] as i32) & 255
                if c < 48 {
                    break
                }
                if c > 57 {
                    break
                }
                value = value + ((c - 48) as f64) * scale
                scale = scale * 0.1
                i = i + 1
            }
        }
    }

    return value * sign
}

fn parse_i32(s: str) i32 {
    return parse_f64(s) as i32
}

fn is_digit_word(s: str) bool {
    if s.len == 0 {
        return false
    }
    let i = 0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        let ok = false
        if c >= 48 {
            if c <= 57 {
                ok = true
            }
        }
        if c == 46 {
            ok = true
        }
        if ok == false {
            return false
        }
        i = i + 1
    }
    return true
}

fn palette_color(h: i32) u32 {
    let x = h
    if x < 0 {
        x = 0 - x
    }
    let palette = x % 5
    if palette == 0 {
        return ui_pack_color("#5fb3f0")
    }
    if palette == 1 {
        return ui_pack_color("#66d39a")
    }
    if palette == 2 {
        return ui_pack_color("#d7a8ff")
    }
    if palette == 3 {
        return ui_pack_color("#f08a7a")
    }
    return ui_pack_color("#f0bd5f")
}

fn name_color(name: str) u32 {
    let h = 2166136261
    let i = 0
    loop i < name.len {
        h = h ^ ((name[i] as i32) & 255)
        h = h * 16777619
        i = i + 1
    }
    return palette_color(h)
}

fn sym_color(sym: i32) u32 {
    if sym >= 0 {
        if sym < g_str_pool_count {
            return g_sym_color[sym]
        }
    }
    return palette_color(sym)
}

fn format_known(s: str) bool {
    if s == "ns-profile-v1" {
        return true
    }
    if s == "ns-profile-v2" {
        return true
    }
    if s == "ns-profile-v3" {
        return true
    }
    if s == "ns-profile-v4" {
        return true
    }
    if s == "ns-profile-v5" {
        return true
    }
    return s == "ns-profile-v6"
}

fn format_has_self(s: str) bool {
    if s == "ns-profile-v4" {
        return true
    }
    if s == "ns-profile-v5" {
        return true
    }
    return s == "ns-profile-v6"
}

fn format_has_thread(s: str) bool {
    if s == "ns-profile-v5" {
        return true
    }
    return s == "ns-profile-v6"
}

fn format_has_blob(s: str) bool {
    return s == "ns-profile-v6"
}

fn find_child(parent: i32, name: str) i32 {
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == parent {
            if g_node_name[i] == name {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn add_node(parent: i32, name: str) i32 {
    if g_node_count >= g_node_parent.len {
        return -1
    }
    let i = g_node_count
    g_node_name[i] = name
    g_node_parent[i] = parent
    g_node_calls[i] = 0
    g_node_total[i] = 0.0
    g_node_self[i] = 0.0
    g_node_x[i] = 0.0
    g_node_w[i] = 0.0
    g_node_depth[i] = 0
    g_node_count = g_node_count + 1
    return i
}

fn stack_frame(stack: str, start: i32) str {
    let p = start
    loop p < stack.len {
        if ((stack[p] as i32) & 255) == 59 {
            return substr(stack, start, p - start)
        }
        p = p + 1
    }
    return substr(stack, start, p - start)
}

fn record_flame_line(line: str) {
    let p = skip_spaces(line, 6)
    let calls_s = word_at(line, p)
    if is_digit_word(calls_s) == false {
        return
    }
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let stack = trim_left(substr(line, p, line.len - p))
    if stack.len == 0 {
        return
    }

    let parent = -1
    let i = 0
    loop i < stack.len {
        let frame = stack_frame(stack, i)
        if frame.len == 0 {
            break
        }
        let node = find_child(parent, frame)
        if node < 0 {
            node = add_node(parent, frame)
        }
        if node < 0 {
            return
        }
        parent = node
        i = i + frame.len
        if i < stack.len {
            if ((stack[i] as i32) & 255) == 59 {
                i = i + 1
            }
        }
    }

    if parent >= 0 {
        g_node_calls[parent] = parse_i32(calls_s)
        g_node_total[parent] = parse_f64(total_s)
        g_node_self[parent] = parse_f64(self_s)
    }
}

fn push_event(start: f64, dur: f64, self_ms: f64, depth: i32, name: str, thread: str) {
    g_ev_raw = g_ev_raw + 1
    let lane = lane_find_or_add(thread)
    let sym = str_pool_intern(name)
    if g_ev_count > 0 {
        let last = g_ev_count - 1
        if g_ev_lane[last] == lane {
            if g_ev_depth[last] == depth {
                if g_ev_sym[last] == sym {
                    let end = g_ev_start[last] + g_ev_duration[last]
                    if start <= end + 0.05 {
                        let new_end = start + dur
                        if new_end > end {
                            g_ev_duration[last] = new_end - g_ev_start[last]
                            if g_ev_duration[last] > g_ev_max_dur {
                                g_ev_max_dur = g_ev_duration[last]
                            }
                            if g_ev_duration[last] >= long_span_min_ms() {
                                // Coalesced growth may newly qualify as a long span.
                                let already = false
                                if g_long_count > 0 {
                                    if g_long_idx[g_long_count - 1] == last {
                                        already = true
                                    }
                                }
                                if already == false {
                                    push_long_span(last)
                                }
                            }
                        }
                        g_ev_self[last] = g_ev_self[last] + self_ms
                        g_ev_calls[last] = g_ev_calls[last] + 1
                        if new_end > g_time_end {
                            g_time_end = new_end
                        }
                        return
                    }
                }
            }
        }
    }
    ensure_event_capacity(g_ev_count + 1)
    let i = g_ev_count
    g_ev_start[i] = start
    g_ev_duration[i] = dur
    g_ev_self[i] = self_ms
    g_ev_depth[i] = depth
    g_ev_calls[i] = 1
    g_ev_lane[i] = lane
    g_ev_sym[i] = sym
    g_ev_color[i] = name_color(name)
    g_ev_count = g_ev_count + 1
    if dur > g_ev_max_dur {
        g_ev_max_dur = dur
    }
    if dur >= long_span_min_ms() {
        push_long_span(i)
    }
    if depth > g_lane_max_depth[lane] {
        g_lane_max_depth[lane] = depth
    }
    if g_ev_count == 1 {
        g_time_origin = start
        g_ev_max_depth = depth
    } else {
        if start < g_time_origin {
            g_time_origin = start
        }
        if depth > g_ev_max_depth {
            g_ev_max_depth = depth
        }
    }
    let end = start + dur
    if end > g_time_end {
        g_time_end = end
    }
}

fn reset_time_view() {
    g_t0 = g_time_origin
    g_t1 = g_time_end
    if g_t1 <= g_t0 {
        g_t1 = g_t0 + 1.0
    }
    cam_snap_time()
}

fn fit_time_view() {
    // Overview and default view cover the whole run; timeline keeps every sample.
    let sample_t0 = g_time_origin
    let sample_t1 = g_time_end
    let elapsed = parse_f64(g_elapsed)
    g_time_origin = 0.0
    g_time_end = elapsed
    if sample_t1 > g_time_end {
        g_time_end = sample_t1
    }
    if g_time_end <= 0.0 {
        g_time_end = 1.0
    }
    if sample_t1 > sample_t0 {
        let pad = (sample_t1 - sample_t0) * 0.02
        if pad < 0.05 {
            pad = 0.05
        }
        g_t0 = sample_t0 - pad
        g_t1 = sample_t1 + pad
        if g_t0 < g_time_origin {
            g_t0 = g_time_origin
        }
        if g_t1 > g_time_end {
            g_t1 = g_time_end
        }
    } else {
        reset_time_view()
    }
    clamp_view()
    cam_snap_time()
    g_cam_scroll = g_scroll
    g_vel_t = 0.0
    g_vel_scroll = 0.0
    g_cam_coasting = false
}

fn record_fn_line(line: str) {
    if starts_with(line, "fn_table:") {
        return
    }
    if g_hot_count >= g_hot_self.len {
        return
    }
    let p = skip_spaces(line, 3)
    let kind = word_at(line, p)
    p = skip_spaces(line, p + kind.len)
    let calls_s = word_at(line, p)
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let avg_s = word_at(line, p)
    p = skip_spaces(line, p + avg_s.len)
    let min_s = word_at(line, p)
    p = skip_spaces(line, p + min_s.len)
    let max_s = word_at(line, p)
    p = skip_spaces(line, p + max_s.len)
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    let i = g_hot_count
    g_hot_name[i] = name
    g_hot_kind[i] = kind
    g_hot_self[i] = parse_f64(self_s)
    g_hot_total[i] = parse_f64(total_s)
    g_hot_calls[i] = parse_i32(calls_s)
    g_hot_count = g_hot_count + 1
}

fn record_scope_event(line: str, has_self: bool, has_thread: bool) {
    let p = skip_spaces(line, 12)
    let thread = "main"
    if has_thread {
        thread = word_at(line, p)
        p = skip_spaces(line, p + thread.len)
    }
    let depth_s = word_at(line, p)
    p = skip_spaces(line, p + depth_s.len)
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_self {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    push_event(parse_f64(start_s), parse_f64(dur_s), parse_f64(self_s), parse_i32(depth_s), name, thread)
}

fn record_ffi_event(line: str, has_depth: bool, has_thread: bool) {
    let p = skip_spaces(line, 10)
    let thread = "main"
    if has_thread {
        thread = word_at(line, p)
        p = skip_spaces(line, p + thread.len)
    }
    let depth = 0
    if has_depth {
        let depth_s = word_at(line, p)
        depth = parse_i32(depth_s)
        p = skip_spaces(line, p + depth_s.len)
    }
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_depth {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    push_event(parse_f64(start_s), parse_f64(dur_s), parse_f64(self_s), depth, name, thread)
}

fn parse_profile_body(src: str, want_events: bool) {
    if want_events == false {
        g_node_count = 0
        g_hot_count = 0
        g_max_depth = 0
        g_root_total = 0.0
        g_selected = -1
        g_selected_ev = -1
        g_hovered = -1
    }
    g_ev_count = 0
    g_ev_raw = 0
    g_ev_max_depth = 0
    g_ev_max_dur = 0.0
    g_long_count = 0
    g_lane_count = 0
    g_lane_content_h = 0.0
    g_time_origin = 0.0
    g_time_end = 0.0
    g_t0 = 0.0
    g_t1 = 1.0
    g_drag_mode = 0
    g_drag_moved = false
    let has_self = format_has_self(g_format)
    let has_thread = format_has_thread(g_format)

    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        if want_events {
            if starts_with(line, "scope_event:") {
                record_scope_event(line, has_self, has_thread)
            } else {
                if starts_with(line, "ffi_event:") {
                    record_ffi_event(line, has_self, has_thread)
                }
            }
        } else {
            let ev_line = false
            if starts_with(line, "timeline:") {
                ev_line = true
            }
            if starts_with(line, "scope_event:") {
                ev_line = true
            }
            if starts_with(line, "ffi_event:") {
                ev_line = true
            }
            if ev_line {
                if g_node_count > 0 {
                    break
                }
            } else {
                if starts_with(line, "flame:") {
                    if starts_with(line, "flame_frames:") == false {
                        record_flame_line(line)
                    }
                } else {
                    if starts_with(line, "fn:") {
                        record_fn_line(line)
                    }
                }
            }
        }
        if i < src.len {
            i = i + 1
        }
    }
}

fn layout_node(node: i32, x: f64, w: f64, depth: i32) {
    g_node_x[node] = x
    g_node_w[node] = w
    g_node_depth[node] = depth
    if depth > g_max_depth {
        g_max_depth = depth
    }
    let cx = x
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == node {
            let cw: f64 = 0.0
            if g_root_total > 0.0 {
                cw = g_node_total[i] / g_root_total
            }
            layout_node(i, cx, cw, depth + 1)
            cx = cx + cw
        }
        i = i + 1
    }
}

fn layout_flame() {
    g_max_depth = 0
    g_root_total = parse_f64(g_elapsed)
    if g_root_total <= 0.0 {
        g_root_total = 0.0
        let i = 0
        loop i < g_node_count {
            if g_node_parent[i] < 0 {
                g_root_total = g_root_total + g_node_total[i]
            }
            i = i + 1
        }
    }
    if g_root_total <= 0.0 {
        g_root_total = 1.0
    }
    let x: f64 = 0.0
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] < 0 {
            let w: f64 = g_node_total[i] / g_root_total
            layout_node(i, x, w, 0)
            x = x + w
        }
        i = i + 1
    }
}

fn header_value(line: str, key: str) str {
    let prefix = key + ":"
    if starts_with(line, prefix) == false {
        return ""
    }
    return trim_left(substr(line, prefix.len, line.len - prefix.len))
}

fn parse_header(src: str) {
    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        if starts_with(line, "fn_table:") {
            return
        }
        if starts_with(line, "ffi_table:") {
            return
        }
        if starts_with(line, "timeline:") {
            return
        }
        if starts_with(line, "flame:") {
            if starts_with(line, "flame_frames:") == false {
                return
            }
        }
        if starts_with(line, "scope_event:") {
            return
        }
        if starts_with(line, "ffi_event:") {
            return
        }
        let v = header_value(line, "format")
        if v.len > 0 {
            g_format = v
        }
        v = header_value(line, "elapsed_ms")
        if v.len > 0 {
            g_elapsed = v
        }
        v = header_value(line, "argv")
        if v.len > 0 {
            g_argv = v
        }
        v = header_value(line, "ffi_calls")
        if v.len > 0 {
            g_ffi_calls = v
        }
        v = header_value(line, "ffi_ms")
        if v.len > 0 {
            g_ffi_ms = v
        }
        v = header_value(line, "ffi_pct")
        if v.len > 0 {
            g_ffi_pct = v
        }
        v = header_value(line, "scope_calls")
        if v.len > 0 {
            g_scope_calls = v
        }
        v = header_value(line, "scope_self_ms")
        if v.len > 0 {
            g_scope_self = v
        }
        v = header_value(line, "timeline_events")
        if v.len > 0 {
            g_timeline_events = v
        }
        v = header_value(line, "timeline_skipped")
        if v.len > 0 {
            g_timeline_skipped = v
        }
        v = header_value(line, "flame_frames")
        if v.len > 0 {
            g_flame_frames = v
        }
        v = header_value(line, "threads")
        if v.len > 0 {
            g_threads_header = v
        }
        v = header_value(line, "timeline_blob")
        if v.len > 0 {
            g_timeline_blob = v
        }
        v = header_value(line, "timeline_blob_codec")
        if v.len > 0 {
            g_timeline_blob_codec = v
        }
        if i < src.len {
            i = i + 1
        }
    }
}

fn read_file(path: str) str {
    let fd = open(path, "rb")
    if fd == 0 {
        return ""
    }
    let data = read(fd)
    close(fd)
    return data
}

fn profile_dirname(path: str) str {
    let i = path.len - 1
    loop i >= 0 {
        let c = (path[i] as i32) & 255
        if c == 47 {
            return substr(path, 0, i)
        }
        if c == 92 {
            return substr(path, 0, i)
        }
        i = i - 1
    }
    return ""
}

fn blob_path_for(profile_path: str) str {
    if g_timeline_blob.len == 0 {
        return ""
    }
    let dir = profile_dirname(profile_path)
    if dir.len == 0 {
        return g_timeline_blob
    }
    return `{dir}/{g_timeline_blob}`
}

fn read_u16_le(buf: [u8], off: i32) i32 {
    let lo = (buf[off] as i32) & 255
    let hi = (buf[off + 1] as i32) & 255
    return lo + hi * 256
}

fn read_u32_le(buf: [u8], off: i32) i32 {
    let b0 = (buf[off] as i32) & 255
    let b1 = (buf[off + 1] as i32) & 255
    let b2 = (buf[off + 2] as i32) & 255
    let b3 = (buf[off + 3] as i32) & 255
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn read_i32_le(buf: [u8], off: i32) i32 {
    return read_u32_le(buf, off)
}

fn us_to_ms(us: i32) f64 {
    return us as f64 * 0.001
}

fn bytes_to_str(buf: [u8], off: i32, len: i32) str {
    if len <= 0 {
        return ""
    }
    // Cap to keep a corrupt length from O(n^2)-strcating into gigabytes.
    // Native heap never frees, so quadratic strcat is fatal.
    if len > 512 {
        len = 512
    }
    if off < 0 {
        return ""
    }
    if off + len > buf.len {
        return ""
    }
    // Build in 16-byte chunks so strcat count is O(len/16), not O(len).
    let alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    let out = ""
    let chunk = ""
    let i = 0
    loop i < len {
        let c = (buf[off + i] as i32) & 255
        if c >= 32 {
            if c <= 126 {
                chunk = chunk + substr(alphabet, c - 32, 1)
            }
        }
        i = i + 1
        if chunk.len >= 16 {
            out = out + chunk
            chunk = ""
        }
    }
    if chunk.len > 0 {
        out = out + chunk
    }
    return out
}

fn clear_blob_load() {
    g_loading = false
    g_load_stage = 0
    g_load_frac = 0.0
    g_load_msg = ""
    g_blob_path = ""
    g_blob_raw_len = 0
    g_blob_data_len = 0
    g_blob_pos = 0
    g_blob_event_total = 0
    g_blob_event_done = 0
    g_blob_sym_count = 0
    g_blob_thread_count = 0
    g_blob_events_off = 0
    g_ov_rebuild_pending = false
    g_text_events_pending = false
}

fn clear_profile() {
    g_raw = ""
    g_format = ""
    g_elapsed = ""
    g_argv = ""
    g_ffi_calls = ""
    g_ffi_ms = ""
    g_ffi_pct = ""
    g_scope_calls = ""
    g_scope_self = ""
    g_timeline_events = ""
    g_timeline_skipped = ""
    g_flame_frames = ""
    g_timeline_blob = ""
    g_timeline_blob_codec = ""
    g_threads_header = ""
    g_node_count = 0
    g_hot_count = 0
    g_ev_count = 0
    g_ev_raw = 0
    g_ev_max_dur = 0.0
    g_long_count = 0
    g_lane_count = 0
    g_lane_content_h = 0.0
    g_str_pool_count = 0
    g_time_origin = 0.0
    g_time_end = 0.0
    g_t0 = 0.0
    g_t1 = 1.0
    g_selected = -1
    g_selected_ev = -1
    g_drag_mode = 0
    g_drag_moved = false
    g_fx0 = 0.0
    g_fx1 = 1.0
    g_scroll = 0.0
    g_profile_loaded = false
    g_events_loaded = false
    clear_blob_load()
    cam_snap_time()
    cam_snap_flame()
    cam_snap_scroll()
    cam_stop()
    invalidate_overview_batch()
}

fn time_min_span() f64 { return 0.025 }
fn flame_min_span() f64 { return 0.01 }

fn time_full_span() f64 {
    let full = g_time_end - g_time_origin
    let min_span = time_min_span()
    if full < min_span {
        return min_span
    }
    return full
}

fn time_view_span() f64 {
    let span = g_t1 - g_t0
    let min_span = time_min_span()
    if span < min_span {
        return min_span
    }
    return span
}

fn flame_view_span() f64 {
    let span = g_fx1 - g_fx0
    let min_span = flame_min_span()
    if span < min_span {
        return min_span
    }
    return span
}

fn clamp_flame_view() {
    let span = g_fx1 - g_fx0
    let min_span = flame_min_span()
    if span < min_span {
        let mid = (g_fx0 + g_fx1) * 0.5
        let half = min_span * 0.5
        g_fx0 = mid - half
        g_fx1 = mid + half
        span = min_span
    }
    if span > 1.0 {
        g_fx0 = 0.0
        g_fx1 = 1.0
        return
    }
    if g_fx0 < 0.0 {
        g_fx0 = 0.0
        g_fx1 = span
    }
    if g_fx1 > 1.0 {
        g_fx1 = 1.0
        g_fx0 = 1.0 - span
        if g_fx0 < 0.0 {
            g_fx0 = 0.0
        }
    }
}

fn fit_flame_view() {
    g_fx0 = 0.0
    g_fx1 = 1.0
    g_scroll = 0.0
    clamp_flame_view()
    cam_snap_flame()
    g_cam_scroll = g_scroll
    g_vel_fx = 0.0
    g_vel_scroll = 0.0
    g_cam_coasting = false
}

fn cam_follow_alpha() f64 { return 0.78 }
fn cam_scroll_follow_alpha() f64 { return 1.0 }
fn cam_vel_damp() f64 { return 0.88 }
fn cam_vel_stop() f64 { return 0.00008 }
fn scroll_drag_gain() f64 { return 3.0 }
fn wheel_zoom_out() f64 { return 1.35 }
fn wheel_zoom_in() f64 { return 0.72 }

fn cam_snap_time() {
    g_cam_t0 = g_t0
    g_cam_t1 = g_t1
}

fn cam_snap_flame() {
    g_cam_fx0 = g_fx0
    g_cam_fx1 = g_fx1
}

fn cam_snap_scroll() {
    g_cam_scroll = g_scroll
}

fn cam_stop() {
    g_vel_t = 0.0
    g_vel_fx = 0.0
    g_vel_scroll = 0.0
    g_cam_coasting = false
}

fn clamp_cam_time() {
    let span = g_cam_t1 - g_cam_t0
    let min_span = time_min_span()
    if span < min_span {
        g_cam_t1 = g_cam_t0 + min_span
        span = min_span
    }
    let full = time_full_span()
    if span > full {
        g_cam_t0 = g_time_origin
        g_cam_t1 = g_time_end
        return
    }
    if g_cam_t0 < g_time_origin {
        g_cam_t0 = g_time_origin
        g_cam_t1 = g_cam_t0 + span
    }
    if g_cam_t1 > g_time_end {
        g_cam_t1 = g_time_end
        g_cam_t0 = g_cam_t1 - span
        if g_cam_t0 < g_time_origin {
            g_cam_t0 = g_time_origin
        }
    }
}

fn clamp_cam_flame() {
    let span = g_cam_fx1 - g_cam_fx0
    let min_span = flame_min_span()
    if span < min_span {
        let mid = (g_cam_fx0 + g_cam_fx1) * 0.5
        let half = min_span * 0.5
        g_cam_fx0 = mid - half
        g_cam_fx1 = mid + half
        span = min_span
    }
    if span > 1.0 {
        g_cam_fx0 = 0.0
        g_cam_fx1 = 1.0
        return
    }
    if g_cam_fx0 < 0.0 {
        g_cam_fx0 = 0.0
        g_cam_fx1 = span
    }
    if g_cam_fx1 > 1.0 {
        g_cam_fx1 = 1.0
        g_cam_fx0 = 1.0 - span
        if g_cam_fx0 < 0.0 {
            g_cam_fx0 = 0.0
        }
    }
}

fn clamp_cam_scroll() {
    if g_cam_scroll < 0.0 {
        g_cam_scroll = 0.0
    }
    if g_cam_scroll > g_cam_scroll_max {
        g_cam_scroll = g_cam_scroll_max
    }
}

fn cam_set_time(t0: f64, t1: f64) {
    g_cam_t0 = t0
    g_cam_t1 = t1
    clamp_cam_time()
}

fn cam_set_flame(fx0: f64, fx1: f64) {
    g_cam_fx0 = fx0
    g_cam_fx1 = fx1
    clamp_cam_flame()
}

fn cam_set_scroll(scroll: f64) {
    g_cam_scroll = scroll
    clamp_cam_scroll()
}

fn cam_sample_vel_time(prev_t0: f64, dt: f64) {
    if dt <= 0.0 {
        return
    }
    let v = (g_cam_t0 - prev_t0) / dt
    g_vel_t = g_vel_t * 0.55 + v * 0.45
}

fn cam_sample_vel_flame(prev_fx0: f64, dt: f64) {
    if dt <= 0.0 {
        return
    }
    let v = (g_cam_fx0 - prev_fx0) / dt
    g_vel_fx = g_vel_fx * 0.55 + v * 0.45
}

fn cam_sample_vel_scroll(prev_scroll: f64, dt: f64) {
    if dt <= 0.0 {
        return
    }
    let v = (g_cam_scroll - prev_scroll) / dt
    g_vel_scroll = g_vel_scroll * 0.55 + v * 0.45
}

fn cam_frame_dt() f64 {
    let now = os_time_ms()
    let dt: f64 = 0.016
    if g_cam_last_ms > 0 {
        let delta = (now - g_cam_last_ms) as f64 * 0.001
        if delta > 0.001 {
            if delta < 0.05 {
                dt = delta
            } else {
                dt = 0.05
            }
        }
    }
    g_cam_last_ms = now
    return dt
}

fn cam_abs(v: f64) f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn cam_settled() bool {
    if cam_abs(g_t0 - g_cam_t0) > 0.00005 {
        return false
    }
    if cam_abs(g_t1 - g_cam_t1) > 0.00005 {
        return false
    }
    if cam_abs(g_fx0 - g_cam_fx0) > 0.00005 {
        return false
    }
    if cam_abs(g_fx1 - g_cam_fx1) > 0.00005 {
        return false
    }
    if cam_abs(g_scroll - g_cam_scroll) > 0.05 {
        return false
    }
    if g_cam_coasting {
        if cam_abs(g_vel_t) > cam_vel_stop() {
            return false
        }
        if cam_abs(g_vel_fx) > cam_vel_stop() {
            return false
        }
        if cam_abs(g_vel_scroll) > 0.2 {
            return false
        }
    }
    return true
}

fn tick_camera(r: ref ui_renderer) {
    let dt = cam_frame_dt()
    let a = cam_follow_alpha()
    if g_cam_coasting {
        if g_drag_mode == 0 {
            let damp = cam_vel_damp()
            if cam_abs(g_vel_t) > cam_vel_stop() {
                let span = g_cam_t1 - g_cam_t0
                g_cam_t0 = g_cam_t0 + g_vel_t * dt
                g_cam_t1 = g_cam_t0 + span
                clamp_cam_time()
                g_vel_t = g_vel_t * damp
            } else {
                g_vel_t = 0.0
            }
            if cam_abs(g_vel_fx) > cam_vel_stop() {
                let span = g_cam_fx1 - g_cam_fx0
                g_cam_fx0 = g_cam_fx0 + g_vel_fx * dt
                g_cam_fx1 = g_cam_fx0 + span
                clamp_cam_flame()
                g_vel_fx = g_vel_fx * damp
            } else {
                g_vel_fx = 0.0
            }
            if cam_abs(g_vel_scroll) > 0.2 {
                g_cam_scroll = g_cam_scroll + g_vel_scroll * dt
                clamp_cam_scroll()
                g_vel_scroll = g_vel_scroll * damp
            } else {
                g_vel_scroll = 0.0
            }
            if cam_abs(g_vel_t) <= cam_vel_stop() {
                if cam_abs(g_vel_fx) <= cam_vel_stop() {
                    if cam_abs(g_vel_scroll) <= 0.2 {
                        g_cam_coasting = false
                    }
                }
            }
        }
    }

    g_t0 = g_t0 + (g_cam_t0 - g_t0) * a
    g_t1 = g_t1 + (g_cam_t1 - g_t1) * a
    g_fx0 = g_fx0 + (g_cam_fx0 - g_fx0) * a
    g_fx1 = g_fx1 + (g_cam_fx1 - g_fx1) * a
    // Vertical lane scroll snaps 1:1 so deep stacks don't feel laggy.
    let sa = cam_scroll_follow_alpha()
    g_scroll = g_scroll + (g_cam_scroll - g_scroll) * sa
    clamp_view()
    clamp_flame_view()
    if g_scroll < 0.0 {
        g_scroll = 0.0
    }
    if g_scroll > g_cam_scroll_max {
        g_scroll = g_cam_scroll_max
    }

    if cam_settled() == false {
        ui_request_render(r, 2)
    } else {
        // Snap leftovers so we stop requesting frames.
        g_t0 = g_cam_t0
        g_t1 = g_cam_t1
        g_fx0 = g_cam_fx0
        g_fx1 = g_cam_fx1
        g_scroll = g_cam_scroll
    }
}

fn begin_drag(mode: i32) {
    g_drag_mode = mode
    g_drag_moved = false
    g_drag_x = g_mouse_x
    g_drag_y = g_mouse_y
    g_drag_t0 = g_cam_t0
    g_drag_t1 = g_cam_t1
    g_drag_scroll = g_cam_scroll
    g_drag_fx0 = g_cam_fx0
    g_drag_fx1 = g_cam_fx1
    g_cam_coasting = false
    g_vel_t = 0.0
    g_vel_fx = 0.0
    g_vel_scroll = 0.0
}

fn end_drag() {
    if g_drag_mode != 0 {
        if g_drag_moved {
            g_cam_coasting = true
        }
    }
    g_drag_mode = 0
}

fn mark_drag_moved(dx: f64, dy: f64) {
    let adx = dx
    if adx < 0.0 {
        adx = 0.0 - adx
    }
    let ady = dy
    if ady < 0.0 {
        ady = 0.0 - ady
    }
    if adx > 2.0 {
        g_drag_moved = true
    }
    if ady > 2.0 {
        g_drag_moved = true
    }
}

// Reports are written to <cwd>/bin/ns.profile; the plain name stays as a
// fallback for profiles left by older ns versions. Prefer an absolute path so
// a launched .app still finds the caller's report after its cwd changes.
fn default_profile_path() str {
    let cwd = os_cwd()
    let binned = `{cwd}/bin/ns.profile`
    if os_file_size(binned) >= 0 {
        return binned
    }
    let legacy = `{cwd}/ns.profile`
    if os_file_size(legacy) >= 0 {
        return legacy
    }
    if os_file_size("bin/ns.profile") >= 0 {
        return "bin/ns.profile"
    }
    return "ns.profile"
}

fn ensure_blob_thread_capacity(need: i32) {
    if need <= g_blob_thread_name.len {
        return
    }
    let next = g_blob_thread_name.len
    if next < 64 {
        next = 64
    }
    loop next < need {
        next = next * 2
    }
    let nname = [str](next)
    let i = 0
    loop i < g_blob_thread_count {
        nname[i] = g_blob_thread_name[i]
        i = i + 1
    }
    g_blob_thread_name = nname
}

fn ensure_sym_color_capacity(need: i32) {
    if need <= g_sym_color.len {
        return
    }
    let next = g_sym_color.len
    if next < 256 {
        next = 256
    }
    loop next < need {
        next = next * 2
        if next >= 65536 {
            next = 65536
            break
        }
    }
    if need > next {
        return
    }
    let nc = [u32](next)
    let i = 0
    loop i < g_str_pool_count {
        nc[i] = g_sym_color[i]
        i = i + 1
    }
    g_sym_color = nc
}

fn push_blob_event_fast(start: f64, dur: f64, self_ms: f64, depth: i32, sym: i32, lane: i32) {
    // Blob events are already coalesced by the writer; skip viewer-side merge.
    // `sym` is already a string-pool index (blob symbol table maps 1:1).
    if g_ev_count >= g_ev_start.len {
        ensure_event_capacity(g_ev_count + 1)
        if g_ev_count >= g_ev_start.len {
            return
        }
    }
    let i = g_ev_count
    g_ev_start[i] = start
    g_ev_duration[i] = dur
    g_ev_self[i] = self_ms
    g_ev_depth[i] = depth
    g_ev_calls[i] = 1
    g_ev_lane[i] = lane
    g_ev_sym[i] = sym
    g_ev_color[i] = sym_color(sym)
    g_ev_count = g_ev_count + 1
    g_ev_raw = g_ev_raw + 1
    if dur > g_ev_max_dur {
        g_ev_max_dur = dur
    }
    if dur >= long_span_min_ms() {
        push_long_span(i)
    }
    if lane >= 0 {
        if lane < g_lane_count {
            if depth > g_lane_max_depth[lane] {
                g_lane_max_depth[lane] = depth
            }
        }
    }
    if g_ev_count == 1 {
        g_time_origin = start
        g_ev_max_depth = depth
    } else {
        if start < g_time_origin {
            g_time_origin = start
        }
        if depth > g_ev_max_depth {
            g_ev_max_depth = depth
        }
    }
    let end = start + dur
    if end > g_time_end {
        g_time_end = end
    }
}

fn finish_blob_load() {
    g_loading = false
    g_load_stage = LOAD_STAGE_DONE()
    g_load_frac = 1.0
    g_events_loaded = true
    g_blob_raw_len = 0
    g_blob_data_len = 0
    g_blob_raw = [u8](16)
    g_blob_data = [u8](16)
    // Flame tables already live in g_node_*; drop the text report now that
    // timeline samples are in SoA arrays. Native heap never frees, but this
    // keeps later format strings from retaining a giant live root.
    if format_has_blob(g_format) {
        g_raw = ""
    }
    rebuild_lane_layout(18.0)
    fit_time_view()
    invalidate_overview_batch()
    g_ov_rebuild_pending = true
    g_status = "Timeline ready."
    g_load_msg = ""
}

fn parse_blob_tables() bool {
    if g_blob_data_len < 24 {
        return false
    }
    let magic = read_u32_le(g_blob_data, 0)
    // 'NSTL' little-endian = 0x4C54534E = 1280594766
    if magic != 1280594766 {
        return false
    }
    let version = read_u32_le(g_blob_data, 4)
    if version != 1 {
        return false
    }
    let thread_count = read_u32_le(g_blob_data, 12)
    let sym_count = read_u32_le(g_blob_data, 16)
    let event_count = read_u32_le(g_blob_data, 20)
    if thread_count < 0 {
        return false
    }
    if sym_count < 0 {
        return false
    }
    if event_count < 0 {
        return false
    }
    if event_count > 2000000 {
        return false
    }
    if thread_count > 256 {
        return false
    }
    let pos = 24
    ensure_blob_thread_capacity(thread_count)
    g_blob_thread_count = 0
    g_lane_count = 0
    let ti = 0
    loop ti < thread_count {
        if pos + 2 > g_blob_data_len {
            return false
        }
        let nlen = read_u16_le(g_blob_data, pos)
        pos = pos + 2
        if pos + nlen > g_blob_data_len {
            return false
        }
        let name = bytes_to_str(g_blob_data, pos, nlen)
        pos = pos + nlen
        if name.len == 0 {
            name = "main"
        }
        g_blob_thread_name[ti] = name
        g_blob_thread_count = g_blob_thread_count + 1
        let lane = lane_find_or_add(name)
        // Empty workers still get one row under the title.
        if g_lane_max_depth[lane] < 0 {
            g_lane_max_depth[lane] = 0
        }
        ti = ti + 1
    }
    // Blob symbol table becomes the viewer string pool 1:1, so each sample
    // stores only a u16 pool index instead of a duplicated label.
    if sym_count > 65536 {
        return false
    }
    ensure_str_pool_capacity(sym_count)
    ensure_sym_color_capacity(sym_count)
    g_str_pool_count = 0
    g_blob_sym_count = 0
    let si = 0
    loop si < sym_count {
        if pos + 5 > g_blob_data_len {
            return false
        }
        let kind = (g_blob_data[pos] as i32) & 255
        pos = pos + 1
        let lib_len = read_u16_le(g_blob_data, pos)
        pos = pos + 2
        let name_len = read_u16_le(g_blob_data, pos)
        pos = pos + 2
        if lib_len > 512 {
            return false
        }
        if name_len > 512 {
            return false
        }
        if pos + lib_len + name_len > g_blob_data_len {
            return false
        }
        let lib = bytes_to_str(g_blob_data, pos, lib_len)
        pos = pos + lib_len
        let name = bytes_to_str(g_blob_data, pos, name_len)
        pos = pos + name_len
        let label = name
        if lib.len > 0 {
            label = `{lib}::{name}`
        }
        if kind == 1 {
            // ffi marker kept in name only; label already includes lib
        }
        g_str_pool[si] = label
        g_sym_color[si] = name_color(label)
        g_str_pool_count = g_str_pool_count + 1
        g_blob_sym_count = g_blob_sym_count + 1
        si = si + 1
    }
    g_blob_events_off = pos
    g_blob_event_total = event_count
    g_blob_event_done = 0
    g_blob_pos = pos
    if event_count > 0 {
        ensure_event_capacity(event_count)
    }
    g_ev_count = 0
    g_ev_raw = 0
    g_ev_max_dur = 0.0
    g_long_count = 0
    g_time_origin = 0.0
    g_time_end = 0.0
    return true
}

fn begin_blob_load(profile_path: str) bool {
    clear_blob_load()
    let path = blob_path_for(profile_path)
    if path.len == 0 {
        return false
    }
    let size = os_file_size(path)
    if size <= 0 {
        g_status = "Timeline blob missing."
        return false
    }
    if size > 2147483647 {
        g_status = "Timeline blob too large."
        return false
    }
    g_blob_path = path
    g_loading = true
    g_load_stage = LOAD_STAGE_READ()
    g_load_frac = 0.01
    g_load_msg = "Reading timeline..."
    g_status = g_load_msg
    return true
}

fn begin_text_events_load() {
    g_text_events_pending = true
    g_loading = true
    g_load_stage = LOAD_STAGE_EVENTS()
    g_load_frac = 0.1
    g_load_msg = "Parsing timeline..."
    g_status = g_load_msg
}

fn tick_blob_load() {
    if g_loading == false {
        return
    }

    if g_text_events_pending {
        g_text_events_pending = false
        g_load_msg = "Parsing timeline..."
        g_status = g_load_msg
        g_load_frac = 0.4
        let want = parse_i32(g_timeline_events)
        if want > 0 {
            ensure_event_capacity(want)
        }
        parse_profile_body(g_raw, true)
        g_events_loaded = true
        rebuild_lane_layout(18.0)
        fit_time_view()
        invalidate_overview_batch()
        g_ov_rebuild_pending = true
        g_loading = false
        g_load_stage = LOAD_STAGE_DONE()
        g_load_frac = 1.0
        g_status = `Loaded {g_ev_count} timeline spans.`
        g_load_msg = ""
        return
    }

    if g_load_stage == LOAD_STAGE_READ() {
        g_load_msg = "Reading timeline..."
        g_status = g_load_msg
        let size = os_file_size(g_blob_path)
        let cap = size as i32
        g_blob_raw = [u8](cap)
        let got = os_read_file_bytes(g_blob_path, g_blob_raw, cap)
        if got <= 0 {
            g_status = "Failed to read timeline blob."
            clear_blob_load()
            return
        }
        g_blob_raw_len = got as i32
        g_load_stage = LOAD_STAGE_INFLATE()
        g_load_frac = 0.08
        g_load_msg = "Decompressing timeline..."
        g_status = g_load_msg
        return
    }

    if g_load_stage == LOAD_STAGE_INFLATE() {
        g_load_msg = "Decompressing timeline..."
        g_status = g_load_msg
        let codec = g_timeline_blob_codec
        if codec == "zstd" {
            let out_len = compress_zstd_decoded_size(g_blob_raw, g_blob_raw_len)
            if out_len <= 0 {
                g_status = "Bad zstd timeline blob."
                clear_blob_load()
                return
            }
            g_blob_data = [u8](out_len)
            let decoded = compress_zstd_decode(g_blob_raw, g_blob_raw_len, g_blob_data, out_len)
            if decoded <= 0 {
                g_status = "Failed to decompress timeline."
                clear_blob_load()
                return
            }
            g_blob_data_len = decoded
            g_blob_raw_len = 0
            g_blob_raw = [u8](16)
        } else {
            g_blob_data = g_blob_raw
            g_blob_data_len = g_blob_raw_len
            g_blob_raw_len = 0
        }
        g_load_stage = LOAD_STAGE_TABLES()
        g_load_frac = 0.15
        g_load_msg = "Indexing symbols..."
        g_status = g_load_msg
        return
    }

    if g_load_stage == LOAD_STAGE_TABLES() {
        if parse_blob_tables() == false {
            g_status = "Invalid timeline blob."
            clear_blob_load()
            return
        }
        g_load_stage = LOAD_STAGE_EVENTS()
        g_load_frac = 0.2
        g_load_msg = `Loading timeline 0/{g_blob_event_total}`
        g_status = g_load_msg
        return
    }

    if g_load_stage == LOAD_STAGE_EVENTS() {
        if g_blob_event_total <= 0 {
            finish_blob_load()
            return
        }
        let budget = LOAD_EVENTS_PER_FRAME()
        let n = 0
        loop n < budget {
            if g_blob_event_done >= g_blob_event_total {
                break
            }
            let off = g_blob_events_off + g_blob_event_done * 20
            if off + 20 > g_blob_data_len {
                break
            }
            let depth = (g_blob_data[off + 1] as i32) & 255
            let thread = read_u16_le(g_blob_data, off + 2)
            let sym = read_u16_le(g_blob_data, off + 4)
            let start_us = read_i32_le(g_blob_data, off + 8)
            let dur_us = read_i32_le(g_blob_data, off + 12)
            let self_us = read_i32_le(g_blob_data, off + 16)
            let lane = 0
            if thread >= 0 {
                if thread < g_lane_count {
                    lane = thread
                }
            }
            let sid = 0
            if sym >= 0 {
                if sym < g_str_pool_count {
                    sid = sym
                }
            }
            push_blob_event_fast(us_to_ms(start_us), us_to_ms(dur_us), us_to_ms(self_us), depth, sid, lane)
            g_blob_event_done = g_blob_event_done + 1
            n = n + 1
        }
        if g_blob_event_total > 0 {
            g_load_frac = 0.2 + 0.75 * (g_blob_event_done as f64 / g_blob_event_total as f64)
        }
        // Update the status string sparsely - backtick format allocates and
        // the native heap never frees.
        if g_blob_event_done % 65536 == 0 {
            g_load_msg = `Loading timeline {g_blob_event_done}/{g_blob_event_total}`
            g_status = g_load_msg
        }
        if g_blob_event_done >= g_blob_event_total {
            finish_blob_load()
        }
        return
    }
}

fn load_profile(path: str) {
    clear_profile()
    g_path = path
    let size = os_file_size(path)
    if size < 0 {
        g_status = "Failed to read profile."
        return
    }
    if size > MAX_TEXT_PROFILE_BYTES() {
        g_status = "Profile text too large (use ns-profile-v6 blob)."
        return
    }
    let data = read_file(path)
    if data.len == 0 {
        g_status = "Failed to read profile."
        return
    }
    g_raw = data
    parse_header(data)
    parse_profile_body(data, false)
    g_events_loaded = false
    layout_flame()
    g_t0 = 0.0
    g_t1 = parse_f64(g_elapsed)
    if g_t1 <= 0.0 {
        g_t1 = 1.0
    }
    cam_snap_time()
    if format_known(g_format) == false {
        g_status = "Loaded file is not an ns-profile."
        fit_flame_view()
        g_mode = 0
        cam_stop()
        return
    }
    fit_flame_view()
    g_drag_mode = 0
    g_drag_moved = false
    g_mode = 0
    g_profile_loaded = true
    cam_stop()
    select_default_detail()
    if format_has_blob(g_format) {
        if g_timeline_blob.len > 0 {
            if begin_blob_load(path) {
                g_status = "Loading timeline..."
            } else {
                g_status = "Profile loaded (timeline unavailable)."
            }
        } else {
            g_status = "Profile loaded."
        }
    } else {
        // Legacy text timelines: parse during the load progress phase too.
        if parse_i32(g_timeline_events) > 0 {
            begin_text_events_load()
        } else {
            g_status = "Profile loaded."
        }
    }
}

fn open_profile() {
    let path = os_open_file_dialog("Open ns.profile")
    if path.len == 0 {
        g_status = "No profile selected."
    } else {
        load_profile(path)
    }
}

fn draw_button(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64, label: str, accent: bool) bool {
    let bg = col_panel_hi()
    let fg = col_text()
    if accent {
        bg = col_accent()
        fg = col_bg()
    }
    if hit(v, x, y, w, h) {
        if accent == false {
            bg = ui_pack_color("#2b3c48")
        }
    }
    ui_fill_rect(r, x, y, w, h, bg, 0.0)
    let tw = ui_text_width(r, label, PX(), FONT())
    let tx = x + (w - tw) * 0.5
    let ty = ui_text_v_center_y(r, y, h, PX(), FONT())
    ui_draw_text(r, tx, ty, label, PX(), fg, FONT())
    if g_frame_count > 2 {
        if v.mouse_pressed {
            if hit(v, x, y, w, h) {
                return true
            }
        }
    }
    return false
}

fn draw_metric(r: ref ui_renderer, x: f64, y: f64, w: f64, label: str, value: str, color: u32) {
    ui_fill_rect(r, x, y, w, 36.0, col_panel(), 0.0)
    ui_draw_text(r, x + 8.0, y + 3.0, label, TITLE_PX(), col_muted(), FONT())
    ui_push_clip(r, x + 8.0, y + 19.0, w - 16.0, 14.0)
    ui_draw_text(r, x + 8.0, y + 19.0, value, PX(), color, FONT())
    ui_pop_clip(r)
}

fn fmt_or_dash(s: str) str {
    if s == "" {
        return "-"
    }
    return s
}

fn floor_f(x: f64) f64 {
    if x >= 2147483647.0 {
        return x
    }
    if x <= -2147483648.0 {
        return x
    }
    if x >= 0.0 {
        return (x as i32) as f64
    }
    let t = (x as i32) as f64
    if t == x {
        return t
    }
    return t - 1.0
}

fn fmt_1dec(x: f64) str {
    let n = floor_f(x * 10.0 + 0.5)
    let whole = floor_f(n / 10.0)
    let frac = n - whole * 10.0
    return `{whole as i32}.{frac as i32}`
}

fn fmt_time_ms(ms: f64) str {
    if ms < 0.0 {
        return "0"
    }
    if ms < 1.0 {
        let us = ms * 1000.0
        if us < 10.0 {
            return `{fmt_1dec(us)} us`
        }
        return `{(floor_f(us + 0.5) as i32)} us`
    }
    if ms < 10.0 {
        return `{fmt_1dec(ms)} ms`
    }
    return `{(floor_f(ms + 0.5) as i32)} ms`
}

fn pick_tick_ms(span: f64, target_count: f64) f64 {
    if span <= 0.0 {
        return 1.0
    }
    if target_count < 1.0 {
        return span
    }
    let raw = span / target_count
    if raw <= 0.0 {
        return span
    }
    let pow10 = 1.0
    let guard = 0
    loop raw >= 10.0 * pow10 {
        if guard > 64 {
            break
        }
        guard = guard + 1
        pow10 = pow10 * 10.0
    }
    guard = 0
    loop raw < pow10 {
        if guard > 64 {
            break
        }
        guard = guard + 1
        if pow10 <= 0.0001 {
            break
        }
        pow10 = pow10 * 0.1
    }
    if pow10 <= 0.0 {
        return span
    }
    let n = raw / pow10
    if n <= 1.0 {
        return pow10
    }
    if n <= 2.0 {
        return 2.0 * pow10
    }
    if n <= 5.0 {
        return 5.0 * pow10
    }
    return 10.0 * pow10
}

fn clamp_view() {
    let span = g_t1 - g_t0
    let min_span = time_min_span()
    if span < min_span {
        g_t1 = g_t0 + min_span
        span = min_span
    }
    let full = time_full_span()
    if span > full {
        span = full
        g_t0 = g_time_origin
        g_t1 = g_time_end
        return
    }
    if g_t0 < g_time_origin {
        g_t0 = g_time_origin
        g_t1 = g_t0 + span
    }
    if g_t1 > g_time_end {
        g_t1 = g_time_end
        g_t0 = g_t1 - span
        if g_t0 < g_time_origin {
            g_t0 = g_time_origin
        }
    }
}

fn draw_time_rulers(r: ref ui_renderer, x: f64, y: f64, w: f64, h: f64, t0: f64, t1: f64, label_y: f64) {
    let span = t1 - t0
    if span <= 0.0 {
        return
    }
    let major = pick_tick_ms(span, max_f(4.0, w / 90.0))
    let minor = major / 5.0
    if minor <= 0.0 {
        minor = major
    }
    let scale = w / span
    let guard = 0
    let t = floor_f(t0 / minor) * minor
    loop t <= t1 + minor * 0.01 {
        if guard > 512 {
            break
        }
        guard = guard + 1
        if t + minor * 0.001 >= t0 {
            let px = x + (t - t0) * scale
            ui_fill_rect(r, px, y + h * 0.45, 1.0, h * 0.55, ui_pack_color("#2a3640"), 0.0)
        }
        t = t + minor
    }

    guard = 0
    t = floor_f(t0 / major) * major
    let last_label_r = x - 1000.0
    loop t <= t1 + major * 0.01 {
        if guard > 256 {
            break
        }
        guard = guard + 1
        if t + major * 0.001 >= t0 {
            let px = x + (t - t0) * scale
            ui_fill_rect(r, px, y, 1.0, h, col_line(), 0.0)
            if label_y >= 0.0 {
                let label = fmt_time_ms(t - g_time_origin)
                let tw = ui_text_width(r, label, PX(), FONT())
                let lx = px - tw * 0.5
                if lx < x {
                    lx = x
                }
                if lx + tw <= x + w {
                    if lx > last_label_r + 4.0 {
                        ui_draw_text(r, lx, label_y, label, PX(), col_muted(), FONT())
                        last_label_r = lx + tw
                    }
                }
            }
        }
        t = t + major
    }
}

fn overview_batch_stale(w: f64, h: f64) bool {
    if g_ov_batch_ready == false {
        return true
    }
    if g_ov_batch_events != g_ev_count {
        return true
    }
    if g_ov_batch_origin != g_time_origin {
        return true
    }
    if g_ov_batch_end != g_time_end {
        return true
    }
    if g_ov_batch_w != w {
        return true
    }
    if g_ov_batch_h != h {
        return true
    }
    return false
}

fn emit_overview_bars(r: ref ui_renderer, batch: i32, ox: f64, oy: f64, w: f64, h: f64) {
    let total = g_time_end - g_time_origin
    if total <= 0.0 {
        return
    }
    let scale = w / total
    let lane_h = max_f(2.0, h - 10.0)
    let lane_y = oy + 4.0
    // Cap bars so a dense dump stays within a retained GPU batch.
    let budget = (w as i32) * 4
    if budget < 256 {
        budget = 256
    }
    let step = 1
    if g_ev_count > budget {
        step = g_ev_count / budget
        if step < 1 {
            step = 1
        }
    }
    let i = 0
    loop i < g_ev_count {
        let bw = max_f(1.0, g_ev_duration[i] * scale)
        let bx = ox + (g_ev_start[i] - g_time_origin) * scale
        let depth_frac: f64 = 0.0
        if g_ev_depth[i] > 0 {
            depth_frac = min_f(0.7, g_ev_depth[i] as f64 * 0.12)
        }
        let by = lane_y + lane_h * depth_frac
        let bh = max_f(2.0, lane_h * (1.0 - depth_frac))
        let color = g_ev_color[i]
        if batch > 0 {
            ui_rect_batch_add(r, batch, bx, by, bw, bh, color)
        } else {
            ui_fill_rect(r, bx, by, bw, bh, color, 0.0)
        }
        i = i + step
    }
}

fn rebuild_overview_batch(r: ref ui_renderer, w: f64, h: f64) bool {
    if g_ov_batch == 0 {
        g_ov_batch = ui_rect_batch_create(r)
    }
    if g_ov_batch == 0 {
        g_ov_batch_ready = false
        return false
    }
    ui_rect_batch_begin(r, g_ov_batch)
    emit_overview_bars(r, g_ov_batch, 0.0, 0.0, w, h)
    g_ov_batch_ready = ui_rect_batch_end(r, g_ov_batch)
    g_ov_batch_w = w
    g_ov_batch_h = h
    g_ov_batch_origin = g_time_origin
    g_ov_batch_end = g_time_end
    g_ov_batch_events = g_ev_count
    return g_ov_batch_ready
}

fn draw_overview(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel_hi(), 0.0)
    let total = g_time_end - g_time_origin
    if total <= 0.0 {
        return
    }
    let scale = w / total
    if overview_batch_stale(w, h) {
        rebuild_overview_batch(r, w, h)
    }
    if g_ov_batch_ready {
        ui_rect_batch_draw_at(r, g_ov_batch, x, y)
    } else {
        emit_overview_bars(r, 0, x, y, w, h)
    }

    draw_time_rulers(r, x, y + h - 8.0, w, 8.0, g_time_origin, g_time_end, -1.0)

    let vx0 = x + (g_t0 - g_time_origin) * scale
    let vx1 = x + (g_t1 - g_time_origin) * scale
    let vw = max_f(3.0, vx1 - vx0)
    ui_fill_rect(r, vx0, y, vw, h, ui_pack_rgba_floats(0.4, 0.83, 0.6, 0.22), 0.0)
    ui_stroke_rect(r, vx0, y + 1.0, vw, h - 2.0, 1.0, col_accent(), 0.0)

}

fn zoom_time_at(mx: f64, x: f64, w: f64, scroll: f64) {
    if w <= 0.0 {
        return
    }
    let span = g_cam_t1 - g_cam_t0
    let use_span = span
    if use_span < time_min_span() {
        use_span = time_min_span()
    }
    let ratio = (mx - x) / w
    if ratio < 0.0 {
        ratio = 0.0
    }
    if ratio > 1.0 {
        ratio = 1.0
    }
    let focus = g_cam_t0 + use_span * ratio
    let factor = wheel_zoom_out()
    if scroll > 0.0 {
        factor = wheel_zoom_in()
    }
    // Larger wheel ticks zoom further in one notch.
    let mag = scroll
    if mag < 0.0 {
        mag = 0.0 - mag
    }
    if mag > 1.0 {
        if scroll > 0.0 {
            factor = factor * factor
        } else {
            factor = factor * factor
        }
    }
    let next = use_span * factor
    let min_span = time_min_span()
    if next < min_span {
        next = min_span
    }
    let full = time_full_span()
    if next > full {
        next = full
    }
    cam_set_time(focus - next * ratio, focus - next * ratio + next)
    g_vel_t = 0.0
    g_cam_coasting = false
}

fn zoom_flame_at(mx: f64, x: f64, w: f64, scroll: f64) {
    if w <= 0.0 {
        return
    }
    let span = g_cam_fx1 - g_cam_fx0
    let use_span = span
    if use_span < flame_min_span() {
        use_span = flame_min_span()
    }
    let ratio = (mx - x) / w
    if ratio < 0.0 {
        ratio = 0.0
    }
    if ratio > 1.0 {
        ratio = 1.0
    }
    let focus = g_cam_fx0 + use_span * ratio
    let factor = wheel_zoom_out()
    if scroll > 0.0 {
        factor = wheel_zoom_in()
    }
    let mag = scroll
    if mag < 0.0 {
        mag = 0.0 - mag
    }
    if mag > 1.0 {
        factor = factor * factor
    }
    let next = use_span * factor
    let min_span = flame_min_span()
    if next < min_span {
        next = min_span
    }
    if next > 1.0 {
        next = 1.0
    }
    cam_set_flame(focus - next * ratio, focus - next * ratio + next)
    g_vel_fx = 0.0
    g_cam_coasting = false
}

fn select_node_by_name(name: str) {
    let i = 0
    loop i < g_node_count {
        if g_node_name[i] == name {
            g_selected = i
            return
        }
        i = i + 1
    }
}

fn select_default_detail() {
    g_selected_ev = -1
    if g_hot_count > 0 {
        select_node_by_name(g_hot_name[0])
        if g_selected >= 0 {
            return
        }
    }
    if g_node_count <= 0 {
        g_selected = -1
        return
    }
    let best = 0
    let i = 1
    loop i < g_node_count {
        if g_node_self[i] > g_node_self[best] {
            best = i
        }
        i = i + 1
    }
    g_selected = best
}

// Draw bar label vertically centered; when the bar is wider than the view,
// clamp the text into the visible window so it stays readable while zoomed.
fn draw_bar_label(r: ref ui_renderer, bx: f64, by: f64, bw: f64, bh: f64, view_x: f64, view_w: f64, label: str) {
    if bw <= 24.0 {
        return
    }
    let pad = 3.0
    let clip_l = max_f(bx + pad, view_x)
    let clip_r = min_f(bx + bw - pad, view_x + view_w)
    if clip_r <= clip_l {
        return
    }
    let ty = ui_text_v_center_y(r, by, bh, PX(), FONT())
    let tw = ui_text_width(r, label, PX(), FONT())
    let tx = bx + pad
    if tw > clip_r - clip_l {
        tx = clip_l
    } else {
        if tx < clip_l {
            tx = clip_l
        }
        if tx + tw > clip_r {
            tx = clip_r - tw
        }
    }
    ui_push_clip(r, clip_l, by, clip_r - clip_l, bh)
    ui_draw_text(r, tx, ty, label, PX(), col_bg(), FONT())
    ui_pop_clip(r)
}

fn show_toast(msg: str, ms: u64) {
    g_toast = msg
    g_toast_until = os_time_ms() + ms
}

fn draw_toast(r: ref ui_renderer, canvas_w: f64, canvas_h: f64) {
    if g_toast == "" {
        return
    }
    let now = os_time_ms()
    if now >= g_toast_until {
        g_toast = ""
        return
    }
    let tw = ui_text_width(r, g_toast, PX(), FONT())
    let pad_x = 14.0
    let box_w = tw + pad_x * 2.0
    let box_h = 28.0
    let bx = (canvas_w - box_w) * 0.5
    let by = canvas_h - box_h - 24.0
    ui_fill_rect(r, bx, by, box_w, box_h, col_panel_hi(), 0.0)
    ui_fill_rect(r, bx, by, box_w, 1.0, col_line(), 0.0)
    ui_fill_rect(r, bx, by + box_h - 1.0, box_w, 1.0, col_line(), 0.0)
    ui_fill_rect(r, bx, by, 1.0, box_h, col_line(), 0.0)
    ui_fill_rect(r, bx + box_w - 1.0, by, 1.0, box_h, col_line(), 0.0)
    let ty = ui_text_v_center_y(r, by, box_h, PX(), FONT())
    ui_draw_text(r, bx + pad_x, ty, g_toast, PX(), col_text(), FONT())
    ui_request_render(r, 2)
}

fn copy_detail(v: ref view, text: str) {
    if text == "" {
        return
    }
    view_set_clipboard(v, text)
    show_toast("Copied", 1400)
}

fn draw_detail_row(r: ref ui_renderer, x: f64, y: f64, w: f64, label: str, value: str) {
    ui_draw_text(r, x, y, label, TITLE_PX(), col_muted(), FONT())
    ui_push_clip(r, x, y + 16.0, w, 14.0)
    ui_draw_text(r, x, y + 16.0, value, PX(), col_text(), FONT())
    ui_pop_clip(r)
}

fn draw_selected_header(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, title: str, name: str) {
    ui_draw_text(r, x + 8.0, y + 6.0, title, TITLE_PX(), col_muted(), FONT())
    let copy_w = 52.0
    let copy_h = 18.0
    let copy_x = x + w - copy_w - 8.0
    if draw_button(r, v, copy_x, y + 4.0, copy_w, copy_h, "Copy", false) {
        copy_detail(v, name)
    }
    ui_push_clip(r, x + 8.0, y + 24.0, w - 16.0, 16.0)
    ui_draw_text(r, x + 8.0, y + 24.0, name, TITLE_PX(), col_accent(), FONT())
    ui_pop_clip(r)
}

fn draw_hot_list(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    let list_y = y
    if g_mode == 1 {
        if g_selected_ev >= 0 {
            if g_selected_ev < g_ev_count {
                draw_selected_header(r, v, x, y, w, "selected span", ev_name(g_selected_ev))
                let elapsed = parse_f64(g_elapsed)
                if elapsed <= 0.0 {
                    elapsed = 1.0
                }
                let dur = g_ev_duration[g_selected_ev]
                let self_ms = g_ev_self[g_selected_ev]
                let dur_pct = dur / elapsed * 100.0
                let self_pct = self_ms / elapsed * 100.0
                let lane = g_ev_lane[g_selected_ev]
                let thread = "main"
                if lane >= 0 {
                    if lane < g_lane_count {
                        thread = g_lane_name[lane]
                    }
                }
                draw_detail_row(r, x + 8.0, y + 48.0, w - 16.0, "DURATION", `{fmt_time_ms(dur)}  {fmt_1dec(dur_pct)}%`)
                draw_detail_row(r, x + 8.0, y + 82.0, w - 16.0, "SELF", `{fmt_time_ms(self_ms)}  {fmt_1dec(self_pct)}%`)
                draw_detail_row(r, x + 8.0, y + 116.0, w - 16.0, "START", `+{fmt_time_ms(g_ev_start[g_selected_ev] - g_time_origin)}`)
                draw_detail_row(r, x + 8.0, y + 150.0, w - 16.0, "CALLS", `{g_ev_calls[g_selected_ev]}`)
                draw_detail_row(r, x + 8.0, y + 184.0, w - 16.0, "DEPTH", `{g_ev_depth[g_selected_ev]}`)
                draw_detail_row(r, x + 8.0, y + 218.0, w - 16.0, "THREAD", thread)
                ui_fill_rect(r, x + 8.0, y + 254.0, w - 16.0, 1.0, col_line(), 0.0)
                list_y = y + 262.0
            }
        }
    } else {
        if g_selected >= 0 {
            if g_selected < g_node_count {
                draw_selected_header(r, v, x, y, w, "selected", g_node_name[g_selected])
                let elapsed = parse_f64(g_elapsed)
                if elapsed <= 0.0 {
                    elapsed = 1.0
                }
                let total_pct = g_node_total[g_selected] / elapsed * 100.0
                let self_pct = g_node_self[g_selected] / elapsed * 100.0
                draw_detail_row(r, x + 8.0, y + 48.0, w - 16.0, "TOTAL", `{fmt_time_ms(g_node_total[g_selected])}  {fmt_1dec(total_pct)}%`)
                draw_detail_row(r, x + 8.0, y + 82.0, w - 16.0, "SELF", `{fmt_time_ms(g_node_self[g_selected])}  {fmt_1dec(self_pct)}%`)
                draw_detail_row(r, x + 8.0, y + 116.0, w - 16.0, "CALLS", `{g_node_calls[g_selected]}`)
                draw_detail_row(r, x + 8.0, y + 150.0, w - 16.0, "DEPTH", `{g_node_depth[g_selected]}`)
                ui_fill_rect(r, x + 8.0, y + 186.0, w - 16.0, 1.0, col_line(), 0.0)
                list_y = y + 194.0
            }
        }
    }

    ui_draw_text(r, x + 8.0, list_y + 6.0, "hot self time", TITLE_PX(), col_muted(), FONT())
    if g_hot_count == 0 {
        ui_draw_text(r, x + 8.0, list_y + 24.0, "No fn table.", PX(), col_muted(), FONT())
    } else {
        let elapsed = parse_f64(g_elapsed)
        if elapsed <= 0.0 {
            elapsed = 1.0
        }
        let row_h = 28.0
        let i = 0
        loop i < g_hot_count {
            let ry = list_y + 22.0 + i as f64 * row_h
            if ry + row_h > y + h {
                break
            }
            let pct = g_hot_self[i] / elapsed * 100.0
            let bar_w = max_f(2.0, (w - 16.0) * (g_hot_self[i] / elapsed))
            ui_fill_rect(r, x + 8.0, ry + 16.0, bar_w, 4.0, name_color(g_hot_name[i]), 0.0)
            let line = `{g_hot_name[i]}  {g_hot_self[i]}ms  {pct}%  {g_hot_calls[i]}x`
            ui_push_clip(r, x + 8.0, ry, w - 16.0, 14.0)
            ui_draw_text(r, x + 8.0, ry, line, PX(), col_text(), FONT())
            ui_pop_clip(r)
            i = i + 1
        }
    }
}

fn draw_flamegraph(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_node_count == 0 {
        ui_draw_text(r, x + 8.0, y + 12.0, "No flame stacks in this profile.", PX(), col_muted(), FONT())
        ui_draw_text(r, x + 8.0, y + 26.0, "Run `ns profile` to generate ns-profile-v5.", PX(), col_muted(), FONT())
        return
    }

    let row_h = 18.0
    let plot_y = y + 8.0
    let plot_h = h - 28.0
    let content_h = (g_max_depth + 1) as f64 * row_h
    let max_scroll = max_f(0.0, content_h - plot_h)
    g_cam_scroll_max = max_scroll
    if g_fx1 <= g_fx0 {
        fit_flame_view()
    }

    let on_plot = hit(v, x, plot_y, w, plot_h)
    if g_chart_input {
        if g_drag_mode != 0 {
            if g_drag_mode != 3 {
                end_drag()
            } else {
                if v.mouse_down == false {
                    end_drag()
                }
            }
        }
        if g_drag_mode == 0 {
            if on_plot {
                if v.scroll_y != 0.0 {
                    zoom_flame_at(g_mouse_x, x, w, v.scroll_y)
                    ui_request_render(r, 2)
                }
                if v.mouse_pressed {
                    begin_drag(3)
                }
                if v.mouse_right_pressed {
                    fit_flame_view()
                    g_selected = -1
                    g_selected_ev = -1
                }
            }
        }
    }

    if g_drag_mode == 3 {
        if v.mouse_down {
            let dx = g_mouse_x - g_drag_x
            let dy = g_mouse_y - g_drag_y
            mark_drag_moved(dx, dy)
            let span = g_drag_fx1 - g_drag_fx0
            let min_span = flame_min_span()
            if span < min_span {
                span = min_span
            }
            let prev_fx0 = g_cam_fx0
            let prev_scroll = g_cam_scroll
            // Absolute pan from press anchor; write camera targets with damping follow.
            cam_set_flame(g_drag_fx0 - dx * span / w, g_drag_fx0 - dx * span / w + span)
            cam_set_scroll(g_drag_scroll - dy * scroll_drag_gain())
            cam_sample_vel_flame(prev_fx0, 0.016)
            cam_sample_vel_scroll(prev_scroll, 0.016)
            ui_request_render(r, 2)
        }
    }

    let view_span = flame_view_span()
    let scale = 1.0 / view_span
    g_hovered = -1

    ui_push_clip(r, x, plot_y, w, plot_h)
    let i = 0
    loop i < g_node_count {
        if g_node_w[i] > 0.0 {
            let nx0 = g_node_x[i]
            let nx1 = g_node_x[i] + g_node_w[i]
            if nx1 > g_fx0 {
                if nx0 < g_fx1 {
                    let bx0 = x + (nx0 - g_fx0) * scale * w
                    let bx1 = x + (nx1 - g_fx0) * scale * w
                    let draw_x = max_f(bx0, x)
                    let draw_r = min_f(bx1, x + w)
                    let bw = max_f(1.0, draw_r - draw_x)
                    let by = plot_y + g_node_depth[i] as f64 * row_h - g_scroll
                    let bh = row_h - 1.0
                    if by + bh > plot_y {
                        if by < plot_y + plot_h {
                            let color = name_color(g_node_name[i])
                            if hit(v, draw_x, by, bw, bh) {
                                g_hovered = i
                                ui_fill_rect(r, draw_x, by, bw, bh, col_warn(), 0.0)
                            } else {
                                if i == g_selected {
                                    ui_fill_rect(r, draw_x, by, bw, bh, col_accent(), 0.0)
                                } else {
                                    ui_fill_rect(r, draw_x, by, bw, bh, color, 0.0)
                                }
                            }
                            let label = `{g_node_name[i]} {g_node_calls[i]}x`
                            draw_bar_label(r, bx0, by, max_f(1.0, bx1 - bx0), bh, x, w, label)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    ui_pop_clip(r)

    if v.mouse_released {
        if g_hovered >= 0 {
            if g_drag_moved == false {
                g_selected = g_hovered
                g_selected_ev = -1
            }
        }
        end_drag()
        g_drag_moved = false
    }

    let footer_h: f64 = 22.0
    let footer_y = y + h - footer_h
    ui_fill_rect(r, x, footer_y, w, 1.0, col_line(), 0.0)
    let footer_ty = ui_text_v_center_y(r, footer_y, footer_h, PX(), FONT())
    if g_hovered >= 0 {
        let detail = `{g_node_name[g_hovered]}  total {g_node_total[g_hovered]} ms  self {g_node_self[g_hovered]} ms  {g_node_calls[g_hovered]}x`
        ui_push_clip(r, x + 8.0, footer_y, w - 16.0, footer_h)
        ui_draw_text(r, x + 8.0, footer_ty, detail, PX(), col_text(), FONT())
        ui_pop_clip(r)
    } else {
        ui_draw_text(r, x + 8.0, footer_ty, "wheel zoom, drag pan, click select, right-click reset", PX(), col_muted(), FONT())
    }
}

fn draw_lane_headers(r: ref ui_renderer, x: f64, w: f64, plot_y: f64, plot_h: f64) {
    let label_h = lane_label_h()
    let li_lane = 0
    loop li_lane < g_lane_count {
        let ly = plot_y + g_lane_y0[li_lane] - g_scroll
        let lh = g_lane_h[li_lane]
        if ly + lh > plot_y {
            if ly < plot_y + plot_h {
                let title = g_lane_name[li_lane]
                if title.len == 0 {
                    title = "main"
                }
                ui_fill_rect(r, x, ly, w, label_h, col_panel_hi(), 0.0)
                let ty = ui_text_v_center_y(r, ly, label_h, PX(), FONT())
                ui_draw_text(r, x + 8.0, ty, title, PX(), col_text(), FONT())
                ui_fill_rect(r, x, ly + label_h - 1.0, w, 1.0, col_line(), 0.0)
                ui_fill_rect(r, x, ly + lh, w, 1.0, col_line(), 0.0)
            }
        }
        li_lane = li_lane + 1
    }
}

fn draw_timeline(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_lane_count == 0 {
        lane_find_or_add("main")
        rebuild_lane_layout(18.0)
    }
    if g_ev_count == 0 {
        ui_draw_text(r, x + 8.0, y + 12.0, "No timeline events in this profile.", PX(), col_muted(), FONT())
        let plot_y = y + 40.0
        let plot_h = h - 62.0
        if plot_h > 8.0 {
            ui_push_clip(r, x, plot_y, w, plot_h)
            draw_lane_headers(r, x, w, plot_y, plot_h)
            ui_pop_clip(r)
        }
        return
    }

    if g_t1 <= g_t0 {
        reset_time_view()
    }
    if g_t1 < g_time_origin {
        reset_time_view()
    }
    if g_t0 > g_time_end {
        reset_time_view()
    }

    let footer_h: f64 = 22.0
    let overview_h: f64 = 28.0
    let ruler_h: f64 = 16.0
    let gap: f64 = 3.0
    if h < overview_h + ruler_h + footer_h + gap * 2.0 + 40.0 {
        overview_h = 20.0
        ruler_h = 14.0
    }
    let overview_y: f64 = y + 2.0
    let ruler_y: f64 = overview_y + overview_h + gap
    let plot_y: f64 = ruler_y + ruler_h + gap
    let plot_h: f64 = h - (plot_y - y) - footer_h
    if plot_h < 8.0 {
        plot_h = 8.0
        plot_y = y + h - footer_h - plot_h
    }

    let ov_x = x + 4.0
    let ov_w = w - 8.0
    let row_h: f64 = 18.0
    if g_lane_count == 0 {
        lane_find_or_add("main")
    }
    rebuild_lane_layout(row_h)
    let content_h = g_lane_content_h
    let max_scroll = max_f(0.0, content_h - plot_h)
    g_cam_scroll_max = max_scroll

    let on_overview = hit(v, ov_x, overview_y, ov_w, overview_h)
    let on_plot = hit(v, x, plot_y, w, plot_h)

    if g_drag_mode == 1 {
        if v.mouse_down == false {
            end_drag()
        }
    } else {
        if g_drag_mode == 2 {
            if v.mouse_down == false {
                end_drag()
            }
        }
    }

    if g_chart_input {
        if g_drag_mode == 0 {
            if v.scroll_y != 0.0 {
                if on_plot {
                    zoom_time_at(g_mouse_x, x, w, v.scroll_y)
                    ui_request_render(r, 2)
                } else {
                    if on_overview {
                        zoom_time_at(g_mouse_x, ov_x, ov_w, v.scroll_y)
                        ui_request_render(r, 2)
                    }
                }
            }
            if v.mouse_pressed {
                if on_overview {
                    begin_drag(2)
                    let full = time_full_span()
                    let mouse_t = g_time_origin + ((g_mouse_x - ov_x) / ov_w) * full
                    let view_span = g_cam_t1 - g_cam_t0
                    if view_span < time_min_span() {
                        view_span = time_min_span()
                    }
                    if mouse_t < g_cam_t0 {
                        cam_set_time(mouse_t - view_span * 0.5, mouse_t - view_span * 0.5 + view_span)
                        g_drag_t0 = g_cam_t0
                        g_drag_t1 = g_cam_t1
                    } else {
                        if mouse_t > g_cam_t1 {
                            cam_set_time(mouse_t - view_span * 0.5, mouse_t - view_span * 0.5 + view_span)
                            g_drag_t0 = g_cam_t0
                            g_drag_t1 = g_cam_t1
                        }
                    }
                    let cur = g_cam_t1 - g_cam_t0
                    if cur > 0.0 {
                        g_drag_grab = (mouse_t - g_cam_t0) / cur
                    } else {
                        g_drag_grab = 0.0
                    }
                    if g_drag_grab < 0.0 {
                        g_drag_grab = 0.0
                    }
                    if g_drag_grab > 1.0 {
                        g_drag_grab = 1.0
                    }
                } else {
                    if on_plot {
                        begin_drag(1)
                    }
                }
            }
            if on_plot {
                if v.mouse_right_pressed {
                    fit_time_view()
                    cam_set_scroll(0.0)
                    g_selected_ev = -1
                }
            }
        }
    }

    if g_drag_mode == 1 {
        if v.mouse_down {
            let dx = g_mouse_x - g_drag_x
            let dy = g_mouse_y - g_drag_y
            mark_drag_moved(dx, dy)
            let press_span = g_drag_t1 - g_drag_t0
            let min_span = time_min_span()
            if press_span < min_span {
                press_span = min_span
            }
            let prev_t0 = g_cam_t0
            let prev_scroll = g_cam_scroll
            cam_set_time(g_drag_t0 - dx * press_span / w, g_drag_t0 - dx * press_span / w + press_span)
            cam_set_scroll(g_drag_scroll - dy * scroll_drag_gain())
            cam_sample_vel_time(prev_t0, 0.016)
            cam_sample_vel_scroll(prev_scroll, 0.016)
            ui_request_render(r, 2)
        }
    } else {
        if g_drag_mode == 2 {
            if v.mouse_down {
                let dx = g_mouse_x - g_drag_x
                mark_drag_moved(dx, 0.0)
                let full = time_full_span()
                let mouse_t = g_time_origin + ((g_mouse_x - ov_x) / ov_w) * full
                let press_span = g_drag_t1 - g_drag_t0
                let min_span = time_min_span()
                if press_span < min_span {
                    press_span = min_span
                }
                let prev_t0 = g_cam_t0
                cam_set_time(mouse_t - press_span * g_drag_grab, mouse_t - press_span * g_drag_grab + press_span)
                cam_sample_vel_time(prev_t0, 0.016)
                ui_request_render(r, 2)
            }
        }
    }

    // Recompute after zoom/pan so bars use the updated view window.
    let span = time_view_span()
    let scale = w / span
    let min_ms = lod_min_ms(span, w)

    draw_overview(r, v, ov_x, overview_y, ov_w, overview_h)
    ui_fill_rect(r, x, ruler_y, w, ruler_h, col_panel(), 0.0)
    draw_time_rulers(r, x, ruler_y + 2.0, w, ruler_h - 2.0, g_t0, g_t1, ruler_y)
    ui_fill_rect(r, x, plot_y - 1.0, w, 1.0, col_line(), 0.0)

    g_tl_hovered = -1
    g_tl_drawn = 0
    g_tl_skipped = 0
    g_tl_scanned = 0
    g_tl_min_ms = min_ms
    let lane_factor = g_lane_count
    if lane_factor < 1 {
        lane_factor = 1
    }
    g_tl_budget = (w as i32) * (g_ev_max_depth + 2) * 2 * lane_factor
    if g_tl_budget < 2048 {
        g_tl_budget = 2048
    }
    ui_push_clip(r, x, plot_y, w, plot_h)
    draw_time_rulers(r, x, plot_y, w, plot_h, g_t0, g_t1, -1.0)

    draw_lane_headers(r, x, w, plot_y, plot_h)

    // Long spans may start well before t0 and still overlap the window.
    let li = 0
    loop li < g_long_count {
        let ev = g_long_idx[li]
        if g_ev_start[ev] < g_t0 {
            if timeline_try_draw_event(r, v, ev, x, w, plot_y, plot_h, row_h, scale) == false {
                break
            }
        }
        li = li + 1
    }

    // Sliding window over starts. Look back by long_span_min_ms so shorter
    // bars that begin just before t0 but still overlap are not dropped;
    // anything longer is covered by g_long_idx above.
    let win_lo = g_t0 - long_span_min_ms()
    let i = event_lower_bound(win_lo)
    g_tl_skipped = g_tl_skipped + i
    loop i < g_ev_count {
        if g_ev_start[i] >= g_t1 {
            g_tl_skipped = g_tl_skipped + (g_ev_count - i)
            break
        }
        // Already drawn via the long-span pass.
        if g_ev_start[i] < g_t0 {
            if g_ev_duration[i] >= long_span_min_ms() {
                i = i + 1
                continue
            }
        }
        if timeline_try_draw_event(r, v, i, x, w, plot_y, plot_h, row_h, scale) == false {
            g_tl_skipped = g_tl_skipped + (g_ev_count - i - 1)
            break
        }
        i = i + 1
    }
    ui_pop_clip(r)

    let footer_y = y + h - footer_h
    ui_fill_rect(r, x, footer_y, w, 1.0, col_line(), 0.0)
    let footer_ty = ui_text_v_center_y(r, footer_y, footer_h, PX(), FONT())
    if g_tl_hovered >= 0 {
        // Draw name only - avoid backtick format (native heap never frees).
        ui_push_clip(r, x + 8.0, footer_y, w - 16.0, footer_h)
        ui_draw_text(r, x + 8.0, footer_ty, ev_name(g_tl_hovered), PX(), col_text(), FONT())
        ui_pop_clip(r)
    } else {
        ui_draw_text(r, x + 8.0, footer_ty, "wheel zoom, drag pan, click select", PX(), col_muted(), FONT())
    }

    if v.mouse_released {
        end_drag()
        g_drag_moved = false
    }
}

fn draw_profile(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    let elapsed_text = g_elapsed
    if elapsed_text == "" {
        elapsed_text = "-"
    } else {
        elapsed_text = elapsed_text + " ms"
    }

    let metric_w = (w - 30.0) / 4.0
    draw_metric(r, x, y, metric_w, "ELAPSED", elapsed_text, col_accent())
    draw_metric(r, x + metric_w + 10.0, y, metric_w, "VM SCOPES", fmt_or_dash(g_scope_calls), col_text())
    draw_metric(r, x + (metric_w + 10.0) * 2.0, y, metric_w, "FLAME STACKS", fmt_or_dash(g_flame_frames), col_warn())
    draw_metric(r, x + (metric_w + 10.0) * 3.0, y, metric_w, "FFI CALLS", fmt_or_dash(g_ffi_calls), col_text())

    let body_y = y + 46.0
    let body_h = h - 46.0
    let split = 6.0
    let min_side = 160.0
    let min_chart = 180.0
    let min_show = 48.0
    let max_side = w - split - min_chart
    if max_side > w * 0.55 {
        max_side = w * 0.55
    }
    if max_side < min_show {
        max_side = min_show
    }
    // Clamp only the on-screen copy. Writing a tight max_side back into
    // g_side_w on a small canvas permanently hid the panel after resize.
    let side_w = g_side_w
    if side_w < min_side {
        side_w = min_side
    }
    if side_w > max_side {
        side_w = max_side
    }
    if side_w > w - split - min_show {
        side_w = w - split - min_show
    }
    if side_w < min_show {
        side_w = min_show
    }
    let chart_w = w - side_w - split
    let split_x = x + chart_w
    let side_x = split_x + split
    let hit_pad = 4.0
    let on_split = hit(v, split_x - hit_pad, body_y, split + hit_pad * 2.0, body_h)

    if g_side_resizing {
        if v.mouse_down {
            let next = g_side_drag_w - (g_mouse_x - g_drag_x)
            if next < min_side {
                next = min_side
            }
            if max_side >= min_side {
                if next > max_side {
                    next = max_side
                }
                g_side_w = next
                side_w = next
            }
            if side_w > w - split - min_show {
                side_w = w - split - min_show
            }
            if side_w < min_show {
                side_w = min_show
            }
            chart_w = w - side_w - split
            split_x = x + chart_w
            side_x = split_x + split
            on_split = true
            ui_request_render(r, 2)
        }
        if v.mouse_released {
            g_side_resizing = false
        }
        if v.mouse_down == false {
            if v.mouse_released == false {
                g_side_resizing = false
            }
        }
    } else {
        if g_drag_mode == 0 {
            if on_split {
                if v.mouse_pressed {
                    g_side_resizing = true
                    g_side_drag_w = g_side_w
                    g_drag_x = g_mouse_x
                    g_drag_y = g_mouse_y
                    ui_request_render(r, 2)
                }
            }
        }
    }

    if body_h > 80.0 {
        let on_side = hit(v, side_x, body_y, side_w, body_h)
        g_chart_input = true
        if g_side_resizing {
            g_chart_input = false
        } else {
            if on_split {
                g_chart_input = false
            } else {
                if on_side {
                    g_chart_input = false
                }
            }
        }
        // Details first: a busy flamegraph can fill the UI command buffer
        // and would otherwise drop the split and the side panel.
        if side_w > 40.0 {
            draw_hot_list(r, v, side_x, body_y, side_w, body_h)
        }
        let split_color = col_line()
        if on_split {
            split_color = col_accent()
        } else {
            if g_side_resizing {
                split_color = col_accent()
            }
        }
        ui_fill_rect(r, split_x + 2.0, body_y + 8.0, 2.0, body_h - 16.0, split_color, 0.0)
        if chart_w > 40.0 {
            if g_mode == 0 {
                draw_flamegraph(r, v, x, body_y, chart_w, body_h)
            } else {
                draw_timeline(r, v, x, body_y, chart_w, body_h)
            }
        }
    }
}

fn render_frame(r: ref ui_renderer, v: ref view) {
    ui_resize(r)
    g_mouse_x = ui_content_x(r, v.mouse_x)
    g_mouse_y = ui_content_y(r, v.mouse_y)
    tick_camera(r)

    // The canvas is the safe area, so the viewer keeps clear of native chrome.
    // ref-fn i32 returns can carry garbage upper bits, which poisons f64
    // arithmetic on the cast and parks the side panel off-screen.
    let w = (ui_canvas_width(r) & 1048575) as f64
    let h = (ui_canvas_height(r) & 1048575) as f64
    if w != g_canvas_w || h != g_canvas_h {
        if w != g_canvas_w {
            g_ov_rebuild_pending = true
        }
        g_canvas_w = w
        g_canvas_h = h
        ui_request_render(r, 2)
    }

    ui_fill_rect(r, 0.0, 0.0, w, h, col_bg(), 0.0)

    let pad = 10.0
    let header_h = 40.0
    ui_fill_rect(r, 0.0, 0.0, w, header_h, col_panel(), 0.0)
    ui_draw_text(r, pad, 4.0, "NS Profile", TITLE_PX(), col_text(), FONT())
    ui_push_clip(r, pad, 22.0, 280.0, 14.0)
    ui_draw_text(r, pad, 22.0, g_status, PX(), col_muted(), FONT())
    ui_pop_clip(r)

    let open_w = 90.0
    let load_w = 110.0
    let mode_w = 60.0
    let by = 8.0
    let open_x = w - pad - open_w
    let load_x = open_x - load_w - 10.0
    let time_x = load_x - mode_w - 10.0
    let flame_x = time_x - mode_w - 10.0
    if draw_button(r, v, flame_x, by, mode_w, 24.0, "Flame", g_mode == 0) {
        if g_loading == false {
            g_mode = 0
            end_drag()
            g_drag_moved = false
        }
    }
    if draw_button(r, v, time_x, by, mode_w, 24.0, "Time", g_mode == 1) {
        // Time data is prepared during load; switching modes must stay instant.
        if g_loading {
            g_status = "Still loading timeline..."
        } else {
            if g_events_loaded {
                g_mode = 1
                end_drag()
                g_drag_moved = false
            } else {
                g_status = "No timeline in this profile."
            }
        }
    }
    if draw_button(r, v, load_x, by, load_w, 24.0, "Load file", false) {
        g_load_profile_pending = true
    }
    if draw_button(r, v, open_x, by, open_w, 24.0, "Open", true) {
        g_open_profile_pending = true
    }

    ui_fill_rect(r, 0.0, header_h, w, 1.0, col_line(), 0.0)

    let body_x = pad
    let body_y = header_h + 10.0
    let body_w = w - pad * 2.0
    let body_h = h - body_y - pad

    if body_w > 100.0 {
        if body_h > 80.0 {
            if g_profile_loaded == false {
                let cy = body_y + min_f(90.0, body_h * 0.3)
                ui_draw_text(r, body_x, cy, "No profile loaded", TITLE_PX(), col_text(), FONT())
                ui_draw_text(r, body_x, cy + 20.0, "Run `ns profile` to write and open bin/ns.profile.", PX(), col_muted(), FONT())
                if g_status == "Loaded file is not an ns-profile." {
                    ui_draw_text(r, body_x, cy + 38.0, g_status, PX(), col_warn(), FONT())
                }
            } else {
                draw_profile(r, v, body_x, body_y, body_w, body_h)
            }
        }
    }
    if g_ov_rebuild_pending {
        if g_loading == false {
            if g_events_loaded {
                rebuild_overview_batch(r, max_f(200.0, w - 40.0), 28.0)
                g_ov_rebuild_pending = false
            }
        }
    }
    if g_loading {
        let bw = min_f(420.0, w * 0.5)
        let bh = 54.0
        let bx = (w - bw) * 0.5
        let by = (h - bh) * 0.5
        ui_fill_rect(r, bx - 8.0, by - 8.0, bw + 16.0, bh + 16.0, col_panel(), 0.0)
        ui_stroke_rect(r, bx - 8.0, by - 8.0, bw + 16.0, bh + 16.0, 1.0, col_line(), 0.0)
        ui_draw_text(r, bx, by, g_load_msg, PX(), col_text(), FONT())
        let track_y = by + 24.0
        ui_fill_rect(r, bx, track_y, bw, 12.0, col_panel_hi(), 0.0)
        let fill = max_f(2.0, bw * g_load_frac)
        ui_fill_rect(r, bx, track_y, fill, 12.0, col_accent(), 0.0)
        // Keep pumping load stages while Flame (or empty) is on screen.
        ui_request_render(r, 2)
    }
    draw_toast(r, w, h)
    g_frame_count = g_frame_count + 1
}

fn main() {
    let v = view_create("NS Profile", 1100, 700)
    reset_view_input(v)
    let startup = os_env("NS_PROFILE_FILE")
    let ok = gpu_request_device(v)
    if ok {
        let r = ui_renderer_create(v)
        if startup.len > 0 {
            load_profile(startup)
        } else {
            let local = default_profile_path()
            if os_file_size(local) >= 0 {
                load_profile(local)
            }
        }
        v.on_frame({ fv in
            // Drain load stages before drawing so the progress bar matches work.
            tick_blob_load()
            ui_begin_frame(r)
            render_frame(r, fv)
            ui_flush(r, clear_color())
            reset_view_input(fv)
            if g_load_profile_pending {
                g_load_profile_pending = false
                load_profile(default_profile_path())
            }
            if g_open_profile_pending {
                g_open_profile_pending = false
                open_profile()
            }
            if g_loading {
                ui_request_render(r, 2)
            }
        })
        v.on_terminate({ dv in
            if g_ov_batch > 0 {
                ui_rect_batch_destroy(r, g_ov_batch)
                g_ov_batch = 0
                g_ov_batch_ready = false
            }
            ui_renderer_destroy(r)
        })
    } else {
        print("no GPU backend on this platform; profile viewer is unavailable\n")
    }
    view_run(v)
}
