// nscode/profile/main.ns
// Native flamegraph viewer for ns.profile files.

use std
use view
use gpu
use ui
use os

fn FONT() i32 { return 1 }
fn PX() f64 { return 12.0 }

let g_path = ""
let g_raw = ""
let g_format = ""
let g_elapsed = ""
let g_argv = ""
let g_ffi_calls = ""
let g_ffi_ms = ""
let g_ffi_pct = ""
let g_scope_calls = ""
let g_scope_self = ""
let g_timeline_events = ""
let g_flame_frames = ""
let g_status = "No profile loaded."
let g_mode = 0
let g_events_loaded = false
let g_frame_count: i32 = 0
let g_load_profile_pending = false
let g_open_profile_pending = false
let g_hovered = -1
let g_zoom = -1
let g_scroll: f64 = 0.0

let g_node_name = [i32: str](4096)
let g_node_parent = [i32](4096)
let g_node_calls = [i32](4096)
let g_node_total = [f64](4096)
let g_node_self = [f64](4096)
let g_node_x = [f64](4096)
let g_node_w = [f64](4096)
let g_node_depth = [i32](4096)
let g_node_count = 0
let g_max_depth = 0
let g_root_total: f64 = 0.0

let g_hot_name = [i32: str](256)
let g_hot_kind = [i32: str](256)
let g_hot_self = [f64](256)
let g_hot_total = [f64](256)
let g_hot_calls = [i32](256)
let g_hot_count = 0

let g_ev_start = [f64](8192)
let g_ev_duration = [f64](8192)
let g_ev_self = [f64](8192)
let g_ev_depth = [i32](8192)
let g_ev_calls = [i32](8192)
let g_ev_name = [i32: str](8192)
let g_ev_count = 0
let g_ev_raw = 0
let g_time_end: f64 = 0.0
let g_t0: f64 = 0.0
let g_t1: f64 = 1.0
let g_drag = false
let g_drag_x: f64 = 0.0
let g_drag_t0: f64 = 0.0

fn col_bg() u32 { return ui_pack_color("#101418") }
fn col_panel() u32 { return ui_pack_color("#182026") }
fn col_panel_hi() u32 { return ui_pack_color("#22303a") }
fn col_line() u32 { return ui_pack_color("#34424d") }
fn col_text() u32 { return ui_pack_color("#d8e0e7") }
fn col_muted() u32 { return ui_pack_color("#8b98a5") }
fn col_accent() u32 { return ui_pack_color("#66d39a") }
fn col_warn() u32 { return ui_pack_color("#f0bd5f") }

fn clear_color() ui_color_rgba {
    return ui_color_rgba { r: 0.063, g: 0.078, b: 0.094, a: 1.0 }
}

fn min_f(a: f64, b: f64) f64 {
    if a < b {
        return a
    }
    return b
}

fn max_f(a: f64, b: f64) f64 {
    if a > b {
        return a
    }
    return b
}

fn hit(v: ref view, x: f64, y: f64, w: f64, h: f64) bool {
    if v.mouse_x < x {
        return false
    }
    if v.mouse_x >= (x + w) {
        return false
    }
    if v.mouse_y < y {
        return false
    }
    if v.mouse_y >= (y + h) {
        return false
    }
    return true
}

fn reset_view_input(v: ref view) {
    v.mouse_pressed = false
    v.mouse_released = false
    v.mouse_right_pressed = false
    v.mouse_right_released = false
    v.mouse_middle_pressed = false
    v.mouse_middle_released = false
    v.scroll_x = 0.0
    v.scroll_y = 0.0
}

fn starts_with(s: str, prefix: str) bool {
    if s.len < prefix.len {
        return false
    }
    return substr(s, 0, prefix.len) == prefix
}

fn trim_left(s: str) str {
    let i = 0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c != 32 {
            if c != 9 {
                return substr(s, i, s.len - i)
            }
        }
        i = i + 1
    }
    return ""
}

fn is_space_code(c: i32) bool {
    if c == 32 {
        return true
    }
    return c == 9
}

fn skip_spaces(s: str, i: i32) i32 {
    let p = i
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) == false {
            return p
        }
        p = p + 1
    }
    return p
}

fn word_at(s: str, i: i32) str {
    let start = skip_spaces(s, i)
    let p = start
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) {
            return substr(s, start, p - start)
        }
        p = p + 1
    }
    return substr(s, start, p - start)
}

fn parse_f64(s: str) f64 {
    let i = skip_spaces(s, 0)
    let sign = 1.0
    if i < s.len {
        if ((s[i] as i32) & 255) == 45 {
            sign = -1.0
            i = i + 1
        }
    }

    let value = 0.0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c < 48 {
            break
        }
        if c > 57 {
            break
        }
        value = value * 10.0 + ((c - 48) as f64)
        i = i + 1
    }

    if i < s.len {
        if ((s[i] as i32) & 255) == 46 {
            i = i + 1
            let scale = 0.1
            loop i < s.len {
                let c = (s[i] as i32) & 255
                if c < 48 {
                    break
                }
                if c > 57 {
                    break
                }
                value = value + ((c - 48) as f64) * scale
                scale = scale * 0.1
                i = i + 1
            }
        }
    }

    return value * sign
}

fn parse_i32(s: str) i32 {
    return parse_f64(s) as i32
}

fn is_digit_word(s: str) bool {
    if s.len == 0 {
        return false
    }
    let i = 0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        let ok = false
        if c >= 48 {
            if c <= 57 {
                ok = true
            }
        }
        if c == 46 {
            ok = true
        }
        if ok == false {
            return false
        }
        i = i + 1
    }
    return true
}

fn name_color(name: str) u32 {
    let h = 2166136261
    let i = 0
    loop i < name.len {
        h = h ^ ((name[i] as i32) & 255)
        h = h * 16777619
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    let palette = h % 5
    if palette == 0 {
        return ui_pack_color("#5fb3f0")
    }
    if palette == 1 {
        return ui_pack_color("#66d39a")
    }
    if palette == 2 {
        return ui_pack_color("#d7a8ff")
    }
    if palette == 3 {
        return ui_pack_color("#f08a7a")
    }
    return ui_pack_color("#f0bd5f")
}

fn format_known(s: str) bool {
    if s == "ns-profile-v1" {
        return true
    }
    if s == "ns-profile-v2" {
        return true
    }
    if s == "ns-profile-v3" {
        return true
    }
    return s == "ns-profile-v4"
}

fn find_child(parent: i32, name: str) i32 {
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == parent {
            if g_node_name[i] == name {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn add_node(parent: i32, name: str) i32 {
    if g_node_count >= g_node_parent.len {
        return -1
    }
    let i = g_node_count
    g_node_name[i] = name
    g_node_parent[i] = parent
    g_node_calls[i] = 0
    g_node_total[i] = 0.0
    g_node_self[i] = 0.0
    g_node_x[i] = 0.0
    g_node_w[i] = 0.0
    g_node_depth[i] = 0
    g_node_count = g_node_count + 1
    return i
}

fn stack_frame(stack: str, start: i32) str {
    let p = start
    loop p < stack.len {
        if ((stack[p] as i32) & 255) == 59 {
            return substr(stack, start, p - start)
        }
        p = p + 1
    }
    return substr(stack, start, p - start)
}

fn record_flame_line(line: str) {
    let p = skip_spaces(line, 6)
    let calls_s = word_at(line, p)
    if is_digit_word(calls_s) == false {
        return
    }
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let stack = trim_left(substr(line, p, line.len - p))
    if stack.len == 0 {
        return
    }

    let parent = -1
    let i = 0
    loop i < stack.len {
        let frame = stack_frame(stack, i)
        if frame.len == 0 {
            break
        }
        let node = find_child(parent, frame)
        if node < 0 {
            node = add_node(parent, frame)
        }
        if node < 0 {
            return
        }
        parent = node
        i = i + frame.len
        if i < stack.len {
            if ((stack[i] as i32) & 255) == 59 {
                i = i + 1
            }
        }
    }

    if parent >= 0 {
        g_node_calls[parent] = parse_i32(calls_s)
        g_node_total[parent] = parse_f64(total_s)
        g_node_self[parent] = parse_f64(self_s)
    }
}

fn push_event(start: f64, dur: f64, self_ms: f64, depth: i32, name: str) {
    g_ev_raw = g_ev_raw + 1
    if g_ev_count > 0 {
        let last = g_ev_count - 1
        if g_ev_depth[last] == depth {
            if g_ev_name[last] == name {
                let end = g_ev_start[last] + g_ev_duration[last]
                if start <= end + 0.05 {
                    let new_end = start + dur
                    if new_end > end {
                        g_ev_duration[last] = new_end - g_ev_start[last]
                    }
                    g_ev_self[last] = g_ev_self[last] + self_ms
                    g_ev_calls[last] = g_ev_calls[last] + 1
                    if new_end > g_time_end {
                        g_time_end = new_end
                    }
                    return
                }
            }
        }
    }
    if g_ev_count >= g_ev_start.len {
        return
    }
    let i = g_ev_count
    g_ev_start[i] = start
    g_ev_duration[i] = dur
    g_ev_self[i] = self_ms
    g_ev_depth[i] = depth
    g_ev_calls[i] = 1
    g_ev_name[i] = name
    g_ev_count = g_ev_count + 1
    let end = start + dur
    if end > g_time_end {
        g_time_end = end
    }
}

fn record_fn_line(line: str) {
    if starts_with(line, "fn_table:") {
        return
    }
    if g_hot_count >= g_hot_self.len {
        return
    }
    let p = skip_spaces(line, 3)
    let kind = word_at(line, p)
    p = skip_spaces(line, p + kind.len)
    let calls_s = word_at(line, p)
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let avg_s = word_at(line, p)
    p = skip_spaces(line, p + avg_s.len)
    let min_s = word_at(line, p)
    p = skip_spaces(line, p + min_s.len)
    let max_s = word_at(line, p)
    p = skip_spaces(line, p + max_s.len)
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    let i = g_hot_count
    g_hot_name[i] = name
    g_hot_kind[i] = kind
    g_hot_self[i] = parse_f64(self_s)
    g_hot_total[i] = parse_f64(total_s)
    g_hot_calls[i] = parse_i32(calls_s)
    g_hot_count = g_hot_count + 1
}

fn record_scope_event(line: str, has_self: bool) {
    let p = skip_spaces(line, 12)
    let depth_s = word_at(line, p)
    p = skip_spaces(line, p + depth_s.len)
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_self {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    push_event(parse_f64(start_s), parse_f64(dur_s), parse_f64(self_s), parse_i32(depth_s), name)
}

fn record_ffi_event(line: str, has_depth: bool) {
    let p = skip_spaces(line, 10)
    let depth = 0
    if has_depth {
        let depth_s = word_at(line, p)
        depth = parse_i32(depth_s)
        p = skip_spaces(line, p + depth_s.len)
    }
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_depth {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    push_event(parse_f64(start_s), parse_f64(dur_s), parse_f64(self_s), depth, name)
}

fn parse_profile_body(src: str, want_events: bool) {
    if want_events == false {
        g_node_count = 0
        g_hot_count = 0
        g_max_depth = 0
        g_root_total = 0.0
        g_zoom = -1
        g_hovered = -1
    }
    g_ev_count = 0
    g_ev_raw = 0
    g_time_end = 0.0
    g_t0 = 0.0
    g_t1 = 1.0
    g_drag = false
    let v4 = g_format == "ns-profile-v4"

    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        if want_events {
            if starts_with(line, "scope_event:") {
                record_scope_event(line, v4)
            } else {
                if starts_with(line, "ffi_event:") {
                    record_ffi_event(line, v4)
                }
            }
        } else {
            let ev_line = false
            if starts_with(line, "timeline:") {
                ev_line = true
            }
            if starts_with(line, "scope_event:") {
                ev_line = true
            }
            if starts_with(line, "ffi_event:") {
                ev_line = true
            }
            if ev_line {
                if g_node_count > 0 {
                    break
                }
            } else {
                if starts_with(line, "flame:") {
                    if starts_with(line, "flame_frames:") == false {
                        record_flame_line(line)
                    }
                } else {
                    if starts_with(line, "fn:") {
                        record_fn_line(line)
                    }
                }
            }
        }
        if i < src.len {
            i = i + 1
        }
    }
}

fn layout_node(node: i32, x: f64, w: f64, depth: i32) {
    g_node_x[node] = x
    g_node_w[node] = w
    g_node_depth[node] = depth
    if depth > g_max_depth {
        g_max_depth = depth
    }
    let cx = x
    let scale: f64 = 0.0
    if g_node_total[node] > 0.0 {
        scale = w / g_node_total[node]
    }
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == node {
            let cw: f64 = g_node_total[i] * scale
            if cw < 1.0 {
                if g_node_total[i] > 0.0 {
                    cw = 1.0
                }
            }
            layout_node(i, cx, cw, depth + 1)
            cx = cx + cw
        }
        i = i + 1
    }
}

fn layout_flame() {
    g_max_depth = 0
    g_root_total = 0.0
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] < 0 {
            g_root_total = g_root_total + g_node_total[i]
        }
        i = i + 1
    }
    if g_zoom >= 0 {
        if g_zoom < g_node_count {
            layout_node(g_zoom, 0.0, 1.0, 0)
            return
        }
    }
    let x: f64 = 0.0
    i = 0
    loop i < g_node_count {
        if g_node_parent[i] < 0 {
            let w: f64 = 0.0
            if g_root_total > 0.0 {
                w = g_node_total[i] / g_root_total
            }
            layout_node(i, x, w, 0)
            x = x + w
        }
        i = i + 1
    }
}

fn header_value(line: str, key: str) str {
    let prefix = key + ":"
    if starts_with(line, prefix) == false {
        return ""
    }
    return trim_left(substr(line, prefix.len, line.len - prefix.len))
}

fn parse_header(src: str) {
    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        if starts_with(line, "fn_table:") {
            return
        }
        if starts_with(line, "ffi_table:") {
            return
        }
        if starts_with(line, "timeline:") {
            return
        }
        if starts_with(line, "flame:") {
            if starts_with(line, "flame_frames:") == false {
                return
            }
        }
        if starts_with(line, "scope_event:") {
            return
        }
        if starts_with(line, "ffi_event:") {
            return
        }
        let v = header_value(line, "format")
        if v.len > 0 {
            g_format = v
        }
        v = header_value(line, "elapsed_ms")
        if v.len > 0 {
            g_elapsed = v
        }
        v = header_value(line, "argv")
        if v.len > 0 {
            g_argv = v
        }
        v = header_value(line, "ffi_calls")
        if v.len > 0 {
            g_ffi_calls = v
        }
        v = header_value(line, "ffi_ms")
        if v.len > 0 {
            g_ffi_ms = v
        }
        v = header_value(line, "ffi_pct")
        if v.len > 0 {
            g_ffi_pct = v
        }
        v = header_value(line, "scope_calls")
        if v.len > 0 {
            g_scope_calls = v
        }
        v = header_value(line, "scope_self_ms")
        if v.len > 0 {
            g_scope_self = v
        }
        v = header_value(line, "timeline_events")
        if v.len > 0 {
            g_timeline_events = v
        }
        v = header_value(line, "flame_frames")
        if v.len > 0 {
            g_flame_frames = v
        }
        if i < src.len {
            i = i + 1
        }
    }
}

fn read_file(path: str) str {
    let fd = open(path, "rb")
    if fd == 0 {
        return ""
    }
    let data = read(fd)
    close(fd)
    return data
}

fn clear_profile() {
    g_raw = ""
    g_format = ""
    g_elapsed = ""
    g_argv = ""
    g_ffi_calls = ""
    g_ffi_ms = ""
    g_ffi_pct = ""
    g_scope_calls = ""
    g_scope_self = ""
    g_timeline_events = ""
    g_flame_frames = ""
    g_node_count = 0
    g_hot_count = 0
    g_ev_count = 0
    g_ev_raw = 0
    g_time_end = 0.0
    g_t0 = 0.0
    g_t1 = 1.0
    g_zoom = -1
    g_drag = false
}

fn load_profile(path: str) {
    let data = read_file(path)
    if data.len == 0 {
        clear_profile()
        g_path = path
        g_status = "Failed to read profile."
    } else {
        g_path = path
        g_raw = data
        parse_header(data)
        parse_profile_body(data, false)
        g_events_loaded = false
        layout_flame()
        g_t0 = 0.0
        g_t1 = parse_f64(g_elapsed)
        if g_t1 <= 0.0 {
            g_t1 = 1.0
        }
        if format_known(g_format) {
            g_status = "Profile loaded."
        } else {
            g_status = "Loaded file is not an ns-profile."
        }
        g_scroll = 0.0
        g_mode = 0
    }
}

fn open_profile() {
    let path = os_open_file_dialog("Open ns.profile")
    if path.len == 0 {
        g_status = "No profile selected."
    } else {
        load_profile(path)
    }
}

fn draw_button(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64, label: str, accent: bool) bool {
    let bg = col_panel_hi()
    let fg = col_text()
    if accent {
        bg = col_accent()
        fg = col_bg()
    }
    if hit(v, x, y, w, h) {
        if accent == false {
            bg = ui_pack_color("#2b3c48")
        }
    }
    ui_fill_rect(r, x, y, w, h, bg, 0.0)
    let tw = ui_text_width(r, label, PX(), FONT())
    let tx = x + (w - tw) * 0.5
    let ty = ui_text_v_center_y(r, y, h, PX(), FONT())
    ui_draw_text(r, tx, ty, label, PX(), fg, FONT())
    if g_frame_count > 2 {
        if v.mouse_pressed {
            if hit(v, x, y, w, h) {
                return true
            }
        }
    }
    return false
}

fn draw_metric(r: ref ui_renderer, x: f64, y: f64, w: f64, label: str, value: str, color: u32) {
    ui_fill_rect(r, x, y, w, 36.0, col_panel(), 0.0)
    ui_draw_text(r, x + 8.0, y + 4.0, label, PX(), col_muted(), FONT())
    ui_push_clip(r, x + 8.0, y + 18.0, w - 16.0, 14.0)
    ui_draw_text(r, x + 8.0, y + 18.0, value, PX(), color, FONT())
    ui_pop_clip(r)
}

fn fmt_or_dash(s: str) str {
    if s == "" {
        return "-"
    }
    return s
}

fn draw_hot_list(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    ui_draw_text(r, x + 8.0, y + 6.0, "hot self time", PX(), col_muted(), FONT())
    if g_hot_count == 0 {
        ui_draw_text(r, x + 8.0, y + 24.0, "No fn table.", PX(), col_muted(), FONT())
        return
    }
    let elapsed = parse_f64(g_elapsed)
    if elapsed <= 0.0 {
        elapsed = 1.0
    }
    let row_h = 28.0
    let i = 0
    loop i < g_hot_count {
        let ry = y + 22.0 + i as f64 * row_h
        if ry + row_h > y + h {
            break
        }
        let pct = g_hot_self[i] / elapsed * 100.0
        let bar_w = max_f(2.0, (w - 16.0) * (g_hot_self[i] / elapsed))
        ui_fill_rect(r, x + 8.0, ry + 16.0, bar_w, 4.0, name_color(g_hot_name[i]), 0.0)
        ui_push_clip(r, x + 8.0, ry, w - 16.0, 14.0)
        let line = `{g_hot_name[i]}  {g_hot_self[i]}ms  {pct}%  {g_hot_calls[i]}x`
        ui_draw_text(r, x + 8.0, ry, line, PX(), col_text(), FONT())
        ui_pop_clip(r)
        i = i + 1
    }
}

fn node_visible(node: i32) bool {
    if g_zoom < 0 {
        return true
    }
    let i = node
    loop i >= 0 {
        if i == g_zoom {
            return true
        }
        i = g_node_parent[i]
    }
    return false
}

fn draw_flamegraph(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_node_count == 0 {
        ui_draw_text(r, x + 8.0, y + 12.0, "No flame stacks in this profile.", PX(), col_muted(), FONT())
        ui_draw_text(r, x + 8.0, y + 26.0, "Run `ns profile` to generate ns-profile-v4.", PX(), col_muted(), FONT())
        return
    }

    let row_h = 18.0
    let plot_y = y + 8.0
    let plot_h = h - 28.0
    g_hovered = -1

    ui_push_clip(r, x, plot_y, w, plot_h)
    let i = 0
    loop i < g_node_count {
        if node_visible(i) {
            if g_node_w[i] > 0.0 {
                let bx = x + g_node_x[i] * w
                let bw = max_f(2.0, g_node_w[i] * w)
                let by = plot_y + g_node_depth[i] as f64 * row_h
                let bh = row_h - 1.0
                if by + bh >= plot_y {
                    if by <= plot_y + plot_h {
                        let color = name_color(g_node_name[i])
                        if hit(v, bx, by, bw, bh) {
                            g_hovered = i
                            ui_fill_rect(r, bx, by, bw, bh, col_warn(), 0.0)
                            if v.mouse_pressed {
                                g_zoom = i
                                layout_flame()
                            }
                        } else {
                            ui_fill_rect(r, bx, by, bw, bh, color, 0.0)
                        }
                        if bw > 24.0 {
                            ui_push_clip(r, bx + 3.0, by, bw - 6.0, bh)
                            let label = `{g_node_name[i]} {g_node_calls[i]}x`
                            ui_draw_text(r, bx + 3.0, by + 2.0, label, PX(), col_bg(), FONT())
                            ui_pop_clip(r)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    ui_pop_clip(r)

    if v.mouse_right_pressed {
        if hit(v, x, y, w, h) {
            g_zoom = -1
            layout_flame()
        }
    }

    ui_fill_rect(r, x, y + h - 22.0, w, 1.0, col_line(), 0.0)
    if g_hovered >= 0 {
        let detail = `{g_node_name[g_hovered]}  total {g_node_total[g_hovered]} ms  self {g_node_self[g_hovered]} ms  {g_node_calls[g_hovered]}x`
        ui_push_clip(r, x + 8.0, y + h - 18.0, w - 16.0, 14.0)
        ui_draw_text(r, x + 8.0, y + h - 16.0, detail, PX(), col_text(), FONT())
        ui_pop_clip(r)
    } else {
        ui_draw_text(r, x + 8.0, y + h - 16.0, "click zoom, right-click reset", PX(), col_muted(), FONT())
    }
}

fn draw_timeline(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_ev_count == 0 {
        ui_draw_text(r, x + 8.0, y + 12.0, "No timeline events in this profile.", PX(), col_muted(), FONT())
        return
    }

    if g_t1 <= g_t0 {
        g_t1 = g_t0 + 1.0
    }

    let row_h = 18.0
    let plot_y = y + 8.0
    let plot_h = h - 28.0
    let span = g_t1 - g_t0
    let scale = w / span
    let max_depth = 0
    let i = 0
    loop i < g_ev_count {
        if g_ev_depth[i] > max_depth {
            max_depth = g_ev_depth[i]
        }
        i = i + 1
    }

    if hit(v, x, plot_y, w, plot_h) {
        if v.scroll_y != 0.0 {
            let mx = (v.mouse_x - x) / w
            let focus = g_t0 + span * mx
            let factor = 1.25
            if v.scroll_y > 0.0 {
                factor = 0.8
            }
            let next = span * factor
            if next < 0.05 {
                next = 0.05
            }
            if next > g_time_end {
                next = g_time_end
            }
            if next < 0.05 {
                next = 0.05
            }
            g_t0 = focus - next * mx
            g_t1 = g_t0 + next
            if g_t0 < 0.0 {
                g_t1 = g_t1 - g_t0
                g_t0 = 0.0
            }
        }
        if v.mouse_pressed {
            g_drag = true
            g_drag_x = v.mouse_x
            g_drag_t0 = g_t0
        }
        if v.mouse_right_pressed {
            g_t0 = 0.0
            g_t1 = g_time_end
            if g_t1 <= 0.0 {
                g_t1 = 1.0
            }
        }
    }
    if g_drag {
        if v.mouse_down {
            let dt = (g_drag_x - v.mouse_x) / scale
            g_t0 = g_drag_t0 + dt
            g_t1 = g_t0 + span
            if g_t0 < 0.0 {
                g_t1 = g_t1 - g_t0
                g_t0 = 0.0
            }
        } else {
            g_drag = false
        }
    }

    let hovered = -1
    ui_push_clip(r, x, plot_y, w, plot_h)
    i = 0
    loop i < g_ev_count {
        let ev_end = g_ev_start[i] + g_ev_duration[i]
        if ev_end >= g_t0 {
            if g_ev_start[i] <= g_t1 {
                let by = plot_y + g_ev_depth[i] as f64 * row_h - g_scroll
                if by + row_h >= plot_y {
                    if by <= plot_y + plot_h {
                        let bx = x + (g_ev_start[i] - g_t0) * scale
                        let bw = max_f(2.0, g_ev_duration[i] * scale)
                        let bh = row_h - 1.0
                        let color = name_color(g_ev_name[i])
                        if hit(v, bx, by, bw, bh) {
                            hovered = i
                            ui_fill_rect(r, bx, by, bw, bh, col_warn(), 0.0)
                        } else {
                            ui_fill_rect(r, bx, by, bw, bh, color, 0.0)
                        }
                        if bw > 24.0 {
                            ui_push_clip(r, bx + 3.0, by, bw - 6.0, bh)
                            let label = `{g_ev_name[i]} {g_ev_calls[i]}x`
                            ui_draw_text(r, bx + 3.0, by + 2.0, label, PX(), col_bg(), FONT())
                            ui_pop_clip(r)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    ui_pop_clip(r)

    ui_fill_rect(r, x, y + h - 22.0, w, 1.0, col_line(), 0.0)
    if hovered >= 0 {
        let detail = `{g_ev_name[hovered]}  {g_ev_calls[hovered]}x  start {g_ev_start[hovered]} ms  dur {g_ev_duration[hovered]} ms`
        ui_push_clip(r, x + 8.0, y + h - 18.0, w - 16.0, 14.0)
        ui_draw_text(r, x + 8.0, y + h - 16.0, detail, PX(), col_text(), FONT())
        ui_pop_clip(r)
    } else {
        let shown = `{g_ev_count} spans / {g_ev_raw} calls   wheel zoom, drag pan`
        ui_draw_text(r, x + 8.0, y + h - 16.0, shown, PX(), col_muted(), FONT())
    }
}

fn draw_profile(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    let elapsed_text = g_elapsed
    if elapsed_text == "" {
        elapsed_text = "-"
    } else {
        elapsed_text = elapsed_text + " ms"
    }

    let metric_w = (w - 30.0) / 4.0
    draw_metric(r, x, y, metric_w, "ELAPSED", elapsed_text, col_accent())
    draw_metric(r, x + metric_w + 10.0, y, metric_w, "VM SCOPES", fmt_or_dash(g_scope_calls), col_text())
    draw_metric(r, x + (metric_w + 10.0) * 2.0, y, metric_w, "FLAME STACKS", fmt_or_dash(g_flame_frames), col_warn())
    draw_metric(r, x + (metric_w + 10.0) * 3.0, y, metric_w, "FFI CALLS", fmt_or_dash(g_ffi_calls), col_text())

    let body_y = y + 46.0
    let body_h = h - 46.0
    let side_w = min_f(260.0, w * 0.28)
    let chart_w = w - side_w - 10.0
    if body_h > 80.0 {
        if g_mode == 0 {
            draw_flamegraph(r, v, x, body_y, chart_w, body_h)
        } else {
            draw_timeline(r, v, x, body_y, chart_w, body_h)
        }
        draw_hot_list(r, v, x + chart_w + 10.0, body_y, side_w, body_h)
    }
}

fn render_frame(r: ref ui_renderer, v: ref view) {
    ui_resize(r)

    let w = v.width as f64
    let h = v.height as f64

    ui_fill_rect(r, 0.0, 0.0, w, h, col_bg(), 0.0)

    let pad = 10.0
    let header_h = 40.0
    ui_fill_rect(r, 0.0, 0.0, w, header_h, col_panel(), 0.0)
    ui_draw_text(r, pad, 6.0, "NS Profile", PX(), col_text(), FONT())
    ui_push_clip(r, pad, 22.0, 280.0, 14.0)
    ui_draw_text(r, pad, 22.0, g_status, PX(), col_muted(), FONT())
    ui_pop_clip(r)

    let open_w = 90.0
    let load_w = 110.0
    let mode_w = 60.0
    let by = 8.0
    let open_x = w - pad - open_w
    let load_x = open_x - load_w - 10.0
    let time_x = load_x - mode_w - 10.0
    let flame_x = time_x - mode_w - 10.0
    if draw_button(r, v, flame_x, by, mode_w, 24.0, "Flame", g_mode == 0) {
        g_mode = 0
    }
    if draw_button(r, v, time_x, by, mode_w, 24.0, "Time", g_mode == 1) {
        g_mode = 1
        if g_events_loaded == false {
            if g_raw.len > 0 {
                parse_profile_body(g_raw, true)
                g_events_loaded = true
                g_t0 = 0.0
                g_t1 = g_time_end
                if g_t1 <= 0.0 {
                    g_t1 = parse_f64(g_elapsed)
                }
                if g_t1 <= 0.0 {
                    g_t1 = 1.0
                }
            }
        }
    }
    if draw_button(r, v, load_x, by, load_w, 24.0, "Load file", false) {
        g_load_profile_pending = true
    }
    if draw_button(r, v, open_x, by, open_w, 24.0, "Open", true) {
        g_open_profile_pending = true
    }

    ui_fill_rect(r, 0.0, header_h, w, 1.0, col_line(), 0.0)

    let body_x = pad
    let body_y = header_h + 10.0
    let body_w = w - pad * 2.0
    let body_h = h - body_y - pad

    if body_w > 100.0 {
        if body_h > 80.0 {
            if g_raw.len == 0 {
                let cy = body_y + min_f(90.0, body_h * 0.3)
                ui_draw_text(r, body_x, cy, "No profile loaded", PX(), col_text(), FONT())
                ui_draw_text(r, body_x, cy + 16.0, "Run `ns profile` then `ns profiler`, or open ns.profile.", PX(), col_muted(), FONT())
                if g_status == "Loaded file is not an ns-profile." {
                    ui_draw_text(r, body_x, cy + 32.0, g_status, PX(), col_warn(), FONT())
                }
            } else {
                draw_profile(r, v, body_x, body_y, body_w, body_h)
            }
        }
    }
    g_frame_count = g_frame_count + 1
}

fn main() {
    let v = view_create("NS Profile", 1100, 700)
    reset_view_input(v)
    let startup = os_env("NS_PROFILE_FILE")
    let ok = gpu_request_device(v)
    if ok {
        let r = ui_renderer_create(v)
        if startup.len > 0 {
            load_profile(startup)
        } else {
            let local = read_file("ns.profile")
            if local.len > 0 {
                load_profile("ns.profile")
            }
        }
        v.on_frame({ fv in
            ui_begin_frame(r)
            render_frame(r, fv)
            ui_flush(r, clear_color())
            reset_view_input(fv)
            if g_load_profile_pending {
                g_load_profile_pending = false
                load_profile("ns.profile")
            }
            if g_open_profile_pending {
                g_open_profile_pending = false
                open_profile()
            }
        })
        v.on_terminate({ dv in
            ui_renderer_destroy(r)
        })
    } else {
        print("no GPU backend on this platform; profile viewer is unavailable\n")
    }
    view_run(v)
}
