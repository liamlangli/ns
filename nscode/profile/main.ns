// nscode/profile/main.ns
// Native flamegraph viewer for ns.profile files.

use std
use view
use gpu
use ui
use os

fn FONT_MONO() i32 { return 1 }

let g_path = ""
let g_raw = ""
let g_format = ""
let g_elapsed = ""
let g_argv = ""
let g_ffi_calls = ""
let g_ffi_ms = ""
let g_ffi_pct = ""
let g_scope_calls = ""
let g_scope_self = ""
let g_timeline_events = ""
let g_flame_frames = ""
let g_status = "No profile loaded."
let g_mode = 0
let g_frame_count: i32 = 0
let g_load_profile_pending = false
let g_open_profile_pending = false
let g_hovered = -1
let g_zoom = -1
let g_scroll: f64 = 0.0

let g_node_name = [i32: str](4096)
let g_node_parent = [i32](4096)
let g_node_calls = [i32](4096)
let g_node_total = [f64](4096)
let g_node_self = [f64](4096)
let g_node_x = [f64](4096)
let g_node_w = [f64](4096)
let g_node_depth = [i32](4096)
let g_node_count = 0
let g_max_depth = 0
let g_root_total: f64 = 0.0

let g_hot_name = [i32: str](64)
let g_hot_kind = [i32: str](64)
let g_hot_self = [f64](64)
let g_hot_total = [f64](64)
let g_hot_calls = [i32](64)
let g_hot_count = 0

let g_ev_start = [f64](4096)
let g_ev_duration = [f64](4096)
let g_ev_self = [f64](4096)
let g_ev_depth = [i32](4096)
let g_ev_name = [i32: str](4096)
let g_ev_count = 0
let g_time_end: f64 = 0.0

fn col_bg() u32 { return ui_pack_color("#101418") }
fn col_panel() u32 { return ui_pack_color("#182026") }
fn col_panel_hi() u32 { return ui_pack_color("#22303a") }
fn col_line() u32 { return ui_pack_color("#34424d") }
fn col_text() u32 { return ui_pack_color("#d8e0e7") }
fn col_muted() u32 { return ui_pack_color("#8b98a5") }
fn col_accent() u32 { return ui_pack_color("#66d39a") }
fn col_warn() u32 { return ui_pack_color("#f0bd5f") }

fn clear_color() ui_color_rgba {
    return ui_color_rgba { r: 0.063, g: 0.078, b: 0.094, a: 1.0 }
}

fn min_f(a: f64, b: f64) f64 {
    if a < b {
        return a
    }
    return b
}

fn max_f(a: f64, b: f64) f64 {
    if a > b {
        return a
    }
    return b
}

fn hit(v: ref view, x: f64, y: f64, w: f64, h: f64) bool {
    if v.mouse_x < x {
        return false
    }
    if v.mouse_x >= (x + w) {
        return false
    }
    if v.mouse_y < y {
        return false
    }
    if v.mouse_y >= (y + h) {
        return false
    }
    return true
}

fn reset_view_input(v: ref view) {
    v.mouse_pressed = false
    v.mouse_released = false
    v.mouse_right_pressed = false
    v.mouse_right_released = false
    v.mouse_middle_pressed = false
    v.mouse_middle_released = false
    v.scroll_x = 0.0
    v.scroll_y = 0.0
}

fn starts_with(s: str, prefix: str) bool {
    if s.len < prefix.len {
        return false
    }
    return substr(s, 0, prefix.len) == prefix
}

fn trim_left(s: str) str {
    let i = 0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c != 32 {
            if c != 9 {
                return substr(s, i, s.len - i)
            }
        }
        i = i + 1
    }
    return ""
}

fn is_space_code(c: i32) bool {
    if c == 32 {
        return true
    }
    return c == 9
}

fn skip_spaces(s: str, i: i32) i32 {
    let p = i
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) == false {
            return p
        }
        p = p + 1
    }
    return p
}

fn word_at(s: str, i: i32) str {
    let start = skip_spaces(s, i)
    let p = start
    loop p < s.len {
        let c = (s[p] as i32) & 255
        if is_space_code(c) {
            return substr(s, start, p - start)
        }
        p = p + 1
    }
    return substr(s, start, p - start)
}

fn parse_f64(s: str) f64 {
    let i = skip_spaces(s, 0)
    let sign = 1.0
    if i < s.len {
        if ((s[i] as i32) & 255) == 45 {
            sign = -1.0
            i = i + 1
        }
    }

    let value = 0.0
    loop i < s.len {
        let c = (s[i] as i32) & 255
        if c < 48 {
            break
        }
        if c > 57 {
            break
        }
        value = value * 10.0 + ((c - 48) as f64)
        i = i + 1
    }

    if i < s.len {
        if ((s[i] as i32) & 255) == 46 {
            i = i + 1
            let scale = 0.1
            loop i < s.len {
                let c = (s[i] as i32) & 255
                if c < 48 {
                    break
                }
                if c > 57 {
                    break
                }
                value = value + ((c - 48) as f64) * scale
                scale = scale * 0.1
                i = i + 1
            }
        }
    }

    return value * sign
}

fn parse_i32(s: str) i32 {
    return parse_f64(s) as i32
}

fn name_color(name: str) u32 {
    let h = 2166136261
    let i = 0
    loop i < name.len {
        h = h ^ ((name[i] as i32) & 255)
        h = h * 16777619
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    let palette = h % 5
    if palette == 0 {
        return ui_pack_color("#5fb3f0")
    }
    if palette == 1 {
        return ui_pack_color("#66d39a")
    }
    if palette == 2 {
        return ui_pack_color("#d7a8ff")
    }
    if palette == 3 {
        return ui_pack_color("#f08a7a")
    }
    return ui_pack_color("#f0bd5f")
}

fn format_known(s: str) bool {
    if s == "ns-profile-v1" {
        return true
    }
    if s == "ns-profile-v2" {
        return true
    }
    if s == "ns-profile-v3" {
        return true
    }
    return s == "ns-profile-v4"
}

fn find_child(parent: i32, name: str) i32 {
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == parent {
            if g_node_name[i] == name {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn add_node(parent: i32, name: str) i32 {
    if g_node_count >= g_node_parent.len {
        return -1
    }
    let i = g_node_count
    g_node_name[i] = name
    g_node_parent[i] = parent
    g_node_calls[i] = 0
    g_node_total[i] = 0.0
    g_node_self[i] = 0.0
    g_node_x[i] = 0.0
    g_node_w[i] = 0.0
    g_node_depth[i] = 0
    g_node_count = g_node_count + 1
    return i
}

fn stack_frame(stack: str, start: i32) str {
    let p = start
    loop p < stack.len {
        if ((stack[p] as i32) & 255) == 59 {
            return substr(stack, start, p - start)
        }
        p = p + 1
    }
    return substr(stack, start, p - start)
}

fn record_flame_line(line: str) {
    let p = skip_spaces(line, 6)
    let calls_s = word_at(line, p)
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let stack = trim_left(substr(line, p, line.len - p))
    if stack.len == 0 {
        return
    }

    let parent = -1
    let i = 0
    loop i < stack.len {
        let frame = stack_frame(stack, i)
        if frame.len == 0 {
            break
        }
        let node = find_child(parent, frame)
        if node < 0 {
            node = add_node(parent, frame)
        }
        if node < 0 {
            return
        }
        parent = node
        i = i + frame.len
        if i < stack.len {
            if ((stack[i] as i32) & 255) == 59 {
                i = i + 1
            }
        }
    }

    if parent >= 0 {
        g_node_calls[parent] = parse_i32(calls_s)
        g_node_total[parent] = parse_f64(total_s)
        g_node_self[parent] = parse_f64(self_s)
    }
}

fn record_fn_line(line: str) {
    if g_hot_count >= g_hot_self.len {
        return
    }
    let p = skip_spaces(line, 3)
    let kind = word_at(line, p)
    p = skip_spaces(line, p + kind.len)
    let calls_s = word_at(line, p)
    p = skip_spaces(line, p + calls_s.len)
    let total_s = word_at(line, p)
    p = skip_spaces(line, p + total_s.len)
    let self_s = word_at(line, p)
    p = skip_spaces(line, p + self_s.len)
    let avg_s = word_at(line, p)
    p = skip_spaces(line, p + avg_s.len)
    let min_s = word_at(line, p)
    p = skip_spaces(line, p + min_s.len)
    let max_s = word_at(line, p)
    p = skip_spaces(line, p + max_s.len)
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    let i = g_hot_count
    g_hot_name[i] = name
    g_hot_kind[i] = kind
    g_hot_self[i] = parse_f64(self_s)
    g_hot_total[i] = parse_f64(total_s)
    g_hot_calls[i] = parse_i32(calls_s)
    g_hot_count = g_hot_count + 1
}

fn record_scope_event(line: str, has_self: bool) {
    if g_ev_count >= g_ev_start.len {
        return
    }
    let p = skip_spaces(line, 12)
    let depth_s = word_at(line, p)
    p = skip_spaces(line, p + depth_s.len)
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_self {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    let i = g_ev_count
    g_ev_start[i] = parse_f64(start_s)
    g_ev_duration[i] = parse_f64(dur_s)
    g_ev_self[i] = parse_f64(self_s)
    g_ev_depth[i] = parse_i32(depth_s)
    g_ev_name[i] = name
    g_ev_count = g_ev_count + 1
    let end = g_ev_start[i] + g_ev_duration[i]
    if end > g_time_end {
        g_time_end = end
    }
}

fn record_ffi_event(line: str, has_depth: bool) {
    if g_ev_count >= g_ev_start.len {
        return
    }
    let p = skip_spaces(line, 10)
    let depth = 0
    if has_depth {
        let depth_s = word_at(line, p)
        depth = parse_i32(depth_s)
        p = skip_spaces(line, p + depth_s.len)
    }
    let start_s = word_at(line, p)
    p = skip_spaces(line, p + start_s.len)
    let dur_s = word_at(line, p)
    p = skip_spaces(line, p + dur_s.len)
    let self_s = dur_s
    if has_depth {
        self_s = word_at(line, p)
        p = skip_spaces(line, p + self_s.len)
    }
    let name = trim_left(substr(line, p, line.len - p))
    if name.len == 0 {
        return
    }
    let i = g_ev_count
    g_ev_start[i] = parse_f64(start_s)
    g_ev_duration[i] = parse_f64(dur_s)
    g_ev_self[i] = parse_f64(self_s)
    g_ev_depth[i] = depth
    g_ev_name[i] = name
    g_ev_count = g_ev_count + 1
    let end = g_ev_start[i] + g_ev_duration[i]
    if end > g_time_end {
        g_time_end = end
    }
}

fn parse_profile_body(src: str) {
    g_node_count = 0
    g_hot_count = 0
    g_ev_count = 0
    g_time_end = 0.0
    g_max_depth = 0
    g_root_total = 0.0
    g_zoom = -1
    g_hovered = -1
    let v4 = g_format == "ns-profile-v4"

    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        if starts_with(line, "flame:") {
            record_flame_line(line)
        } else {
            if starts_with(line, "fn:") {
                record_fn_line(line)
            } else {
                if starts_with(line, "scope_event:") {
                    record_scope_event(line, v4)
                } else {
                    if starts_with(line, "ffi_event:") {
                        record_ffi_event(line, v4)
                    }
                }
            }
        }
        if i < src.len {
            i = i + 1
        }
    }
}

fn layout_node(node: i32, x: f64, w: f64, depth: i32) {
    g_node_x[node] = x
    g_node_w[node] = w
    g_node_depth[node] = depth
    if depth > g_max_depth {
        g_max_depth = depth
    }
    let cx = x
    let scale: f64 = 0.0
    if g_node_total[node] > 0.0 {
        scale = w / g_node_total[node]
    }
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] == node {
            let cw: f64 = g_node_total[i] * scale
            if cw < 1.0 {
                if g_node_total[i] > 0.0 {
                    cw = 1.0
                }
            }
            layout_node(i, cx, cw, depth + 1)
            cx = cx + cw
        }
        i = i + 1
    }
}

fn layout_flame() {
    g_max_depth = 0
    g_root_total = 0.0
    let i = 0
    loop i < g_node_count {
        if g_node_parent[i] < 0 {
            g_root_total = g_root_total + g_node_total[i]
        }
        i = i + 1
    }
    if g_zoom >= 0 {
        if g_zoom < g_node_count {
            layout_node(g_zoom, 0.0, 1.0, 0)
            return
        }
    }
    let x: f64 = 0.0
    i = 0
    loop i < g_node_count {
        if g_node_parent[i] < 0 {
            let w: f64 = 0.0
            if g_root_total > 0.0 {
                w = g_node_total[i] / g_root_total
            }
            layout_node(i, x, w, 0)
            x = x + w
        }
        i = i + 1
    }
}

fn profile_line(src: str, key: str) str {
    let i = 0
    loop i < src.len {
        let start = i
        loop i < src.len {
            if ((src[i] as i32) & 255) != 10 {
                i = i + 1
            } else {
                break
            }
        }
        let line = substr(src, start, i - start)
        let prefix = key + ":"
        if starts_with(line, prefix) {
            return trim_left(substr(line, prefix.len, line.len - prefix.len))
        }
        if i < src.len {
            i = i + 1
        }
    }
    return ""
}

fn read_file(path: str) str {
    let fd = open(path, "rb")
    if fd == 0 {
        return ""
    }
    let data = read(fd)
    close(fd)
    return data
}

fn clear_profile() {
    g_raw = ""
    g_format = ""
    g_elapsed = ""
    g_argv = ""
    g_ffi_calls = ""
    g_ffi_ms = ""
    g_ffi_pct = ""
    g_scope_calls = ""
    g_scope_self = ""
    g_timeline_events = ""
    g_flame_frames = ""
    g_node_count = 0
    g_hot_count = 0
    g_ev_count = 0
    g_time_end = 0.0
    g_zoom = -1
}

fn load_profile(path: str) {
    let data = read_file(path)
    if data.len == 0 {
        clear_profile()
        g_path = path
        g_status = "Failed to read profile."
    } else {
        g_path = path
        g_raw = data
        g_format = profile_line(data, "format")
        g_elapsed = profile_line(data, "elapsed_ms")
        g_argv = profile_line(data, "argv")
        g_ffi_calls = profile_line(data, "ffi_calls")
        g_ffi_ms = profile_line(data, "ffi_ms")
        g_ffi_pct = profile_line(data, "ffi_pct")
        g_scope_calls = profile_line(data, "scope_calls")
        g_scope_self = profile_line(data, "scope_self_ms")
        g_timeline_events = profile_line(data, "timeline_events")
        g_flame_frames = profile_line(data, "flame_frames")
        parse_profile_body(data)
        layout_flame()
        if format_known(g_format) {
            g_status = "Profile loaded."
        } else {
            g_status = "Loaded file is not an ns-profile."
        }
        g_scroll = 0.0
        if g_node_count > 0 {
            g_mode = 0
        } else {
            g_mode = 1
        }
    }
}

fn open_profile() {
    let path = os_open_file_dialog("Open ns.profile")
    if path.len == 0 {
        g_status = "No profile selected."
    } else {
        load_profile(path)
    }
}

fn draw_button(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64, label: str, accent: bool) bool {
    let bg = col_panel_hi()
    let fg = col_text()
    if accent {
        bg = col_accent()
        fg = col_bg()
    }
    if hit(v, x, y, w, h) {
        if accent == false {
            bg = ui_pack_color("#2b3c48")
        }
    }
    ui_fill_rect(r, x, y, w, h, bg, 0.0)
    let tw = ui_text_width(r, label, 10.0, FONT_MONO())
    let tx = x + (w - tw) * 0.5
    let ty = ui_text_v_center_y(r, y, h, 10.0, FONT_MONO())
    ui_draw_text(r, tx, ty, label, 10.0, fg, FONT_MONO())
    if g_frame_count > 2 {
        if v.mouse_pressed {
            if hit(v, x, y, w, h) {
                return true
            }
        }
    }
    return false
}

fn draw_metric(r: ref ui_renderer, x: f64, y: f64, w: f64, label: str, value: str, color: u32) {
    ui_fill_rect(r, x, y, w, 60.0, col_panel(), 0.0)
    ui_draw_text(r, x + 10.0, y + 10.0, label, 10.0, col_muted(), FONT_MONO())
    ui_push_clip(r, x + 10.0, y + 30.0, w - 20.0, 20.0)
    ui_draw_text(r, x + 10.0, y + 30.0, value, 20.0, color, FONT_MONO())
    ui_pop_clip(r)
}

fn fmt_or_dash(s: str) str {
    if s == "" {
        return "-"
    }
    return s
}

fn draw_hot_list(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    ui_draw_text(r, x + 10.0, y + 10.0, "hot self time", 10.0, col_muted(), FONT_MONO())
    if g_hot_count == 0 {
        ui_draw_text(r, x + 10.0, y + 40.0, "No fn table in this profile.", 10.0, col_muted(), FONT_MONO())
        return
    }
    let elapsed = parse_f64(g_elapsed)
    if elapsed <= 0.0 {
        elapsed = 1.0
    }
    let row_h = 20.0
    let i = 0
    loop i < g_hot_count {
        let ry = y + 30.0 + i as f64 * row_h
        if ry + row_h > y + h {
            break
        }
        let pct = g_hot_self[i] / elapsed
        let bar_w = max_f(2.0, (w - 20.0) * pct)
        ui_fill_rect(r, x + 10.0, ry + 14.0, bar_w, 4.0, name_color(g_hot_name[i]), 0.0)
        ui_push_clip(r, x + 10.0, ry, w - 20.0, 14.0)
        ui_draw_text(r, x + 10.0, ry, g_hot_name[i], 10.0, col_text(), FONT_MONO())
        ui_pop_clip(r)
        i = i + 1
    }
}

fn node_visible(node: i32) bool {
    if g_zoom < 0 {
        return true
    }
    let i = node
    loop i >= 0 {
        if i == g_zoom {
            return true
        }
        i = g_node_parent[i]
    }
    return false
}

fn draw_flamegraph(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_node_count == 0 {
        ui_draw_text(r, x + 10.0, y + 20.0, "No flame stacks in this profile.", 10.0, col_muted(), FONT_MONO())
        ui_draw_text(r, x + 10.0, y + 40.0, "Run `ns profile` to generate ns-profile-v4.", 10.0, col_muted(), FONT_MONO())
        return
    }

    let row_h = 20.0
    let plot_y = y + 10.0
    let plot_h = h - 40.0
    g_hovered = -1

    ui_push_clip(r, x, plot_y, w, plot_h)
    let i = 0
    loop i < g_node_count {
        if node_visible(i) {
            if g_node_w[i] > 0.0 {
                let bx = x + g_node_x[i] * w
                let bw = max_f(1.0, g_node_w[i] * w)
                let by = plot_y + g_node_depth[i] as f64 * row_h
                let bh = row_h - 1.0
                if by + bh >= plot_y {
                    if by <= plot_y + plot_h {
                        let color = name_color(g_node_name[i])
                        if hit(v, bx, by, bw, bh) {
                            g_hovered = i
                            ui_fill_rect(r, bx, by, bw, bh, col_warn(), 0.0)
                            if v.mouse_pressed {
                                g_zoom = i
                                layout_flame()
                            }
                        } else {
                            ui_fill_rect(r, bx, by, bw, bh, color, 0.0)
                        }
                        if bw > 40.0 {
                            ui_push_clip(r, bx + 4.0, by, bw - 8.0, bh)
                            ui_draw_text(r, bx + 4.0, by + 4.0, g_node_name[i], 10.0, col_bg(), FONT_MONO())
                            ui_pop_clip(r)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    ui_pop_clip(r)

    if v.mouse_right_pressed {
        if hit(v, x, y, w, h) {
            g_zoom = -1
            layout_flame()
        }
    }

    ui_fill_rect(r, x, y + h - 30.0, w, 1.0, col_line(), 0.0)
    if g_hovered >= 0 {
        let detail = `{g_node_name[g_hovered]}  total {g_node_total[g_hovered]} ms  self {g_node_self[g_hovered]} ms`
        ui_draw_text(r, x + 10.0, y + h - 20.0, detail, 10.0, col_text(), FONT_MONO())
    } else {
        ui_draw_text(r, x + 10.0, y + h - 20.0, "click a frame to zoom, right-click to reset", 10.0, col_muted(), FONT_MONO())
    }
}

fn draw_timeline(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    ui_fill_rect(r, x, y, w, h, col_panel(), 0.0)
    if g_ev_count == 0 {
        ui_draw_text(r, x + 10.0, y + 20.0, "No timeline events in this profile.", 10.0, col_muted(), FONT_MONO())
        return
    }

    let end_ms = g_time_end
    if end_ms <= 0.0 {
        end_ms = parse_f64(g_elapsed)
    }
    if end_ms <= 0.0 {
        end_ms = 1.0
    }

    let row_h = 20.0
    let plot_y = y + 10.0
    let plot_h = h - 40.0
    let scale = w / end_ms
    let max_depth = 0
    let i = 0
    loop i < g_ev_count {
        if g_ev_depth[i] > max_depth {
            max_depth = g_ev_depth[i]
        }
        i = i + 1
    }

    if hit(v, x, plot_y, w, plot_h) {
        g_scroll = g_scroll - v.scroll_y * 20.0
        let max_scroll = max_f(0.0, (max_depth + 1) as f64 * row_h - plot_h)
        if g_scroll < 0.0 {
            g_scroll = 0.0
        }
        if g_scroll > max_scroll {
            g_scroll = max_scroll
        }
    }

    let hovered = -1
    ui_push_clip(r, x, plot_y, w, plot_h)
    i = 0
    loop i < g_ev_count {
        let by = plot_y + g_ev_depth[i] as f64 * row_h - g_scroll
        if by + row_h >= plot_y {
            if by <= plot_y + plot_h {
                let bx = x + g_ev_start[i] * scale
                let bw = max_f(1.0, g_ev_duration[i] * scale)
                let bh = row_h - 2.0
                let color = name_color(g_ev_name[i])
                if hit(v, bx, by, bw, bh) {
                    hovered = i
                    ui_fill_rect(r, bx, by, bw, bh, col_warn(), 0.0)
                } else {
                    ui_fill_rect(r, bx, by, bw, bh, color, 0.0)
                }
                if bw > 40.0 {
                    ui_push_clip(r, bx + 4.0, by, bw - 8.0, bh)
                    ui_draw_text(r, bx + 4.0, by + 4.0, g_ev_name[i], 10.0, col_bg(), FONT_MONO())
                    ui_pop_clip(r)
                }
            }
        }
        i = i + 1
    }
    ui_pop_clip(r)

    ui_fill_rect(r, x, y + h - 30.0, w, 1.0, col_line(), 0.0)
    if hovered >= 0 {
        let detail = `{g_ev_name[hovered]}  start {g_ev_start[hovered]} ms  dur {g_ev_duration[hovered]} ms`
        ui_draw_text(r, x + 10.0, y + h - 20.0, detail, 10.0, col_text(), FONT_MONO())
    } else {
        ui_draw_text(r, x + 10.0, y + h - 20.0, fmt_or_dash(g_timeline_events) + " timeline events", 10.0, col_muted(), FONT_MONO())
    }
}

fn draw_profile(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64) {
    let elapsed_text = g_elapsed
    if elapsed_text == "" {
        elapsed_text = "-"
    } else {
        elapsed_text = elapsed_text + " ms"
    }

    let metric_w = (w - 30.0) / 4.0
    draw_metric(r, x, y, metric_w, "ELAPSED", elapsed_text, col_accent())
    draw_metric(r, x + metric_w + 10.0, y, metric_w, "VM SCOPES", fmt_or_dash(g_scope_calls), col_text())
    draw_metric(r, x + (metric_w + 10.0) * 2.0, y, metric_w, "FLAME STACKS", fmt_or_dash(g_flame_frames), col_warn())
    draw_metric(r, x + (metric_w + 10.0) * 3.0, y, metric_w, "FFI CALLS", fmt_or_dash(g_ffi_calls), col_text())

    let body_y = y + 70.0
    let body_h = h - 70.0
    let side_w = min_f(280.0, w * 0.28)
    let chart_w = w - side_w - 10.0
    if body_h > 80.0 {
        if g_mode == 0 {
            draw_flamegraph(r, v, x, body_y, chart_w, body_h)
        } else {
            draw_timeline(r, v, x, body_y, chart_w, body_h)
        }
        draw_hot_list(r, v, x + chart_w + 10.0, body_y, side_w, body_h)
    }
}

fn render_frame(r: ref ui_renderer, v: ref view) {
    ui_resize(r)

    let w = v.width as f64
    let h = v.height as f64

    ui_fill_rect(r, 0.0, 0.0, w, h, col_bg(), 0.0)

    let pad = 20.0
    let header_h = 70.0
    ui_fill_rect(r, 0.0, 0.0, w, header_h, col_panel(), 0.0)
    ui_draw_text(r, pad, 10.0, "NS Profile", 20.0, col_text(), FONT_MONO())
    ui_draw_text(r, pad, 40.0, g_status, 10.0, col_muted(), FONT_MONO())

    let open_w = 120.0
    let load_w = 140.0
    let mode_w = 90.0
    let by = 20.0
    let open_x = w - pad - open_w
    let load_x = open_x - load_w - 10.0
    let time_x = load_x - mode_w - 10.0
    let flame_x = time_x - mode_w - 10.0
    if draw_button(r, v, flame_x, by, mode_w, 30.0, "Flame", g_mode == 0) {
        g_mode = 0
    }
    if draw_button(r, v, time_x, by, mode_w, 30.0, "Time", g_mode == 1) {
        g_mode = 1
    }
    if draw_button(r, v, load_x, by, load_w, 30.0, "Load ns.profile", false) {
        g_load_profile_pending = true
    }
    if draw_button(r, v, open_x, by, open_w, 30.0, "Open Profile", true) {
        g_open_profile_pending = true
    }

    ui_fill_rect(r, 0.0, header_h, w, 1.0, col_line(), 0.0)

    let body_x = pad
    let body_y = header_h + 20.0
    let body_w = w - pad * 2.0
    let body_h = h - body_y - pad

    if body_w > 100.0 {
        if body_h > 100.0 {
            if g_raw.len == 0 {
                let cy = body_y + min_f(90.0, body_h * 0.3)
                ui_draw_text(r, body_x, cy, "No profile loaded", 20.0, col_text(), FONT_MONO())
                ui_draw_text(r, body_x, cy + 30.0, "Run `ns profile` then open ns.profile, or load ./ns.profile.", 10.0, col_muted(), FONT_MONO())
                if g_status == "Loaded file is not an ns-profile." {
                    ui_draw_text(r, body_x, cy + 50.0, g_status, 10.0, col_warn(), FONT_MONO())
                }
            } else {
                draw_profile(r, v, body_x, body_y, body_w, body_h)
            }
        }
    }
    g_frame_count = g_frame_count + 1
}

fn main() {
    let v = view_create("NS Profile", 1100, 700)
    reset_view_input(v)
    let startup = os_env("NS_PROFILE_FILE")
    let ok = gpu_request_device(v)
    if ok {
        let r = ui_renderer_create(v)
        if startup.len > 0 {
            load_profile(startup)
        } else {
            let local = read_file("ns.profile")
            if local.len > 0 {
                load_profile("ns.profile")
            }
        }
        v.on_frame({ fv in
            ui_begin_frame(r)
            render_frame(r, fv)
            ui_flush(r, clear_color())
            reset_view_input(fv)
            if g_load_profile_pending {
                g_load_profile_pending = false
                load_profile("ns.profile")
            }
            if g_open_profile_pending {
                g_open_profile_pending = false
                open_profile()
            }
        })
        v.on_terminate({ dv in
            ui_renderer_destroy(r)
        })
    } else {
        print("no GPU backend on this platform; profile viewer is unavailable\n")
        print("open ns.profile.json in https://ui.perfetto.dev\n")
    }
    view_run(v)
}
