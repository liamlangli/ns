// nscode/profile/live.ns
// ---------------------------------------------------------------------------
// Live capture session: the loopback listener, the profiled child process, the
// wire protocol, and the 128-frame ring. Everything here is rendering-agnostic
// and headless-testable (nscode/profile/test/live_test.ns); main.ns owns the
// decoding into the shared event arrays and every pixel drawn from them.
//
// `ns profiler --live [path]` starts the viewer with NS_PROFILE_LIVE=1 plus the
// project to measure. The viewer owns the listener and starts
// `ns profile --live-port <port>` itself, so Run / Restart / Stop stay in the
// viewer window. The target publishes one message per frame; the ring here
// mirrors the ring the runtime retains, so the last 128 frames stay scrubbable
// while capture keeps running.

use std
use os
use net

fn LIVE_FRAMES() i32 { return 128 }
fn LIVE_RING_BYTES() i32 { return 16777216 }
fn LIVE_IN_MAX() i32 { return 16777216 }
fn LIVE_PORT_BASE() i32 { return 9613 }
fn LIVE_PORT_TRIES() i32 { return 16 }
// 'NSLP' little-endian.
fn LIVE_MAGIC() i32 { return 1347179342 }
fn LIVE_VERSION() i32 { return 1 }
fn LIVE_MSG_HELLO() i32 { return 1 }
fn LIVE_MSG_SYMBOLS() i32 { return 2 }
fn LIVE_MSG_THREADS() i32 { return 3 }
fn LIVE_MSG_FRAME() i32 { return 4 }
fn LIVE_MSG_BYE() i32 { return 5 }
fn LIVE_CMD_PAUSE() i32 { return 20 }
fn LIVE_CMD_RESUME() i32 { return 21 }
fn LIVE_CMD_QUIT() i32 { return 22 }
fn LIVE_CMD_REPLAY() i32 { return 23 }
fn LIVE_EVENT_SIZE() i32 { return 20 }
fn LIVE_STACK_LANES() i32 { return 64 }
fn LIVE_STACK_DEPTH() i32 { return 64 }
// A frame at or above this many milliseconds is drawn as a spike in the strip.
fn LIVE_BUDGET_MS() f64 { return 16.7 }

let g_live_enabled = false
let g_live_port = 0
let g_live_server = -1
let g_live_client = -1
let g_live_pid = 0
let g_live_exe = ""
let g_live_project = ""
let g_live_entry = ""
let g_live_title = ""
let g_live_hello = false
// Bumped whenever a session ends. Message handling checks it so a stream that
// turns out to be unreadable stops parsing mid-buffer.
let g_live_session = 0
let g_live_paused = false
let g_live_follow = true
let g_live_window = false
let g_live_ended = false
let g_live_stopping = false
let g_live_note = "Live capture idle."
let g_live_msg_frames = 0
let g_live_last_index = -1
let g_live_gaps = 0
let g_live_sel_index = -1
let g_live_dirty = false

// Reassembly buffer for the target stream.
let g_live_in = [u8](262144)
let g_live_in_len = 0
// Command scratch: one 8-byte header, no payload.
let g_live_cmd = [u8](8)
// Symbol and lane tables exactly as the target published them. The viewer maps
// these into its own string pool and lanes once per new entry.
let g_live_sym_label = [str](256)
let g_live_sym_count = 0
let g_live_thread_name = [str](256)
let g_live_thread_count = 0

// Frame ring. Event payloads are kept encoded in one byte ring; only the frame
// on screen is decoded into the shared event arrays.
let g_lf_buf = [u8](16)
let g_lf_off = [i32](128)
let g_lf_len = [i32](128)
let g_lf_events = [i32](128)
let g_lf_index = [i32](128)
let g_lf_start = [f64](128)
let g_lf_end = [f64](128)
let g_lf_tail = 0
let g_lf_count = 0
let g_lf_write = 0

fn live_frames_retained() i32 {
    return g_lf_count
}

fn live_slot_at(order: i32) i32 {
    return (g_lf_tail + order) % LIVE_FRAMES()
}

fn live_newest_slot() i32 {
    if g_lf_count <= 0 {
        return -1
    }
    return live_slot_at(g_lf_count - 1)
}

fn live_slot_of_index(index: i32) i32 {
    let i = 0
    loop i < g_lf_count {
        let slot = live_slot_at(i)
        if g_lf_index[slot] == index {
            return slot
        }
        i = i + 1
    }
    return -1
}

fn live_selected_slot() i32 {
    if g_live_sel_index >= 0 {
        let pinned = live_slot_of_index(g_live_sel_index)
        if pinned >= 0 {
            return pinned
        }
    }
    return live_newest_slot()
}

// ---------------------------------------------------------------------------
// stream buffers

fn ensure_live_in_capacity(need: i32) bool {
    if need <= g_live_in.len {
        return true
    }
    if need > LIVE_IN_MAX() {
        return false
    }
    let next = g_live_in.len
    if next < 262144 {
        next = 262144
    }
    loop next < need {
        next = next * 2
        if next >= LIVE_IN_MAX() {
            next = LIVE_IN_MAX()
            break
        }
    }
    if need > next {
        return false
    }
    let grown = [u8](next)
    let i = 0
    loop i < g_live_in_len {
        grown[i] = g_live_in[i]
        i = i + 1
    }
    g_live_in = grown
    return true
}

fn ensure_live_ring() {
    if g_lf_buf.len >= LIVE_RING_BYTES() {
        return
    }
    g_lf_buf = [u8](LIVE_RING_BYTES())
    g_lf_tail = 0
    g_lf_count = 0
    g_lf_write = 0
}

fn live_reset_stream() {
    g_live_in_len = 0
    g_live_hello = false
    g_live_sym_count = 0
    g_live_thread_count = 0
    g_lf_tail = 0
    g_lf_count = 0
    g_lf_write = 0
    g_live_last_index = -1
    g_live_sel_index = -1
    g_live_msg_frames = 0
    g_live_gaps = 0
    g_live_ended = false
    g_live_stopping = false
    g_live_paused = false
    g_live_follow = true
}

// ---------------------------------------------------------------------------
// listener and target process

fn live_listen() bool {
    if g_live_server >= 0 {
        return true
    }
    let attempt = 0
    loop attempt < LIVE_PORT_TRIES() {
        let port = LIVE_PORT_BASE() + attempt
        let fd = net_tcp_listen_local(port)
        if fd >= 0 {
            net_set_nonblocking(fd, true)
            g_live_server = fd
            g_live_port = port
            return true
        }
        attempt = attempt + 1
    }
    g_live_note = "No free loopback port for live capture."
    return false
}

fn live_close_client() {
    if g_live_client >= 0 {
        net_close(g_live_client)
    }
    g_live_client = -1
    g_live_hello = false
    g_live_in_len = 0
    g_live_session = g_live_session + 1
}

fn live_send_command(cmd: i32) {
    if g_live_client < 0 {
        return
    }
    g_live_cmd[0] = (cmd & 255) as u8
    g_live_cmd[1] = ((cmd >> 8) & 255) as u8
    g_live_cmd[2] = 0 as u8
    g_live_cmd[3] = 0 as u8
    g_live_cmd[4] = 0 as u8
    g_live_cmd[5] = 0 as u8
    g_live_cmd[6] = 0 as u8
    g_live_cmd[7] = 0 as u8
    net_send_bytes(g_live_client, g_live_cmd, 8)
}

fn live_target_running() bool {
    if g_live_pid <= 0 {
        return false
    }
    return os_process_alive(g_live_pid) == 1
}

fn live_run_target() {
    if live_listen() == false {
        return
    }
    if g_live_exe.len == 0 {
        g_live_note = "No ns executable; start with `ns profiler --live`."
        return
    }
    if live_target_running() {
        live_stop_target()
    }
    live_close_client()
    live_reset_stream()
    ensure_live_ring()
    let pid = os_launch_ns_profile(g_live_exe, g_live_project, g_live_entry, g_live_port)
    if pid <= 0 {
        g_live_pid = 0
        g_live_note = "Failed to start the profiled process."
        return
    }
    g_live_pid = pid
    g_live_note = `Waiting for the target on port {g_live_port}...`
}

// Ask the target to quit. It writes its own bin/ns.profile on the way out, so a
// live session still leaves a report behind. A second call - or a target that
// is not listening any more - stops the process outright.
fn live_stop_target() {
    if g_live_stopping == false {
        if g_live_client >= 0 {
            live_send_command(LIVE_CMD_QUIT())
            g_live_stopping = true
            g_live_note = "Asked the target to stop."
            return
        }
    }
    live_force_stop()
}

fn live_force_stop() {
    if g_live_pid > 0 {
        if os_process_alive(g_live_pid) == 1 {
            os_process_stop(g_live_pid)
        }
    }
    g_live_pid = 0
    g_live_stopping = false
    g_live_note = "Target stopped."
}

// A replay refills the window from the target's own ring, so drop what is here
// first and let every frame land again.
fn live_clear_frames() {
    g_lf_tail = 0
    g_lf_count = 0
    g_lf_write = 0
    g_live_last_index = -1
    g_live_sel_index = -1
    g_live_gaps = 0
}

// ---------------------------------------------------------------------------
// message decoding

fn ensure_live_sym_capacity(need: i32) {
    if need <= g_live_sym_label.len {
        return
    }
    if need > 65536 {
        return
    }
    let next = g_live_sym_label.len
    if next < 256 {
        next = 256
    }
    loop next < need {
        next = next * 2
    }
    let grown = [str](next)
    let i = 0
    loop i < g_live_sym_count {
        grown[i] = g_live_sym_label[i]
        i = i + 1
    }
    g_live_sym_label = grown
}

// Symbol ids are dense and stable for the whole session, so the table only ever
// grows. The viewer publishes new entries into its string pool from here.
fn live_put_symbol(id: i32, label: str) {
    if id < 0 {
        return
    }
    if id >= 65536 {
        return
    }
    ensure_live_sym_capacity(id + 1)
    if id >= g_live_sym_label.len {
        return
    }
    g_live_sym_label[id] = label
    if id + 1 > g_live_sym_count {
        g_live_sym_count = id + 1
    }
}

fn live_symbol(id: i32) str {
    if id < 0 {
        return "?"
    }
    if id >= g_live_sym_count {
        return "?"
    }
    return g_live_sym_label[id]
}

fn live_put_thread(id: i32, name: str) {
    if id < 0 {
        return
    }
    if id >= g_live_thread_name.len {
        return
    }
    g_live_thread_name[id] = name
    if id + 1 > g_live_thread_count {
        g_live_thread_count = id + 1
    }
}

fn live_thread(id: i32) str {
    if id < 0 {
        return "main"
    }
    if id >= g_live_thread_count {
        return "main"
    }
    return g_live_thread_name[id]
}

fn live_read_symbols(off: i32, len: i32) {
    if len < 8 {
        return
    }
    let first = read_u32_le(g_live_in, off)
    let count = read_u32_le(g_live_in, off + 4)
    let pos = off + 8
    let limit = off + len
    let i = 0
    loop i < count {
        if pos + 5 > limit {
            return
        }
        let kind = (g_live_in[pos] as i32) & 255
        let lib_len = read_u16_le(g_live_in, pos + 1)
        let name_len = read_u16_le(g_live_in, pos + 3)
        pos = pos + 5
        if pos + lib_len + name_len > limit {
            return
        }
        let lib = bytes_to_str(g_live_in, pos, lib_len)
        let name = bytes_to_str(g_live_in, pos + lib_len, name_len)
        pos = pos + lib_len + name_len
        let label = name
        if lib.len > 0 {
            label = `{lib}::{name}`
        }
        if kind == 1 {
            // ffi symbols already carry their library in the label
        }
        live_put_symbol(first + i, label)
        i = i + 1
    }
}

fn live_read_threads(off: i32, len: i32) {
    if len < 8 {
        return
    }
    let first = read_u32_le(g_live_in, off)
    let count = read_u32_le(g_live_in, off + 4)
    let pos = off + 8
    let limit = off + len
    let i = 0
    loop i < count {
        if pos + 2 > limit {
            return
        }
        let name_len = read_u16_le(g_live_in, pos)
        pos = pos + 2
        if pos + name_len > limit {
            return
        }
        let name = bytes_to_str(g_live_in, pos, name_len)
        pos = pos + name_len
        if name.len == 0 {
            name = "main"
        }
        live_put_thread(first + i, name)
        i = i + 1
    }
}

fn live_ranges_overlap(a0: i32, a_len: i32, b0: i32, b_len: i32) bool {
    if a0 + a_len <= b0 {
        return false
    }
    if b0 + b_len <= a0 {
        return false
    }
    return true
}

fn live_drop_oldest() {
    if g_lf_count <= 0 {
        return
    }
    g_lf_tail = (g_lf_tail + 1) % LIVE_FRAMES()
    g_lf_count = g_lf_count - 1
}

fn live_store_frame(index: i32, start_ms: f64, end_ms: f64, count: i32, off: i32) {
    ensure_live_ring()
    let bytes = count * LIVE_EVENT_SIZE()
    if bytes < 0 {
        return
    }
    if bytes > g_lf_buf.len {
        return
    }
    if g_lf_write + bytes > g_lf_buf.len {
        g_lf_write = 0
    }
    // Retire every frame whose payload the new one is about to overwrite, then
    // the oldest frame when all 128 slots are taken.
    loop g_lf_count > 0 {
        let oldest = g_lf_tail
        if live_ranges_overlap(g_lf_off[oldest], g_lf_len[oldest], g_lf_write, bytes) == false {
            break
        }
        live_drop_oldest()
    }
    if g_lf_count >= LIVE_FRAMES() {
        live_drop_oldest()
    }
    let slot = (g_lf_tail + g_lf_count) % LIVE_FRAMES()
    let i = 0
    loop i < bytes {
        g_lf_buf[g_lf_write + i] = g_live_in[off + i]
        i = i + 1
    }
    g_lf_off[slot] = g_lf_write
    g_lf_len[slot] = bytes
    g_lf_events[slot] = count
    g_lf_index[slot] = index
    g_lf_start[slot] = start_ms
    g_lf_end[slot] = end_ms
    g_lf_write = g_lf_write + bytes
    g_lf_count = g_lf_count + 1

    if g_live_last_index >= 0 {
        if index > g_live_last_index + 1 {
            // The target dropped frames to keep up; the index gap says so.
            g_live_gaps = g_live_gaps + (index - g_live_last_index - 1)
        }
    }
    g_live_last_index = index
    g_live_msg_frames = g_live_msg_frames + 1
    g_live_dirty = true
}

fn live_read_frame(off: i32, len: i32) {
    if len < 16 {
        return
    }
    let index = read_u32_le(g_live_in, off)
    let start_us = read_i32_le(g_live_in, off + 4)
    let end_us = read_i32_le(g_live_in, off + 8)
    let count = read_u32_le(g_live_in, off + 12)
    if count < 0 {
        return
    }
    if count * LIVE_EVENT_SIZE() > len - 16 {
        return
    }
    live_store_frame(index, us_to_ms(start_us), us_to_ms(end_us), count, off + 16)
}

fn live_handle_message(kind: i32, off: i32, len: i32) {
    if kind == LIVE_MSG_HELLO() {
        if len >= 12 {
            let version = read_u32_le(g_live_in, off)
            if version != LIVE_VERSION() {
                g_live_note = "Target speaks a different live protocol."
                live_close_client()
                return
            }
            let pid = read_u32_le(g_live_in, off + 4)
            if len >= 14 {
                let name_len = read_u16_le(g_live_in, off + 12)
                g_live_title = bytes_to_str(g_live_in, off + 14, name_len)
            }
            if g_live_pid <= 0 {
                g_live_pid = pid
            }
            g_live_note = "Capturing."
        }
        return
    }
    if kind == LIVE_MSG_SYMBOLS() {
        live_read_symbols(off, len)
        return
    }
    if kind == LIVE_MSG_THREADS() {
        live_read_threads(off, len)
        return
    }
    if kind == LIVE_MSG_FRAME() {
        live_read_frame(off, len)
        return
    }
    if kind == LIVE_MSG_BYE() {
        g_live_ended = true
        g_live_note = "Target exited."
        return
    }
}

fn live_compact_stream(pos: i32) {
    if pos <= 0 {
        return
    }
    let read = pos
    let write = 0
    loop read < g_live_in_len {
        g_live_in[write] = g_live_in[read]
        write = write + 1
        read = read + 1
    }
    g_live_in_len = write
}

fn live_parse_stream() {
    let session = g_live_session
    let pos = 0
    if g_live_hello == false {
        if g_live_in_len < 4 {
            return
        }
        if read_u32_le(g_live_in, 0) != LIVE_MAGIC() {
            g_live_note = "Unrecognised live stream."
            live_close_client()
            return
        }
        pos = 4
        g_live_hello = true
    }
    loop g_live_in_len - pos >= 8 {
        let kind = read_u32_le(g_live_in, pos)
        let len = read_u32_le(g_live_in, pos + 4)
        if len < 0 {
            g_live_note = "Corrupt live message."
            live_close_client()
            return
        }
        if len > LIVE_IN_MAX() {
            g_live_note = "Live message too large."
            live_close_client()
            return
        }
        if g_live_in_len - pos - 8 < len {
            if ensure_live_in_capacity(pos + 8 + len) == false {
                g_live_note = "Live message too large."
                live_close_client()
                return
            }
            break
        }
        live_handle_message(kind, pos + 8, len)
        if g_live_session != session {
            return
        }
        pos = pos + 8 + len
    }
    live_compact_stream(pos)
}

fn live_receive() {
    if g_live_client < 0 {
        return
    }
    let rounds = 0
    loop rounds < 64 {
        let n = net_recv_try(g_live_client)
        if n > 0 {
            if ensure_live_in_capacity(g_live_in_len + n) == false {
                g_live_note = "Live buffer exhausted."
                live_close_client()
                return
            }
            let got = net_buf_read(g_live_in, g_live_in_len, n)
            g_live_in_len = g_live_in_len + got
            rounds = rounds + 1
        } else {
            if n < 0 {
                live_close_client()
                if g_live_ended == false {
                    g_live_note = "Target disconnected."
                }
                return
            }
            break
        }
    }
    live_parse_stream()
}

fn live_accept() {
    if g_live_server < 0 {
        return
    }
    if g_live_client >= 0 {
        return
    }
    let fd = net_tcp_accept(g_live_server)
    if fd < 0 {
        return
    }
    net_set_nonblocking(fd, true)
    g_live_client = fd
    g_live_hello = false
    g_live_in_len = 0
    g_live_ended = false
    g_live_note = "Target connected."
}

// ---------------------------------------------------------------------------
// decoding the frame on screen

// ---------------------------------------------------------------------------
// little-endian readers shared by the timeline blob and the live stream

fn read_u16_le(buf: [u8], off: i32) i32 {
    let lo = (buf[off] as i32) & 255
    let hi = (buf[off + 1] as i32) & 255
    return lo + hi * 256
}

fn read_u32_le(buf: [u8], off: i32) i32 {
    let b0 = (buf[off] as i32) & 255
    let b1 = (buf[off + 1] as i32) & 255
    let b2 = (buf[off + 2] as i32) & 255
    let b3 = (buf[off + 3] as i32) & 255
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn read_i32_le(buf: [u8], off: i32) i32 {
    return read_u32_le(buf, off)
}

fn us_to_ms(us: i32) f64 {
    return us as f64 * 0.001
}

fn bytes_to_str(buf: [u8], off: i32, len: i32) str {
    if len <= 0 {
        return ""
    }
    // Cap to keep a corrupt length from O(n^2)-strcating into gigabytes.
    // Native heap never frees, so quadratic strcat is fatal.
    if len > 512 {
        len = 512
    }
    if off < 0 {
        return ""
    }
    if off + len > buf.len {
        return ""
    }
    // Build in 16-byte chunks so strcat count is O(len/16), not O(len).
    let alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    let out = ""
    let chunk = ""
    let i = 0
    loop i < len {
        let c = (buf[off + i] as i32) & 255
        if c >= 32 {
            if c <= 126 {
                chunk = chunk + substr(alphabet, c - 32, 1)
            }
        }
        i = i + 1
        if chunk.len >= 16 {
            out = out + chunk
            chunk = ""
        }
    }
    if chunk.len > 0 {
        out = out + chunk
    }
    return out
}

// Leave the target running only if it is not ours: a viewer that started the
// process owns it, and an orphaned profiled app would keep the port busy.
fn live_shutdown() {
    if g_live_enabled == false {
        return
    }
    if g_live_pid > 0 {
        live_force_stop()
    }
    live_close_client()
    if g_live_server >= 0 {
        net_close(g_live_server)
        g_live_server = -1
    }
}

fn live_start() {
    g_live_enabled = true
    g_live_exe = os_env("NS_PROFILE_NS")
    g_live_project = os_env("NS_PROFILE_PROJECT")
    g_live_entry = os_env("NS_PROFILE_ENTRY")
    if g_live_project.len == 0 {
        g_live_project = os_cwd()
    }
    ensure_live_ring()
    if live_listen() {
        g_live_note = `Listening on 127.0.0.1:{g_live_port}.`
        live_run_target()
    }
}
