// Two fingers on the map act as one pointer at their centroid, and a finger
// landing or lifting is reported so a drag restarts instead of jumping.
use std
use view

fn main() {
    assert lens_touch_apply(VIEW_INPUT_PHASE_BEGAN, 7, 100.0, 200.0)
    assert g_lens_touch_count == 1
    assert lens_touch_center_x() == 100.0
    assert !lens_touch_apply(VIEW_INPUT_PHASE_MOVED, 7, 110.0, 200.0)
    assert lens_touch_apply(VIEW_INPUT_PHASE_BEGAN, 9, 210.0, 300.0)
    assert g_lens_touch_count == 2
    assert lens_touch_center_x() == 160.0
    assert lens_touch_center_y() == 250.0
    // A slow, symmetric pinch keeps the centroid still.
    assert !lens_touch_apply(VIEW_INPUT_PHASE_MOVED, 7, 105.0, 195.0)
    assert !lens_touch_apply(VIEW_INPUT_PHASE_MOVED, 9, 215.0, 305.0)
    assert lens_touch_center_x() == 160.0
    assert lens_touch_center_y() == 250.0
    // Lifting one finger hands the pointer to the other.
    assert lens_touch_apply(VIEW_INPUT_PHASE_ENDED, 7, 105.0, 195.0)
    assert g_lens_touch_count == 1
    assert lens_touch_center_x() == 215.0
    assert !lens_touch_apply(VIEW_INPUT_PHASE_ENDED, 7, 0.0, 0.0)
    assert lens_touch_apply(VIEW_INPUT_PHASE_CANCELLED, 9, 215.0, 305.0)
    assert g_lens_touch_count == 0
    // A short, still tap counts; a drag, a slow press or a pinch does not.
    lens_tap_begin(50.0, 60.0, 1.0)
    assert !lens_tap_step(53.0, 62.0, 1.05, true, false)
    assert lens_tap_step(54.0, 63.0, 1.1, false, false)
    assert !lens_tap_step(54.0, 63.0, 1.2, false, false)
    lens_tap_begin(50.0, 60.0, 2.0)
    assert !lens_tap_step(80.0, 60.0, 2.05, true, false)
    assert !lens_tap_step(50.0, 60.0, 2.1, false, false)
    lens_tap_begin(50.0, 60.0, 3.0)
    assert !lens_tap_step(50.0, 60.0, 3.8, false, false)
    lens_tap_begin(50.0, 60.0, 4.0)
    assert !lens_tap_step(50.0, 60.0, 4.05, true, true)
    assert !lens_tap_step(50.0, 60.0, 4.1, false, false)
    // A pinch queued whole in one idle frame still marks the gesture, so its
    // lift is no tap.
    g_lens_touch_multi = false
    g_lens_multi_end = -1.0
    lens_touch_event(VIEW_INPUT_PHASE_BEGAN, 1, 100.0, 100.0, 5.0)
    lens_touch_event(VIEW_INPUT_PHASE_BEGAN, 2, 104.0, 100.0, 5.0)
    lens_touch_event(VIEW_INPUT_PHASE_ENDED, 1, 100.0, 100.0, 5.0)
    lens_touch_event(VIEW_INPUT_PHASE_ENDED, 2, 104.0, 100.0, 5.0)
    assert g_lens_touch_count == 0
    assert g_lens_touch_multi
    assert !lens_tap_step(102.0, 100.0, 5.05, false, g_lens_touch_multi)
    // A finger landing just after the pinch lifted is its straggler; one
    // landing later is a tap again.
    g_lens_touch_multi = false
    g_lens_multi_end = 5.05
    lens_touch_event(VIEW_INPUT_PHASE_BEGAN, 3, 100.0, 100.0, 5.2)
    lens_touch_event(VIEW_INPUT_PHASE_ENDED, 3, 100.0, 100.0, 5.25)
    assert !lens_tap_step(100.0, 100.0, 5.25, false, false)
    lens_touch_event(VIEW_INPUT_PHASE_BEGAN, 4, 100.0, 100.0, 6.0)
    lens_touch_event(VIEW_INPUT_PHASE_ENDED, 4, 100.0, 100.0, 6.05)
    assert lens_tap_step(100.0, 100.0, 6.05, false, false)
    // Three fingers tilt the map by their vertical travel; two do not, and a
    // finger joining restarts the drag instead of jumping.
    g_lens_tilt = 0.0
    g_lens_touch_tilt = false
    lens_touch_tilt_step(2, 100.0, false)
    lens_touch_tilt_step(2, 140.0, false)
    assert g_lens_tilt == 0.0 && !g_lens_touch_tilt
    lens_touch_tilt_step(3, 300.0, true)
    assert g_lens_touch_tilt && g_lens_tilt == 0.0
    lens_touch_tilt_step(3, 340.0, false)
    assert g_lens_tilt == 10.0
    lens_touch_tilt_step(3, 220.0, false)
    assert g_lens_tilt == -20.0
    lens_touch_tilt_step(2, 100.0, true)
    assert g_lens_tilt == -20.0
    g_lens_touch_tilt = false
    g_lens_tilt = 0.0
    // A trackpad's turn spins the map at once. Fingers on the screen spin
    // it only past LENS_SPIN_ENGAGE, then with the whole turn so far.
    g_lens_touch_held = false
    assert lens_touch_turn(0.0625) == 0.0625
    g_lens_touch_held = true
    g_lens_touch_turned = 0.0
    g_lens_touch_spin = false
    assert lens_touch_turn(0.125) == 0.0
    assert lens_touch_turn(-0.0625) == 0.0
    assert lens_touch_turn(0.125) == 0.1875
    assert g_lens_touch_spin
    assert lens_touch_turn(-0.0625) == -0.0625
    g_lens_touch_held = false
    g_lens_touch_turned = 0.0
    g_lens_touch_spin = false
    // Three trackpad fingers hold off the left drag until the button lifts.
    // A four-finger tap toggles and undoes the tilt it passed through; a
    // smaller tap does not.
    g_lens_tilt = 0.0
    g_lens_spin = 0.0
    assert !lens_pad_step(3, 0, true)
    assert g_lens_pad_many
    g_lens_tilt = 12.0
    assert !lens_pad_step(0, 0, true)
    assert g_lens_pad_many
    assert !lens_pad_step(0, 0, false)
    assert !g_lens_pad_many
    assert !lens_pad_step(4, 0, false)
    g_lens_tilt = 20.0
    assert lens_pad_step(0, 4, false)
    assert g_lens_tilt == 12.0
    assert !lens_pad_step(0, 3, false)
    // A tap over between two frames changes nothing it must undo.
    g_lens_tilt = 7.0
    assert lens_pad_step(0, 4, false)
    assert g_lens_tilt == 7.0
    g_lens_tilt = 0.0

    // Only a tap on the code brings the folded keyboard back.
    g_mobile_keyboard_hidden = true
    g_lens_touch_tap = false
    lens_touch_tap_code()
    assert g_mobile_keyboard_hidden
    g_lens_touch_tap = true
    lens_touch_tap_code()
    assert !g_mobile_keyboard_hidden
    g_lens_touch_tap = false
    print("touch_test: passed\n")
}
