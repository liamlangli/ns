fn main() {
    g_lens_poll_time = -1.0
    assert lens_poll_due(10.0, true)
    assert lens_poll_due(10.0, false)
    g_lens_poll_time = 10.0
    g_lens_frame_active = true
    assert lens_poll_due(10.05, true) == false
    assert lens_poll_due(10.2, true)
    assert lens_poll_due(10.9, false) == false
    assert lens_poll_due(11.1, false)
    assert lens_poll_due(9.0, true)
    g_lens_frame_active = false
    assert lens_poll_due(10.01, true)
    assert lens_poll_due(10.01, false) == false
    g_lens_frame_time = -1.0
    assert lens_frame_due(10.0, true, false, false)
    assert lens_frame_due(10.0, false, true, true) == false
    g_lens_frame_time = 10.0
    g_lens_frame_active = true
    g_lens_frame_delay = LENS_IDLE_POLL_MS
    g_lens_generation = g_workspace_generation
    g_lens_input_dirty = false
    assert lens_frame_due(10.1, true, false, false) == false
    assert lens_frame_due(11.0, true, false, false)
    assert lens_frame_due(10.1, true, true, false)
    assert lens_frame_due(10.1, true, false, true)
    g_lens_input_dirty = true
    assert lens_frame_due(10.1, true, false, false)
    assert lens_frame_due(11.0, false, false, false) == false
    g_lens_input_dirty = false
    g_lens_frame_active = false
    assert lens_frame_due(10.1, true, false, false)
    g_lens_frame_active = true
    g_lens_frame_delay = 16
    assert lens_frame_due(10.008, true, false, false) == false
    assert lens_frame_due(10.020, true, false, false)
    g_lens_frame_delay = 50
    assert lens_frame_due(10.020, true, false, false) == false
    assert lens_frame_due(10.060, true, false, false)
    g_lens_frame_delay = 0
    assert lens_frame_due(10.001, true, false, false)
    assert lens_frame_due(9.0, true, false, false)
    g_workspace_generation = g_workspace_generation + 1
    g_lens_frame_delay = LENS_IDLE_POLL_MS
    assert lens_frame_due(10.1, true, false, false)
}
