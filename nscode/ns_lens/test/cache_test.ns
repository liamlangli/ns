use std
use os
use task

fn main() {
    let root = "/tmp/ns_lens_cache_test"
    g_workspace_root = root
    os_make_dirs(root)
    lens_cache_init()
    assert os_text_hash("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    let path = root + "/sample.ns"
    assert os_write_file_atomic(path, "abc") != 0
    let hash = os_file_hash(path)
    assert hash == os_text_hash("abc")
    assert os_file_hash(root + "/missing") == ""
    assert lens_read_source(path, 0 as i64, 8192) == "abc"
    let file = lens_cache_path(path, "page0-8192")
    assert lens_cache_get(file, hash, 8192) == "abc"
    assert g_lens_cache_found
    assert os_write_file_atomic(path, "abd") != 0
    assert os_file_hash(path) != hash
    assert lens_cache_get(file, os_file_hash(path), 8192) == ""
    assert g_lens_cache_found == false
    assert lens_read_source(path, 0 as i64, 8192) == "abd"
    assert os_write_file_atomic(file, "broken record") != 0
    assert lens_read_source(path, 0 as i64, 8192) == "abd"
    let good = os_read_file(file)
    assert os_write_file_atomic(file, substr(good, 0, good.len - 1) + "x") != 0
    assert lens_cache_get(file, os_file_hash(path), 8192) == ""
    assert g_lens_cache_found == false
    assert lens_read_source(path, 0 as i64, 8192) == "abd"
    assert lens_offset_key((2147483647 as i64) * 2 + 2) == "4294967296"
    assert os_write_file_atomic(path, "") != 0
    assert lens_read_source(path, 0 as i64, 8192) == ""
    assert lens_cache_get(file, os_file_hash(path), 8192) == ""
    assert g_lens_cache_found
    let empty_metrics = lens_file_metrics(path)
    assert empty_metrics.lines == 1 && empty_metrics.columns == 0
    let missing_metrics = [i64](2)
    assert !os_file_text_metrics(root + "/missing", missing_metrics)
    assert missing_metrics[0] == -1
    assert os_write_file_atomic(path, "ab\ncd") != 0
    let initial_metrics = lens_file_metrics(path)
    assert initial_metrics.lines == 2 && initial_metrics.columns == 2
    let hits = g_lens_cache_hits
    let reused_metrics = lens_file_metrics(path)
    assert reused_metrics.lines == 2
    assert g_lens_cache_hits == hits + 1
    // Same bytes, different line count: stale metrics must be replaced.
    assert os_write_file_atomic(path, "abcd\n") != 0
    let changed_metrics = lens_file_metrics(path)
    assert changed_metrics.lines == 2 && changed_metrics.columns == 4
    assert os_write_file_atomic(path, "abcde") != 0
    let one_line_metrics = lens_file_metrics(path)
    assert one_line_metrics.lines == 1
    // Count beyond the preview cap, including a newline across a read boundary.
    let large = "a"
    for n in 0 to 19 {
        large = large + large
    }
    large = large + "\nend\n"
    assert os_write_file_atomic(path, large) != 0
    let large_metrics = [i64](2)
    assert os_file_text_metrics(path, large_metrics)
    assert large_metrics[0] == 3 && large_metrics[1] == 524288
    assert os_write_file_atomic(path, "worker source") != 0
    g_workspace_streaming = true
    workspace_init()
    let index = workspace_find("sample.ns")
    assert index >= 0
    lens_rebuild()
    lens_io_start(index, 0 as i64, 8192, 0)
    let deadline = os_time() + 3.0
    loop g_lens_io_running && os_time() < deadline {
        sleep(1)
        lens_io_poll()
    }
    assert g_lens_io_running == false
    assert lens_preview(index, false) == "worker source"
    let signature = lens_layout_signature()
    lens_store_layout(signature)
    assert lens_load_layout(signature)
    assert lens_load_layout(os_text_hash("different tree")) == false
    os_watch_stop()
    print("cache_test: passed\n")
}
