// The open file's HEAD check runs on a worker: a tick only starts it, and a
// later tick adopts the revision and the file's text at HEAD.
fn check_head(base: str) {
    let root = base + "/head"
    make_repo(root)
    assert os_write_file_atomic(root + "/main.ns", "fn main() {}\n") != 0
    git(root, "add\n-A")
    git(root, "commit\n-q\n-m\nbase")
    let first = lens_one_line(git(root, "rev-parse\nHEAD"))
    assert os_write_file_atomic(root + "/main.ns", "fn main() {\n}\n") != 0
    g_workspace_streaming = true
    g_workspace_root = root
    workspace_init()
    g_lens_view_mode = LENS_MODE_CODE
    lens_rebuild()
    assert lens_open(workspace_find("main.ns"))
    lens_git_tick(false)
    g_lens_git_deadline = 0.0
    lens_git_tick(false)
    assert g_lens_head_running
    assert g_lens_git_revision == ""
    finish_head()
    assert g_lens_git_revision == first
    assert g_lens_git_base == "fn main() {}\n"
    // The diff against the buffer follows on a worker too.
    lens_git_tick(false)
    assert g_lens_edit_diff_running
    assert g_lens_git_version != g_doc_version
    finish_edit_diff()
    assert g_lens_git_version == g_doc_version
    assert g_lens_diff_deleted_count == 1 && g_lens_diff_deleted[0] == "fn main() {}"
    // A commit moves HEAD: the next check reads the new base.
    git(root, "commit\n-q\n-a\n-m\nedit")
    g_lens_git_poll = 0.0
    lens_git_tick(false)
    assert g_lens_head_running
    finish_head()
    assert g_lens_git_revision != first && g_lens_git_revision != ""
    assert g_lens_git_base == "fn main() {\n}\n"
    // An edit made while a diff runs drops that diff; the next one covers it.
    lens_git_tick(false)
    assert g_lens_edit_diff_running
    place_cursor(0, 0, false)
    paste_str("// note\n")
    finish_edit_diff()
    assert g_lens_git_version != g_doc_version
    lens_git_tick(false)
    g_lens_git_deadline = 0.0
    lens_git_tick(false)
    assert g_lens_edit_diff_running
    finish_edit_diff()
    assert g_lens_git_version == g_doc_version
    assert g_lens_diff_deleted_count == 0
    assert g_lens_diff_added[0] == 1 && g_lens_diff_added[1] == 0
}

// The editor opens a changed file with the rows its leaf already shows, even
// while the camera still moves, and a rewrite on disk brings its new rows in
// with the patch rather than with the editor's own diff.
fn check_diff_seed(base: str) {
    let root = base + "/seed"
    make_repo(root)
    assert os_write_file_atomic(root + "/main.ns", "fn main() {\n    print(\"hi\")\n}\n") != 0
    git(root, "add\n-A")
    git(root, "commit\n-q\n-m\nbase")
    assert os_write_file_atomic(root + "/main.ns", "fn main() {\n    print(\"changed\")\n}\n") != 0
    assert os_write_file_atomic(root + "/fresh.ns", "fn fresh() {}\nfn more() {}\n") != 0
    g_workspace_streaming = true
    g_workspace_root = root
    workspace_init()
    g_lens_view_mode = LENS_MODE_CODE
    lens_rebuild()
    lens_patch_tick(false)
    finish_patches()
    // The previous check leaves an unsaved buffer of another root open.
    g_lens_editing = false
    g_workspace_active = -1
    assert lens_open(workspace_find("main.ns"))
    lens_git_tick(true)
    assert g_lens_head_running == false
    assert g_lens_diff_deleted_count == 1 && g_lens_diff_deleted[0] == "    print(\"hi\")"
    assert g_lens_diff_added[1] == 1 && g_lens_diff_added[0] == 0
    // An unsaved edit leaves the rows to the editor's own diff.
    place_cursor(0, 0, false)
    paste_str("// note\n")
    lens_git_tick(true)
    assert g_lens_diff_deleted_count == 0
    load_str(g_workspace_originals[g_workspace_active])
    lens_git_tick(true)
    assert g_lens_diff_deleted_count == 1
    // A new file is added throughout.
    assert lens_open(workspace_find("fresh.ns"))
    lens_git_tick(true)
    assert g_lens_diff_added[0] == 1 && g_lens_diff_added[1] == 1 && g_lens_diff_deleted_count == 0
    // Rewritten on disk: the reload waits for fresh patches, then takes them.
    assert lens_open(workspace_find("main.ns"))
    lens_git_tick(true)
    assert os_write_file_atomic(root + "/main.ns", "fn main() {\n    print(\"hi\")\n    print(\"again\")\n}\n") != 0
    workspace_refresh_from_disk()
    lens_rebuild()
    lens_git_tick(true)
    assert g_lens_diff_deleted_count == 0
    lens_patch_tick(false)
    finish_patches()
    assert g_lens_diff_deleted_count == 0
    assert g_lens_diff_added[2] == 1 && g_lens_diff_added[1] == 0
    g_lens_editing = false
}

fn check_search_scan(base: str) {
    let root = base + "/search"
    os_make_dirs(root + "/src")
    assert os_write_file_atomic(root + "/src/alpha.ns", "fn alpha() {\n    let needle = 1\n}\n") != 0
    assert os_write_file_atomic(root + "/src/needle_file.ns", "fn other() {}\n") != 0
    g_workspace_streaming = true
    g_workspace_root = root
    workspace_init()
    lens_rebuild()
    g_lens_search_open = true
    lens_search_set_query("needle")
    finish_search()
    assert g_lens_search_done_query == "needle"
    assert g_lens_hit_count == 2
    // Name matches come first, then the matching lines.
    assert g_lens_hit_line[0] == -1
    assert lens_relative_path(os_entry_path(g_lens_hit_file[0])) == "src/needle_file.ns"
    assert g_lens_hit_line[1] == 1 && g_lens_hit_text[1] == "let needle = 1"
    assert lens_search_marked(g_lens_hit_file[0]) && lens_search_marked(g_lens_hit_file[1])
    assert lens_search_fraction() == 1.0
    // A capital letter makes the search case sensitive.
    lens_search_set_query("Needle")
    finish_search()
    assert g_lens_hit_count == 0
    // Going to a hit selects the file and closes the search.
    lens_search_set_query("needle")
    finish_search()
    lens_search_go(1)
    assert g_lens_search_open == false
    assert g_lens_selected == g_lens_hit_file[1]
    assert g_lens_target_distance > 0.0
}

// The branch menu's jobs against real repositories: create, switch, pull a
// remote branch in, and delete the current one, with the branch and the lists
// read after each.
fn check_branches(base: str) {
    let remote = base + "/branches.git"
    let work = base + "/branches"
    let other = base + "/branches_other"
    git(base, "init\n-q\n--bare\nbranches.git")
    make_repo(work)
    // The user's init.defaultBranch must not pick the name.
    git(work, "symbolic-ref\nHEAD\nrefs/heads/main")
    git(work, "remote\nadd\norigin\n" + remote)
    assert os_write_file_atomic(work + "/main.ns", "fn main() {}\n") != 0
    for step in lens_commit_steps("first") {
        git(work, step)
    }
    git(work, "push\n-q\n-u\norigin\nmain")
    g_workspace_streaming = true
    g_workspace_root = work
    workspace_init()
    g_lens_editing = false
    g_workspace_active = -1
    lens_job_start(LENS_JOB_STATUS, [str](0))
    finish_job()
    assert g_lens_branch == "main" && g_lens_branch_detached == ""
    assert g_lens_branch_local_count == 1 && g_lens_branch_locals[0] == "main"
    assert g_lens_branch_remote_count == 1 && g_lens_branch_remotes[0] == "origin/main"
    // No origin/HEAD yet: the local main is the default.
    assert g_lens_branch_default == "main"
    git(work, "remote\nset-head\norigin\nmain")
    lens_job_start(LENS_JOB_STATUS, [str](0))
    finish_job()
    assert g_lens_branch_default == "main" && g_lens_branch_remote_count == 1
    // The default branch stays.
    lens_branch_delete()
    assert g_lens_job_running == false && g_lens_message == "The default branch cannot be deleted"

    // A typed name with blanks becomes a branch with dashes, checked out.
    lens_branch_create_show()
    assert g_lens_branch_create_open
    g_lens_branch_create_name = " feature one "
    lens_branch_create_submit()
    assert g_lens_branch_create_open == false
    finish_job()
    assert g_lens_message == "created feature-one"
    assert g_lens_branch == "feature-one" && g_lens_branch_local_count == 2
    // No upstream yet: the down arrow explains, and the up arrow publishes.
    assert g_lens_sync_behind == -1 && g_lens_sync_ahead == -1
    lens_pull()
    assert g_lens_job_running == false
    assert g_lens_message == "No upstream to pull from; the up arrow publishes this branch"
    assert lens_branch_has("feature-one") && lens_branch_has("main")
    // A taken name keeps the dialog open.
    lens_branch_create_show()
    g_lens_branch_create_name = "main"
    lens_branch_create_submit()
    assert g_lens_branch_create_open && g_lens_message == "A branch named main already exists"
    g_lens_branch_create_name = "-x"
    lens_branch_create_submit()
    assert g_lens_branch_create_open && g_lens_message == "A branch name cannot start with -"
    g_lens_branch_create_name = "bad..name"
    lens_branch_create_submit()
    finish_job()
    assert substr(g_lens_message, 0, 13) == "create failed" && g_lens_branch == "feature-one"
    // Published with an upstream, so delete can drop it later.
    assert os_write_file_atomic(work + "/feature.ns", "fn feature() {}\n") != 0
    lens_commit("feature")
    finish_job()
    lens_push()
    finish_job()
    assert g_lens_message == "push done" && g_lens_sync_ahead == 0
    assert lens_branch_has_remote("origin/feature-one")

    // Switching from the menu moves the files.
    lens_branch_show()
    assert g_lens_branch_open
    finish_job()
    lens_branch_switch("main")
    assert g_lens_branch_open == false
    finish_job()
    assert g_lens_message == "switched to main" && g_lens_branch == "main"
    assert os_file_size(work + "/feature.ns") < 0
    assert g_lens_patch_wanted
    // Picking the branch already checked out does nothing.
    lens_branch_switch("main")
    assert g_lens_job_running == false

    // A branch pushed from another clone is fetched and searched for, then
    // checked out tracking it.
    git(base, "clone\n-q\n" + remote + "\nbranches_other")
    git(other, "config\nuser.name\nns_lens test")
    git(other, "config\nuser.email\nlens@example.com")
    git(other, "config\ncommit.gpgsign\nfalse")
    git(other, "switch\n-q\n-c\nremote-only\norigin/main")
    assert os_write_file_atomic(other + "/only.ns", "fn only() {}\n") != 0
    for step in lens_commit_steps("remote only") {
        git(other, step)
    }
    git(other, "push\n-q\n-u\norigin\nremote-only")
    lens_remote_show()
    assert g_lens_remote_open && lens_remote_fetching()
    finish_job()
    assert g_lens_message == "fetch done" && lens_remote_fetching() == false
    assert lens_branch_has_remote("origin/remote-only")
    g_lens_remote_query = "on"
    lens_remote_filter()
    assert g_lens_remote_hit_count == 2
    g_lens_remote_query = "remote-"
    lens_remote_filter()
    assert g_lens_remote_hit_count == 1
    lens_remote_go(0)
    assert g_lens_remote_open == false
    finish_job()
    assert g_lens_message == "switched to remote-only" && g_lens_branch == "remote-only"
    assert g_lens_sync_ahead == 0 && g_lens_sync_behind == 0
    assert os_file_size(work + "/only.ns") >= 0
    // One with a local branch already is fast-forwarded to the remote.
    git(other, "switch\n-q\n-c\nfeature-one\norigin/feature-one")
    assert os_write_file_atomic(other + "/feature.ns", "fn feature() { 2 }\n") != 0
    for step in lens_commit_steps("feature from other") {
        git(other, step)
    }
    git(other, "push\n-q")
    lens_remote_show()
    finish_job()
    g_lens_remote_query = "origin/feature-one"
    lens_remote_filter()
    assert g_lens_remote_hit_count == 1
    lens_remote_go(0)
    finish_job()
    assert g_lens_message == "switched to feature-one" && g_lens_branch == "feature-one"
    assert g_lens_sync_behind == 0
    assert lens_last_line(git(work, "log\n-1\n--format=%s")) == "feature from other"

    // Delete returns to the default branch and drops the one left.
    lens_branch_delete()
    finish_job()
    assert g_lens_message == "deleted feature-one" && g_lens_branch == "main"
    assert lens_branch_has("feature-one") == false && lens_branch_has("remote-only")
    // Git keeps a branch whose commits are nowhere else, and says why.
    g_lens_branch_create_name = "scratch"
    lens_branch_create_submit()
    finish_job()
    assert os_write_file_atomic(work + "/scratch.ns", "fn scratch() {}\n") != 0
    lens_commit("scratch")
    finish_job()
    lens_branch_delete()
    finish_job()
    assert g_lens_message == "delete failed: error: the branch 'scratch' is not fully merged"
    assert g_lens_branch == "main" && lens_branch_has("scratch")
    // Unsaved edits keep the branch where it is.
    assert lens_open(workspace_find("main.ns"))
    place_cursor(0, 0, false)
    paste_str("// note\n")
    lens_branch_switch("scratch")
    assert g_lens_job_running == false && g_lens_message == "Save edited files before switching branches"
    lens_branch_delete()
    assert g_lens_job_running == false
    load_str(g_workspace_originals[g_workspace_active])
    g_lens_editing = false
    g_workspace_active = -1
}

fn main() {
    let base = "/tmp/ns_lens_vcs_test_" + itos((os_time() * 1000.0) as i32)
    check_text_helpers()
    check_branch_helpers()
    check_search_helpers()
    check_git(base)
    check_search_scan(base)
    check_change_list(base)
    check_partial_commit(base)
    check_head(base)
    check_diff_seed(base)
    check_branches(base)
    print("vcs_test: passed\n")
}
