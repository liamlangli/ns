use std
use os
use task

fn git(folder: str, args: str) str {
    let out = os_git_run(folder, args)
    assert os_git_status() == 0
    return out
}

fn finish_job() {
    let deadline = os_time() + 20.0
    loop g_lens_job_running && os_time() < deadline {
        sleep(1)
        lens_job_poll()
    }
    assert g_lens_job_running == false
}

fn finish_search() {
    let deadline = os_time() + 20.0
    loop (g_lens_search_running || g_lens_search_query != g_lens_search_done_query) && os_time() < deadline {
        sleep(1)
        g_lens_search_edit_time = 0.0
        lens_search_tick()
    }
    assert g_lens_search_running == false
}

// A scratch repository with its own identity, so the user's global Git
// configuration (signing, hooks) cannot change the outcome.
fn make_repo(folder: str) {
    os_make_dirs(folder)
    git(folder, "init\n-q")
    git(folder, "config\nuser.name\nns_lens test")
    git(folder, "config\nuser.email\nlens@example.com")
    git(folder, "config\ncommit.gpgsign\nfalse")
    git(folder, "config\ncore.hooksPath\n/dev/null")
    git(folder, "config\nrebase.autoStash\nfalse")
}

fn check_text_helpers() {
    assert lens_one_line("fix\nthe  bug\r\n") == "fix the  bug"
    assert lens_one_line("") == ""
    assert lens_last_line("Counting\rWriting 100%\nerror: denied\n\n") == "error: denied"
    assert lens_last_line("a\rb") == "b"
    assert lens_patch_body("--- a/tmp/x1\n+++ b/tmp/x2\n@@ -1 +1 @@\n-a\n+b\n") == "@@ -1 +1 @@\n-a\n+b\n"
    assert lens_patch_body("--- a\n+++ b\n") == ""
    lens_sync_parse("3\t12\n")
    assert g_lens_sync_ahead == 3 && g_lens_sync_behind == 12
    lens_sync_parse("")
    assert g_lens_sync_ahead == -1 && g_lens_sync_behind == -1
    let steps = lens_commit_steps("one\ntwo")
    assert steps[0] == "add\n-A\n--\n."
    assert steps[1] == "commit\n-q\n-m\none two\n--\n."
    // Without a known upstream the branch is published to origin.
    assert lens_push_steps()[0] == "push\n--progress\n--set-upstream\norigin\nHEAD"
    g_lens_sync_ahead = 0
    assert lens_push_steps()[0] == "push\n--progress"
    g_lens_sync_ahead = -1
    let pull = lens_pull_steps()
    assert pull[0] == "fetch\n--progress" && pull[1] == "pull\n--rebase\n--progress"
    // The status bar's down arrow pulls and its up arrow pushes.
    g_lens_sync_y = 100.0
    g_lens_sync_down_x = 12.0
    g_lens_sync_down_w = 30.0
    g_lens_sync_up_x = 42.0
    g_lens_sync_up_w = 30.0
    assert lens_sync_button_at(20.0, 110.0) == LENS_JOB_PULL
    assert lens_sync_button_at(50.0, 110.0) == LENS_JOB_PUSH
    assert lens_sync_button_at(20.0, 90.0) == 0
    assert lens_sync_button_at(100.0, 110.0) == 0
    g_lens_sync_down_w = 0.0
    g_lens_sync_up_w = 0.0
    assert lens_sync_button_at(20.0, 110.0) == 0
}

fn check_branch_helpers() {
    // Git's explanation, not the hint after it.
    assert lens_git_error("error: the branch 'x' is not fully merged\nhint: run 'git branch -D x'\n") == "error: the branch 'x' is not fully merged"
    assert lens_git_error("hint: Diverging branches\nfatal: Not possible to fast-forward, aborting.\n") == "fatal: Not possible to fast-forward, aborting."
    assert lens_git_error("On branch main\nnothing to commit, working tree clean\n") == "nothing to commit, working tree clean"
    assert lens_git_error("") == ""
    lens_branch_apply("feature", "", "feature\nmain\n", "origin/HEAD origin/trunk\norigin/feature/x \norigin/main \n")
    assert g_lens_branch == "feature" && lens_branch_label() == "feature"
    assert g_lens_branch_local_count == 2 && g_lens_branch_locals[1] == "main"
    // A remote's HEAD is no branch to list; it names the default branch.
    assert g_lens_branch_remote_count == 2
    assert g_lens_branch_remotes[0] == "origin/feature/x" && g_lens_branch_remotes[1] == "origin/main"
    assert g_lens_branch_default == "trunk"
    let serial = g_lens_branch_serial
    lens_branch_apply("feature", "", "feature\nmain\n", "origin/HEAD origin/trunk\norigin/feature/x \norigin/main \n")
    assert g_lens_branch_serial == serial
    // Without one, main or master, local or remote.
    lens_branch_apply("feature", "", "feature\nmaster\n", "")
    assert g_lens_branch_default == "master" && g_lens_branch_serial == serial + 1
    lens_branch_apply("feature", "", "feature\n", "origin/main \n")
    assert g_lens_branch_default == "main"
    lens_branch_apply("feature", "", "feature\n", "")
    assert g_lens_branch_default == "" && lens_branch_can_delete() == false
    // A branch without a commit has no ref, yet is listed; a detached HEAD
    // shows its commit.
    lens_branch_apply("main", "", "", "")
    assert g_lens_branch_local_count == 1 && g_lens_branch_locals[0] == "main"
    lens_branch_apply("", "1a2b3c4", "main\n", "")
    assert lens_branch_label() == "1a2b3c4" && lens_branch_can_delete() == false
    lens_branch_apply("", "", "", "")
    assert lens_branch_label() == ""
    assert lens_branch_remote_name("origin/feature/x") == "feature/x"
    assert lens_branch_remote_of("origin/feature/x") == "origin"
    assert lens_branch_remote_name("plain") == "plain"
    assert lens_branch_clean("  my new\tbranch ") == "my-new-branch"
    assert lens_branch_clean("fix") == "fix"
    assert lens_branch_clean("   ") == ""
    assert lens_branch_create_steps("x")[0] == "switch\n-c\nx"
    assert lens_branch_switch_steps("main")[0] == "switch\nmain"
    let deleting = lens_branch_delete_steps("feature", "main")
    assert deleting[0] == "switch\nmain" && deleting[1] == "branch\n-d\nfeature"
    // A remote branch with a local one switches and fast-forwards it.
    lens_branch_apply("main", "", "main\nfeature\n", "origin/feature \norigin/fresh \n")
    let tracked = lens_branch_remote_steps("origin/fresh")
    assert tracked.len == 1 && tracked[0] == "switch\n--track\norigin/fresh"
    let known = lens_branch_remote_steps("origin/feature")
    assert known.len == 2 && known[0] == "switch\nfeature" && known[1] == "merge\n--ff-only\n--quiet\norigin/feature"
    // The remote search filters with smart case.
    g_lens_remote_query = ""
    lens_remote_filter()
    assert g_lens_remote_hit_count == 2
    g_lens_remote_query = "fre"
    lens_remote_filter()
    assert g_lens_remote_hit_count == 1 && g_lens_branch_remotes[g_lens_remote_hits[0]] == "origin/fresh"
    g_lens_remote_query = "Fre"
    lens_remote_filter()
    assert g_lens_remote_hit_count == 0
    g_lens_remote_query = ""
    // The button, and the menu rows above the status bar.
    g_lens_branch_y = 100.0
    g_lens_branch_x = 80.0
    g_lens_branch_w = 60.0
    assert lens_branch_button_at(90.0, 110.0)
    assert lens_branch_button_at(150.0, 110.0) == false
    assert lens_branch_button_at(90.0, 90.0) == false
    let h: f64 = 800.0
    let top = lens_branch_menu_y(h)
    assert top + lens_branch_menu_h(h) == h - STATUS_BAR_H - 2.0
    assert lens_branch_rows(h) == 2
    assert lens_branch_row_at(top + 2.0, h) == LENS_BRANCH_ROW_CREATE
    assert lens_branch_row_at(top + LENS_MODE_ITEM + 2.0, h) == LENS_BRANCH_ROW_REMOTE
    assert lens_branch_row_at(top + LENS_MODE_ITEM * 2.0 + 2.0, h) == LENS_BRANCH_ROW_NONE
    let list_y = lens_branch_list_y(h)
    assert lens_branch_row_at(list_y + 2.0, h) == 0
    assert lens_branch_row_at(list_y + LENS_MODE_ITEM + 2.0, h) == 1
    assert lens_branch_row_at(lens_branch_delete_y(h) + 2.0, h) == LENS_BRANCH_ROW_DELETE
    assert lens_branch_row_at(top - 2.0, h) == LENS_BRANCH_ROW_NONE
    // A long list scrolls, and a short window shows fewer rows.
    let many = ""
    for i in 0 to 30 {
        many = many + "b" + itos(i) + "\n"
    }
    lens_branch_apply("b0", "", many, "")
    assert lens_branch_rows(h) == LENS_BRANCH_ROWS && lens_branch_scroll_max(h) == 30 - LENS_BRANCH_ROWS
    g_lens_branch_scroll = 3
    assert lens_branch_row_at(lens_branch_list_y(h) + 2.0, h) == 3
    g_lens_branch_scroll = 0
    assert lens_branch_rows(300.0) < LENS_BRANCH_ROWS
    assert lens_branch_menu_y(300.0) >= LENS_TOP_BAR_H
    g_lens_branch_w = 0.0
    lens_branch_clear()
    assert lens_branch_label() == "" && g_lens_branch_local_count == 0
}

fn check_search_helpers() {
    assert lens_search_folds("render")
    assert lens_search_folds("Render") == false
    assert lens_search_find("let Render = 1", 0, 14, "render", true) == 4
    assert lens_search_find("let Render = 1", 0, 14, "Render", false) == 4
    assert lens_search_find("let render = 1", 0, 14, "Render", false) == -1
    assert lens_search_find("abc", 0, 3, "abcd", true) == -1
    assert lens_search_find("abcabc", 1, 6, "abc", true) == 3
    assert lens_search_snippet("\t  let x = 1", 0, 12) == "let x = 1"
    let file = [i32](4)
    let line = [i32](4)
    let row = [i32](4)
    let text = [str](4)
    // The second line wraps over three rows at width 4, so the third line's
    // first display row is 4.
    let count = lens_search_text("x\nabcdefghij\nfind x", "x", true, 7, 4, file, line, row, text, 0, 4)
    assert count == 2
    assert file[0] == 7 && line[0] == 0 && row[0] == 0
    assert line[1] == 2 && row[1] == 4 && text[1] == "find x"
    assert lens_search_text("x\nx\nx", "x", true, 1, 4, file, line, row, text, 0, 2) == 2
}

fn check_git(base: str) {
    os_make_dirs(base)
    let probe = os_git_run(base, "--version")
    if os_git_status() != 0 {
        print("vcs_test: git unavailable, skipping repository checks\n")
        return
    }
    let remote = base + "/remote.git"
    let work = base + "/work"
    let other = base + "/other"
    git(base, "init\n-q\n--bare\nremote.git")
    make_repo(work)
    git(work, "remote\nadd\norigin\n" + remote)
    assert os_write_file_atomic(work + "/main.ns", "fn main() {\n    print(\"hi\")\n}\n") != 0
    for step in lens_commit_steps("first") {
        git(work, step)
    }
    assert lens_last_line(git(work, "log\n-1\n--format=%s")) == "first"
    // Publishing a branch reports Git's own progress.
    git(work, lens_push_steps()[0])
    assert os_git_progress() == 100
    lens_sync_parse(git(work, "rev-list\n--left-right\n--count\nHEAD...@{upstream}"))
    assert g_lens_sync_ahead == 0 && g_lens_sync_behind == 0
    // A missing credential or remote fails instead of prompting.
    let failed = os_git_run(work, "push\nnowhere\nHEAD")
    assert os_git_status() != 0 && lens_last_line(failed) != ""

    // The job path: commit on a worker, then the counts follow.
    g_workspace_root = work
    assert os_write_file_atomic(work + "/util.ns", "fn helper() i32 {\n    return 4\n}\n") != 0
    lens_commit("second")
    assert g_lens_job_running
    finish_job()
    assert g_lens_message == "commit done"
    assert g_lens_sync_ahead == 1 && g_lens_sync_behind == 0
    assert os_git_changes(work) == ""
    lens_push()
    finish_job()
    assert g_lens_message == "push done"
    assert g_lens_sync_ahead == 0

    // A commit pushed from another clone shows up as behind after a fetch.
    git(base, "clone\n-q\n" + remote + "\nother")
    git(other, "config\nuser.name\nns_lens test")
    git(other, "config\nuser.email\nlens@example.com")
    git(other, "config\ncommit.gpgsign\nfalse")
    assert os_write_file_atomic(other + "/remote.ns", "fn remote() {}\n") != 0
    for step in lens_commit_steps("from other") {
        git(other, step)
    }
    git(other, "push\n-q")
    let steps = [str](1)
    steps[0] = "fetch\n--quiet"
    lens_job_start(LENS_JOB_FETCH, steps)
    finish_job()
    assert g_lens_sync_behind == 1 && g_lens_sync_ahead == 0
    // Pulling brings the remote commit in.
    lens_pull()
    finish_job()
    assert g_lens_message == "pull done"
    assert g_lens_sync_behind == 0 && g_lens_sync_ahead == 0
    assert os_file_size(work + "/remote.ns") >= 0
    // Nothing left to commit is reported, not hidden.
    lens_commit("empty")
    finish_job()
    assert substr(g_lens_message, 0, 13) == "commit failed"
    // Git refuses to rebase over uncommitted changes, and says so.
    assert os_write_file_atomic(other + "/remote.ns", "fn remote() { 2 }\n") != 0
    for step in lens_commit_steps("again") {
        git(other, step)
    }
    git(other, "push\n-q")
    assert os_write_file_atomic(work + "/remote.ns", "fn remote() { local }\n") != 0
    lens_pull()
    finish_job()
    assert substr(g_lens_message, 0, 11) == "pull failed"
    git(work, "checkout\n--\nremote.ns")
    check_patches(work)
}

fn finish_patches() {
    let deadline = os_time() + 20.0
    loop g_lens_patch_running && os_time() < deadline {
        sleep(1)
        lens_patch_tick(false)
    }
    assert g_lens_patch_running == false
}

// Every changed file gets a patch against HEAD; a new file is all added.
fn check_patches(work: str) {
    assert os_write_file_atomic(work + "/main.ns", "fn main() {\n    print(\"changed\")\n}\n") != 0
    assert os_write_file_atomic(work + "/fresh.ns", "fn fresh() {}\n") != 0
    g_workspace_streaming = true
    g_workspace_root = work
    workspace_init()
    lens_rebuild()
    lens_patch_tick(false)
    assert g_lens_patch_running
    finish_patches()
    let main_file = workspace_find("main.ns")
    let fresh_file = workspace_find("fresh.ns")
    let util_file = workspace_find("util.ns")
    assert main_file >= 0 && fresh_file >= 0 && util_file >= 0
    let diff = lens_leaf_diff(main_file)
    assert diff.added_count == 1 && diff.added[0] == 1
    assert diff.deleted_count == 1 && diff.deleted[0] == "    print(\"hi\")"
    assert lens_leaf_diff(fresh_file).all_added
    assert lens_leaf_patch(util_file) == ""
    let serial = lens_leaf_patch_serial(main_file)
    assert serial > 0
    // A rescan that finds the same patch keeps its serial; a commit clears it.
    g_lens_patch_wanted = true
    lens_patch_tick(false)
    finish_patches()
    assert lens_leaf_patch_serial(main_file) == serial
    lens_commit("patched")
    finish_job()
    assert g_lens_patch_wanted
    lens_patch_tick(false)
    finish_patches()
    assert lens_leaf_patch(main_file) == "" && lens_leaf_patch(fresh_file) == ""
}

fn finish_changes() {
    let deadline = os_time() + 20.0
    loop g_lens_change_running && os_time() < deadline {
        sleep(1)
        lens_changes_poll()
    }
    assert g_lens_change_running == false
}

// The change view lists Git's changes on a worker: switching to it returns at
// once, and a later frame adopts the listing and rebuilds the map.
fn check_change_list(base: str) {
    let root = base + "/changes"
    make_repo(root)
    // Lens keeps its caches under bin/, which a project ignores.
    assert os_write_file_atomic(root + "/.gitignore", "bin/\n") != 0
    assert os_write_file_atomic(root + "/kept.ns", "fn kept() {}\n") != 0
    git(root, "add\n-A")
    git(root, "commit\n-q\n-m\nbase")
    assert os_write_file_atomic(root + "/fresh.ns", "fn fresh() {}\n") != 0
    g_workspace_streaming = true
    g_workspace_root = root
    workspace_init()
    g_lens_view_mode = LENS_MODE_CODE
    lens_rebuild()
    assert lens_file_count() == 2
    lens_set_mode(LENS_MODE_CHANGE)
    // Until this folder's listing arrives, no other folder's list picks leaves.
    assert g_lens_change_running
    assert lens_file_count() == 0
    finish_changes()
    assert g_lens_change_root == root
    assert lens_change_has("fresh.ns") && lens_change_has("kept.ns") == false
    assert lens_file_count() == 1
    assert g_lens_files[workspace_find("fresh.ns")] == 1
    // A file that changes while a listing runs is listed by the next one.
    lens_changes_request(false)
    assert os_write_file_atomic(root + "/kept.ns", "fn kept() { }\n") != 0
    lens_changes_request(true)
    assert g_lens_change_again
    finish_changes()
    assert g_lens_change_again == false
    assert lens_change_has("kept.ns")
    assert lens_file_count() == 2
    lens_set_mode(LENS_MODE_CODE)
    // The commit dialog opens at once and counts its files from a listing.
    lens_commit_show()
    assert g_lens_commit_open && g_lens_commit_changes == -1
    assert g_lens_change_running
    finish_changes()
    assert g_lens_commit_changes == 2
    assert g_lens_commit_path[0] == "kept.ns" && g_lens_commit_kind[0] == LENS_GIT_MODIFIED
    assert g_lens_commit_path[1] == "fresh.ns" && g_lens_commit_kind[1] == LENS_GIT_ADDED
    assert g_lens_commit_checked[0] && g_lens_commit_checked[1]
    // The same listing gives the outline its states.
    assert g_lens_git_states_root == root
    assert lens_entry_git_kind(workspace_find("fresh.ns")) == LENS_GIT_ADDED
    assert lens_entry_git_kind(workspace_find("kept.ns")) == LENS_GIT_MODIFIED
    // Committing only the ticked file leaves the other one changed.
    g_lens_commit_message = "only kept"
    lens_commit_toggle(1)
    assert lens_commit_ticked() == 1
    assert lens_commit_title() == "Commit 1 of 2 changed files"
    lens_commit_submit()
    assert g_lens_commit_open == false
    finish_job()
    assert g_lens_message == "commit done"
    assert lens_last_line(git(root, "log\n-1\n--format=%s")) == "only kept"
    assert os_git_change_kinds(root) == "A fresh.ns\n"
    // Nothing ticked keeps the dialog open and says why.
    lens_commit_show()
    finish_changes()
    assert g_lens_commit_changes == 1
    lens_commit_tick_all()
    assert lens_commit_ticked() == 0
    g_lens_commit_message = "none"
    lens_commit_submit()
    assert g_lens_commit_open && g_lens_message == "Tick the files to commit"
    lens_commit_tick_all()
    assert lens_commit_ticked() == 1
    g_lens_commit_open = false
    lens_commit_list("M a.ns\n", 128)
    assert g_lens_commit_changes == 0
    lens_commit_list("M a.ns\nD b/c.ns\nA d.ns", 0)
    assert g_lens_commit_changes == 3
    assert g_lens_commit_kind[1] == LENS_GIT_DELETED && g_lens_commit_path[1] == "b/c.ns"
    assert g_lens_commit_path[2] == "d.ns"
}

// A partial commit stages new files, then commits exactly the ticked paths:
// renames, staged and unstaged deletions, and names that look like patterns.
fn check_partial_commit(base: str) {
    let root = base + "/partial"
    make_repo(root)
    os_make_dirs(root + "/sub")
    assert os_write_file_atomic(root + "/keep.txt", "a\n") != 0
    assert os_write_file_atomic(root + "/gone.txt", "b\n") != 0
    assert os_write_file_atomic(root + "/staged_gone.txt", "c\n") != 0
    assert os_write_file_atomic(root + "/old.txt", "d\n") != 0
    assert os_write_file_atomic(root + "/sub/mod.txt", "e\n") != 0
    assert os_write_file_atomic(root + "/we*ird.txt", "f\n") != 0
    assert os_write_file_atomic(root + "/weird.txt", "g\n") != 0
    git(root, "add\n-A")
    git(root, "commit\n-q\n-m\nbase")
    assert os_write_file_atomic(root + "/keep.txt", "a2\n") != 0
    assert os_rename_path(root + "/gone.txt", base + "/gone.txt") != 0
    git(root, "rm\n-q\nstaged_gone.txt")
    git(root, "mv\nold.txt\nnew.txt")
    assert os_write_file_atomic(root + "/sub/mod.txt", "e2\n") != 0
    assert os_write_file_atomic(root + "/sub/fresh.txt", "n\n") != 0
    assert os_write_file_atomic(root + "/we*ird.txt", "f2\n") != 0
    assert os_write_file_atomic(root + "/weird.txt", "g2\n") != 0
    let listed = os_git_change_kinds(root)
    assert os_git_status() == 0
    assert listed == "D gone.txt\nM keep.txt\nA new.txt\nD old.txt\nD staged_gone.txt\nM sub/mod.txt\nM we*ird.txt\nM weird.txt\nA sub/fresh.txt\n"
    // Listed from a folder below the repository root, paths start there.
    assert os_git_change_kinds(root + "/sub") == "M mod.txt\nA fresh.txt\n"
    lens_git_states_apply(listed, root)
    assert g_lens_git_states["sub"] == LENS_GIT_MODIFIED
    assert g_lens_git_states["sub/fresh.txt"] == LENS_GIT_ADDED
    lens_git_states_apply("A a/b/x.ns\nA a/y.ns\nD a/b/z.ns\nD c/w.ns\n", root)
    assert g_lens_git_states["a"] == LENS_GIT_MODIFIED && g_lens_git_states["a/b"] == LENS_GIT_MODIFIED
    assert g_lens_git_states["c"] == LENS_GIT_DELETED && has(g_lens_git_states, "a/b/x") == false
    let steps = lens_commit_paths_steps("part\nial", "\nnew.txt\nsub/fresh.txt", "\ngone.txt\nstaged_gone.txt\nnew.txt\nold.txt\nsub/fresh.txt\nwe*ird.txt")
    assert steps.len == 2
    assert steps[0] == "--literal-pathspecs\nadd\n-A\n--\nnew.txt\nsub/fresh.txt"
    assert substr(steps[1], 0, 45) == "--literal-pathspecs\ncommit\n-q\n-m\npart ial\n--\n"
    for step in steps {
        git(root, step)
    }
    assert os_git_change_kinds(root) == "M keep.txt\nM sub/mod.txt\nM weird.txt\n"
    assert lens_commit_paths_steps("m", "", "\nkeep.txt").len == 1
}

