// Exercise the floating panels through a real renderer: the outline tree, its
// scope marks and the terminal grid all go through ui text and rectangle calls,
// so a frame here catches layout or palette mistakes that pure state tests miss.
use std
use os
use view
use gpu
use ui
use editor
use workspace
use task

// Let the Git job running in the background end. The test folder is no
// repository, so the branch lists a job reads are empty.
fn settle_jobs() {
    let deadline = os_time() + 20.0
    loop g_lens_job_running && os_time() < deadline {
        sleep(1)
        lens_job_poll()
    }
    assert g_lens_job_running == false
    g_lens_fetch_next = os_time() + 1000.0
    g_lens_status_next = os_time() + 1000.0
}

fn main() {
    let stamp = os_time_us() % 1000000000
    let root = "/tmp/ns_lens_panels_" + itos(stamp as i32)
    assert os_make_dirs(root + "/src/nested") != 0
    assert os_write_file_atomic(root + "/src/main.ns", "use std\n\nfn main() {\n    print(\"hello\")\n}\n") != 0
    assert os_write_file_atomic(root + "/src/nested/part.ns", "let value = 1\n") != 0
    assert os_write_file_atomic(root + "/README.md", "# demo\n") != 0

    g_workspace_streaming = true
    g_workspace_root = root
    workspace_init()

    let v = view_create("panels render test", 1280, 800)
    if !gpu_request_device(v) {
        view_close(v)
        return
    }
    let r = ui_renderer_create(v)

    g_mouse_x = -100.0
    g_mouse_y = -100.0
    outline_show()
    let src = workspace_find("src")
    assert src >= 0
    outline_select(src)
    lens_scope_set(src)

    // A terminal-shaped screen without a shell process.
    g_terminal_open = true
    g_terminal_ready = true
    g_terminal_handle = 0
    g_terminal_exited = false
    g_terminal_error = ""
    g_term_cols = 60
    g_term_rows = 18
    term_full_reset()
    term_feed_text("$ printf '\u{1b}[1;32mgreen\u{1b}[0m'\r\ngreen\r\n$ \u{1b}[4munder\u{1b}[0m")
    g_term_offset = 1
    // The mode dropdown draws a shortcut label on every row; render it open so
    // a bad row width or missing key label fails here rather than on screen.
    g_lens_mode_open = true

    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }

    assert outline_open()
    assert terminal_open()
    assert g_lens_scope_path == root + "/src"
    assert lens_file_count() == 2

    // Git states tint outline rows and end them with a letter; the commit
    // dialog lists every changed file with a tick box, scrolled past a page.
    workspace_toggle_entry(workspace_find("nested"))
    lens_git_states_apply("M src/main.ns\nA src/nested/part.ns\nD gone.ns\n", root)
    assert lens_entry_git_kind(workspace_find("src")) == LENS_GIT_MODIFIED
    assert lens_entry_git_kind(workspace_find("nested")) == LENS_GIT_ADDED
    assert lens_entry_git_kind(workspace_find("part.ns")) == LENS_GIT_ADDED
    assert lens_entry_git_kind(workspace_find("README.md")) == LENS_GIT_NONE
    terminal_hide()
    g_lens_mode_open = false
    g_lens_commit_open = true
    let listing = ""
    for i in 0 to 20 {
        listing = listing + "M src/file_" + itos(i) + ".ns\n"
    }
    lens_commit_list(listing + "A src/nested/part.ns\nD gone.ns\n", 0)
    assert g_lens_commit_changes == 22
    lens_commit_toggle(3)
    g_lens_commit_scroll = 4
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert lens_commit_h() == LENS_COMMIT_LIST_Y + 12.0 * LENS_COMMIT_ROW_H + 76.0
    assert lens_commit_scroll_max() == 10
    g_lens_commit_open = false

    // Open Recent ends in a separator and Clear Recent.
    g_recent[0] = root
    g_recent_count = 1
    g_lens_file_open = true
    g_lens_recent_open = true
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert lens_recent_h() == 2.0 * LENS_MODE_ITEM + LENS_RECENT_SEPARATOR_H
    g_lens_file_open = false
    g_lens_recent_open = false

    // The status bar's branch button opens its menu above it, scrolled past a
    // page of branches; Create Branch and Pull Remote Branch open their own
    // panels.
    let branches = ""
    for i in 0 to 20 {
        branches = branches + "feature/branch_" + itos(i) + "\n"
    }
    let remotes = "origin/HEAD origin/main\norigin/main \norigin/feature/branch_3 \norigin/fresh \n"
    settle_jobs()
    lens_branch_apply("feature/branch_3", "", branches + "main\n", remotes)
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert g_lens_branch_w > 0.0
    assert lens_branch_button_at(g_lens_branch_x + 2.0, g_lens_branch_y + 14.0)
    lens_branch_show()
    settle_jobs()
    lens_branch_apply("feature/branch_3", "", branches + "main\n", remotes)
    g_lens_branch_scroll = 5
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert lens_branch_menu_y(800.0) + lens_branch_menu_h(800.0) == 800.0 - STATUS_BAR_H - 2.0
    assert lens_branch_scroll_max(800.0) == 21 - LENS_BRANCH_ROWS
    lens_branch_create_show()
    g_lens_branch_create_name = "topic"
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert lens_typing() && lens_menu_blocks()
    lens_remote_show()
    assert g_lens_branch_create_open == false
    settle_jobs()
    lens_branch_apply("feature/branch_3", "", branches + "main\n", remotes)
    g_lens_remote_query = "fe"
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert g_lens_remote_hit_count == 1
    lens_branch_hide()
    lens_branch_clear()

    outline_hide()
    // With no project open the window draws only its Open Folder button.
    lens_close_root()
    for n in 0 to 2 {
        ui_begin_frame(r)
        render_lens(r, v, 1280, 800)
        ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
    }
    assert g_workspace_root == ""
    ui_renderer_destroy(r)
    view_close(v)
    print("panels: passed" + unescape("\n"))
}
