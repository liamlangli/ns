// File > Open Recent: the shared list keeps the newest projects first, once
// each, and opening one from the submenu maps it and moves it to the top.
use std
use os

fn check(name: str, ok: bool) {
    if ok {
        print("ok   " + name + "\n")
    } else {
        print("FAIL " + name + "\n")
        assert false
    }
}

fn project(root: str) str {
    assert os_make_dirs(root + "/src") != 0
    assert os_write_file_atomic(root + "/src/main.ns", "fn main() {\n}\n") != 0
    return root
}

fn main() {
    let stamp = os_time_us() % 1000000000
    let base = "/tmp/ns_lens_recent_" + itos(stamp as i32)
    assert os_make_dirs(base) != 0
    g_recent_file = base + "/recent"
    g_panel_state = false

    check("normalize drops trailing separators", recent_normalize("/a/b//") == "/a/b" && recent_normalize("/") == "/")
    check("normalize makes relative paths absolute", recent_normalize("x") == os_cwd() + "/x" && recent_normalize("./x") == os_cwd() + "/x" && recent_normalize(".") == os_cwd())
    check("name and place", recent_name("/a/b/proj") == "proj" && recent_place("/a/b/proj") == "/a/b")
    let home = os_env("HOME")
    check("place shortens home", home == "" || recent_place(home + "/os/proj") == "~/os")

    recent_load()
    check("missing file is an empty list", g_recent_count == 0)
    for i in 0 to 14 {
        recent_add("/p/" + itos(i))
    }
    check("list keeps the newest ten", g_recent_count == RECENT_KEEP && RECENT_KEEP == 10 && g_recent[0] == "/p/13" && g_recent[RECENT_KEEP - 1] == "/p/4")
    recent_add("/p/7/")
    check("reopening moves to the front once", g_recent[0] == "/p/7" && g_recent[1] == "/p/13" && g_recent_count == RECENT_KEEP && recent_find("/p/7") == 0)
    recent_load()
    check("list survives a reload", g_recent_count == RECENT_KEEP && g_recent[0] == "/p/7" && g_recent[2] == "/p/12")
    recent_remove("/p/13")
    check("remove", recent_find("/p/13") < 0 && g_recent_count == RECENT_KEEP - 1 && g_recent[1] == "/p/12")

    // Launched with no folder, Lens starts in its own resource directory,
    // which is never remembered.
    lit bundle = "/Applications/ns_lens.app/Contents/Resources"
    check("bundle resources are the app default", recent_is_app_default(bundle + "/") && recent_is_app_default("/a/b") == false && recent_is_app_default("") == false)
    let packaged = base + "/packaged"
    assert os_make_dirs(packaged) != 0
    assert os_write_file_atomic(packaged + "/.ns-resources", "") != 0
    check("a marked package directory is the app default", recent_is_app_default(packaged))
    recent_add(bundle)
    recent_add(packaged)
    recent_load()
    check("app default is not remembered", g_recent_count == RECENT_KEEP - 1 && g_recent[0] == "/p/7" && recent_find(bundle) < 0)
    assert os_write_file_atomic(g_recent_file, bundle + "\n/p/1\n") != 0
    recent_load()
    check("a remembered app default leaves the list", g_recent_count == 1 && g_recent[0] == "/p/1")

    // Clear Recent empties the shared file and closes the menu.
    g_lens_file_open = true
    g_lens_recent_open = true
    lens_recent_clear()
    check("clear recent empties the list", g_recent_count == 0 && g_lens_file_open == false && g_lens_recent_open == false)
    recent_load()
    check("cleared list stays empty", g_recent_count == 0)

    // Open Recent keeps the File menu up and shows its submenu.
    g_lens_file_open = true
    lens_file_action(LENS_FILE_RECENT)
    check("open recent shows the submenu", g_lens_file_open && g_lens_recent_open)
    check("empty submenu keeps a placeholder row", lens_recent_rows() == 1)
    let ry = lens_recent_y()
    let clear_y = ry + LENS_MODE_ITEM + LENS_RECENT_SEPARATOR_H
    check("clear recent follows a separator", lens_recent_clear_y() == clear_y && lens_recent_h() == 2.0 * LENS_MODE_ITEM + LENS_RECENT_SEPARATOR_H)
    check("submenu rows by height", lens_recent_row_at(ry + 1.0) == 0 && lens_recent_row_at(clear_y - 1.0) == -1 && lens_recent_row_at(clear_y + 1.0) == LENS_RECENT_CLEAR)
    lens_recent_action(0)
    check("placeholder only closes the menu", g_lens_file_open == false && g_lens_recent_open == false)

    let first = project(base + "/first")
    let second = project(base + "/second")
    g_workspace_streaming = true
    g_workspace_root = first
    workspace_init()
    recent_add(g_workspace_root)
    lens_rebuild()
    check("open records the project", lens_open_root(second) && g_workspace_root == second)
    check("newest first", g_recent_count == 2 && g_recent[0] == second && g_recent[1] == first)
    check("submenu lists the open project too", lens_recent_rows() == 2 && lens_recent_row_at(ry + LENS_MODE_ITEM + 1.0) == 1)
    g_lens_file_open = true
    g_lens_recent_open = true
    lens_recent_action(0)
    check("open project's row only closes the menu", g_workspace_root == second && g_lens_file_open == false)
    g_lens_file_open = true
    g_lens_recent_open = true
    lens_recent_action(1)
    check("submenu opens the project", g_workspace_root == first && g_recent[0] == first && g_lens_file_open == false)
    check("project is mapped", workspace_find("main.ns") >= 0)

    // A folder deleted since it was opened maps the open project again and
    // leaves the list.
    recent_add(base + "/gone")
    check("missing project does not open", lens_open_root(base + "/gone") == false)
    check("open project is mapped again", g_workspace_root == first && workspace_find("main.ns") >= 0)
    check("missing project leaves the list", recent_find(base + "/gone") < 0 && g_recent_count == 2)
    check("missing project is reported", g_lens_message != "")

    // With no project open, a folder that cannot be opened keeps the window
    // empty and a real one maps.
    lens_close_root()
    check("missing project keeps the window empty", lens_open_root(base + "/gone") == false && g_workspace_root == "" && g_workspace_count == 0)
    check("empty window opens a project", lens_open_root(second) && g_workspace_root == second && g_recent[0] == second)

    // Started from the Dock or Finder, Lens reopens the most recent project;
    // a named folder or the shell's directory wins, and a new window opens
    // empty.
    check("startup reopens the most recent project", recent_startup_root("", "", bundle) == second && g_recent_restored)
    check("startup prefers the named folder", recent_startup_root(first, "/shell", bundle) == first && g_recent_restored == false)
    check("startup uses the shell directory", recent_startup_root("", "/shell", bundle) == "/shell" && g_recent_restored == false)
    check("new window opens empty", recent_startup_root(RECENT_NEW_WINDOW, "", bundle) == "" && g_recent_restored == false)
    recent_clear()
    check("startup with nothing remembered opens empty", recent_startup_root("", "", bundle) == "" && g_recent_restored == false)

    // File > New Window leads the menu and takes Cmd+Shift+N.
    check("new window leads the file menu", LENS_FILE_NEW_WINDOW == 0 && lens_file_item_label(LENS_FILE_NEW_WINDOW) == "New Window" && lens_file_item_keys(LENS_FILE_NEW_WINDOW) == "cmd+shift+N")
    check("dock menu offers new window", lens_dock_menu_items() == "New Window" && LENS_DOCK_NEW_WINDOW == 0)

    // The window title is the open project's path, home shortened to ~.
    check("window title is the project path", lens_window_title_text() == recent_tilde(second))
    check("tilde shortens home", home == "" || (recent_tilde(home + "/os/ns") == "~/os/ns" && recent_tilde(home) == "~" && recent_tilde(home + "x/y") == home + "x/y"))
    lens_close_root()
    check("empty window is titled with the app name", lens_window_title_text() == "ns_lens")

    os_watch_stop()
    print("recent_test: passed\n")
}
