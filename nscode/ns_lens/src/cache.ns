// Disk records are versioned and validate both source SHA-256 and payload SHA-256.
use os
use std

lit LENS_CACHE_HEADER = 136
let g_lens_cache_root = ""
let g_lens_cache_found = false
let g_lens_cache_hits: i32 = 0
let g_lens_cache_misses: i32 = 0
let g_lens_cache_keys = [str](4096)

fn lens_cache_init() {
    g_lens_cache_root = g_workspace_root + "/bin/ns_lens"
    os_make_dirs(g_lens_cache_root + "/files")
}

fn lens_cache_path(path: str, tag: str) str {
    return g_lens_cache_root + "/files/" + os_text_hash(path) + "." + tag + ".cache"
}

fn lens_cache_get(file: str, source_hash: str, limit: i32) str {
    g_lens_cache_found = false
    if source_hash.len != 64 {
        return ""
    }
    let size = os_file_size(file)
    if size < LENS_CACHE_HEADER || size > (limit + LENS_CACHE_HEADER) as i64 {
        return ""
    }
    let record = os_read_file_part(file, 0 as i64, (limit + LENS_CACHE_HEADER) as i64)
    if record.len < LENS_CACHE_HEADER || substr(record, 0, 6) != "lens1\n" {
        return ""
    }
    if substr(record, 6, 64) != source_hash {
        return ""
    }
    let payload = substr(record, LENS_CACHE_HEADER, record.len - LENS_CACHE_HEADER)
    if os_text_hash(payload) != substr(record, 71, 64) {
        return ""
    }
    g_lens_cache_found = true
    g_lens_cache_hits = g_lens_cache_hits + 1
    return payload
}

fn lens_cache_put(file: str, source_hash: str, payload: str) {
    if source_hash.len == 64 {
        os_write_file_atomic(file, "lens1\n" + source_hash + "\n" + os_text_hash(payload) + "\n" + payload)
    }
}

struct lens_cache_record {
    found: bool,
    text: str
}

// Worker reads use a value result, never the main thread's cache-found flag.
fn lens_disk_record(file: str, hash: str, limit: i32) lens_cache_record {
    if hash.len != 64 {
        return lens_cache_record(false, "")
    }
    let size = os_file_size(file)
    if size < LENS_CACHE_HEADER || size > (limit + LENS_CACHE_HEADER) as i64 {
        return lens_cache_record(false, "")
    }
    let record = os_read_file_part(file, 0 as i64, (limit + LENS_CACHE_HEADER) as i64)
    if record.len < LENS_CACHE_HEADER || substr(record, 0, 6) != "lens1\n" || substr(record, 6, 64) != hash {
        return lens_cache_record(false, "")
    }
    let text = substr(record, LENS_CACHE_HEADER, record.len - LENS_CACHE_HEADER)
    if os_text_hash(text) != substr(record, 71, 64) {
        return lens_cache_record(false, "")
    }
    return lens_cache_record(true, text)
}

fn lens_disk_source(root: str, path: str, offset: i64, bytes: i32) str {
    let hash = os_file_hash(path)
    let file = root + "/files/" + os_text_hash(path) + ".page" + lens_offset_key(offset) + "-" + itos(bytes) + ".cache"
    let record = lens_disk_record(file, hash, bytes)
    if record.found {
        return record.text
    }
    let text = os_read_file_part(path, offset, bytes as i64)
    if hash != "" && os_file_hash(path) == hash {
        lens_cache_put(file, hash, text)
    }
    return text
}

fn lens_read_source(path: str, offset: i64, bytes: i32) str {
    if g_lens_cache_root == "" {
        lens_cache_init()
    }
    return lens_disk_source(g_lens_cache_root, path, offset, bytes)
}

// The layout signature covers the ordered source set, sizes, and ancestry.
// Text changes with an unchanged size still validate against SHA-256 on use.
fn lens_layout_signature() str {
    let signature = "layout3\n"
    for i in 0 to g_workspace_count {
        g_lens_cache_keys[i] = os_text_hash(os_entry_path(i))
        signature = signature + os_text_hash(g_lens_cache_keys[i] + ":" + ftos(g_lens_weight[i]) + ":" + itos(os_entry_parent(i)))
    }
    return os_text_hash(signature)
}

let g_lens_parse_offset: i32 = 0
fn lens_cache_number(text: str) f64 {
    let start = g_lens_parse_offset
    let end = start
    loop end < text.len && ((text[end] as i32) & 255) != 10 {
        end = end + 1
    }
    g_lens_parse_offset = end + 1
    return stof(substr(text, start, end - start))
}

fn lens_load_layout(signature: str) bool {
    let data = lens_cache_get(g_lens_cache_root + "/index.cache", signature, 1048576)
    if data == "" {
        return false
    }
    g_lens_parse_offset = 0
    for i in 0 to g_workspace_count {
        g_lens_x[i] = lens_cache_number(data)
        g_lens_y[i] = lens_cache_number(data)
        g_lens_w[i] = lens_cache_number(data)
        g_lens_h[i] = lens_cache_number(data)
        g_lens_folder_header[i] = lens_cache_number(data)
        if g_lens_w[i] < 0.0 || g_lens_w[i] > 1200.01 || g_lens_h[i] < 0.0 || g_lens_h[i] > 900.01 {
            return false
        }
    }
    return g_lens_parse_offset == data.len
}

fn lens_store_layout(signature: str) {
    let data = ""
    for i in 0 to g_workspace_count {
        data = data + ftos(g_lens_x[i]) + "\n" + ftos(g_lens_y[i]) + "\n" + ftos(g_lens_w[i]) + "\n" + ftos(g_lens_h[i]) + "\n" + ftos(g_lens_folder_header[i]) + "\n"
    }
    lens_cache_put(g_lens_cache_root + "/index.cache", signature, data)
}

fn lens_offset_key(value: i64) str {
    if value == 0 {
        return "0"
    }
    let n = value
    let out = ""
    let digits = "0123456789"
    loop n > 0 {
        out = substr(digits, (n % 10) as i32, 1) + out
        n = n / 10
    }
    return out
}
