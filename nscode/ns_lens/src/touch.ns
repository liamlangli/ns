// Multi-finger touch on the map. The view's single mouse position follows
// whichever finger moved last, so with two fingers down it jumps between them
// on every event; a pinch read through it pans back and forth and zooms around
// the wrong point. While several fingers are down the pointer becomes their
// centroid instead, and the extra contacts never click.
use view
use ui
use os

lit LENS_TOUCH_MAX = 10
let g_lens_touch_id = [i32](LENS_TOUCH_MAX)
let g_lens_touch_x = [f64](LENS_TOUCH_MAX)
let g_lens_touch_y = [f64](LENS_TOUCH_MAX)
let g_lens_touch_count: i32 = 0
// Set once a second finger lands, until every finger has lifted.
let g_lens_touch_multi = false
// The finger set changed this frame: drags restart from the new pointer
// rather than jumping to it.
let g_lens_touch_rebase = false
// Set once a third finger lands, until every finger has lifted: the fingers'
// vertical drag tilts the map, and neither pans nor pinches it.
let g_lens_touch_tilt = false
let g_lens_touch_tilt_y: f64 = 0.0
// A one-finger tap: the finger lifted near where it landed, soon after.
// Left drags pan the map, so on touch the tap does what a desktop right
// click does there: focus a file or place the text cursor.
lit LENS_TAP_SLOP = 10.0
lit LENS_TAP_TIME = 0.5
// A finger landing this soon after a pinch lifted is the pinch's straggler,
// not a tap.
lit LENS_TAP_AFTER_MULTI = 0.3
let g_lens_tap_down = false
let g_lens_tap_x: f64 = 0.0
let g_lens_tap_y: f64 = 0.0
let g_lens_tap_time: f64 = 0.0
let g_lens_tap_moved = false
// Four fingers tapped together toggle every control but the map: the gesture
// peaked at four or more fingers, lifted soon after the first landed, and its
// centroid barely moved. The tilt the passing three-finger stage applied is
// undone.
lit LENS_FOUR_TAP_TIME = 0.5
lit LENS_FOUR_TAP_SLOP = 24.0
let g_lens_touch_peak: i32 = 0
let g_lens_touch_begin: f64 = 0.0
let g_lens_touch_begin_tilt: f64 = 0.0
let g_lens_touch_travel: f64 = 0.0
let g_lens_touch_last_x: f64 = 0.0
let g_lens_touch_last_y: f64 = 0.0
// When the last multi-finger gesture lifted.
let g_lens_multi_end: f64 = -1.0
// Set on the frame a tap ends, with g_mouse_x/y at the release point.
let g_lens_touch_tap = false

fn lens_touch_find(id: i32) i32 {
    for i in 0 to g_lens_touch_count {
        if g_lens_touch_id[i] == id { return i }
    }
    return -1
}

// Applies one pointer event to the set of held fingers. Returns true when the
// set gained or lost a finger.
fn lens_touch_apply(phase: i32, id: i32, x: f64, y: f64) bool {
    let at = lens_touch_find(id)
    if phase == VIEW_INPUT_PHASE_BEGAN || phase == VIEW_INPUT_PHASE_MOVED {
        if at < 0 {
            if g_lens_touch_count >= LENS_TOUCH_MAX { return false }
            at = g_lens_touch_count
            g_lens_touch_count = g_lens_touch_count + 1
            g_lens_touch_id[at] = id
            g_lens_touch_x[at] = x
            g_lens_touch_y[at] = y
            return true
        }
        g_lens_touch_x[at] = x
        g_lens_touch_y[at] = y
        return false
    }
    if (phase == VIEW_INPUT_PHASE_ENDED || phase == VIEW_INPUT_PHASE_CANCELLED) && at >= 0 {
        let last = g_lens_touch_count - 1
        g_lens_touch_id[at] = g_lens_touch_id[last]
        g_lens_touch_x[at] = g_lens_touch_x[last]
        g_lens_touch_y[at] = g_lens_touch_y[last]
        g_lens_touch_count = last
        return true
    }
    return false
}

fn lens_touch_center_x() f64 {
    let sum: f64 = 0.0
    for i in 0 to g_lens_touch_count { sum = sum + g_lens_touch_x[i] }
    return sum / (clamp_i(g_lens_touch_count, 1, LENS_TOUCH_MAX) as f64)
}

fn lens_touch_center_y() f64 {
    let sum: f64 = 0.0
    for i in 0 to g_lens_touch_count { sum = sum + g_lens_touch_y[i] }
    return sum / (clamp_i(g_lens_touch_count, 1, LENS_TOUCH_MAX) as f64)
}

// Runs before any input handling each frame, with g_mouse_x/y already in
// content coordinates.
fn lens_touch_update(r: ref ui_renderer, v: ref view) {
    g_lens_touch_rebase = false
    g_lens_touch_tap = false
    let now = os_time()
    let n = view_input_count(v)
    for i in 0 to n {
        let e = view_input_at(v, i)
        if e.device == VIEW_INPUT_DEVICE_TOUCH {
            if lens_touch_event(e.phase, e.pointer_id, ui_content_x(r, e.x), ui_content_y(r, e.y), now) {
                g_lens_touch_rebase = true
            }
        }
    }
    if v.mouse_down == false {
        // The view saw every finger lift; nothing can still be held.
        g_lens_touch_count = 0
    }
    if view_gesture(v).zoom_factor != 1.0 {
        // The system saw a pinch even if no frame held both fingers at once.
        lens_touch_multi_begin()
    }
    if g_lens_touch_count > 0 {
        let cx = lens_touch_center_x()
        let cy = lens_touch_center_y()
        if g_lens_touch_rebase == false {
            g_lens_touch_travel = g_lens_touch_travel + abs(cx - g_lens_touch_last_x) + abs(cy - g_lens_touch_last_y)
        }
        g_lens_touch_last_x = cx
        g_lens_touch_last_y = cy
    }
    lens_touch_tilt_step(g_lens_touch_count, lens_touch_center_y(), g_lens_touch_rebase)
    if g_lens_touch_multi {
        // Only the first finger's press counts; the rest of the gesture
        // neither presses nor clicks anything.
        v.mouse_pressed = false
        if v.mouse_down { v.mouse_released = false }
        if g_lens_touch_count > 0 {
            g_mouse_x = lens_touch_center_x()
            g_mouse_y = lens_touch_center_y()
        }
    }
    g_lens_touch_tap = lens_tap_step(g_mouse_x, g_mouse_y, now, v.mouse_down, g_lens_touch_multi)
    if v.mouse_down == false && g_lens_touch_multi {
        if lens_four_tap(g_lens_touch_peak, now - g_lens_touch_begin, g_lens_touch_travel) {
            g_lens_tilt = g_lens_touch_begin_tilt
            lens_ui_toggle()
        }
        g_lens_touch_multi = false
        g_lens_multi_end = now
    }
    if v.mouse_down == false {
        g_lens_touch_tilt = false
    }
}

// Three or more fingers tilt the map by their centroid's vertical travel. A
// finger landing or lifting restarts the drag from the new centroid.
fn lens_touch_tilt_step(count: i32, center_y: f64, rebase: bool) {
    let restart = rebase
    if count >= 3 && g_lens_touch_tilt == false {
        g_lens_touch_tilt = true
        restart = true
    }
    if g_lens_touch_tilt == false || count < 3 {
        return
    }
    if restart == false {
        lens_tilt_by(center_y - g_lens_touch_tilt_y)
    }
    g_lens_touch_tilt_y = center_y
}

// One finger event. An idle frame can queue a whole quick pinch, both fingers
// landing and lifting, so a second finger is noticed as its event arrives
// rather than from the count left once the frame's events are applied.
fn lens_touch_event(phase: i32, id: i32, x: f64, y: f64, now: f64) bool {
    if phase == VIEW_INPUT_PHASE_BEGAN && g_lens_touch_count == 0 {
        lens_tap_begin(x, y, now)
        g_lens_touch_peak = 0
        g_lens_touch_begin = now
        g_lens_touch_begin_tilt = g_lens_tilt
        g_lens_touch_travel = 0.0
        if g_lens_multi_end >= 0.0 && now - g_lens_multi_end < LENS_TAP_AFTER_MULTI {
            g_lens_tap_moved = true
        }
    }
    let changed = lens_touch_apply(phase, id, x, y)
    if g_lens_touch_count > g_lens_touch_peak { g_lens_touch_peak = g_lens_touch_count }
    if g_lens_touch_count >= 2 { lens_touch_multi_begin() }
    return changed
}

fn lens_four_tap(peak: i32, held: f64, travel: f64) bool {
    return peak >= 4 && held <= LENS_FOUR_TAP_TIME && travel <= LENS_FOUR_TAP_SLOP
}

fn lens_touch_multi_begin() {
    if g_lens_touch_multi { return }
    g_lens_touch_multi = true
    g_lens_tap_moved = true
    // A label pressed by the first finger is not clicked by this gesture.
    g_lens_label_press = -1
}

fn lens_tap_begin(x: f64, y: f64, now: f64) {
    g_lens_tap_down = true
    g_lens_tap_moved = false
    g_lens_tap_x = x
    g_lens_tap_y = y
    g_lens_tap_time = now
}

// Follows the held finger; true on the frame it lifts as a tap.
fn lens_tap_step(x: f64, y: f64, now: f64, down: bool, multi: bool) bool {
    if g_lens_tap_down == false { return false }
    let dx = x - g_lens_tap_x
    let dy = y - g_lens_tap_y
    if multi || dx * dx + dy * dy > LENS_TAP_SLOP * LENS_TAP_SLOP {
        g_lens_tap_moved = true
    }
    if down { return false }
    g_lens_tap_down = false
    return !g_lens_tap_moved && now - g_lens_tap_time <= LENS_TAP_TIME
}

// Called once the map knows the pointer is over it, before map input runs.
// A tap anywhere on the map folds the software keyboard away; one that lands
// on the open file's code brings it back (lens_touch_tap_code).
fn lens_touch_tap_click(v: ref view, over_map: bool) {
    if g_lens_touch_tap && over_map {
        v.mouse_right_pressed = true
        v.mouse_right_released = true
        g_mobile_keyboard_hidden = true
    }
}

// The tap placed the cursor in the code being edited.
fn lens_touch_tap_code() {
    if g_lens_touch_tap { g_mobile_keyboard_hidden = false }
}
