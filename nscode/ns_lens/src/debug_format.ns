// Display raw snapshot bits without changing the snapshot or delta baseline.
use std
lit DEBUG_FORMAT_COUNT = 6
let g_debug_register_format: i32 = 0
let g_debug_stack_format: i32 = 0

fn lens_debug_format_label(mode: i32) str {
    if mode == 1 { return "i64" }
    if mode == 2 { return "u64" }
    if mode == 3 { return "i32" }
    if mode == 4 { return "f32" }
    if mode == 5 { return "f64" }
    return "Hex"
}
fn lens_debug_format_find(text: str, needle: str) i32 {
    for i in 0 to text.len - needle.len + 1 {
        if substr(text, i, needle.len) == needle { return i }
    }
    return -1
}
fn lens_debug_hex_digit(c: i32) i32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}
fn lens_debug_format_word(text: str) u64 {
    let bits: u64 = 0
    for i in 0 to text.len {
        let digit = lens_debug_hex_digit(text[i])
        bits = (bits << 4) | (digit as u64)
    }
    return bits
}
// Decode IEEE bits, rather than numerically casting the integer to a float.
// Scaling the mantissa in stages also preserves subnormal values.
fn lens_debug_float(bits: u64, wide: bool) str {
    let fraction_bits: i32 = 23
    let exponent_bits: i32 = 8
    let bias: i32 = 127
    if wide {
        fraction_bits = 52
        exponent_bits = 11
        bias = 1023
    }
    let one: u64 = 1
    let fraction_mask = (one << (fraction_bits as u64)) - one
    let exponent_mask = (one << (exponent_bits as u64)) - one
    let fraction = bits & fraction_mask
    let exponent = (bits >> (fraction_bits as u64)) & exponent_mask
    let sign = ""
    if ((bits >> ((fraction_bits + exponent_bits) as u64)) & one) != 0 { sign = "-" }
    if exponent == exponent_mask {
        if fraction != 0 { return "NaN" }
        return sign + "Inf"
    }
    if exponent == 0 && fraction == 0 { return sign + "0" }
    let value = (fraction as f64) / ((one << (fraction_bits as u64)) as f64)
    let power = 1 - bias
    if exponent != 0 {
        value = value + 1.0
        power = (exponent as i32) - bias
    }
    let factor: f64 = 2.0
    if power < 0 {
        factor = 0.5
        power = -power
    }
    loop power > 0 {
        if (power & 1) != 0 { value = value * factor }
        power = power >> 1
        if power > 0 { factor = factor * factor }
    }
    return sign + ftos(value)
}
fn lens_debug_word_display(bits: u64, mode: i32) str {
    if mode == 1 { return `{bits as i64}` }
    if mode == 2 { return `{bits}` }
    if mode == 3 { return `[{bits as i32}, {(bits >> 32) as i32}]` }
    if mode == 4 { return "[" + lens_debug_float(bits & 0xffffffff, false) + ", " + lens_debug_float(bits >> 32, false) + "]" }
    return lens_debug_float(bits, true)
}
fn lens_debug_format_line(text: str, mode: i32, register_row: bool) str {
    if mode == 0 || text == "" { return text }
    let start: i32 = -1
    if register_row || lens_debug_format_find(text, "=") >= 0 {
        let eq = lens_debug_format_find(text, "=")
        if eq < 0 { return text }
        start = eq + 1
        loop start < text.len && text[start] == 32 { start = start + 1 }
    } else if text[0] == 91 {
        let close = lens_debug_format_find(text, "]")
        if close < 0 { return text }
        start = close + 1
        loop start < text.len && text[start] == 32 { start = start + 1 }
    } else if text.len > 2 && substr(text, 0, 2) == "0x" {
        // Native stack address stays hex; only the word after it is formatted.
        start = lens_debug_format_find(text, " ")
        if start < 0 { return text }
        loop start < text.len && text[start] == 32 { start = start + 1 }
    } else { return text }
    let prefix = substr(text, 0, start)
    if start + 2 <= text.len && substr(text, start, 2) == "0x" { start = start + 2 }
    let end = start
    loop end < text.len && lens_debug_hex_digit(text[end]) >= 0 { end = end + 1 }
    let digits = end - start
    if digits < 1 || digits > 16 { return text }
    // Decimal-only pc metadata is already readable; do not reinterpret it.
    if register_row && lens_debug_register_name(text) == "pc" && lens_debug_format_find(text, "0x") < 0 { return text }
    let first = lens_debug_format_word(substr(text, start, digits))
    let second_start = end
    loop second_start < text.len && text[second_start] == 32 { second_start = second_start + 1 }
    // SIMD snapshot words are printed high then low. Display lanes low first.
    if digits == 16 && second_start + 16 == text.len {
        let valid = true
        for i in second_start to text.len {
            if lens_debug_hex_digit(text[i]) < 0 { valid = false }
        }
        if valid {
            let low = lens_debug_format_word(substr(text, second_start, 16))
            return prefix + lens_debug_word_display(low, mode) + " | " + lens_debug_word_display(first, mode)
        }
    }
    if end < text.len && text[end] != 32 { return text }
    return prefix + lens_debug_word_display(first, mode)
}
