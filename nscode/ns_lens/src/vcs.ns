// Git commands behind the File menu: commit, push, and a background fetch
// that keeps the ahead/behind counts current. One job runs at a time on a
// worker task; the main thread polls it and refreshes file states after it.
// The change view's file list and per-file patches are read on workers too.
use os
use task

lit LENS_JOB_STATUS = 1
lit LENS_JOB_FETCH = 2
lit LENS_JOB_COMMIT = 3
lit LENS_JOB_PUSH = 4
lit LENS_JOB_PULL = 5
// Seconds between background fetches.
lit LENS_FETCH_INTERVAL = 300.0

let g_lens_job_kind: i32 = 0
let g_lens_job_running = false
let g_lens_job_root = ""
let g_lens_job_lock: ref os_lock = nil
let g_lens_job_lock_ready = false
// Worker results, guarded by g_lens_job_lock.
let g_lens_job_done = [i32](1)
let g_lens_job_code = [i32](1)
let g_lens_job_output = [str](1)
let g_lens_job_counts = [str](1)
// A commit or push asked for while another job runs starts after it.
let g_lens_job_queued: i32 = 0
let g_lens_job_queued_steps = [str](0)
// Commits only on this branch (ahead) and only on its upstream (behind);
// -1 when unknown or the branch has no upstream.
let g_lens_sync_ahead: i32 = -1
let g_lens_sync_behind: i32 = -1
let g_lens_sync_root = ""
let g_lens_fetch_next: f64 = 0.0
// Status bar buttons as last drawn: the down arrow pulls, the up arrow
// pushes. Zero width while the counts are unknown.
let g_lens_sync_y: f64 = 0.0
let g_lens_sync_down_x: f64 = 0.0
let g_lens_sync_down_w: f64 = 0.0
let g_lens_sync_up_x: f64 = 0.0
let g_lens_sync_up_w: f64 = 0.0

// Jobs the user asked for: queued behind a running job, shown with progress
// and reported when they end.
fn lens_job_user(kind: i32) bool {
    return kind == LENS_JOB_COMMIT || kind == LENS_JOB_PUSH || kind == LENS_JOB_PULL
}

fn lens_job_label(kind: i32) str {
    if kind == LENS_JOB_COMMIT {
        return "commit"
    }
    if kind == LENS_JOB_PUSH {
        return "push"
    }
    if kind == LENS_JOB_PULL {
        return "pull"
    }
    if kind == LENS_JOB_FETCH {
        return "fetch"
    }
    return "status"
}

// Git takes one argument per line, so a message keeps to one line.
fn lens_one_line(text: str) str {
    let out = ""
    let start: i32 = 0
    for i in 0 to text.len + 1 {
        let c: i32 = 10
        if i < text.len {
            c = (text[i] as i32) & 255
        }
        if c == 10 || c == 13 {
            if i > start {
                if out != "" {
                    out = out + " "
                }
                out = out + substr(text, start, i - start)
            }
            start = i + 1
        }
    }
    return out
}

// Every change under the workspace root, untracked files included: what the
// change view shows is what gets committed.
fn lens_commit_steps(message: str) [str] {
    let steps = [str](2)
    steps[0] = "add\n-A\n--\n."
    steps[1] = "commit\n-q\n-m\n" + lens_one_line(message) + "\n--\n."
    return steps
}

// Only the files ticked in the commit dialog. A partial commit takes paths
// Git already knows, so new files are staged first; the commit then takes
// each chosen path as it is in the work tree, renames and deletions included,
// and leaves every other change as it was. `added` and `chosen` hold one
// "\n<path>" per file, matched literally rather than as patterns.
fn lens_commit_paths_steps(message: str, added: str, chosen: str) [str] {
    let commit = "--literal-pathspecs\ncommit\n-q\n-m\n" + lens_one_line(message) + "\n--" + chosen
    if added == "" {
        let steps = [str](1)
        steps[0] = commit
        return steps
    }
    let steps = [str](2)
    steps[0] = "--literal-pathspecs\nadd\n-A\n--" + added
    steps[1] = commit
    return steps
}

fn lens_commit_paths(message: str, added: str, chosen: str) {
    lens_job_start(LENS_JOB_COMMIT, lens_commit_paths_steps(message, added, chosen))
}

// A branch without an upstream is published to origin under its own name.
fn lens_push_steps() [str] {
    let steps = [str](1)
    steps[0] = "push\n--progress"
    if g_lens_sync_ahead < 0 {
        steps[0] = "push\n--progress\n--set-upstream\norigin\nHEAD"
    }
    return steps
}

// Fetch, then replay local commits on the upstream. Git refuses while the
// work tree has uncommitted changes, and that refusal is reported.
fn lens_pull_steps() [str] {
    let steps = [str](2)
    steps[0] = "fetch\n--progress"
    steps[1] = "pull\n--rebase\n--progress"
    return steps
}

fn lens_pull() {
    lens_job_start(LENS_JOB_PULL, lens_pull_steps())
}

fn lens_commit(message: str) {
    lens_job_start(LENS_JOB_COMMIT, lens_commit_steps(message))
}

fn lens_push() {
    lens_job_start(LENS_JOB_PUSH, lens_push_steps())
}

fn lens_job_start(kind: i32, steps: [str]) {
    if g_workspace_root == "" {
        return
    }
    if g_lens_job_running {
        if lens_job_user(kind) {
            g_lens_job_queued = kind
            g_lens_job_queued_steps = steps
        }
        return
    }
    if g_lens_job_lock_ready == false {
        g_lens_job_lock = os_lock_create()
        g_lens_job_lock_ready = true
    }
    let root = g_workspace_root
    let lock = g_lens_job_lock
    let done = g_lens_job_done
    let code = g_lens_job_code
    let output = g_lens_job_output
    let counts = g_lens_job_counts
    done[0] = 0
    g_lens_job_kind = kind
    g_lens_job_root = root
    g_lens_job_running = true
    if lens_job_user(kind) {
        g_lens_message = lens_job_label(kind) + "..."
    }
    let pending = dispatch(queue_worker) { in
        let status: i32 = 0
        let text = ""
        for step in steps {
            if status == 0 {
                text = os_git_run(root, step)
                status = os_git_status()
            }
        }
        // The counts read the refs the steps just moved.
        let sync = os_git_run(root, "rev-list\n--left-right\n--count\nHEAD...@{upstream}")
        if os_git_status() != 0 {
            sync = ""
        }
        os_lock_acquire(lock)
        output[0] = text
        code[0] = status
        counts[0] = sync
        done[0] = 1
        os_lock_release(lock)
    }
}

// "<ahead>\t<behind>" from rev-list --left-right --count HEAD...@{upstream}.
fn lens_sync_parse(counts: str) {
    if counts == "" {
        g_lens_sync_ahead = -1
        g_lens_sync_behind = -1
        return
    }
    g_lens_sync_ahead = lens_diff_number(counts, 0)
    g_lens_sync_behind = lens_diff_number(counts, g_lens_diff_number_end + 1)
}

// The last non-empty line of Git's output, after any progress carriage
// returns: where Git puts its result or error.
fn lens_last_line(text: str) str {
    let end = text.len
    loop end > 0 {
        let c = (text[end - 1] as i32) & 255
        if c != 10 && c != 13 && c != 32 {
            break
        }
        end = end - 1
    }
    let start = end
    loop start > 0 {
        let c = (text[start - 1] as i32) & 255
        if c == 10 || c == 13 {
            break
        }
        start = start - 1
    }
    return substr(text, start, end - start)
}

fn lens_job_poll() {
    if g_lens_job_running == false || os_lock_try_acquire(g_lens_job_lock) == false {
        return
    }
    let ready = g_lens_job_done[0] != 0
    let status = g_lens_job_code[0]
    let text = g_lens_job_output[0]
    let counts = g_lens_job_counts[0]
    os_lock_release(g_lens_job_lock)
    if ready == false {
        return
    }
    g_lens_job_running = false
    let kind = g_lens_job_kind
    if g_lens_job_root == g_workspace_root {
        lens_sync_parse(counts)
        g_lens_sync_root = g_lens_job_root
    }
    if lens_job_user(kind) {
        if status == 0 {
            g_lens_message = lens_job_label(kind) + " done"
        } else {
            g_lens_message = lens_job_label(kind) + " failed: " + lens_last_line(text)
        }
    }
    if (kind == LENS_JOB_COMMIT || kind == LENS_JOB_PULL) && status == 0 {
        // A commit cleans files and a pull moves HEAD and files: refresh the
        // change view, the leaves' patches and the open file's diff against
        // the new HEAD now rather than at the next poll.
        g_lens_change_poll = 0.0
        g_lens_git_poll = 0.0
        g_lens_patch_wanted = true
    }
    if g_lens_job_queued != 0 {
        let queued = g_lens_job_queued
        g_lens_job_queued = 0
        lens_job_start(queued, g_lens_job_queued_steps)
    }
}

// Each frame: collect a finished job, read the counts for a newly opened
// project at once, and fetch in the background every LENS_FETCH_INTERVAL.
fn lens_vcs_tick(moving: bool) {
    lens_job_poll()
    if g_lens_job_running || g_workspace_root == "" {
        return
    }
    if g_lens_sync_root != g_workspace_root {
        g_lens_sync_ahead = -1
        g_lens_sync_behind = -1
        g_lens_sync_root = g_workspace_root
        g_lens_fetch_next = os_time() + 2.0
        lens_job_start(LENS_JOB_STATUS, [str](0))
        return
    }
    if moving == false && os_time() >= g_lens_fetch_next {
        g_lens_fetch_next = os_time() + LENS_FETCH_INTERVAL
        let steps = [str](1)
        steps[0] = "fetch\n--quiet"
        lens_job_start(LENS_JOB_FETCH, steps)
    }
}

// A commit or push the user is waiting on, for the activity row.
fn lens_job_visible() bool {
    return g_lens_job_running && lens_job_user(g_lens_job_kind)
}

// Push and pull report Git's own percentage; a commit has none.
fn lens_job_fraction() f64 {
    if g_lens_job_kind == LENS_JOB_PUSH || g_lens_job_kind == LENS_JOB_PULL {
        let percent = os_git_progress()
        if percent >= 0 {
            return (percent as f64) / 100.0
        }
    }
    return -1.0
}

// Status bar: a down arrow with the upstream commits not pulled yet, then an
// up arrow with the local commits not pushed. Returns the width it used, 0
// when the branch has no upstream.
fn lens_draw_sync(r: ref ui_renderer, x: f64, y: f64) f64 {
    g_lens_sync_y = y
    g_lens_sync_down_w = 0.0
    g_lens_sync_up_w = 0.0
    if g_lens_sync_ahead < 0 || g_lens_sync_behind < 0 {
        return 0.0
    }
    g_lens_sync_down_x = x
    g_lens_sync_down_w = lens_draw_sync_count(r, x, y, g_lens_sync_behind, true)
    g_lens_sync_up_x = x + g_lens_sync_down_w
    g_lens_sync_up_w = lens_draw_sync_count(r, g_lens_sync_up_x, y, g_lens_sync_ahead, false)
    return g_lens_sync_down_w + g_lens_sync_up_w + 8.0
}

// Which status bar button is under (mx, my): LENS_JOB_PULL, LENS_JOB_PUSH,
// or 0 for neither.
fn lens_sync_button_at(mx: f64, my: f64) i32 {
    if my < g_lens_sync_y + 4.0 || my >= g_lens_sync_y + 24.0 {
        return 0
    }
    if mx >= g_lens_sync_down_x - 4.0 && mx < g_lens_sync_down_x - 4.0 + g_lens_sync_down_w {
        return LENS_JOB_PULL
    }
    if mx >= g_lens_sync_up_x - 4.0 && mx < g_lens_sync_up_x - 4.0 + g_lens_sync_up_w {
        return LENS_JOB_PUSH
    }
    return 0
}

// One button, an arrow and its count, in a 28 px status bar at `y`; it
// lights up under the pointer. The atlas has no arrow glyphs, so the arrow
// is a stem and a triangle head.
fn lens_draw_sync_count(r: ref ui_renderer, x: f64, y: f64, count: i32, down: bool) f64 {
    let color = col_muted()
    if count > 0 {
        color = col_text()
    }
    let label = itos(count)
    let label_w = ui_text_width(r, label, small_px(), FONT_MONO())
    let w = 11.0 + label_w + 10.0
    if g_mouse_x >= x - 4.0 && g_mouse_x < x - 4.0 + w && g_mouse_y >= y + 4.0 && g_mouse_y < y + 24.0 {
        ui_fill_round_rect(r, x - 4.0, y + 4.0, w - 2.0, 20.0, 3.0, col_editor_panel_hi(), 0.0)
        color = col_accent()
    }
    let ax = x + 4.0
    let cy = y + 14.0
    if down {
        ui_stroke_line(r, ax, cy - 6.0, ax, cy + 1.0, 1.5, color, 0.5)
        ui_fill_triangle(r, ax - 4.0, cy, ax + 4.0, cy, ax, cy + 5.0, color, 0.5)
    } else {
        ui_stroke_line(r, ax, cy - 1.0, ax, cy + 6.0, 1.5, color, 0.5)
        ui_fill_triangle(r, ax - 4.0, cy, ax + 4.0, cy, ax, cy - 5.0, color, 0.5)
    }
    draw_text_clipped(r, x + 11.0, y + 5.0, label_w, 20.0, label, small_px(), color)
    return w
}

// A changed path's Git state, from the letter that leads its line in an
// os_git_change_kinds listing. The commit dialog and the outline tint a path
// with its state's color and end its row with the letter.
lit LENS_GIT_NONE = 0
lit LENS_GIT_MODIFIED = 1
lit LENS_GIT_ADDED = 2
lit LENS_GIT_DELETED = 3
// Files a listing contributes to the outline's states; each also marks the
// folders above it.
lit LENS_GIT_STATE_FILES = 4096
lit LENS_GIT_STATE_KEYS = 12288

fn lens_git_kind(letter: i32) i32 {
    if letter == 65 {
        return LENS_GIT_ADDED
    }
    if letter == 68 {
        return LENS_GIT_DELETED
    }
    return LENS_GIT_MODIFIED
}

fn lens_git_letter(kind: i32) str {
    if kind == LENS_GIT_ADDED { return "A" }
    if kind == LENS_GIT_DELETED { return "D" }
    if kind == LENS_GIT_MODIFIED { return "M" }
    return ""
}

fn col_git_kind(kind: i32) u32 {
    if kind == LENS_GIT_ADDED { return ui_pack_color("#81b88b") }
    if kind == LENS_GIT_DELETED { return ui_pack_color("#e06c5a") }
    if kind == LENS_GIT_MODIFIED { return ui_pack_color("#e2c08d") }
    return col_text()
}

// The state of every changed path and of every folder above one, by path
// relative to the root the listing came from. A folder whose changes are all
// of one kind takes that kind; a mix reads as modified.
let g_lens_git_states = [str: i32](16384)
let g_lens_git_states_root = ""
let g_lens_git_states_text = ""

fn lens_git_states_apply(listed: str, root: str) {
    if listed == g_lens_git_states_text && root == g_lens_git_states_root {
        return
    }
    g_lens_git_states_text = listed
    g_lens_git_states_root = root
    let states = [str: i32](16384)
    let files: i32 = 0
    let keys: i32 = 0
    let start: i32 = 0
    for i in 0 to listed.len + 1 {
        if i == listed.len || ((listed[i] as i32) & 255) == 10 {
            if i > start + 2 && files < LENS_GIT_STATE_FILES && keys < LENS_GIT_STATE_KEYS {
                let kind = lens_git_kind((listed[start] as i32) & 255)
                let path = substr(listed, start + 2, i - start - 2)
                if has(states, path) == false {
                    keys = keys + 1
                }
                states[path] = kind
                files = files + 1
                let cut = path.len - 1
                loop cut > 0 && keys < LENS_GIT_STATE_KEYS {
                    if ((path[cut] as i32) & 255) == 47 {
                        let folder = substr(path, 0, cut)
                        if has(states, folder) == false {
                            states[folder] = kind
                            keys = keys + 1
                        } else if states[folder] != kind {
                            states[folder] = LENS_GIT_MODIFIED
                        }
                    }
                    cut = cut - 1
                }
            }
            start = i + 1
        }
    }
    g_lens_git_states = states
}

// The Git state the outline shows for a workspace entry.
fn lens_entry_git_kind(index: i32) i32 {
    if g_lens_git_states_root != g_workspace_root || g_lens_git_states_text == "" {
        return LENS_GIT_NONE
    }
    let path = lens_relative_path(os_entry_path(index))
    if has(g_lens_git_states, path) {
        return g_lens_git_states[path]
    }
    return LENS_GIT_NONE
}

// The change view's file list. `git status` takes tens of milliseconds, too
// long for a frame, so a worker runs it and the main thread adopts the
// listing in a later frame. Each line is "K path", K the change's letter.
let g_lens_change_running = false
let g_lens_change_again = false
let g_lens_change_job_root = ""
let g_lens_change_lock: ref os_lock = nil
let g_lens_change_lock_ready = false
// Worker results, guarded by g_lens_change_lock: [0] done, [1] Git status.
let g_lens_change_state = [i32](2)
let g_lens_change_output = [str](1)

// List the opened folder's changes on a worker. A listing already running
// for this folder serves the request, unless `stale`: files changed after it
// began, so another listing follows it.
fn lens_changes_request(stale: bool) {
    if g_workspace_root == "" {
        return
    }
    if g_lens_change_running {
        if stale || g_lens_change_job_root != g_workspace_root {
            g_lens_change_again = true
        }
        return
    }
    if g_lens_change_lock_ready == false {
        g_lens_change_lock = os_lock_create()
        g_lens_change_lock_ready = true
    }
    let root = g_workspace_root
    let lock = g_lens_change_lock
    let state = g_lens_change_state
    let output = g_lens_change_output
    state[0] = 0
    g_lens_change_running = true
    g_lens_change_job_root = root
    let pending = dispatch(queue_worker) { in
        let text = os_git_change_kinds(root)
        let status = os_git_status()
        os_lock_acquire(lock)
        output[0] = text
        state[1] = status
        state[0] = 1
        os_lock_release(lock)
    }
}

// Each frame: adopt a finished listing while the change view still shows the
// folder it was read from; a list that changed rebuilds the map. An open
// commit dialog takes its files from the same listing, and the outline its
// states.
fn lens_changes_poll() {
    if g_lens_change_running == false || os_lock_try_acquire(g_lens_change_lock) == false {
        return
    }
    let done = g_lens_change_state[0] != 0
    let status = g_lens_change_state[1]
    let text = g_lens_change_output[0]
    os_lock_release(g_lens_change_lock)
    if done == false {
        return
    }
    g_lens_change_running = false
    if status == 0 {
        lens_git_states_apply(text, g_lens_change_job_root)
    }
    if g_lens_commit_open && g_lens_commit_changes < 0 && g_lens_change_job_root == g_workspace_root {
        lens_commit_list(text, status)
    }
    if g_lens_view_mode == LENS_MODE_CHANGE && g_lens_change_job_root == g_workspace_root {
        lens_changes_apply(text, status, g_lens_change_job_root)
        if g_lens_changes_dirty {
            lens_rebuild()
            g_lens_changes_dirty = false
        }
    }
    if g_lens_change_again {
        g_lens_change_again = false
        lens_changes_request(false)
    }
}

// Patches against HEAD for every changed file, so each leaf's minimap shows
// the size of its change. A worker lists the changes and diffs each file the
// way the editor does; rescans follow file changes, commits, and a timer.
lit LENS_PATCH_FILES = 256
lit LENS_PATCH_BYTES: i64 = 1048576
lit LENS_PATCH_INTERVAL = 30.0

// Patch and change serial by path relative to the workspace root.
let g_lens_patches = [str: str](8192)
let g_lens_patch_serials = [str: i32](8192)
let g_lens_patch_counter: i32 = 0
let g_lens_patch_root = ""
let g_lens_patch_seen: i32 = -1
let g_lens_patch_next: f64 = 0.0
let g_lens_patch_wanted = false
let g_lens_patch_running = false
let g_lens_patch_lock: ref os_lock = nil
let g_lens_patch_lock_ready = false
// Worker results, guarded by g_lens_patch_lock: [0] done, [1] count, [2] the
// listing's Git status; the listing itself feeds the outline's states.
let g_lens_patch_state = [i32](3)
let g_lens_patch_paths = [str](256)
let g_lens_patch_texts = [str](256)
let g_lens_patch_listed = [str](1)

// The hunks of a patch. Its header names the temporary files Git compared,
// which differ on every run, so it would make an unchanged patch look new.
fn lens_patch_body(patch: str) str {
    let offset: i32 = 0
    loop offset < patch.len {
        if offset + 3 <= patch.len && substr(patch, offset, 3) == "@@ " {
            return substr(patch, offset, patch.len - offset)
        }
        offset = lens_line_end(patch, offset) + 1
    }
    return ""
}

fn lens_join_path(root: str, relative: str) str {
    let n = root.len
    loop n > 0 && ((root[n - 1] as i32) & 255) == 47 {
        n = n - 1
    }
    return substr(root, 0, n) + "/" + relative
}

fn lens_patch_start() {
    if g_lens_patch_lock_ready == false {
        g_lens_patch_lock = os_lock_create()
        g_lens_patch_lock_ready = true
    }
    let root = g_workspace_root
    let lock = g_lens_patch_lock
    let state = g_lens_patch_state
    let paths = g_lens_patch_paths
    let texts = g_lens_patch_texts
    let listings = g_lens_patch_listed
    state[0] = 0
    state[1] = 0
    g_lens_patch_running = true
    g_lens_patch_root = root
    g_lens_patch_seen = g_workspace_generation
    g_lens_patch_wanted = false
    g_lens_patch_next = os_time() + LENS_PATCH_INTERVAL
    let pending = dispatch(queue_worker) { in
        let listed = os_git_change_kinds(root)
        let status = os_git_status()
        let count: i32 = 0
        if status == 0 {
            let start: i32 = 0
            for i in 0 to listed.len + 1 {
                if i == listed.len || ((listed[i] as i32) & 255) == 10 {
                    // A deleted file has nothing to diff.
                    if i > start + 2 && count < LENS_PATCH_FILES && ((listed[start] as i32) & 255) != 68 {
                        let relative = substr(listed, start + 2, i - start - 2)
                        let full = lens_join_path(root, relative)
                        let size = os_file_size(full)
                        if size >= 0 && size <= LENS_PATCH_BYTES {
                            let base = os_git_base(full, 1048576)
                            if os_git_status() != 0 {
                                paths[count] = relative
                                texts[count] = LENS_PATCH_NEW
                                count = count + 1
                            } else {
                                let patch = lens_patch_body(os_git_diff_text(base, os_read_file(full), 1048576))
                                if os_git_status() >= 0 && patch != "" {
                                    paths[count] = relative
                                    texts[count] = patch
                                    count = count + 1
                                }
                            }
                        }
                    }
                    start = i + 1
                }
            }
        }
        os_lock_acquire(lock)
        listings[0] = listed
        state[2] = status
        state[1] = count
        state[0] = 1
        os_lock_release(lock)
    }
}

// A leaf whose patch changed rebuilds its minimap and preview glyphs.
fn lens_patch_invalidate(i: i32) {
    g_lens_source_done[i] = false
    for s in 0 to LENS_CACHE_SLOTS {
        if g_lens_cache_id[s] == i {
            g_lens_glyph_dirty[s] = 1
            g_lens_preview_wrap[s] = -1
            lens_mini_offer(i, g_lens_cache_text[s])
        }
    }
}

fn lens_patch_apply(count: i32) {
    let next = [str: str](8192)
    let serials = [str: i32](8192)
    let changed = set[str](1024)
    for k in 0 to count {
        let path = g_lens_patch_paths[k]
        let patch = g_lens_patch_texts[k]
        next[path] = patch
        if has(g_lens_patches, path) && g_lens_patches[path] == patch {
            serials[path] = g_lens_patch_serials[path]
        } else {
            g_lens_patch_counter = g_lens_patch_counter + 1
            serials[path] = g_lens_patch_counter
            insert(changed, path)
        }
    }
    for path in g_lens_patches {
        if has(next, path) == false {
            insert(changed, path)
        }
    }
    g_lens_patches = next
    g_lens_patch_serials = serials
    for i in 0 to g_workspace_count {
        if g_lens_files[i] == 1 && has(changed, lens_relative_path(os_entry_path(i))) {
            lens_patch_invalidate(i)
        }
    }
}

fn lens_patch_tick(moving: bool) {
    if g_lens_patch_root != g_workspace_root && g_lens_patch_running == false {
        g_lens_patches = [str: str](8192)
        g_lens_patch_serials = [str: i32](8192)
        g_lens_patch_root = g_workspace_root
        g_lens_patch_seen = -1
    }
    if g_lens_patch_running && os_lock_try_acquire(g_lens_patch_lock) {
        let done = g_lens_patch_state[0] != 0
        let count = g_lens_patch_state[1]
        let listed_status = g_lens_patch_state[2]
        let listed = g_lens_patch_listed[0]
        os_lock_release(g_lens_patch_lock)
        if done {
            g_lens_patch_running = false
            g_lens_patch_listed[0] = ""
            if g_lens_patch_root == g_workspace_root {
                lens_patch_apply(count)
                if listed_status == 0 {
                    lens_git_states_apply(listed, g_lens_patch_root)
                } else {
                    lens_git_states_apply("", g_lens_patch_root)
                }
            }
        }
    }
    if g_lens_patch_running || moving || g_workspace_root == "" {
        return
    }
    if g_lens_patch_seen != g_workspace_generation || g_lens_patch_wanted || os_time() >= g_lens_patch_next {
        lens_patch_start()
    }
}

// The patch a leaf shows, "" when its file is unchanged.
fn lens_leaf_patch(i: i32) str {
    if g_lens_view_mode == LENS_MODE_REF { return "" }
    let path = lens_relative_path(os_entry_path(i))
    if has(g_lens_patches, path) {
        return g_lens_patches[path]
    }
    return ""
}

fn lens_leaf_patch_serial(i: i32) i32 {
    let path = lens_relative_path(os_entry_path(i))
    if has(g_lens_patch_serials, path) {
        return g_lens_patch_serials[path]
    }
    return 0
}

fn lens_leaf_diff(i: i32) lens_file_diff {
    return lens_file_diff_parse(lens_leaf_patch(i))
}
