use os
use std

let g_status_started = false
let g_status_time: f64 = 0.0
let g_status_frames: i32 = 0
let g_status_fps: i32 = 0
let g_status_memory: u64 = 0
let g_status_memory_total: u64 = 0

fn status_sample(now: f64) {
    if !g_status_started || now < g_status_time {
        g_status_started = true
        g_status_time = now
        g_status_frames = 0
        g_status_fps = 0
        g_status_memory = os_process_memory()
        g_status_memory_total = os_memory_total()
        return
    }
    g_status_frames = g_status_frames + 1
    let elapsed = now - g_status_time
    if elapsed >= 1.0 {
        g_status_fps = (g_status_frames as f64 / elapsed + 0.5) as i32
        g_status_memory = os_process_memory()
        g_status_time = now
        g_status_frames = 0
    }
}

fn status_memory_fraction(used: u64, total: u64) f64 {
    if total == 0 {
        return 0.0
    }
    return clamp(used as f64 / total as f64, 0.0, 1.0)
}

fn status_memory_text(used: u64, total: u64) str {
    if used == 0 {
        return "RAM unavailable"
    }
    let mib = ((used as f64 / 1048576.0) + 0.5) as i64
    let label = "RAM " + itos(mib) + " MiB"
    if total > 0 {
        let tenths = (status_memory_fraction(used, total) * 1000.0 + 0.5) as i32
        label = label + " (" + itos(tenths / 10) + "." + itos(tenths % 10) + "%)"
    }
    return label
}
