// HEAD-to-working-buffer changes. Deleted source is a read-only inline ghost row.
use std
use os

lit LENS_DIFF_DELETED = 8192
let g_lens_git_path = ""
let g_lens_git_revision = ""
let g_lens_git_base = ""
let g_lens_git_version: i32 = -1
let g_lens_git_observed: i32 = -1
let g_lens_git_deadline: f64 = 0.0
let g_lens_git_poll: f64 = 0.0
let g_lens_diff_added = [i32](65536)
let g_lens_diff_deleted = [str](8192)
let g_lens_diff_anchor = [i32](8192)
let g_lens_diff_deleted_count: i32 = 0
let g_lens_diff_rows = [i32](73728)
let g_lens_diff_source = [i32](65536)
let g_lens_diff_count: i32 = 0
let g_lens_diff_revision: i32 = 0
let g_lens_diff_number_end: i32 = 0

fn lens_diff_number(text: str, offset: i32) i32 {
    let value: i32 = 0
    let i = offset
    loop i < text.len {
        let c = (text[i] as i32) & 255
        if c < 48 || c > 57 {
            break
        }
        value = clamp_i(value * 10 + c - 48, 0, 65536)
        i = i + 1
    }
    g_lens_diff_number_end = i
    return value
}

fn lens_diff_clear() {
    for i in 0 to 65536 {
        g_lens_diff_added[i] = 0
    }
    for i in 0 to g_lens_diff_deleted_count {
        g_lens_diff_deleted[i] = ""
    }
    g_lens_diff_deleted_count = 0
}

fn lens_diff_parse(patch: str) {
    lens_diff_clear()
    let offset: i32 = 0
    let current: i32 = 0
    let hunk = false
    loop offset < patch.len {
        let end = offset
        loop end < patch.len && ((patch[end] as i32) & 255) != 10 {
            end = end + 1
        }
        let line = substr(patch, offset, end - offset)
        if line.len >= 4 && substr(line, 0, 3) == "@@ " {
            let plus: i32 = 3
            loop plus < line.len && ((line[plus] as i32) & 255) != 43 {
                plus = plus + 1
            }
            let start = lens_diff_number(line, plus + 1)
            let count: i32 = 1
            if g_lens_diff_number_end < line.len && ((line[g_lens_diff_number_end] as i32) & 255) == 44 {
                count = lens_diff_number(line, g_lens_diff_number_end + 1)
            }
            current = start - 1
            if count == 0 {
                current = start
            }
            current = clamp_i(current, 0, 65536)
            hunk = true
        } else if hunk && line.len > 0 {
            let kind = (line[0] as i32) & 255
            if kind == 43 {
                if current < 65536 {
                    g_lens_diff_added[current] = 1
                }
                current = current + 1
            } else if kind == 45 && g_lens_diff_deleted_count < LENS_DIFF_DELETED {
                let slot = g_lens_diff_deleted_count
                g_lens_diff_anchor[slot] = current
                g_lens_diff_deleted[slot] = substr(line, 1, line.len - 1)
                g_lens_diff_deleted_count = slot + 1
            } else if kind == 32 {
                current = current + 1
            }
        }
        offset = end + 1
    }
    lens_diff_build_rows()
}

fn lens_diff_build_rows() {
    g_lens_diff_revision = g_lens_diff_revision + 1
    let deleted: i32 = 0
    g_lens_diff_count = 0
    for line in 0 to line_count() + 1 {
        loop deleted < g_lens_diff_deleted_count && g_lens_diff_anchor[deleted] <= line {
            g_lens_diff_rows[g_lens_diff_count] = -1 - deleted
            g_lens_diff_count = g_lens_diff_count + 1
            deleted = deleted + 1
        }
        if line < line_count() {
            g_lens_diff_source[line] = g_lens_diff_count
            g_lens_diff_rows[g_lens_diff_count] = line
            g_lens_diff_count = g_lens_diff_count + 1
        }
    }
}

fn lens_diff_source_row(row: i32) i32 {
    if g_lens_diff_count <= 0 {
        return row
    }
    let code = g_lens_diff_rows[clamp_i(row, 0, g_lens_diff_count - 1)]
    if code >= 0 {
        return code
    }
    return clamp_i(g_lens_diff_anchor[-1 - code], 0, line_count() - 1)
}

fn lens_git_load_base(path: str, revision: str) bool {
    let hash = os_text_hash(revision)
    let file = lens_cache_path(path, "base")
    g_lens_git_base = lens_cache_get(file, hash, LENS_EDIT_BYTES)
    if g_lens_cache_found {
        return true
    }
    g_lens_git_base = os_git_base(path, LENS_EDIT_BYTES)
    if os_git_status() < 0 {
        g_lens_message = "Git base is unavailable or exceeds the detail budget"
        return false
    }
    lens_cache_put(file, hash, g_lens_git_base)
    return true
}

fn lens_git_tick(moving: bool) {
    if g_lens_editing == false || g_workspace_active < 0 {
        if g_lens_diff_deleted_count != 0 || g_lens_diff_count != line_count() || g_doc_version != g_lens_git_observed {
            lens_diff_clear()
            lens_diff_build_rows()
            g_lens_git_observed = g_doc_version
        }
        return
    }
    let now = os_time()
    let path = os_entry_path(g_workspace_active)
    if path != g_lens_git_path {
        g_lens_git_path = path
        g_lens_git_revision = ""
        g_lens_git_version = -1
        g_lens_git_observed = -1
        g_lens_git_poll = 0.0
    }
    if g_doc_version != g_lens_git_observed {
        g_lens_git_observed = g_doc_version
        g_lens_git_deadline = now + 0.2
        lens_diff_clear()
        lens_diff_build_rows()
    }
    if moving || now < g_lens_git_deadline {
        return
    }
    if now >= g_lens_git_poll {
        let revision = os_git_revision(path)
        g_lens_git_poll = now + 2.0
        if revision != g_lens_git_revision {
            g_lens_git_revision = revision
            g_lens_git_version = -1
            if revision != "" && lens_git_load_base(path, revision) == false {
                g_lens_git_revision = ""
            }
        }
    }
    if g_lens_git_revision == "" || g_lens_git_version == g_doc_version {
        return
    }
    let hash = os_text_hash(g_lens_git_revision + os_text_hash(g_doc))
    let file = lens_cache_path(path, "diff")
    let patch = lens_cache_get(file, hash, LENS_EDIT_BYTES)
    if g_lens_cache_found == false {
        patch = os_git_diff_text(g_lens_git_base, g_doc, LENS_EDIT_BYTES)
        if os_git_status() < 0 {
            return
        }
        lens_cache_put(file, hash, patch)
    }
    lens_diff_parse(patch)
    g_lens_git_version = g_doc_version
}

fn lens_diff_visual_text(row: i32) str {
    let source = g_lens_diff_rows[row]
    if source < 0 {
        return g_lens_diff_deleted[-1 - source]
    }
    return line_text(source)
}
