// Persistent minimap: every file keeps its own retained bar batch, built once
// from its text and kept across camera moves, preview-cache evictions and
// workspace rescans, so a leaf showing bars never blanks while the camera
// moves. A batch is rebuilt only when its file's text or column flow changes.
use std
use os
use ui

let g_lens_mini_batch = [i32](4096)
let g_lens_mini_path = [str](4096)
let g_lens_mini_hash = [str](4096)
let g_lens_mini_lines = [i32](4096)
let g_lens_mini_rows = [i32](4096)
let g_lens_mini_column_pitch = [f64](4096)
let g_lens_mini_line_pitch = [f64](4096)
let g_lens_mini_document = [bool](4096)
let g_lens_mini_doc_version = [i32](4096)
let g_lens_mini_diff_version = [i32](4096)
let g_lens_mini_fit = [f64](4096)
// Batches whose files left the workspace, destroyed on the next frame.
let g_lens_mini_drop = [i32](4096)
let g_lens_mini_drop_count: i32 = 0
// Texts read since the last frame, built when a renderer is at hand.
let g_lens_mini_queue_index = [i32](8)
let g_lens_mini_queue_text = [str](8)
let g_lens_mini_queue_block = [i32](8)
let g_lens_mini_build_block: i32 = 0
let g_lens_mini_queue_count: i32 = 0

// A rescan renumbers entries: carry each batch over to its path's new index.
fn lens_mini_remap() {
    let old_index = [str: i32](8192)
    for j in 0 to 4096 {
        if g_lens_mini_batch[j] != 0 && g_lens_mini_path[j] != "" {
            old_index[g_lens_mini_path[j]] = j
        }
    }
    let batch = [i32](4096)
    let hash = [str](4096)
    let lines = [i32](4096)
    let rows = [i32](4096)
    let fit = [f64](4096)
    let column_pitch = [f64](4096)
    let line_pitch = [f64](4096)
    let document = [bool](4096)
    let kept = [i32](4096)
    for i in 0 to g_workspace_count {
        let path = os_entry_path(i)
        if has(old_index, path) {
            let j = old_index[path]
            batch[i] = g_lens_mini_batch[j]
            hash[i] = g_lens_mini_hash[j]
            lines[i] = g_lens_mini_lines[j]
            rows[i] = g_lens_mini_rows[j]
            fit[i] = g_lens_mini_fit[j]
            column_pitch[i] = g_lens_mini_column_pitch[j]
            line_pitch[i] = g_lens_mini_line_pitch[j]
            document[i] = g_lens_mini_document[j]
            kept[j] = 1
        }
    }
    for j in 0 to 4096 {
        if g_lens_mini_batch[j] != 0 && kept[j] == 0 && g_lens_mini_drop_count < 4096 {
            g_lens_mini_drop[g_lens_mini_drop_count] = g_lens_mini_batch[j]
            g_lens_mini_drop_count = g_lens_mini_drop_count + 1
        }
    }
    for i in 0 to 4096 {
        g_lens_mini_batch[i] = batch[i]
        g_lens_mini_hash[i] = hash[i]
        g_lens_mini_lines[i] = lines[i]
        g_lens_mini_rows[i] = rows[i]
        g_lens_mini_fit[i] = fit[i]
        g_lens_mini_column_pitch[i] = column_pitch[i]
        g_lens_mini_line_pitch[i] = line_pitch[i]
        g_lens_mini_document[i] = document[i]
        g_lens_mini_doc_version[i] = -1
        g_lens_mini_diff_version[i] = -1
        g_lens_mini_path[i] = ""
        if i < g_workspace_count {
            g_lens_mini_path[i] = os_entry_path(i)
        }
    }
    g_lens_mini_queue_count = 0
}

fn lens_mini_offer(index: i32, text: str) {
    if index < 0 || index >= g_workspace_count || g_lens_mini_queue_count >= 8 {
        return
    }
    g_lens_mini_queue_block[g_lens_mini_queue_count] = 0
    g_lens_mini_queue_index[g_lens_mini_queue_count] = index
    g_lens_mini_queue_text[g_lens_mini_queue_count] = text
    g_lens_mini_queue_count = g_lens_mini_queue_count + 1
}

fn lens_mini_offer_block(index: i32, text: str, block: i32) {
    let slot = g_lens_mini_queue_count
    lens_mini_offer(index, text)
    if g_lens_mini_queue_count > slot {
        g_lens_mini_queue_block[slot] = block
    }
}

fn lens_mini_ready(index: i32) bool {
    return g_lens_mini_batch[index] != 0
}

// True when the file's leaf now flows its lines differently from its batch.
fn lens_mini_stale(index: i32) bool {
    lens_code_flow(index, g_lens_mini_lines[index])
    return g_lens_flow_rows != g_lens_mini_rows[index] || g_lens_flow_column_pitch != g_lens_mini_column_pitch[index] || g_lens_flow_line_pitch != g_lens_mini_line_pitch[index]
}

fn lens_mini_update(r: ref ui_renderer) {
    for d in 0 to g_lens_mini_drop_count {
        ui_rect_batch_destroy(r, g_lens_mini_drop[d])
    }
    g_lens_mini_drop_count = 0
    // A close view only spends the frame on leaves actually on screen.
    // Off-screen texts stay queued until the camera pulls back.
    let keep: i32 = 0
    for q in 0 to g_lens_mini_queue_count {
        let index = g_lens_mini_queue_index[q]
        let build = g_lens_close_view == false || (index >= 0 && index < g_workspace_count && g_lens_on_screen[index] != 0)
        if build {
            g_lens_mini_build_block = g_lens_mini_queue_block[q]
            lens_mini_build(r, index, g_lens_mini_queue_text[q])
            g_lens_mini_build_block = 0
            g_lens_mini_queue_text[q] = ""
        } else {
            if keep != q {
                g_lens_mini_queue_index[keep] = index
                g_lens_mini_queue_block[keep] = g_lens_mini_queue_block[q]
                g_lens_mini_queue_text[keep] = g_lens_mini_queue_text[q]
                g_lens_mini_queue_text[q] = ""
            }
            keep = keep + 1
        }
    }
    g_lens_mini_queue_count = keep
}

fn lens_text_lines(text: str) i32 {
    let rows: i32 = 1
    for byte in text {
        if byte == 10 {
            rows = rows + 1
        }
    }
    return rows
}

// 0 code, 1 string, 2 comment: a bar breaks where the class changes.
fn lens_token_class(kind: i32) i32 {
    if kind == TK_COMMENT() {
        return 2
    }
    if kind == TK_STRING() {
        return 1
    }
    return 0
}

// One bar per code segment rather than per token: a segment runs across
// single spaces and stops at a wider gap or where code turns into a string or
// comment. It keeps the shape and colour of the code at a fraction of the
// vertices, so the whole project's minimap stays resident.
fn lens_mini_build(r: ref ui_renderer, index: i32, text: str) {
    lens_mini_build_content(r, index, text, false)
}

// Keep Git ghost rows in both forms so changing LOD cannot reflow the file.
fn lens_mini_sync_document(r: ref ui_renderer, index: i32) {
    if !g_lens_mini_document[index] || g_lens_mini_doc_version[index] != g_doc_version || g_lens_mini_diff_version[index] != g_lens_diff_revision || lens_mini_stale(index) {
        lens_mini_build_content(r, index, g_doc, true)
        g_lens_mini_doc_version[index] = g_doc_version
        g_lens_mini_diff_version[index] = g_lens_diff_revision
    }
}

fn lens_mini_build_content(r: ref ui_renderer, index: i32, text: str, document: bool) {
    let lines = lens_text_lines(text)
    if document {
        lines = g_lens_diff_count
    } else if g_lens_mini_build_block != 0 {
        lines = g_lens_source_lines[index]
    }
    lens_code_flow(index, lines)
    let rows = g_lens_flow_rows
    let hash = os_text_hash(text)
    if document {
        hash = hash + ":" + itos(g_lens_diff_revision)
    } else if g_lens_mini_build_block != 0 {
        hash = hash + ":block" + itos(g_lens_mini_build_block)
    }
    if g_lens_mini_batch[index] != 0 && g_lens_mini_hash[index] == hash && g_lens_mini_rows[index] == rows && !lens_mini_stale(index) {
        g_lens_mini_fit[index] = g_lens_flow_fit
        return
    }
    let batch = g_lens_mini_batch[index]
    if batch == 0 {
        batch = ui_rect_batch_create(r)
        if batch == 0 {
            return
        }
    }
    let char_w = ui_mono_char_width(r, code_base_font_px(), CODE_FONT())
    if char_w <= 0.0 {
        char_w = code_base_font_px() * 0.6
    }
    let first_row: i32 = 0
    let first_col: i32 = 0
    if g_lens_mini_build_block != 0 {
        let block = g_lens_blocks[g_lens_mini_build_block]
        first_row = block.row
        first_col = block.col
        if block.offset == 0 {
            ui_rect_batch_begin(r, batch)
        }
    } else {
        ui_rect_batch_begin(r, batch)
    }
    let start_vertex = ui_rect_batch_vertex_count(r, batch)
    let input = lens_batch_prepare(r, text, document, first_row, first_col, lines, rows, char_w, true)
    lens_batch_build(r, batch, ref input)
    ui_rect_batch_end(r, batch)
    if g_lens_mini_build_block != 0 {
        g_lens_block_mini_first[g_lens_mini_build_block] = start_vertex
        g_lens_block_mini_count[g_lens_mini_build_block] = ui_rect_batch_vertex_count(r, batch) - start_vertex
    }
    g_lens_mini_document[index] = document
    g_lens_mini_batch[index] = batch
    g_lens_mini_hash[index] = hash
    g_lens_mini_lines[index] = lines
    g_lens_mini_rows[index] = rows
    g_lens_mini_fit[index] = g_lens_flow_fit
    g_lens_mini_column_pitch[index] = g_lens_flow_column_pitch
    g_lens_mini_line_pitch[index] = g_lens_flow_line_pitch
}

// The file's bars at the leaf's code origin, scaled by the camera.
fn lens_mini_draw(r: ref ui_renderer, index: i32, x: f64, y: f64, zoom: f64, squash: f64) bool {
    let batch = g_lens_mini_batch[index]
    if batch == 0 || zoom <= 0.0 || g_lens_mini_fit[index] <= 0.0 {
        return false
    }
    let scale = zoom * g_lens_mini_fit[index]
    if g_lens_mini_document[index] {
        let world = clamp(g_lens_code_world, 0.000001, 1000000.0)
        ui_push_clip(r, x, y, g_lens_w[index] * zoom / world - 2.0, (g_lens_h[index] / world - LENS_LEAF_HEADER_REF) * zoom * squash - 1.0)
        y = y - g_code_scroll * scale * squash / g_code_zoom_y
        x = x - (g_coloff as f64) * ui_mono_char_width(r, code_base_font_px(), CODE_FONT()) * scale
    }
    ui_rect_batch_draw_range(r, batch, 0, ui_rect_batch_vertex_count(r, batch), x, y, scale, scale * squash)
    if g_lens_mini_document[index] {
        ui_pop_clip(r)
    }
    return true
}

// A loading marker until the worker builds this file's sole minimap batch.
// Once ready, the same batch scales continuously at every distance.
fn lens_mini_loading(r: ref ui_renderer, leaf: lens_leaf_rect, content: lens_leaf_rect) {
    if content.w <= 0.0 || content.h <= 0.0 {
        ui_fill_rect(r, leaf.x + leaf.w * 0.15, leaf.y + leaf.h * 0.45, leaf.w * 0.7, clamp(leaf.h * 0.15, 0.2, 1.0), col_muted(), 0.0)
        return
    }
    ui_push_clip(r, content.x, content.y, content.w, content.h)
    let height = clamp(content.h * 0.02, 0.5, 2.0)
    for row in 0 to 3 {
        let width = content.w * (0.62 - (row as f64) * 0.13)
        ui_fill_rect(r, content.x + content.w * 0.08, content.y + content.h * (0.12 + (row as f64) * 0.13), width, height, ui_pack_color("#555555"), 0.0)
    }
    ui_pop_clip(r)
}
