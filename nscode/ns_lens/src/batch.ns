// Native exec tasks build disjoint CPU batches. The caller joins every task
// before publishing vertices or changing document, syntax, theme or flow state.
use task

struct lens_batch_input {
    source: [str],
    offset: [i32],
    length: [i32],
    // Byte column of each entry's first byte within its line (non-zero only
    // when a chunk starts mid-line).
    lead: [i32],
    // Each entry's LENS_ROW_* Git state.
    kind: [i32],
    number: [str],
    row: [i32],
    vertex: [i32],
    colors: [u32],
    // Row backgrounds indexed by LENS_ROW_* (0 draws none).
    marks: [u32],
    count: i32,
    bytes: i32,
    first_row: i32,
    first_col: i32,
    rows: i32,
    // Bytes per display row; longer lines continue on the following rows.
    wrap: i32,
    column_pitch: f64,
    line_pitch: f64,
    char_w: f64,
    text_y: f64,
    number_y: f64,
    mini: bool,
    language: i32
}

// Default keeps every line. A glyph draw narrows this to the visible window
// and restores it before anyone else prepares a batch.
let g_lens_batch_c0: i32 = 0
let g_lens_batch_c1: i32 = 128
let g_lens_batch_r0: i32 = 0
let g_lens_batch_r1: i32 = 2147483647

fn lens_batch_window_reset() {
    g_lens_batch_c0 = 0
    g_lens_batch_c1 = LENS_MAX_COLUMNS
    g_lens_batch_r0 = 0
    g_lens_batch_r1 = 2147483647
}

fn lens_batch_keeps_row(row: i32, rows: i32) bool {
    if g_lens_batch_r1 > 100000000 { return true }
    let n = rows
    if n < 1 { n = 1 }
    let column = row / n
    let local = row % n
    return column >= g_lens_batch_c0 && column < g_lens_batch_c1 && local >= g_lens_batch_r0 && local < g_lens_batch_r1
}

// Display rows of a `length`-byte line wrapped every `wrap` bytes. Byte c of
// a line sits on its row c / wrap at column c % wrap; an empty line keeps one.
fn lens_wrap_rows(length: i32, wrap: i32) i32 {
    if wrap <= 0 || length <= wrap {
        return 1
    }
    return (length + wrap - 1) / wrap
}

// Rows of a line from byte column `lead` on, for a chunk that starts mid-line.
fn lens_wrap_span(lead: i32, length: i32, wrap: i32) i32 {
    if lead <= 0 {
        return lens_wrap_rows(length, wrap)
    }
    return lens_wrap_rows(lead + length, wrap) - lead / clamp_i(wrap, 1, 100000000)
}

fn lens_text_rows(text: str, wrap: i32) i32 {
    let rows: i32 = 0
    let offset: i32 = 0
    loop true {
        let end = lens_line_end(text, offset)
        rows = rows + lens_wrap_rows(end - offset, wrap)
        if end >= text.len {
            return rows
        }
        offset = end + 1
    }
    return rows
}

// First byte at or after column `n` that starts a UTF-8 character, so a wrap
// never splits one: a character belongs to the row its first byte is on.
fn lens_char_start(source: str, offset: i32, length: i32, n: i32) i32 {
    let p = clamp_i(n, 0, length)
    loop p < length && (lens_byte(source, offset + p) & 192) == 128 { p = p + 1 }
    return p
}

// A minimap bar runs across gaps shorter than this many blanks.
lit LENS_BAR_GAP = 4
// A run of another colour this short joins the bar before it.
lit LENS_BAR_ABSORB = 2

// Git's added and deleted rows fill their whole row. The minimap uses a
// stronger shade than the editor so a leaf's change reads from far away.
fn lens_mark_color(kind: i32, mini: bool) u32 {
    if kind == LENS_ROW_ADDED {
        if mini {
            return ui_pack_color("#255c38")
        }
        return ui_pack_color("#183e2b")
    }
    if kind == LENS_ROW_DELETED {
        if mini {
            return ui_pack_color("#6e2a2a")
        }
        return ui_pack_color("#4b1e1e")
    }
    return 0u
}

struct lens_bar_run {
    end: i32,
    // Non-blank bytes in the run.
    chars: i32
}

// The run of tokens drawn in `color` from `start`, crossing gaps shorter
// than LENS_BAR_GAP.
fn lens_bar_run_of(source: str, offset: i32, m: i32, start: i32, color: u32, colors: [u32], language: i32) lens_bar_run {
    let end = start
    let chars: i32 = 0
    let p = start
    loop p < m {
        let token = lens_token_scan(source, offset, m, p, language)
        if colors[lens_token_kind(token)] != color {
            break
        }
        let q = clamp_i(lens_token_position(token), p + 1, m)
        for c in p to q {
            if !lens_is_blank(lens_byte(source, offset + c)) {
                chars = chars + 1
            }
        }
        end = q
        let n = q
        loop n < m && lens_is_blank(lens_byte(source, offset + n)) {
            n = n + 1
        }
        if n >= m || n - q >= LENS_BAR_GAP {
            break
        }
        p = n
    }
    return lens_bar_run(end, chars)
}

// One entry per source line or ghost row, each covering one or more display
// rows. A chunk's `first_row` is the display row of its first byte, which
// sits `first_col` bytes into its line. Document rows come from the wrap
// table; other text takes its ghost rows and added lines from `diff`.
fn lens_batch_prepare(r: ref ui_renderer, text: str, diff: lens_file_diff, document: bool, first_row: i32, first_col: i32, total: i32, rows: i32, wrap: i32, char_w: f64, mini: bool, language: i32) lens_batch_input {
    // Initialize every language's literal cache before native workers.
    for l in 0 to 4 {
        let keyword_ready = is_keyword_language("", 0, 0, l)
        let type_ready = is_type_word_language("", 0, 0, l)
    }
    let wrap_n = clamp_i(wrap, 1, 100000000)
    if document {
        lens_wrap_sync(wrap_n)
    }
    let capacity = g_lens_diff_count
    if !document { capacity = lens_text_lines(text) + diff.deleted_count }
    if g_lens_batch_r1 <= 100000000 {
        let span = g_lens_batch_r1 - g_lens_batch_r0
        let cols = g_lens_batch_c1 - g_lens_batch_c0
        if span < 0 { span = 0 }
        if cols < 0 { cols = 0 }
        let n64 = (span as i64) * (cols as i64)
        let n: i32 = 1000000
        if n64 < 1000000 { n = n64 as i32 }
        if n < capacity { capacity = n }
    }
    if capacity < 0 { capacity = 0 }
    let rows_n = rows
    if rows_n < 1 { rows_n = 1 }
    let input = lens_batch_input {
        [str](capacity), [i32](capacity), [i32](capacity), [i32](capacity), [i32](capacity),
        [str](capacity), [i32](capacity), [i32](capacity), [u32](9), [u32](3),
        0, 0, first_row, first_col,
        rows, wrap_n, g_lens_flow_column_pitch,
        g_lens_flow_line_pitch, char_w,
        text_center_y(r, 0.0, g_lens_flow_line_pitch, code_base_font_px()),
        text_center_y(r, 0.0, g_lens_flow_line_pitch, small_px()), mini, language
    }
    for kind in 0 to 9 {
        input.colors[kind] = token_color(kind)
        if mini { input.colors[kind] = (token_color(kind) & 0x00ffffffu) | 0xa5000000u }
    }
    for kind in 0 to 3 {
        input.marks[kind] = lens_mark_color(kind, mini)
        // A ui batch holds rects or glyphs, never both, so a glyph batch
        // leaves its row backgrounds to lens_batch_marks; the editor draws the
        // open document's itself.
        if !mini { input.marks[kind] = 0u }
    }
    let offset: i32 = 0
    let row = first_row
    let lead = first_col
    let line = first_row
    // Document diff row, or this text's next source line, ghost row and added line.
    let at: i32 = 0
    let source_line: i32 = 0
    let ghost: i32 = 0
    let added: i32 = 0
    if document {
        at = lens_wrap_find(first_row)
    }
    loop row < total && input.count < capacity {
        let is_ghost = !document && ghost < diff.deleted_count && diff.anchor[ghost] <= source_line
        if (document && at >= g_lens_diff_count) || (!document && !is_ghost && offset >= text.len) {
            break
        }
        let source = text
        let start = offset
        let end = 0
        let number = line + 1
        let span: i32 = 1
        let kind = LENS_ROW_KEPT
        if document {
            source = lens_diff_visual_text(at)
            start = 0
            end = source.len
            number = g_lens_diff_rows[at] + 1
            row = g_lens_wrap_first[at]
            span = g_lens_wrap_first[at + 1] - row
            lead = 0
            if g_lens_diff_rows[at] < 0 {
                kind = LENS_ROW_DELETED
            } else if g_lens_diff_added[clamp_i(g_lens_diff_rows[at], 0, 65535)] != 0 {
                kind = LENS_ROW_ADDED
            }
        } else if is_ghost {
            source = diff.deleted[ghost]
            start = 0
            end = source.len
            number = 0
            span = lens_wrap_rows(end, wrap_n)
            kind = LENS_ROW_DELETED
        } else {
            end = lens_line_end(text, offset)
            span = lens_wrap_span(lead, end - offset, wrap_n)
            loop added < diff.added_count && diff.added[added] < source_line {
                added = added + 1
            }
            if diff.all_added || (added < diff.added_count && diff.added[added] == source_line) {
                kind = LENS_ROW_ADDED
            }
        }
        // Only the chunk's first source line starts mid-line.
        let entry_lead = lead
        if document || is_ghost {
            entry_lead = 0
        }
        let keep = false
        for s in 0 to span {
            if !keep && lens_batch_keeps_row(row + s, rows_n) {
                keep = true
            }
        }
        if keep {
            let i = input.count
            input.source[i] = substr(source, start, end - start)
            input.offset[i] = 0
            input.length[i] = end - start
            input.lead[i] = entry_lead
            input.kind[i] = kind
            input.row[i] = row
            if !mini {
                input.number[i] = itos(number)
                if number == 0 { input.number[i] = "-" }
                if entry_lead != 0 { input.number[i] = "" }
            }
            input.bytes = input.bytes + end - start + 1
            input.count = i + 1
        }
        if document {
            at = at + 1
        } else if is_ghost {
            ghost = ghost + 1
        } else {
            offset = end + 1
            line = line + 1
            source_line = source_line + 1
            lead = 0
        }
        row = row + span
    }
    return input
}

// Entry i's Git background in `mark`, across every row it wraps onto.
fn lens_batch_mark_rows(r: ref ui_renderer, batch: i32, input: ref lens_batch_input, i: i32, mark: u32) {
    let wrap = clamp_i(input.wrap, 1, 100000000)
    let row = input.row[i]
    let top = code_base_top_pad()
    for s in 0 to lens_wrap_span(input.lead[i], input.length[i], wrap) {
        let back = row + s
        let back_x = (clamp_i(back / input.rows, 0, LENS_MAX_COLUMNS - 1) as f64) * input.column_pitch
        ui_rect_batch_add(r, batch, back_x, top + ((back % input.rows) as f64) * input.line_pitch, input.column_pitch, input.line_pitch, mark)
    }
}

// The added and deleted row backgrounds of glyph entries, a rect batch drawn
// under their glyph batch.
fn lens_batch_marks(r: ref ui_renderer, batch: i32, input: ref lens_batch_input) {
    for i in 0 to input.count {
        let mark = lens_mark_color(input.kind[i], false)
        if mark != 0u {
            lens_batch_mark_rows(r, batch, input, i, mark)
        }
    }
}

fn lens_batch_range(r: ref ui_renderer, batch: i32, input: ref lens_batch_input, begin: i32, end: i32) {
    let font_px = code_base_font_px()
    let number_px = small_px()
    let measure_font = FONT_MONO()
    let muted = col_muted()
    let gutter = code_base_gutter_w()
    let inset = code_base_text_inset()
    let top = code_base_top_pad()
    let bar_h = code_base_line_h()
    let wrap = clamp_i(input.wrap, 1, 100000000)
    for i in begin to end {
        input.vertex[i] = ui_rect_batch_vertex_count(r, batch)
        let row = input.row[i]
        let lead = input.lead[i]
        let base = lead / wrap
        let mark = input.marks[input.kind[i]]
        if mark != 0u {
            // Added and deleted rows fill their background behind the bars.
            lens_batch_mark_rows(r, batch, input, i, mark)
        }
        if !input.mini {
            let number = input.number[i]
            let column_x = (clamp_i(row / input.rows, 0, LENS_MAX_COLUMNS - 1) as f64) * input.column_pitch
            let number_x = column_x + gutter - 10.0 - ui_text_width(r, number, number_px, measure_font)
            ui_rect_batch_add_text(r, batch, number_x, top + ((row % input.rows) as f64) * input.line_pitch + input.number_y, number, number_px, muted, CODE_FONT())
        }
        let source = input.source[i]
        let offset = input.offset[i]
        let m = input.length[i]
        let p: i32 = 0
        loop p < m {
            if lens_is_blank(lens_byte(source, offset + p)) {
                p = p + 1
            } else {
                let token = lens_token_scan(source, offset, m, p, input.language)
                let q = clamp_i(lens_token_position(token), p + 1, m)
                let color = input.colors[lens_token_kind(token)]
                if input.mini {
                    // A bar keeps its first token's colour. It ends at a gap of
                    // LENS_BAR_GAP blanks, or where a run of another colour is
                    // longer than LENS_BAR_ABSORB; a shorter run joins it.
                    let more = true
                    loop more && q < m {
                        let n = q
                        loop n < m && lens_is_blank(lens_byte(source, offset + n)) { n = n + 1 }
                        if n >= m || n - q >= LENS_BAR_GAP {
                            more = false
                        } else {
                            let next = input.colors[lens_token_kind(lens_token_scan(source, offset, m, n, input.language))]
                            let run = lens_bar_run_of(source, offset, m, n, next, input.colors, input.language)
                            if next == color || run.chars <= LENS_BAR_ABSORB {
                                q = clamp_i(run.end, n + 1, m)
                            } else {
                                more = false
                            }
                        }
                    }
                }
                // The whole line is tokenized, so a wrapped token keeps its
                // colour; its pieces break at each wrap onto the next row.
                let a = p
                loop a < q {
                    let segment = (lead + a) / wrap
                    let e = clamp_i(lens_char_start(source, offset, m, (segment + 1) * wrap - lead), a + 1, q)
                    let piece_row = row + segment - base
                    let column_x = (clamp_i(piece_row / input.rows, 0, LENS_MAX_COLUMNS - 1) as f64) * input.column_pitch
                    let x = column_x + gutter + inset + ((lead + a - segment * wrap) as f64) * input.char_w
                    let row_top = top + ((piece_row % input.rows) as f64) * input.line_pitch
                    if input.mini {
                        ui_rect_batch_add(r, batch, x, row_top + (input.line_pitch - bar_h) * 0.5 + bar_h * 0.25, ((e - a) as f64) * input.char_w, bar_h * 0.5, color)
                    } else {
                        ui_rect_batch_add_text_range(r, batch, x, row_top + input.text_y, source, offset + a, e - a, font_px, color, CODE_FONT())
                    }
                    a = e
                }
                p = q
            }
        }
    }
}

// Keep inferred typed task handles on the stack; all tasks are launched before
// joining, and each join reports completion into a disjoint result slot.
fn lens_batch_dispatch(r: ref ui_renderer, input: ref lens_batch_input, batches: [i32], starts: [i32], completed: [bool], worker: i32, workers: i32) {
    if worker >= workers { return }
    let output = batches[worker]
    if output == 0 {
        lens_batch_dispatch(r, input, batches, starts, completed, worker + 1, workers)
        return
    }
    let begin = starts[worker]
    let end = starts[worker + 1]
    let source = input.source
    let offset = input.offset
    let length = input.length
    let lead = input.lead
    let kind = input.kind
    let number = input.number
    let row = input.row
    let vertex = input.vertex
    let colors = input.colors
    let marks = input.marks
    let count = input.count
    let bytes = input.bytes
    let first_row = input.first_row
    let first_col = input.first_col
    let rows = input.rows
    let wrap = input.wrap
    let column_pitch = input.column_pitch
    let line_pitch = input.line_pitch
    let char_w = input.char_w
    let text_y = input.text_y
    let number_y = input.number_y
    let mini = input.mini
    let language = input.language
    let pending = dispatch(queue_worker) { in
        let work = lens_batch_input(source, offset, length, lead, kind, number, row, vertex, colors, marks, count, bytes, first_row, first_col, rows, wrap, column_pitch, line_pitch, char_w, text_y, number_y, mini, language)
        lens_batch_range(r, output, ref work, begin, end)
    }
    lens_batch_dispatch(r, input, batches, starts, completed, worker + 1, workers)
    wait(pending)
    completed[worker] = !cancelled(pending)
}

// Small pages stay inline. Split large pages by source bytes at row boundaries,
// so long lines do not leave most of the CPUs idle. Batch allocation/merge and
// destruction stay on the caller; workers only mutate their assigned batches
// and disjoint ranges of input.vertex. No worker issues GPU calls.
fn lens_batch_build(r: ref ui_renderer, batch: i32, input: ref lens_batch_input) {
    if input.count == 0 { return }
    let workers = clamp_i(input.bytes / 8192, 1, os_cpu_count())
    workers = clamp_i(workers, 1, input.count)
    if workers <= 1 {
        lens_batch_range(r, batch, input, 0, input.count)
        return
    }
    let batches = [i32](workers)
    let starts = [i32](workers + 1)
    let completed = [bool](workers)
    let bytes: i32 = 0
    let cursor: i32 = 0
    for w in 0 to workers {
        starts[w] = cursor
        let target = ((input.bytes as i64) * ((w + 1) as i64) / (workers as i64)) as i32
        loop cursor < input.count && (w == workers - 1 || bytes < target) {
            bytes = bytes + input.length[cursor] + 1
            cursor = cursor + 1
        }
        starts[w + 1] = cursor
        batches[w] = ui_rect_batch_create(r)
        if batches[w] != 0 { ui_rect_batch_begin(r, batches[w]) }
    }
    lens_batch_dispatch(r, input, batches, starts, completed, 0, workers)
    for w in 0 to workers {
        let output = batches[w]
        let base = ui_rect_batch_vertex_count(r, batch)
        let merged = false
        if output != 0 && completed[w] {
            merged = ui_rect_batch_append(r, batch, output)
        }
        if merged {
            for i in starts[w] to starts[w + 1] { input.vertex[i] = input.vertex[i] + base }
        } else {
            // Preserve serial atlas selection and handle allocation/task failure.
            lens_batch_range(r, batch, input, starts[w], starts[w + 1])
        }
        if output != 0 { ui_rect_batch_destroy(r, output) }
    }
}
