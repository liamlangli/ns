// Perspective treemap. Metadata stays resident; source previews are an LRU.
use std
use os
use view
use ui
use workspace
use editor

lit LENS_CORNER_RADIUS = 3.0
lit LENS_CACHE_SLOTS = 48
// Code is laid out once per cached page in code-layout pixels (the editor's
// metrics at zoom 1) and drawn scaled by the camera. The zoom picks one of
// two forms: glyphs or persistent minimap bars; close enough, the resident
// file becomes the editor at the same scale.
lit LENS_MAX_ZOOM = 2.5
lit LENS_DISTANCE_LIMIT = 1000000000.0
// Wheel zoom per scroll unit: fast with the camera down at the code, slow
// high above the map, easing between with the square root of the distance.
lit LENS_WHEEL_NEAR = 0.05
lit LENS_WHEEL_FAR = 0.012
lit LENS_ORTHO_SNAP = 5.0
lit LENS_MAX_TILT = 60.0
lit LENS_EDIT_ZOOM = 0.5
lit LENS_GLYPH_ZOOM: f64 = 0.18
// On a tilted plane the far edge compresses many lines into a few screen
// pixels. Glyphs sampled there vanish; bars stay visible down to this height.
lit LENS_PLANE_LINE_FLOOR = 3.0
// Extra columns and local rows kept around the visible window, so a small
// pan or scroll reuses the glyph batch instead of tessellating it again.
lit LENS_GLYPH_COL_MARGIN = 1
lit LENS_GLYPH_ROW_MARGIN = 30
// Code flows in newspaper columns this many characters wide (layout pixels
// per column below), so a tall file fills a wide leaf instead of overflowing.
lit LENS_COLUMN_REF = 800.0
lit LENS_MAX_COLUMNS = 128
// Source bytes per line when sizing a leaf from metadata alone. Directories
// only partition the treemap, so files use the whole map.
lit LENS_LAYOUT_FILL = 1.0
lit LENS_PAGE_BYTES = 8192
// Screen size range of the large file name shown over a leaf's minimap.
lit LENS_NAME_MIN_PX = 6.0
lit LENS_NAME_MAX_PX = 9.0
let g_lens_files = [i32](4096)
let g_lens_names = [str](4096)
// Project-relative path of each entry, shown in a leaf's header row.
let g_lens_paths = [str](4096)
let g_lens_weight = [f64](4096)
let g_lens_x = [f64](4096)
let g_lens_y = [f64](4096)
let g_lens_w = [f64](4096)
let g_lens_h = [f64](4096)
let g_lens_cache_id = [i32](48)
let g_lens_cache_text = [str](49)
let g_lens_cache_age = [i32](48)
let g_lens_cache_offset = [i64](48)
let g_lens_preview_count = [i32](48)
// Display rows of each cached text at the wrap width they were counted at.
let g_lens_preview_rows = [i32](48)
let g_lens_preview_wrap = [i32](48)
let g_lens_preview_patch = [i32](48)
let g_lens_glyph_batch = [i32](49)
let g_lens_glyph_dirty = [i32](49)
// World units per code-layout pixel, so every leaf's code shares one size.
let g_lens_code_world: f64 = 1.0
let g_lens_folder_header = [f64](4096)
let g_lens_slot_index = [i32](49)
let g_lens_slot_rows = [i32](49)
let g_lens_glyph_time = [f64](49)
let g_lens_glyph_frame = [i32](49)
// Column and local-row span last tessellated into each slot, including margin.
let g_lens_built_c0 = [i32](49)
let g_lens_built_c1 = [i32](49)
let g_lens_built_r0 = [i32](49)
let g_lens_built_r1 = [i32](49)
let g_lens_render_serial: i32 = 0
lit LENS_GLYPH_VERTEX_BUDGET = 2000000
// Display rows of each file: its lines plus their wrapped continuations.
let g_lens_source_rows = [i32](4096)
// Bytes per display row: most lines fit, longer ones wrap onto more rows.
let g_lens_source_columns = [i32](4096)
let g_lens_slot_column_pitch = [f64](49)
let g_lens_slot_line_pitch = [f64](49)
let g_lens_slot_wrap = [i32](49)
let g_lens_flow_column_pitch: f64 = 800.0
let g_lens_flow_line_pitch: f64 = 20.0
let g_lens_flow_columns: i32 = 1
let g_lens_flow_rows: i32 = 1
let g_lens_flow_fit: f64 = 1.0
// Each file's largest scale for its source line count. Fewer lines keep it,
// so editing does not resize the font until the text outgrows the leaf.
let g_lens_leaf_fit = [f64](4096)
let g_lens_document_version: i32 = -1
let g_lens_document_diff: i32 = -1
let g_lens_document_index: i32 = -1
let g_lens_document_wrap: i32 = -1

let g_lens_file_count: i32 = 0
// 0 code: recognized source. 1 change: git staged, unstaged, untracked.
// 2 full: every scanned file. Name-only leaves (g_lens_files == 2) are files
// the editor does not treat as text.
lit LENS_MODE_CODE = 0
lit LENS_MODE_CHANGE = 1
lit LENS_MODE_FULL = 2
// The bar over the top of the map that holds the File and map menus, a
// little taller than the status bar; its controls are as tall as the status
// bar's.
lit LENS_TOP_BAR_H = 32.0
// Floating panels and popups (the outline, the terminal, menu dropdowns, the
// search box and the commit and ignore dialogs) share an 80% opaque background
// so the map stays visible behind them without making their text hard to read.
lit LENS_FLOAT_ALPHA = 204

fn lens_float_color(color: u32) u32 {
    return (color & 0x00ffffffu) | ((LENS_FLOAT_ALPHA as u32) << 24)
}
lit LENS_MODE_W = 80.0
lit LENS_MODE_H = 20.0
lit LENS_MODE_ITEM = 26.0
let g_lens_view_mode: i32 = 0
let g_lens_mode_open = false
let g_lens_mode_block = false
// Folder whose contents the map shows, as a workspace entry index and its
// absolute path. -1 and "" show the whole opened project; the View > Outline
// panel sets and clears the scope. Directories only group the treemap, so a
// scope changes which leaves are laid out, never the map's shape otherwise.
let g_lens_scope: i32 = -1
let g_lens_scope_path = ""
let g_lens_change_path = [str](4096)
let g_lens_change_count: i32 = 0
let g_lens_change_text = ""
let g_lens_change_root = ""
let g_lens_change_poll: f64 = 0.0
let g_lens_changes_dirty = false
let g_lens_preview_slot: i32 = -1
let g_lens_preview_builds: i32 = 0
let g_lens_page: i64 = 0
let g_lens_preview_read = false
let g_lens_clock: i32 = 0
let g_lens_generation: i32 = -1
let g_lens_distance: f64 = 1600.0
let g_lens_target_distance: f64 = 1600.0
let g_lens_ref_return_distance: f64 = 1600.0
let g_lens_ref_return_x: f64 = 0.0
let g_lens_ref_return_y: f64 = 0.0
let g_lens_center_x: f64 = 0.0
let g_lens_center_y: f64 = 0.0
let g_lens_target_x: f64 = 0.0
let g_lens_target_y: f64 = 0.0
// Map tilt in degrees. Under LENS_ORTHO_SNAP the camera is orthographic and
// a released drag settles back to 0; past it the map is a plane in perspective.
let g_lens_tilt: f64 = 0.0
let g_lens_screen_drag_y: f64 = 0.0
// Plane camera for this frame: the pivot, the pinhole distance, the tilt in
// radians, and the part of the flat map the screen can see.
let g_lens_plane_cx: f64 = 0.0
let g_lens_plane_cy: f64 = 0.0
let g_lens_plane_focal: f64 = 1.0
let g_lens_plane_tilt: f64 = 0.0
let g_lens_view_x0: f64 = 0.0
let g_lens_view_y0: f64 = 0.0
let g_lens_view_x1: f64 = 0.0
let g_lens_view_y1: f64 = 0.0
let g_lens_plane_x: f64 = 0.0
let g_lens_plane_y: f64 = 0.0
// Drawable height the plane matrix projects with. 0 keeps the flat scale.
let g_lens_screen_h: f64 = 0.0
// Last frame had a viewport leaf at glyph size. Background minimap builds stay
// off that frame; they resume when the camera pulls back above the glyph zoom.
let g_lens_close_view = false
let g_lens_on_screen = [i32](4096)
let g_lens_drag_x: f64 = 0.0
let g_lens_drag_y: f64 = 0.0
let g_lens_selected: i32 = -1
let g_lens_selected_path = ""
let g_lens_editing = false
let g_lens_reading = false
let g_lens_canvas_h: f64 = 800.0
// The map viewport of the last frame, for camera moves made outside it.
let g_lens_view_w: f64 = 1280.0
let g_lens_body_h: f64 = 680.0
let g_lens_message = ""
// A floating panel changed something that needs one more frame (a rescan, a
// terminal chunk, or a prompt action). The frame request at the end consumes it.
let g_lens_input_dirty = false
// Leaf whose path label took the last left press, and the pointer there.
let g_lens_label_press: i32 = -1
let g_lens_label_press_x: f64 = 0.0
let g_lens_label_press_y: f64 = 0.0

fn lens_clear_cache() {
    for i in 0 to LENS_CACHE_SLOTS {
        g_lens_cache_id[i] = -1
        g_lens_cache_text[i] = ""
        g_lens_cache_age[i] = 0
        lens_build_preview(i, "")
    }
}

// Binary weighted partitions keep siblings together and avoid skinny strips.
fn lens_partition(ids: [i32], first: i32, end: i32, x: f64, y: f64, w: f64, h: f64) {
    if end <= first {
        return
    }
    if end == first + 1 {
        let i = ids[first]
        g_lens_x[i] = x
        g_lens_y[i] = y
        g_lens_w[i] = w
        g_lens_h[i] = h
        return
    }
    let total: f64 = 0.0
    for j in first to end {
        total = total + g_lens_weight[ids[j]]
    }
    let split = first + 1
    let left = g_lens_weight[ids[first]]
    loop split < end - 1 && left < total * 0.5 {
        left = left + g_lens_weight[ids[split]]
        split = split + 1
    }
    let ratio = left / total
    if w >= h {
        lens_partition(ids, first, split, x, y, w * ratio, h)
        lens_partition(ids, split, end, x + w * ratio, y, w * (1.0 - ratio), h)
    } else {
        lens_partition(ids, first, split, x, y, w, h * ratio)
        lens_partition(ids, split, end, x, y + h * ratio, w, h * (1.0 - ratio))
    }
}

fn lens_layout_children(parent: i32, x0: f64, y0: f64, w0: f64, h0: f64) {
    // A directory only groups its children. They fill its rectangle; the
    // directory itself is not drawn.
    let ids = [i32](4096)
    let count: i32 = 0
    for i in 0 to g_workspace_count {
        if os_entry_parent(i) == parent && g_lens_weight[i] > 0.0 {
            ids[count] = i
            count = count + 1
        }
    }
    lens_partition(ids, 0, count, x0, y0, w0, h0)
    for j in 0 to count {
        let i = ids[j]
        if os_entry_is_dir(i) != 0 {
            lens_layout_children(i, g_lens_x[i], g_lens_y[i], g_lens_w[i], g_lens_h[i])
        }
    }
}

fn lens_git_unavailable() str {
    return "Git status is unavailable"
}

fn lens_relative_path(path: str) str {
    let root = g_workspace_root
    let root_len = root.len
    loop root_len > 0 {
        let c = (root[root_len - 1] as i32) & 255
        if c != 47 && c != 92 {
            break
        }
        root_len = root_len - 1
    }
    if root_len == 0 || path.len <= root_len {
        return path
    }
    for i in 0 to root_len {
        if ((path[i] as i32) & 255) != ((root[i] as i32) & 255) {
            return path
        }
    }
    let sep = (path[root_len] as i32) & 255
    if sep != 47 && sep != 92 {
        return path
    }
    let rel = substr(path, root_len + 1, path.len - root_len - 1)
    let slash = false
    for i in 0 to rel.len {
        if ((rel[i] as i32) & 255) == 92 {
            slash = true
            break
        }
    }
    if slash == false {
        return rel
    }
    let out = ""
    for i in 0 to rel.len {
        let c = (rel[i] as i32) & 255
        if c == 92 {
            out = out + "/"
        } else {
            out = out + substr(rel, i, 1)
        }
    }
    return out
}

fn lens_changes_parse(text: str) {
    let old = g_lens_change_count
    g_lens_change_count = 0
    let start: i32 = 0
    for i in 0 to text.len + 1 {
        if i == text.len || ((text[i] as i32) & 255) == 10 {
            if i > start && g_lens_change_count < 4096 {
                g_lens_change_path[g_lens_change_count] = substr(text, start, i - start)
                g_lens_change_count = g_lens_change_count + 1
            }
            start = i + 1
        }
    }
    for i in g_lens_change_count to old {
        g_lens_change_path[i] = ""
    }
}

fn lens_change_has(relative: str) bool {
    for i in 0 to g_lens_change_count {
        if g_lens_change_path[i] == relative {
            return true
        }
    }
    return false
}

// Adopt a listing of `root` that Git returned with `status`; a list that
// differs from the shown one marks the map for a rebuild.
fn lens_changes_apply(text: str, status: i32, root: str) {
    let listed = text
    if status != 0 {
        listed = ""
        if g_lens_message == "" || g_lens_message == lens_git_unavailable() {
            g_lens_message = lens_git_unavailable()
        }
    } else if g_lens_message == lens_git_unavailable() {
        g_lens_message = ""
    }
    if listed != g_lens_change_text || g_lens_change_root != root {
        g_lens_change_text = listed
        g_lens_change_root = root
        lens_changes_parse(listed)
        g_lens_changes_dirty = true
    }
}

fn lens_entry_shown(index: i32) bool {
    if os_entry_is_dir(index) != 0 {
        return false
    }
    if g_lens_scope_path != "" && lens_scope_contains(index) == false {
        return false
    }
    if g_lens_view_mode == LENS_MODE_FULL {
        return true
    }
    if g_lens_view_mode == LENS_MODE_CHANGE {
        return lens_change_has(lens_relative_path(os_entry_path(index)))
    }
    return workspace_entry_code(index)
}

// Whether `index` is the scoped folder or lies below it.
fn lens_scope_contains(index: i32) bool {
    if g_lens_scope_path == "" {
        return true
    }
    let parent = index
    loop parent >= 0 {
        if parent == g_lens_scope {
            return true
        }
        parent = os_entry_parent(parent)
    }
    return false
}

// Re-resolve the scoped folder after a rescan or rename. A folder that is no
// longer in the snapshot clears the scope and brings the whole project back.
fn lens_scope_sync() {
    if g_lens_scope_path == "" {
        g_lens_scope = -1
        return
    }
    if g_lens_scope >= 0 && g_lens_scope < g_workspace_count && os_entry_is_dir(g_lens_scope) != 0 && os_entry_path(g_lens_scope) == g_lens_scope_path {
        return
    }
    let index = workspace_find_path(g_lens_scope_path)
    if index < 0 || os_entry_is_dir(index) == 0 {
        g_lens_scope = -1
        g_lens_scope_path = ""
    } else {
        g_lens_scope = index
    }
}

fn lens_scope_set(index: i32) {
    if index < 0 {
        lens_scope_clear()
        return
    }
    if index >= g_workspace_count || os_entry_is_dir(index) == 0 {
        return
    }
    g_lens_scope = index
    g_lens_scope_path = os_entry_path(index)
    // Scoping is a treemap action; ref mode returns to the map it filters.
    if g_lens_view_mode == LENS_MODE_REF {
        lens_set_mode(LENS_MODE_CODE)
    } else {
        lens_rebuild()
    }
    g_lens_target_x = 0.0
    g_lens_target_y = 0.0
    g_lens_target_distance = 1600.0
}

fn lens_scope_clear() {
    if g_lens_scope_path == "" && g_lens_scope < 0 {
        return
    }
    g_lens_scope = -1
    g_lens_scope_path = ""
    lens_rebuild()
    g_lens_target_x = 0.0
    g_lens_target_y = 0.0
    g_lens_target_distance = 1600.0
}

fn lens_include_file(index: i32) {
    let path = os_entry_path(index)
    if workspace_entry_editable(index) {
        let metrics = lens_file_metrics(path)
        if metrics.lines >= 1 {
            g_lens_files[index] = 1
            g_lens_source_rows[index] = clamp_i(metrics.rows as i32, 1, 100000000)
            g_lens_source_columns[index] = clamp_i(metrics.typical as i32, 1, 100000000)
            g_lens_weight[index] = g_lens_source_rows[index] as f64
            return
        }
    }
    let bytes = os_file_size(path)
    if bytes < 0 {
        return
    }
    let lines = (bytes / 64) as i32
    if lines < 4 {
        lines = 4
    }
    if lines > 400 {
        lines = 400
    }
    g_lens_files[index] = 2
    g_lens_source_rows[index] = lines
    g_lens_source_columns[index] = 40
    g_lens_weight[index] = lines as f64
}

fn lens_set_mode(mode: i32) {
    if mode == g_lens_view_mode {
        return
    }
    if mode == LENS_MODE_REF {
        g_lens_ref_return_distance = g_lens_target_distance
        g_lens_ref_return_x = g_lens_target_x
        g_lens_ref_return_y = g_lens_target_y
    } else if g_lens_view_mode == LENS_MODE_REF {
        g_lens_target_distance = g_lens_ref_return_distance
        g_lens_target_x = g_lens_ref_return_x
        g_lens_target_y = g_lens_ref_return_y
    }
    g_lens_view_mode = mode
    if mode == LENS_MODE_CHANGE {
        g_lens_change_poll = os_time() + 2.0
        lens_changes_request(false)
    } else if g_lens_message == lens_git_unavailable() {
        g_lens_message = ""
    }
    if mode == LENS_MODE_REF { g_lens_ref_root = g_lens_selected_path }
    g_lens_ref_drag = -1
    lens_rebuild()
    g_lens_changes_dirty = false
}

fn lens_rebuild() {
    lens_scope_sync()
    if g_lens_view_mode == LENS_MODE_CHANGE && g_lens_change_root != g_workspace_root {
        // Another folder's list must not pick this one's leaves. This
        // folder's listing arrives from the worker and rebuilds again.
        lens_changes_parse("")
        g_lens_change_text = ""
        lens_changes_request(false)
    }
    lens_mini_remap()
    lens_atlas_reset()
    lens_clear_cache()
    g_lens_ready_index = -1
    g_lens_ready_text = ""
    g_lens_warm_cursor = 0
    g_lens_selected = workspace_find_path(g_lens_selected_path)
    if g_lens_reading && g_lens_selected < 0 {
        g_lens_reading = false
    }
    if g_lens_editing {
        g_lens_selected = g_workspace_active
        if g_workspace_active < 0 {
            g_lens_editing = false
        }
    }
    lens_cache_init()
    for i in 0 to g_workspace_count {
        g_lens_weight[i] = 0.0
        g_lens_files[i] = 0
        g_lens_names[i] = os_entry_name(i)
        g_lens_paths[i] = lens_relative_path(os_entry_path(i))
        g_lens_folder_header[i] = 0.0
        if lens_entry_shown(i) {
            lens_include_file(i)
        }
    }
    let i = g_workspace_count - 1
    loop i >= 0 {
        let parent = os_entry_parent(i)
        if parent >= 0 {
            g_lens_weight[parent] = g_lens_weight[parent] + g_lens_weight[i]
        }
        i = i - 1
    }
    // Weights are code-layout areas; one world/layout ratio maps them onto
    // the map. Directories do not keep a frame of their own.
    g_lens_file_count = 0
    let code_area: f64 = 0.0
    for f in 0 to g_workspace_count {
        if g_lens_files[f] != 0 {
            g_lens_file_count = g_lens_file_count + 1
            code_area = code_area + (g_lens_weight[f] * code_base_line_h() + lens_header_h() + code_base_top_pad()) * LENS_COLUMN_REF
        }
    }
    g_lens_code_world = sqrt(1080000.0 * LENS_LAYOUT_FILL / clamp(code_area, 1.0, 1000000000000000.0))
    lens_cache_init()
    let signature = lens_layout_signature()
    if lens_load_layout(signature) == false {
        lens_layout_children(g_lens_scope, -600.0, -450.0, 1200.0, 900.0)
        lens_store_layout(signature)
    }
    lens_leaf_fits()
    if g_lens_view_mode == LENS_MODE_REF { lens_ref_build() }
    g_lens_generation = g_workspace_generation
}

fn lens_source_bytes(path: str) i32 {
    let size = os_file_size(path)
    if size <= 0 {
        return 0
    }
    if size > 2147483647 {
        return 2147483647
    }
    return size as i32
}

// One whole-file read per frame. The preview keeps every line.
fn lens_preview(index: i32, allow_read: bool) str {
    g_lens_preview_read = false
    g_lens_preview_slot = -1
    g_lens_clock = g_lens_clock + 1
    let victim: i32 = 0
    let offset: i64 = 0
    for slot in 0 to LENS_CACHE_SLOTS {
        if g_lens_cache_id[slot] == index && g_lens_cache_offset[slot] == offset {
            if g_lens_view_mode == LENS_MODE_REF && g_lens_editing && index == g_workspace_active && g_lens_cache_text[slot] != g_doc {
                g_lens_cache_text[slot] = g_doc
                lens_build_preview(slot, g_doc)
            }
            g_lens_cache_age[slot] = g_lens_clock
            g_lens_preview_slot = slot
            return g_lens_cache_text[slot]
        }
        if g_lens_cache_age[slot] < g_lens_cache_age[victim] {
            victim = slot
        }
    }
    let ref_document = g_lens_view_mode == LENS_MODE_REF && g_lens_editing && index == g_workspace_active
    if allow_read == false && !ref_document {
        return ""
    }
    g_lens_preview_read = !ref_document
    let text = g_doc
    if !ref_document {
        let path = os_entry_path(index)
        text = lens_read_source(path, offset, lens_source_bytes(path))
    }
    g_lens_slot_block[victim] = 0
    g_lens_cache_offset[victim] = offset
    g_lens_cache_id[victim] = index
    g_lens_cache_text[victim] = text
    g_lens_cache_age[victim] = g_lens_clock
    lens_build_preview(victim, text)
    g_lens_preview_slot = victim
    return text
}

// 0: editor, 1: glyphs, 2: minimap. There is no hidden-content state.
fn lens_lod(zoom: f64) i32 {
    if zoom >= LENS_EDIT_ZOOM {
        return 0
    }
    if zoom >= LENS_GLYPH_ZOOM {
        return 1
    }
    return 2
}

fn lens_file_count() i32 {
    return g_lens_file_count
}

struct lens_detail {
    ready: i32,
    total: i32,
    code: bool
}

// Viewport leaves at glyph size report code progress. Otherwise the bar is
// how many project files have a finished minimap.
fn lens_detail_of(code_ready: i32, code_total: i32, bars_ready: i32, bars_total: i32) lens_detail {
    if code_total > 0 {
        return lens_detail(code_ready, code_total, true)
    }
    return lens_detail(bars_ready, bars_total, false)
}

fn lens_detail_text(detail: lens_detail) str {
    let name = "minimap"
    if detail.code {
        name = "code"
    }
    return name + " " + itos(detail.ready) + "/" + itos(detail.total)
}

fn lens_detail_fraction(detail: lens_detail) f64 {
    if detail.total <= 0 {
        return 0.0
    }
    return clamp((detail.ready as f64) / (detail.total as f64), 0.0, 1.0)
}

fn lens_file_code_ready(index: i32) bool {
    if g_lens_editing && g_workspace_active == index {
        return true
    }
    if g_lens_reading && g_lens_selected == index {
        return true
    }
    for slot in 0 to LENS_CACHE_SLOTS {
        if g_lens_cache_id[slot] == index && g_lens_cache_text[slot] != "" {
            return true
        }
    }
    return false
}

fn lens_code_zoom(leaf: lens_leaf_rect) f64 {
    return leaf.scale * g_lens_code_world
}

fn lens_open(index: i32) bool {
    if workspace_entry_editable(index) == false {
        return false
    }
    let size = os_file_size(os_entry_path(index))
    if size < 0 {
        g_lens_message = "File is unavailable"
        return false
    }
    // Keep one Lens-owned editor resident. Unsaved changes are never evicted;
    // a rescan can leave no active tab, which needs no release step.
    if g_lens_editing && g_workspace_active >= 0 && g_workspace_active != index {
        if workspace_entry_dirty(g_workspace_active) {
            g_lens_message = "Save the current file before editing another file"
            return false
        }
        let old = g_workspace_active
        // Restore the source-only minimap before releasing the old document.
        lens_mini_offer(old, g_workspace_buffers[old])
        g_lens_mini_document[old] = false
        workspace_close_tab(old)
        g_workspace_buffers[old] = ""
        g_workspace_originals[old] = ""
        g_workspace_opened[old] = 0
        for slot in 0 to history_cap() {
            g_history_doc[history_key(g_history_id, slot)] = ""
        }
    }
    g_lens_selected = index
    g_lens_selected_path = os_entry_path(index)
    g_lens_large_index = -1
    g_lens_reading = false
    if g_workspace_opened[index] == 0 {
        let text = g_lens_prefetch_text
        if g_lens_prefetch_index != index {
            text = lens_read_source(os_entry_path(index), 0 as i64, lens_source_bytes(os_entry_path(index)))
        }
        g_workspace_buffers[index] = text
        g_workspace_originals[index] = text
        g_workspace_opened[index] = 1
    }
    g_lens_editing = workspace_open(index)
    g_lens_message = ""
    g_code_scroll = 0.0
    return g_lens_editing
}

// The map menu sits just right of File.
fn lens_mode_x() f64 { return LENS_FILE_X + LENS_FILE_W + 8.0 }

// File > Open (Cmd+O): pick a folder and map it. An unsaved edit keeps the
// current project open.
fn lens_open_project() {
    if g_lens_editing && workspace_entry_dirty(g_workspace_active) {
        g_lens_message = "Save the current file before opening another project"
        return
    }
    let root = os_open_folder_dialog("Open code project")
    if root == "" {
        return
    }
    g_lens_editing = false
    g_lens_reading = false
    g_lens_selected_path = ""
    g_lens_scope = -1
    g_lens_scope_path = ""
    outline_reset()
    workspace_open_root(root)
    // The shell starts in the workspace root, so restart it after that changes.
    terminal_restart()
    g_lens_target_x = 0.0
    g_lens_target_y = 0.0
    g_lens_target_distance = 1600.0
    lens_rebuild()
}

// The menu bar contains dropdown menus only, centred vertically.
fn lens_mode_y() f64 { return main_menu_h() + (LENS_TOP_BAR_H - LENS_MODE_H) * 0.5 }

fn lens_mode_popup_y() f64 { return lens_mode_y() + LENS_MODE_H + 2.0 }

fn lens_mode_at(row: i32) i32 {
    if row == 1 { return LENS_MODE_REF }
    if row > 1 { return row - 1 }
    return LENS_MODE_CODE
}

fn lens_mode_label(mode: i32) str {
    if mode == LENS_MODE_REF { return "ref" }
    if mode == LENS_MODE_CHANGE {
        return "change"
    }
    if mode == LENS_MODE_FULL {
        return "full"
    }
    return "code"
}

fn lens_mode_handle(v: ref view, w: f64) {
    let x = lens_mode_x()
    let y = lens_mode_y()
    let pop_y = lens_mode_popup_y()
    let pop_h = LENS_MODE_ITEM * 4.0
    g_lens_mode_block = g_lens_mode_open && raw_hit(v, x, pop_y, LENS_MODE_W, pop_h)
    if v.mouse_pressed == false {
        return
    }
    if raw_hit(v, x, y, LENS_MODE_W, LENS_MODE_H) {
        if g_lens_mode_open {
            g_lens_mode_open = false
        } else {
            g_lens_mode_open = true
            g_lens_file_open = false
            g_lens_view_open = false
        }
        v.mouse_pressed = false
        return
    }
    if g_lens_mode_open == false {
        return
    }
    if g_lens_mode_block {
        let row = ((g_mouse_y - pop_y) / LENS_MODE_ITEM) as i32
        if row < 0 {
            row = 0
        }
        if row > 3 {
            row = 3
        }
        g_lens_mode_open = false
        v.mouse_pressed = false
        lens_set_mode(lens_mode_at(row))
        return
    }
    g_lens_mode_open = false
    v.mouse_pressed = false
}

fn lens_draw_mode_menu(r: ref ui_renderer, v: ref view, w: f64) {
    let x = lens_mode_x()
    let y = lens_mode_y()
    let border = col_muted()
    if g_lens_mode_open {
        border = col_accent()
    }
    ui_fill_round_rect(r, x, y, LENS_MODE_W, LENS_MODE_H, 3.0, col_editor_panel(), 0.0)
    ui_stroke_round_rect(r, x, y, LENS_MODE_W, LENS_MODE_H, 3.0, 1.0, border, 0.0)
    let label = lens_mode_label(g_lens_view_mode)
    let ty = ui_text_v_center_y(r, y, LENS_MODE_H, small_px(), FONT_MONO())
    draw_text_clipped(r, x + 10.0, ty, LENS_MODE_W - 28.0, LENS_MODE_H, label, small_px(), col_text())
    draw_text_clipped(r, x + LENS_MODE_W - 16.0, ty, 12.0, LENS_MODE_H, "v", small_px(), col_muted())
    if g_lens_mode_open == false {
        return
    }
    let pop_y = lens_mode_popup_y()
    let pop_h = LENS_MODE_ITEM * 4.0
    ui_fill_round_rect(r, x, pop_y, LENS_MODE_W, pop_h, 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, x, pop_y, LENS_MODE_W, pop_h, 3.0, 1.0, col_muted(), 0.0)
    for row in 0 to 4 {
        let i = lens_mode_at(row)
        let iy = pop_y + (row as f64) * LENS_MODE_ITEM
        let hot = raw_hit(v, x, iy, LENS_MODE_W, LENS_MODE_ITEM)
        if hot || i == g_lens_view_mode {
            ui_fill_rect(r, x + 1.0, iy, LENS_MODE_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
        let color = col_text()
        if i == g_lens_view_mode {
            color = col_accent()
        }
        let row_ty = ui_text_v_center_y(r, iy, LENS_MODE_ITEM, small_px(), FONT_MONO())
        draw_text_clipped(r, x + 10.0, row_ty, LENS_MODE_W - 16.0, LENS_MODE_ITEM, lens_mode_label(i), small_px(), color)
    }
}

fn lens_draw_plain_leaf(r: ref ui_renderer, v: ref view, i: i32, w: f64, top: f64, body_h: f64, vx0: f64, vy0: f64, vx1: f64, vy1: f64, over_map: bool) {
    let leaf = lens_project_leaf(i, w, top, body_h)
    let pw = leaf.w
    let ph = leaf.h
    let px = leaf.x
    let py = leaf.y
    if pw <= 1.0 || ph <= 1.0 || px >= vx1 || px + pw <= vx0 || py >= vy1 || py + ph <= vy0 {
        return
    }
    g_lens_on_screen[i] = 1
    let color = col_muted()
    if i == g_lens_selected {
        color = col_accent()
    }
    let content = lens_leaf_content(leaf, vx0, vy0, vx1, vy1)
    let on_screen = px >= vx0 && py >= vy0 && px + pw <= vx1 && py + ph <= vy1
    if on_screen && pw >= 12.0 && ph >= 12.0 {
        ui_fill_round_rect(r, px + 1.0, py + 1.0, pw - 2.0, ph - 2.0, LENS_CORNER_RADIUS, col_editor_panel_hi(), 0.0)
        ui_stroke_round_rect(r, px + 1.0, py + 1.0, pw - 2.0, ph - 2.0, LENS_CORNER_RADIUS, 1.0, color, 0.0)
    } else if content.w > 1.0 && content.h > 1.0 {
        ui_fill_rect(r, content.x, content.y, content.w, content.h, col_editor_panel_hi(), 0.0)
    }
    // A file without code never shows glyphs, so it keeps the large name.
    lens_draw_far_name(r, content, g_lens_names[i], i == g_lens_selected)
    lens_draw_search_mark(r, i, leaf, on_screen)
    if v.mouse_right_pressed && over_map && hit(v, px, py, pw, ph) {
        g_lens_selected = i
        g_lens_selected_path = os_entry_path(i)
        v.mouse_right_pressed = false
    }
}

// Camera-space projection includes perspective depth from the tilted map plane
// and directory elevation. All geometry and hit tests use the same projection.
fn render_lens(r: ref ui_renderer, v: ref view, w: f64, h: f64) {
    g_lens_render_serial = g_lens_render_serial + 1
    lens_batch_window_reset()
    lens_io_poll()
    terminal_poll()
    if g_lens_generation != g_workspace_generation {
        if g_lens_view_mode == LENS_MODE_CHANGE {
            g_lens_change_poll = os_time() + 2.0
            lens_changes_request(true)
        }
        lens_rebuild()
        g_lens_changes_dirty = false
    }
    lens_mini_update(r)
    g_lens_canvas_h = h
    g_lens_screen_h = ui_surface_height(r) as f64
    // The map covers the whole window and is drawn first. The top bar and
    // the status bar float over it on translucent panels, and the map takes
    // no pointer input under them.
    let top = main_menu_h()
    let body_h = h - top
    let bar_bottom = top + LENS_TOP_BAR_H
    let map_w = w
    g_lens_view_w = w
    g_lens_body_h = body_h
    ui_fill_rect(r, 0.0, top, w, body_h, col_editor_bg(), 0.0)
    lens_menu_keys(v)
    lens_menu_mouse(v, w, h)
    lens_mode_handle(v, w)
    // Floating panels take pointer input before the map. The terminal is drawn
    // above the outline, so it also wins when their rectangles overlap.
    if lens_menu_blocks() == false {
        terminal_mouse(v, w, h)
        outline_mouse(v, w, h)
    }
    if g_lens_view_mode == LENS_MODE_REF { lens_ref_tick() }
    // The map is laid out flat and seen through the plane camera: every map
    // interaction runs on the flat plane, under the unprojected pointer.
    let screen_x = g_mouse_x
    let screen_y = g_mouse_y
    let over_panel = outline_blocks_pointer(v) || terminal_blocks_pointer(v)
    let over_map = g_lens_mode_block == false && lens_menu_blocks() == false && over_panel == false && !lens_ref_depth_hit(v, w) && hit(v, 0.0, bar_bottom, map_w, h - STATUS_BAR_H - bar_bottom)
    if over_map && v.mouse_middle_down {
        g_lens_tilt = clamp(g_lens_tilt + (screen_y - g_lens_screen_drag_y) * 0.25, 0.0, LENS_MAX_TILT)
    }
    if v.mouse_middle_down == false && g_lens_tilt < LENS_ORTHO_SNAP {
        g_lens_tilt = 0.0
    }
    g_lens_screen_drag_y = screen_y
    lens_plane_setup(w, top, body_h)
    lens_unproject(screen_x, screen_y)
    g_mouse_x = g_lens_plane_x
    g_mouse_y = g_lens_plane_y
    if over_map {
        if shift_down(v) == false && v.scroll_y != 0.0 {
            lens_zoom_at(g_mouse_x, g_mouse_y, w, top, body_h, v.scroll_y)
        }
        lens_pinch_at(g_mouse_x, g_mouse_y, w, top, body_h, view_gesture(v).zoom_factor)
    }
    let cell_drag = false
    if g_lens_view_mode == LENS_MODE_REF { cell_drag = lens_ref_input(v, over_map, w, top, body_h) }
    lens_pan_input(v, over_map && !cell_drag)
    let dt = clamp(os_time() - g_lens_last_time, 0.001, 0.05)
    g_lens_last_time = os_time()
    let blend = dt / (dt + 0.071)
    g_lens_distance = g_lens_distance + (g_lens_target_distance - g_lens_distance) * blend
    g_lens_center_x = g_lens_center_x + (g_lens_target_x - g_lens_center_x) * blend
    g_lens_center_y = g_lens_center_y + (g_lens_target_y - g_lens_center_y) * blend
    let moving = lens_camera_moving(v)
    lens_git_tick(moving)
    lens_vcs_tick(moving)
    lens_patch_tick(moving)
    lens_search_tick()
    lens_changes_poll()
    if g_lens_view_mode == LENS_MODE_CHANGE && moving == false && os_time() >= g_lens_change_poll {
        g_lens_change_poll = os_time() + 2.0
        lens_changes_request(false)
    }
    let read_budget: i32 = 1
    if moving {
        read_budget = 0
    }
    let preview_budget: i32 = LENS_CACHE_SLOTS
    let vx0 = g_lens_view_x0
    let vy0 = g_lens_view_y0
    let vx1 = g_lens_view_x1
    let vy1 = g_lens_view_y1
    g_code_view_x0 = vx0
    g_code_view_x1 = vx1
    g_code_view_y0 = vy0
    g_code_view_y1 = vy1
    if g_lens_plane_tilt > 0.0 {
        ui_begin_plane(r, g_lens_plane_cx, g_lens_plane_cy, g_lens_plane_tilt, g_lens_plane_focal, 0.0, top, w, body_h)
    }
    ui_push_clip(r, vx0, vy0, vx1 - vx0, vy1 - vy0)
    lens_draw_grid(r, w, top, body_h)
    let close_view = false
    let bars_ready: i32 = 0
    let bars_total: i32 = 0
    let code_ready: i32 = 0
    let code_total: i32 = 0
    for i in 0 to g_workspace_count {
        g_lens_on_screen[i] = 0
        if !lens_ref_visible(i) { continue }
        if g_lens_files[i] == 2 && g_lens_weight[i] > 0.0 {
            lens_draw_plain_leaf(r, v, i, w, top, body_h, vx0, vy0, vx1, vy1, over_map)
        } else if g_lens_files[i] == 1 && g_lens_weight[i] > 0.0 {
            bars_total = bars_total + 1
            if g_lens_source_done[i] && lens_mini_ready(i) {
                bars_ready = bars_ready + 1
            }
            let leaf = lens_project_leaf(i, w, top, body_h)
            let pw = leaf.w
            let ph = leaf.h
            let px = leaf.x
            let py = leaf.y
            if pw > 1.0 && ph > 1.0 && px < vx1 && px + pw > vx0 && py < vy1 && py + ph > vy0 {
                g_lens_on_screen[i] = 1
                let color = col_muted()
                if i == g_lens_selected {
                    color = col_accent()
                }
                // Leaves tile edge to edge; a one-pixel inset keeps a seam.
                // A zoomed leaf is far larger than the viewport. Rounding the
                // whole rectangle submits triangles whose corners sit thousands
                // of pixels off screen, so a partial leaf is just its visible fill.
                let content = lens_leaf_content(leaf, vx0, vy0, vx1, vy1)
                let on_screen = px >= vx0 && py >= vy0 && px + pw <= vx1 && py + ph <= vy1
                if on_screen && pw >= 12.0 && ph >= 12.0 {
                    ui_fill_round_rect(r, px + 1.0, py + 1.0, pw - 2.0, ph - 2.0, LENS_CORNER_RADIUS, col_editor_panel_hi(), 0.0)
                    ui_stroke_round_rect(r, px + 1.0, py + 1.0, pw - 2.0, ph - 2.0, LENS_CORNER_RADIUS, 1.0, color, 0.0)
                } else if content.w > 1.0 && content.h > 1.0 {
                    ui_fill_rect(r, content.x, content.y, content.w, content.h, col_editor_panel_hi(), 0.0)
                }
                let zoom = lens_code_zoom(leaf)
                // Detail follows the size on screen: a leaf far up the tilted
                // plane is smaller than its flat layout.
                let gain = lens_depth_gain(clamp(py + ph * 0.5, vy0, vy1))
                let hovered = over_map && hit(v, px, py, pw, ph)
                let resident = g_lens_view_mode != LENS_MODE_REF && g_lens_editing && g_workspace_active == i
                let paged = g_lens_view_mode != LENS_MODE_REF && g_lens_reading && g_lens_selected == i
                if !resident && !paged && g_lens_mini_document[i] && g_workspace_buffers[i] != "" {
                    lens_mini_build(r, i, g_workspace_buffers[i])
                }
                // Code hangs from the leaf's own origin and scales with it; the
                // visible part of the leaf only clips it. The name row and the
                // code share the scale of whichever form is drawn.
                let content_drawn = false
                // Glyphs carry the name in their header row; anything else
                // (bars, loading) shows the large name instead.
                let glyphs = false
                let code_x = px + 1.0
                let fit = g_lens_leaf_fit[i]
                let code_y = lens_code_y(leaf, fit)
                let lod = 2
                if resident || paged {
                    // The open document wraps at the file's width; its rows
                    // set the grid that glyphs and editing overlays share.
                    g_code_wrap = lens_wrap_cols(i)
                    lens_wrap_sync(g_code_wrap)
                    lens_code_flow(i, g_lens_wrap_total)
                    fit = g_lens_flow_fit
                    code_y = lens_code_y(leaf, fit)
                    lod = lens_lod(zoom * fit * gain)
                    // The full-file bar batch is not drawn while glyphs cover
                    // the leaf. Building it here tokenizes every line on the
                    // select frame. Tilt still wants those bars under the far band.
                    if resident && (g_lens_plane_tilt > 0.0 || lod > 1) {
                        lens_mini_sync_document(r, i)
                    }
                }
                if lod <= 1 && (resident || paged) {
                    g_editor_byte_limit = 0
                    g_code_rows = g_lens_flow_rows
                    g_code_column_base = g_lens_flow_column_pitch
                    g_code_line_pitch = g_lens_flow_line_pitch
                    set_code_zoom(zoom * g_lens_flow_fit, zoom * g_lens_flow_fit * leaf.scale_y / leaf.scale)
                    ui_push_clip(r, content.x, content.y, content.w, content.h)
                    // Retain visible glyphs across frames; the immediate stream
                    // only draws editing overlays. The renderer supplies frame
                    // storage if a retained GPU copy is unavailable.
                    g_code_draw_glyphs = false
                    draw_leaf_code(r, v, code_x, code_y, pw - 2.0, py + ph - code_y - 1.0, resident && lod == 0 && lens_typing() == false)
                    g_code_draw_glyphs = true
                    // One form per file: glyphs when the batch is on screen,
                    // otherwise the bars.
                    if lens_draw_document_batch(r, i, code_x, code_y, zoom, leaf.scale_y / leaf.scale, content) {
                        content_drawn = true
                        glyphs = true
                    } else {
                        content_drawn = lens_mini_draw(r, i, code_x, code_y, zoom, leaf.scale_y / leaf.scale)
                    }
                    if resident && lod == 0 {
                        draw_code_caret(r, code_x, code_y, code_line_h(), ui_mono_char_width(r, code_font_px(), CODE_FONT()), g_code_rows)
                    }
                    ui_pop_clip(r)
                } else {
                    // Glyphs and bars are mutually exclusive on each file.
                    // Bars show only when this frame did not draw code.
                    let mini = lens_mini_ready(i)
                    if mini {
                        lod = lens_lod(zoom * g_lens_mini_fit[i] * gain)
                    } else {
                        lod = lens_lod(zoom * gain)
                    }
                    let code = false
                    let need_text = false
                    ui_push_clip(r, content.x, content.y, content.w, content.h)
                    if lod <= 1 && preview_budget > 0 {
                        preview_budget = preview_budget - 1
                        let text = lens_preview(i, false)
                        if g_lens_preview_slot >= 0 {
                            let slot = g_lens_preview_slot
                            lens_code_flow(i, lens_preview_rows(slot, i))
                            lod = lens_lod(zoom * g_lens_flow_fit * gain)
                            if lod <= 1 {
                                fit = g_lens_flow_fit
                                code_y = lens_code_y(leaf, fit)
                                code = lens_draw_code_batch(r, slot, i, code_x, code_y, zoom * g_lens_flow_fit, leaf.scale_y / leaf.scale, content)
                            }
                            if mini == false || lens_mini_stale(i) {
                                lens_mini_offer(i, g_lens_cache_text[slot])
                            }
                        } else {
                            // A ready minimap must not block the text read, or the
                            // closest zoom stays on bars forever.
                            need_text = true
                        }
                    }
                    let drew = code
                    glyphs = code
                    if code == false && mini {
                        fit = g_lens_mini_fit[i]
                        code_y = lens_code_y(leaf, fit)
                        drew = lens_mini_draw(r, i, code_x, code_y, zoom, leaf.scale_y / leaf.scale)
                    }
                    content_drawn = drew
                    ui_pop_clip(r)
                    if need_text {
                        let allow = read_budget > 0 || hovered
                        let pending = lens_preview_stream(i, allow && g_lens_io_running == false)
                        if g_lens_preview_read {
                            read_budget = 0
                        }
                    }
                }
                if content_drawn == false {
                    lens_mini_loading(r, leaf, content)
                }
                if lod <= 1 {
                    close_view = true
                    code_total = code_total + 1
                    if lens_file_code_ready(i) {
                        code_ready = code_ready + 1
                    }
                }
                if g_lens_view_mode != LENS_MODE_REF && lod == 0 && hovered && moving == false {
                    lens_request_near(i)
                }
                if glyphs {
                    lens_draw_label(r, v, i, leaf, content, fit, color, over_map)
                } else {
                    lens_draw_far_name(r, content, g_lens_names[i], i == g_lens_selected)
                }
                lens_draw_search_mark(r, i, leaf, on_screen)
                if v.mouse_right_pressed && hovered {
                    g_lens_selected = i
                    g_lens_selected_path = os_entry_path(i)
                    if lod != 0 {
                        // Focus at a readable code size, framing the top of the file.
                        let lines = g_lens_source_rows[i]
                        if lens_mini_ready(i) { lines = g_lens_mini_lines[i] }
                        lens_code_flow(i, lines)
                        let distance = clamp(800.0 * g_lens_code_world * g_lens_flow_fit, 1.0, 6000.0)
                        let view = distance / 800.0
                        g_lens_target_x = g_lens_x[i] + clamp(g_lens_w[i] * 0.5, 0.0, (w * 0.5 - 24.0) * view)
                        g_lens_target_y = g_lens_y[i] + clamp(g_lens_h[i] * 0.5, 0.0, (body_h * 0.5 - LENS_TOP_BAR_H - 24.0) * view)
                        g_lens_target_distance = distance
                    }
                    v.mouse_right_pressed = false
                }
            }
        }
    }
    if g_lens_view_mode == LENS_MODE_REF { lens_ref_links(r, w, top, body_h) }
    if v.mouse_released || !v.mouse_down {
        g_lens_label_press = -1
    }
    g_lens_close_view = close_view
    lens_trim_glyphs(r)
    lens_release_idle_glyphs(r)
    ui_pop_clip(r)
    ui_end_plane(r)
    g_mouse_x = screen_x
    g_mouse_y = screen_y
    ui_fill_rect(r, 0.0, top, w, LENS_TOP_BAR_H, col_bar(), 0.0)
    if lens_file_count() == 0 {
        let note = "No source files in "
        if g_lens_view_mode == LENS_MODE_CHANGE && g_lens_change_root != g_workspace_root {
            note = "Listing changed files in "
        } else if g_lens_view_mode == LENS_MODE_CHANGE {
            note = "No changed files in "
        } else if g_lens_view_mode == LENS_MODE_FULL {
            note = "No files in "
        }
        let subject = g_workspace_root
        if g_lens_scope_path != "" {
            subject = g_lens_scope_path
        }
        draw_centered_text(r, 0.0, top, w, body_h, note + subject + "  ·  File > Open (cmd+O)", small_px(), col_muted())
    }
    if g_workspace_count >= 4096 {
        g_lens_message = "Filesystem snapshot limit reached: 4096 entries"
    }
    if g_lens_reading && g_lens_selected >= 0 && g_lens_editing == false {
        if hit(v, w - 160.0, h - 68.0, 70.0, 28.0) && v.mouse_pressed {
            if g_lens_page >= LENS_PAGE_BYTES {
                g_lens_page = g_lens_page - LENS_PAGE_BYTES
            }
        }
        if hit(v, w - 84.0, h - 68.0, 70.0, 28.0) && v.mouse_pressed {
            if g_lens_page + LENS_PAGE_BYTES < os_file_size(os_entry_path(g_lens_selected)) {
                g_lens_page = g_lens_page + LENS_PAGE_BYTES
            }
        }
        if g_lens_reading && v.mouse_pressed && hit(v, w - 160.0, h - 68.0, 146.0, 28.0) {
            load_str(lens_read_source(os_entry_path(g_lens_selected), g_lens_page, LENS_PAGE_BYTES))
            g_code_scroll = 0.0
        }
        draw_centered_text(r, w - 160.0, h - 68.0, 70.0, 28.0, "Prev", small_px(), col_blue())
        draw_centered_text(r, w - 84.0, h - 68.0, 70.0, 28.0, "Next", small_px(), col_blue())
    }
    draw_status_bar(r, 0.0, h - STATUS_BAR_H, w, lens_detail_of(code_ready, code_total, bars_ready, bars_total))
    if g_lens_view_mode == LENS_MODE_REF { lens_ref_controls(r, v, w) }
    lens_draw_overlay(r, w, h)
    outline_draw(r, v, w, h)
    terminal_draw(r, v, w, h)
    lens_draw_mode_menu(r, v, w)
    lens_draw_menus(r, v, w, h)

    lens_warm_cache(moving)
    if moving {
        // The display paces a moving camera. A timer started after the frame
        // would add its delay to the frame's own cost.
        view_request_frame(v, 1)
    } else if g_lens_input_dirty {
        // A panel action or terminal chunk changed what this frame should show.
        g_lens_input_dirty = false
        view_request_frame_after(v, 1)
    } else if read_budget == 0 || g_lens_io_running || g_lens_change_running || g_lens_close_view || lens_job_visible() || g_lens_search_running {
        view_request_frame_after(v, 16)
    } else if terminal_needs_frames() {
        view_request_frame_after(v, terminal_frame_delay())
    } else {
        // Idle polling keeps file watching alive without drawing 60 empty frames.
        view_request_frame_after(v, 100)
    }
}

let g_lens_last_time: f64 = 0.0

struct lens_leaf_rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    distance: f64,
    // Screen pixels per world unit, across and down.
    scale: f64,
    scale_y: f64
}

// The plane camera for this frame. Below LENS_ORTHO_SNAP it is orthographic:
// the flat map is the screen. Past it, the map plane turns about the
// horizontal line through the map's centre, seen from a pinhole in front of
// the screen, and the visible part of the flat map grows toward the horizon.
fn lens_plane_setup(w: f64, top: f64, body_h: f64) {
    g_lens_plane_cx = w * 0.5
    g_lens_plane_cy = top + body_h * 0.5
    g_lens_plane_focal = body_h * 1.3
    g_lens_plane_tilt = 0.0
    if g_lens_tilt >= LENS_ORTHO_SNAP {
        g_lens_plane_tilt = clamp(g_lens_tilt, 0.0, LENS_MAX_TILT) * 0.017453292519943295
    }
    let far: f64 = lens_unproject_y(top - g_lens_plane_cy)
    let near: f64 = lens_unproject_y(body_h * 0.5)
    let far_half: f64 = w * 0.5 * lens_depth(far) / g_lens_plane_focal
    let near_half: f64 = w * 0.5 * lens_depth(near) / g_lens_plane_focal
    let half: f64 = clamp(far_half, near_half, 1000000.0)
    g_lens_view_x0 = g_lens_plane_cx - half
    g_lens_view_x1 = g_lens_plane_cx + half
    g_lens_view_y0 = g_lens_plane_cy + far
    g_lens_view_y1 = g_lens_plane_cy + near
}

// Distance from the pinhole to the plane point `y` below the pivot.
fn lens_depth(y: f64) f64 {
    return g_lens_plane_focal - y * sin(g_lens_plane_tilt)
}

// Plane offset below the pivot seen at screen offset `t` below it; clamped
// short of the horizon.
fn lens_unproject_y(t: f64) f64 {
    let denom: f64 = g_lens_plane_focal * cos(g_lens_plane_tilt) + t * sin(g_lens_plane_tilt)
    return t * g_lens_plane_focal / clamp(denom, g_lens_plane_focal * 0.05, 1000000000.0)
}

// Flat-map point under the screen point (sx, sy), into g_lens_plane_x/y.
fn lens_unproject(sx: f64, sy: f64) {
    let y: f64 = lens_unproject_y(sy - g_lens_plane_cy)
    g_lens_plane_x = g_lens_plane_cx + (sx - g_lens_plane_cx) * lens_depth(y) / g_lens_plane_focal
    g_lens_plane_y = g_lens_plane_cy + y
}

// Screen size over flat size at flat-map height `y`.
fn lens_depth_gain(y: f64) f64 {
    return g_lens_plane_focal / clamp(lens_depth(y - g_lens_plane_cy), 1.0, 1000000000.0)
}

// Screen y of a flat canvas point, using the same plane matrix as ui_begin_plane.
// Flat when the plane is off, so callers can compare it with canvas y.
fn lens_plane_screen_y(flat_y: f64) f64 {
    let screen_h = g_lens_screen_h
    if g_lens_plane_tilt <= 0.0 || screen_h <= 1.0 {
        return flat_y
    }
    let tilt = g_lens_plane_tilt
    let focal = g_lens_plane_focal
    let cy = g_lens_plane_cy
    let s = sin(tilt)
    let c = cos(tilt)
    let ncy = 1.0 - 2.0 * cy / screen_h
    let k = 0.5 * screen_h * s / focal
    let ndcy = 1.0 - 2.0 * flat_y / screen_h
    let w = k * ndcy + 1.0 - k * ncy
    let yclip = (ncy * k + c) * ndcy + (ncy - ncy * ncy * k - c * ncy)
    if w < 0.001 && w > -0.001 {
        w = 0.001
    }
    return (1.0 - yclip / w) * 0.5 * screen_h
}

// Screen pixels per flat pixel at flat_y. Less than 1 where the plane recedes.
fn lens_screen_per_flat(flat_y: f64) f64 {
    if g_lens_plane_tilt <= 0.0 || g_lens_screen_h <= 1.0 {
        return 1.0
    }
    let d = lens_plane_screen_y(flat_y + 0.5) - lens_plane_screen_y(flat_y - 0.5)
    if d < 0.0 {
        d = -d
    }
    return d
}

// Flat y below which a line of `line_flat` canvas pixels is shorter than
// LENS_PLANE_LINE_FLOOR on screen. The top of the plane is the far edge.
fn lens_plane_cut(y0: f64, y1: f64, line_flat: f64) f64 {
    if g_lens_plane_tilt <= 0.0 || line_flat <= 0.0 || y1 <= y0 {
        return y0
    }
    if line_flat * lens_screen_per_flat(y0) >= LENS_PLANE_LINE_FLOOR {
        return y0
    }
    if line_flat * lens_screen_per_flat(y1) < LENS_PLANE_LINE_FLOOR {
        return y1
    }
    let lo = y0
    let hi = y1
    for n in 0 to 12 {
        let mid = (lo + hi) * 0.5
        if line_flat * lens_screen_per_flat(mid) < LENS_PLANE_LINE_FLOOR {
            lo = mid
        } else {
            hi = mid
        }
    }
    return hi
}

fn lens_line_flat(code_zoom: f64) f64 {
    return g_lens_flow_line_pitch * code_zoom * g_lens_flow_fit
}

// Bars behind the receding band. Glyphs are still drawn on top; where the
// perspective shrinks them off a pixel, these bars stay visible.
fn lens_draw_far_bars(r: ref ui_renderer, index: i32, x: f64, y: f64, zoom: f64, squash: f64, content: lens_leaf_rect, line_flat: f64) bool {
    if g_lens_plane_tilt <= 0.0 || lens_mini_ready(index) == false {
        return false
    }
    let bottom = content.y + content.h
    let cut = lens_plane_cut(content.y, bottom, line_flat)
    let h = cut - content.y
    if h < 0.5 || content.w <= 0.0 {
        return false
    }
    ui_push_clip(r, content.x, content.y, content.w, h)
    let drew = lens_mini_draw(r, index, x, y, zoom, squash)
    ui_pop_clip(r)
    return drew
}

// One affine camera for every entry, so neighbouring rectangles share their
// edges exactly on screen: the map tiles without overlaps or gaps.
fn lens_project_leaf(i: i32, w: f64, top: f64, body_h: f64) lens_leaf_rect {
    let scale: f64 = 800.0 / clamp(g_lens_distance, 1.0, LENS_DISTANCE_LIMIT)
    let scale_y: f64 = scale
    let px: f64 = w * 0.5 + (g_lens_x[i] - g_lens_center_x) * scale
    let py: f64 = top + body_h * 0.5 + (g_lens_y[i] - g_lens_center_y) * scale_y
    let pw: f64 = g_lens_w[i] * scale
    let ph: f64 = g_lens_h[i] * scale_y
    return lens_leaf_rect(px, py, pw, ph, g_lens_distance, scale, scale_y)
}

// The file name is one code row above the code, in code units, so it scales
// with the camera exactly like the lines below it.
fn lens_header_h() f64 {
    return code_base_line_h()
}

// While the search box is open, files with a hit are outlined. A leaf partly
// off screen skips it rather than tessellating a huge rectangle.
fn lens_draw_search_mark(r: ref ui_renderer, i: i32, leaf: lens_leaf_rect, on_screen: bool) {
    if on_screen && leaf.w >= 6.0 && leaf.h >= 6.0 && lens_search_marked(i) {
        ui_stroke_round_rect(r, leaf.x + 1.0, leaf.y + 1.0, leaf.w - 2.0, leaf.h - 2.0, LENS_CORNER_RADIUS, 2.0, col_accent(), 0.0)
    }
}

// Fly the camera to display row `row` of leaf `i` at readable code size: the
// row's column starts near the left edge (or the leaf is centred when it
// fits), and the row sits a little above the middle of the view.
fn lens_focus_row(i: i32, row: i32) {
    let rows = g_lens_source_rows[i]
    if lens_mini_ready(i) {
        rows = g_lens_mini_lines[i]
    }
    lens_code_flow(i, rows)
    let fit = g_lens_flow_fit
    let distance = clamp(800.0 * g_lens_code_world * fit, 1.0, 6000.0)
    let view = distance / 800.0
    // World units per code layout pixel.
    let unit = g_lens_code_world * fit
    let r = clamp_i(row, 0, 2000000000)
    let column = r / g_lens_flow_rows
    let local = r % g_lens_flow_rows
    let left = g_lens_x[i] + (column as f64) * g_lens_flow_column_pitch * unit
    let line_y = g_lens_y[i] + (lens_header_h() + code_base_top_pad() + ((local as f64) + 0.5) * g_lens_flow_line_pitch) * unit
    let room = g_lens_x[i] + g_lens_w[i] - left
    g_lens_target_x = left + clamp(room * 0.5, 0.0, (g_lens_view_w * 0.5 - 24.0) * view)
    g_lens_target_y = line_y + g_lens_body_h * 0.15 * view
    g_lens_target_distance = distance
}

// Screen y where a leaf's code starts, below its name row at scale `fit`.
fn lens_code_y(leaf: lens_leaf_rect, fit: f64) f64 {
    return leaf.y + lens_header_h() * lens_code_zoom(leaf) * fit * leaf.scale_y / leaf.scale
}

// The file's project-relative path occupies the leaf's header row in the
// code font and size, shown alongside the glyphs. The atlas has no bold face:
// a second pass a fraction of a glyph to the right thickens the strokes.
// Under the pointer the path is underlined, and a click copies it.
fn lens_draw_label(r: ref ui_renderer, v: ref view, i: i32, leaf: lens_leaf_rect, content: lens_leaf_rect, fit: f64, color: u32, over_map: bool) {
    let zoom = lens_code_zoom(leaf) * fit
    let row_h = lens_header_h() * zoom * leaf.scale_y / leaf.scale
    let bottom = content.y + content.h
    let y0 = clamp(leaf.y + 1.0, content.y, bottom)
    let y1 = clamp(leaf.y + 1.0 + row_h, content.y, bottom)
    if y1 - y0 < 0.5 || content.w < 1.0 {
        return
    }
    let path = g_lens_paths[i]
    let font_px = code_base_font_px() * zoom
    let x = leaf.x + 1.0 + code_base_text_inset() * zoom
    let ty = ui_text_v_center_y(r, leaf.y + 1.0, row_h, font_px, CODE_FONT())
    let text_w = ui_text_width(r, path, font_px, CODE_FONT()) + font_px * 0.06
    let right = content.x + content.w
    let hx0 = clamp(x, content.x, right)
    let hx1 = clamp(x + text_w, content.x, right)
    let hovered = over_map && hx1 > hx0 && hit(v, hx0, y0, hx1 - hx0, y1 - y0)
    lens_label_click(v, i, hovered, path)
    let ink = color
    if hovered {
        ink = col_accent()
    }
    ui_push_clip(r, content.x, y0, content.w, y1 - y0)
    ui_draw_text(r, x, ty, path, font_px, ink, CODE_FONT())
    ui_draw_text(r, x + font_px * 0.06, ty, path, font_px, ink, CODE_FONT())
    if hovered {
        let thick = clamp(font_px * 0.07, 1.0, 4.0)
        ui_fill_rect(r, x, leaf.y + 1.0 + row_h * 0.5 + font_px * 0.6, text_w, thick, ink, 0.0)
    }
    ui_pop_clip(r)
}

// A left press and release on the same path label copies the path. The press
// still pans the map, so a pointer that moved more than a few pixels between
// the two dragged the map instead.
fn lens_label_click(v: ref view, i: i32, hovered: bool, path: str) {
    if g_lens_view_mode == LENS_MODE_REF { return }
    if v.mouse_pressed && hovered {
        g_lens_label_press = i
        g_lens_label_press_x = g_mouse_x
        g_lens_label_press_y = g_mouse_y
    }
    if v.mouse_released && hovered && g_lens_label_press == i {
        let dx = g_mouse_x - g_lens_label_press_x
        let dy = g_mouse_y - g_lens_label_press_y
        if dx * dx + dy * dy <= 16.0 {
            view_set_clipboard(v, path)
            g_lens_message = "Copied " + path
        }
        g_lens_label_press = -1
    }
}

// Without glyphs the file name sits in bright text at the top left of the
// visible leaf, over the bars. It shrinks to fit a small leaf and is left out
// when it would be smaller than LENS_NAME_MIN_PX.
fn lens_draw_far_name(r: ref ui_renderer, content: lens_leaf_rect, name: str, selected: bool) {
    let font_px = lens_name_px(content.w, content.h, ui_text_width(r, name, 10.0, FONT_MONO()))
    if font_px <= 0.0 {
        return
    }
    let color = col_text()
    if selected {
        color = col_accent()
    }
    let x = content.x + 6.0
    let ty = ui_text_v_center_y(r, content.y + 2.0, font_px * 1.5, font_px, FONT_MONO())
    ui_draw_text(r, x, ty, name, font_px, color, FONT_MONO())
    ui_draw_text(r, x + font_px * 0.05, ty, name, font_px, color, FONT_MONO())
}

// Font size for a name `unit` pixels wide at 10 px in a width x height
// leaf, or 0 when it would be too small to read.
fn lens_name_px(width: f64, height: f64, unit: f64) f64 {
    if unit <= 0.0 {
        return 0.0
    }
    let font_px = clamp(10.0 * (width - 16.0) / unit, 0.0, LENS_NAME_MAX_PX)
    font_px = clamp(font_px, 0.0, height * 0.5)
    if font_px < LENS_NAME_MIN_PX {
        return 0.0
    }
    return font_px
}

struct lens_flow_layout {
    width: f64,
    height: f64,
    column_w: f64,
    line_h: f64,
    top_pad: f64,
    count: i32,
    cap: f64,
    rows: i32,
    columns: i32,
    fit: f64,
    column_pitch: f64,
    line_pitch: f64
}
let g_lens_flow_cache = [lens_flow_layout](4096)

// The largest scale at which `lines` rows fit leaf `i` in newspaper columns.
// Line height stays in proportion to the glyphs, so nothing stretches.
fn lens_best_fit(i: i32, lines: i32) f64 {
    let world = clamp(g_lens_code_world, 0.000001, 1000000.0)
    let width = clamp(g_lens_w[i] / world - 2.0, 0.001, 1000000000.0)
    let height = clamp(g_lens_h[i] / world - 4.0, 0.001, 1000000000.0)
    let count = clamp_i(lines, 1, 100000000)
    let column_w = lens_code_column_width(i)
    let best: f64 = 0.0
    for c in 1 to clamp_i(count, 1, LENS_MAX_COLUMNS) + 1 {
        let rows = (count + c - 1) / c
        let columns = (count + rows - 1) / rows
        let fit = clamp(width / ((columns as f64) * column_w), 0.0, height / (lens_header_h() + code_base_top_pad() + (rows as f64) * code_base_line_h()))
        if fit > best { best = fit }
    }
    return best
}

// Bytes per display row of file `i`; longer lines wrap onto more rows.
fn lens_wrap_cols(i: i32) i32 {
    return clamp_i(g_lens_source_columns[i], 1, 100000000)
}

fn lens_code_column_width(i: i32) f64 {
    return code_base_gutter_w() + code_base_text_inset() + (g_lens_source_columns[i] as f64) * code_base_font_px() * 0.6 + 16.0
}

// Fill every leaf after the treemap is laid out: each file gets the largest
// font its leaf holds, so leaves no longer share one map-wide size.
fn lens_leaf_fits() {
    for i in 0 to g_workspace_count {
        g_lens_leaf_fit[i] = 0.0
        if g_lens_files[i] != 0 {
            g_lens_leaf_fit[i] = lens_best_fit(i, g_lens_source_rows[i])
        }
    }
}

// Glyphs, minimap bars and editing overlays share this row grid. Rows keep
// their proportion to the glyphs; spare width spreads the columns apart.
fn lens_code_flow(i: i32, lines: i32) {
    let world = clamp(g_lens_code_world, 0.000001, 1000000.0)
    let width = clamp(g_lens_w[i] / world - 2.0, 0.001, 1000000000.0)
    let height = clamp(g_lens_h[i] / world - 4.0, 0.001, 1000000000.0)
    let count = clamp_i(lines, 1, 100000000)
    let column_w = lens_code_column_width(i)
    let cap = g_lens_leaf_fit[i]
    let saved = g_lens_flow_cache[i]
    if saved.count == count && saved.cap == cap && saved.width == width && saved.height == height && saved.column_w == column_w && saved.line_h == code_base_line_h() && saved.top_pad == code_base_top_pad() {
        g_lens_flow_rows = saved.rows
        g_lens_flow_columns = saved.columns
        g_lens_flow_fit = saved.fit
        g_lens_flow_column_pitch = saved.column_pitch
        g_lens_flow_line_pitch = saved.line_pitch
        return
    }
    // Up to the source line count the leaf's own scale holds; more rows
    // (new lines, Git deletion rows) shrink it only as far as they need.
    let fit = lens_best_fit(i, count)
    if cap > 0.0 && cap < fit {
        fit = cap
    }
    let capacity = clamp((height / fit - lens_header_h() - code_base_top_pad()) / code_base_line_h(), 1.0, count as f64)
    // A small tolerance keeps an exact-fit final row despite float rounding.
    let rows = clamp_i((capacity + 0.000001) as i32, 1, count)
    let columns = (count + rows - 1) / rows
    g_lens_flow_rows = rows
    g_lens_flow_columns = columns
    g_lens_flow_fit = fit
    g_lens_flow_column_pitch = width / ((columns as f64) * fit)
    g_lens_flow_line_pitch = code_base_line_h()
    g_lens_flow_cache[i] = lens_flow_layout(width, height, column_w, code_base_line_h(), code_base_top_pad(), count, cap, rows, columns, fit, g_lens_flow_column_pitch, g_lens_flow_line_pitch)
}

// Wheel zoom preserves the map point beneath the pointer, so a leaf stays put.
fn lens_sign(v: f64) f64 {
    if v < 0.0 {
        return -1.0
    }
    return 1.0
}

// Ref graphs grow with depth and dragging. Keep at least ten times the old
// range, and enough extra distance to pull back beyond the whole graph.
fn lens_zoom_farthest() f64 {
    if g_lens_view_mode == LENS_MODE_REF {
        return clamp(lens_ref_fit_distance(lens_ref_bounds()) * 2.0, 60000.0, LENS_DISTANCE_LIMIT)
    }
    return 6000.0
}

// Each wheel unit scales the distance by 1 + this rate, in or out.
fn lens_wheel_rate(nearest: f64) f64 {
    let height: f64 = clamp(g_lens_target_distance, nearest, lens_zoom_farthest())
    return clamp(LENS_WHEEL_NEAR * sqrt(nearest / height), LENS_WHEEL_FAR, LENS_WHEEL_NEAR)
}

// Closest camera distance over (mx, my). Past LENS_MAX_ZOOM a line no longer
// fits the window; stop there rather than diving into the blank space between
// glyphs.
fn lens_zoom_nearest(mx: f64, my: f64, w: f64, top: f64, body_h: f64) f64 {
    let fit: f64 = 1.0
    for index in 0 to g_workspace_count {
        if g_lens_files[index] != 0 && lens_ref_visible(index) {
            let box = lens_project_leaf(index, w, top, body_h)
            if mx >= box.x && mx < box.x + box.w && my >= box.y && my < box.y + box.h {
                let lines = g_lens_source_rows[index]
                if lens_mini_ready(index) { lines = g_lens_mini_lines[index] }
                lens_code_flow(index, lines)
                fit = g_lens_flow_fit
                break
            }
        }
    }
    return clamp(800.0 * g_lens_code_world * fit / LENS_MAX_ZOOM, 1.0, 6000.0)
}

fn lens_zoom_at(mx: f64, my: f64, w: f64, top: f64, body_h: f64, wheel: f64) {
    let nearest = lens_zoom_nearest(mx, my, w, top, body_h)
    let step: f64 = clamp(1.0 + clamp(wheel * lens_sign(wheel), 0.0, 1000.0) * lens_wheel_rate(nearest), 1.0, 4.0)
    let factor: f64 = step
    if wheel > 0.0 {
        factor = 1.0 / step
    }
    lens_zoom_by(mx, my, w, top, body_h, factor, nearest)
}

// A trackpad pinch scales the view by the fingers' spread since the last
// frame: spreading them (a factor above 1) brings the camera closer.
fn lens_pinch_at(mx: f64, my: f64, w: f64, top: f64, body_h: f64, spread: f64) {
    if spread <= 0.0 || spread == 1.0 {
        return
    }
    lens_zoom_by(mx, my, w, top, body_h, 1.0 / spread, lens_zoom_nearest(mx, my, w, top, body_h))
}

// Scale the camera distance by `factor` within the current mode's range. The world
// point under the pointer keeps its screen position.
fn lens_zoom_by(mx: f64, my: f64, w: f64, top: f64, body_h: f64, factor: f64, nearest: f64) {
    let next = clamp(g_lens_target_distance * factor, nearest, lens_zoom_farthest())
    let delta = (g_lens_target_distance - next) / 800.0
    g_lens_target_x = g_lens_target_x + (mx - w * 0.5) * delta
    g_lens_target_y = g_lens_target_y + (my - top - body_h * 0.5) * delta
    g_lens_target_distance = next
}

fn lens_activate_near(index: i32) bool {
    if g_lens_editing && g_workspace_active == index {
        return true
    }
    if g_lens_reading && g_lens_selected == index {
        return true
    }
    if g_lens_editing && workspace_entry_dirty(g_workspace_active) {
        return false
    }
    g_lens_page = 0
    return lens_open(index)
}

// A cache insertion only counts rows and marks the slot's batches stale; they
// are rebuilt on the next draw that needs them, when a renderer is at hand.
fn lens_build_preview(slot: i32, text: str) {
    g_lens_preview_count[slot] = lens_text_lines(text)
    g_lens_preview_wrap[slot] = -1
    g_lens_glyph_dirty[slot] = 1
    if text != "" {
        g_lens_preview_builds = g_lens_preview_builds + 1
    }
}

// Display rows of a cached text at its file's wrap width, ghost rows of its
// Git patch included. A new width or patch recounts.
fn lens_preview_rows(slot: i32, index: i32) i32 {
    let wrap = lens_wrap_cols(index)
    let serial = lens_leaf_patch_serial(index)
    if g_lens_preview_wrap[slot] != wrap || g_lens_preview_patch[slot] != serial {
        g_lens_preview_wrap[slot] = wrap
        g_lens_preview_patch[slot] = serial
        g_lens_preview_rows[slot] = lens_text_rows(g_lens_cache_text[slot], wrap) + lens_file_diff_rows(lens_leaf_diff(index), wrap)
    }
    return g_lens_preview_rows[slot]
}

fn lens_line_end(text: str, offset: i32) i32 {
    let end = offset
    loop end < text.len && ((text[end] as i32) & 255) != 10 {
        end = end + 1
    }
    return end
}

fn lens_preview_line(slot: i32, row: i32) str {
    if slot < 0 || slot >= LENS_CACHE_SLOTS || row < 0 || row >= g_lens_preview_count[slot] {
        return ""
    }
    let text = g_lens_cache_text[slot]
    let offset: i32 = 0
    for skip in 0 to row {
        offset = lens_line_end(text, offset) + 1
    }
    let end = lens_line_end(text, offset)
    return substr(text, offset, end - offset)
}

fn lens_is_blank(b: i32) bool {
    return b == 32 || b == 9 || b == 13
}

fn lens_byte(text: str, i: i32) i32 {
    if i < 0 || i >= text.len {
        return 0
    }
    return (text[i] as i32) & 255
}

// Pack end and kind into a scalar to avoid a heap allocation per token in
// native worker threads. The low four bits hold the nine token kinds.
fn lens_token_pack(end: i32, kind: i32) i64 {
    return ((end as i64) << 4) | (kind as i64)
}

fn lens_token_position(token: i64) i32 { return (token >> 4) as i32 }
fn lens_token_kind(token: i64) i32 { return (token & 15) as i32 }

fn lens_token_end(text: str, s: i32, m: i32, p: i32) i64 {
    return lens_token_scan(text, s, m, p, g_syntax_language)
}

fn lens_token_scan(text: str, s: i32, m: i32, p: i32, language: i32) i64 {
    let kind = TK_TEXT()
    let b = lens_byte(text, s + p)
    if b == 47 && (p + 1) < m && lens_byte(text, s + p + 1) == 47 {
        kind = TK_COMMENT()
        return lens_token_pack(m, kind)
    }
    if b == 35 && language == 2 {
        kind = TK_COMMENT()
        return lens_token_pack(m, kind)
    }
    if b == 34 || b == 39 || b == 96 {
        kind = TK_STRING()
        let q = p + 1
        loop q < m && lens_byte(text, s + q) != b {
            if lens_byte(text, s + q) == 92 {
                q = q + 1
            }
            q = q + 1
        }
        return lens_token_pack(clamp_i(q + 1, p + 1, m), kind)
    }
    if is_digit_byte(b) {
        kind = TK_NUMBER()
        let q = p + 1
        loop q < m && (is_word_byte(lens_byte(text, s + q)) || lens_byte(text, s + q) == 46) {
            q = q + 1
        }
        return lens_token_pack(q, kind)
    }
    if is_word_byte(b) {
        let q = p + 1
        loop q < m && is_word_byte(lens_byte(text, s + q)) {
            q = q + 1
        }
        kind = TK_TEXT()
        if is_keyword_language(text, s + p, q - p, language) {
            kind = TK_KEYWORD()
        } else if is_type_word_language(text, s + p, q - p, language) {
            kind = TK_TYPE()
        } else if lens_byte(text, s + q) == 40 {
            kind = TK_CALL()
        }
        return lens_token_pack(q, kind)
    }
    kind = TK_PUNCT()
    let q = p + 1
    loop q < m {
        let nb = lens_byte(text, s + q)
        if lens_is_blank(nb) || is_word_byte(nb) || nb == 34 || nb == 39 || nb == 96 || nb == 47 {
            break
        }
        q = q + 1
    }
    return lens_token_pack(q, kind)
}

// The minimap keeps each token's hue at reduced opacity.
// Lays out a cached page with the editor's zoom-1 metrics, flowing lines
// down `rows`-row columns: line numbers in each column's gutter, then the
// highlighted glyphs. g_lens_batch_* selects which rows are tessellated;
// the default keeps the whole page.
fn lens_build_code_batch(r: ref ui_renderer, slot: i32, rows: i32) i32 {
    let batch = g_lens_glyph_batch[slot]
    if batch == 0 {
        batch = ui_rect_batch_create(r)
        if batch == 0 {
            return 0
        }
    }
    let text = g_lens_cache_text[slot]
    let font_px = code_base_font_px()
    let char_w = ui_mono_char_width(r, font_px, CODE_FONT())
    if char_w <= 0.0 {
        char_w = font_px * 0.6
    }
    ui_rect_batch_begin(r, batch)
    let first_row: i32 = 0
    let first_col: i32 = 0
    let document = slot == LENS_CACHE_SLOTS
    if g_lens_slot_block[slot] != 0 {
        let block = g_lens_blocks[g_lens_slot_block[slot]]
        first_row = block.row
        first_col = block.col
    }
    let wrap = lens_wrap_cols(g_lens_slot_index[slot])
    let total = 0
    let diff = lens_file_diff_none()
    if document {
        lens_wrap_sync(wrap)
        total = g_lens_wrap_total
    } else {
        diff = lens_leaf_diff(g_lens_slot_index[slot])
        total = first_row + lens_text_rows(text, wrap) + lens_file_diff_rows(diff, wrap)
    }
    let input = lens_batch_prepare(r, text, diff, document, first_row, first_col, total, rows, wrap, char_w, false)
    lens_batch_build(r, batch, ref input)
    ui_rect_batch_end(r, batch)
    return batch
}

struct lens_glyph_window {
    c0: i32,
    c1: i32,
    r0: i32,
    r1: i32
}

fn lens_floor_i(v: f64) i32 {
    let i = v as i32
    if v < 0.0 && (i as f64) != v {
        return i - 1
    }
    return i
}

fn lens_ceil_i(v: f64) i32 {
    let i = v as i32
    if v > (i as f64) {
        return i + 1
    }
    return i
}

fn lens_clamp_span(c0: i32, c1: i32, r0: i32, r1: i32, rows: i32) lens_glyph_window {
    let rows_n = rows
    if rows_n < 1 { rows_n = 1 }
    let a = c0
    let b = c1
    let c = r0
    let d = r1
    if a < 0 { a = 0 }
    if c < 0 { c = 0 }
    if b > LENS_MAX_COLUMNS { b = LENS_MAX_COLUMNS }
    if d > rows_n { d = rows_n }
    if b < a { b = a }
    if d < c { d = c }
    return lens_glyph_window(a, b, c, d)
}

// Tight span of flow columns and local rows that cross `view`. Layout space
// matches the glyph batch: screen offset from the code origin, divided by
// the same scale the batch is drawn with.
fn lens_visible_window(x: f64, y: f64, zoom: f64, squash: f64, view: lens_leaf_rect, rows: i32) lens_glyph_window {
    let rows_n = rows
    if rows_n < 1 { rows_n = 1 }
    let sy = zoom * squash
    if zoom <= 0.000001 || sy <= 0.000001 {
        return lens_glyph_window(0, LENS_MAX_COLUMNS, 0, rows_n)
    }
    let pitch_x = g_lens_flow_column_pitch
    let pitch_y = g_lens_flow_line_pitch
    if pitch_x < 0.001 { pitch_x = 0.001 }
    if pitch_y < 0.001 { pitch_y = 0.001 }
    let x0 = (view.x - x) / zoom
    let x1 = (view.x + view.w - x) / zoom
    let y0 = (view.y - y) / sy
    let y1 = (view.y + view.h - y) / sy
    let top = code_base_top_pad()
    return lens_clamp_span(lens_floor_i(x0 / pitch_x), lens_ceil_i(x1 / pitch_x), lens_floor_i((y0 - top) / pitch_y), lens_ceil_i((y1 - top) / pitch_y), rows_n)
}

fn lens_pad_glyph_window(w: lens_glyph_window, rows: i32) lens_glyph_window {
    return lens_clamp_span(w.c0 - LENS_GLYPH_COL_MARGIN, w.c1 + LENS_GLYPH_COL_MARGIN, w.r0 - LENS_GLYPH_ROW_MARGIN, w.r1 + LENS_GLYPH_ROW_MARGIN, rows)
}

fn lens_glyph_window_inside(slot: i32, w: lens_glyph_window) bool {
    return w.c0 >= g_lens_built_c0[slot] && w.c1 <= g_lens_built_c1[slot] && w.r0 >= g_lens_built_r0[slot] && w.r1 <= g_lens_built_r1[slot]
}

// Draws the glyph batch scaled by the camera. Only the rows that cross `view`
// are tessellated; the retained batch is that window plus a small margin.
// Returns false when the batch could not be built.
fn lens_draw_code_batch(r: ref ui_renderer, slot: i32, index: i32, x: f64, y: f64, zoom: f64, squash: f64, view: lens_leaf_rect) bool {
    let rows = g_lens_flow_rows
    let mismatch = g_lens_slot_index[slot] != index || g_lens_slot_rows[slot] != rows || g_lens_slot_column_pitch[slot] != g_lens_flow_column_pitch || g_lens_slot_line_pitch[slot] != g_lens_flow_line_pitch || g_lens_slot_wrap[slot] != lens_wrap_cols(index)
    let tight = lens_visible_window(x, y, zoom, squash, view, rows)
    let batch = g_lens_glyph_batch[slot]
    if mismatch == false && g_lens_glyph_dirty[slot] == 0 && batch != 0 && lens_glyph_window_inside(slot, tight) {
        if ui_rect_batch_vertex_count(r, batch) <= 0 {
            return false
        }
        g_lens_glyph_time[slot] = os_time()
        g_lens_glyph_frame[slot] = g_lens_render_serial
        ui_rect_batch_draw_range(r, batch, 0, ui_rect_batch_vertex_count(r, batch), x, y, zoom, zoom * squash)
        return true
    }
    g_lens_slot_index[slot] = index
    g_lens_slot_rows[slot] = rows
    g_lens_slot_column_pitch[slot] = g_lens_flow_column_pitch
    g_lens_slot_line_pitch[slot] = g_lens_flow_line_pitch
    g_lens_slot_wrap[slot] = lens_wrap_cols(index)
    let padded = lens_pad_glyph_window(tight, rows)
    g_lens_batch_c0 = padded.c0
    g_lens_batch_c1 = padded.c1
    g_lens_batch_r0 = padded.r0
    g_lens_batch_r1 = padded.r1
    batch = lens_build_code_batch(r, slot, rows)
    lens_batch_window_reset()
    g_lens_glyph_batch[slot] = batch
    g_lens_built_c0[slot] = padded.c0
    g_lens_built_c1[slot] = padded.c1
    g_lens_built_r0[slot] = padded.r0
    g_lens_built_r1[slot] = padded.r1
    g_lens_glyph_dirty[slot] = 0
    g_lens_glyph_time[slot] = os_time()
    g_lens_glyph_frame[slot] = g_lens_render_serial
    if batch == 0 || ui_rect_batch_vertex_count(r, batch) <= 0 {
        return false
    }
    ui_rect_batch_draw_range(r, batch, 0, ui_rect_batch_vertex_count(r, batch), x, y, zoom, zoom * squash)
    return true
}

// One retained detailed document, including Git ghost rows. Only overlays
// use the immediate UI stream. Off-screen rows stay out of the glyph batch.
fn lens_draw_document_batch(r: ref ui_renderer, index: i32, x: f64, y: f64, zoom: f64, squash: f64, view: lens_leaf_rect) bool {
    let slot = LENS_CACHE_SLOTS
    let wrap = lens_wrap_cols(index)
    lens_wrap_sync(wrap)
    if g_lens_document_version != g_doc_version || g_lens_document_diff != g_lens_diff_revision || g_lens_document_index != index || g_lens_document_wrap != wrap {
        g_lens_document_version = g_doc_version
        g_lens_document_diff = g_lens_diff_revision
        g_lens_document_index = index
        g_lens_document_wrap = wrap
        g_lens_cache_text[slot] = g_doc
        g_lens_glyph_dirty[slot] = 1
    }
    lens_code_flow(index, g_lens_wrap_total)
    let scale = zoom * g_lens_flow_fit
    let dy = g_code_scroll * scale * squash / g_code_zoom_y
    let left = clamp(x, view.x, view.x + view.w)
    let top = clamp(y, view.y, view.y + view.h)
    ui_push_clip(r, left, top, view.x + view.w - left, view.y + view.h - top)
    let drew = lens_draw_code_batch(r, slot, index, x, y - dy, scale, squash, view)
    ui_pop_clip(r)
    return drew
}

// Source chunks are bounded, and retained GPU text has a shared budget too.
// Called after every slot drawn this frame has been stamped, so a visible
// batch is never destroyed to make room for one drawn later in the same frame.
fn lens_trim_glyphs(r: ref ui_renderer) {
    let vertices: i32 = 0
    for s in 0 to LENS_CACHE_SLOTS + 1 {
        vertices = vertices + ui_rect_batch_vertex_count(r, g_lens_glyph_batch[s])
    }
    loop vertices > LENS_GLYPH_VERTEX_BUDGET {
        let victim: i32 = -1
        let oldest: f64 = os_time() + 1.0
        for s in 0 to LENS_CACHE_SLOTS + 1 {
            if g_lens_glyph_batch[s] != 0 && g_lens_glyph_frame[s] != g_lens_render_serial && g_lens_glyph_time[s] < oldest {
                oldest = g_lens_glyph_time[s]
                victim = s
            }
        }
        if victim < 0 {
            break
        }
        vertices = vertices - ui_rect_batch_vertex_count(r, g_lens_glyph_batch[victim])
        ui_rect_batch_destroy(r, g_lens_glyph_batch[victim])
        g_lens_glyph_batch[victim] = 0
        g_lens_glyph_dirty[victim] = 1
    }
}

// Glyph batches of whole files are large; one left undrawn for a while goes
// back to a rebuild on demand.
fn lens_release_idle_glyphs(r: ref ui_renderer) {
    let now = os_time()
    for slot in 0 to LENS_CACHE_SLOTS + 1 {
        if g_lens_glyph_batch[slot] != 0 && g_lens_glyph_frame[slot] != g_lens_render_serial && now - g_lens_glyph_time[slot] > 8.0 {
            ui_rect_batch_destroy(r, g_lens_glyph_batch[slot])
            g_lens_glyph_batch[slot] = 0
            g_lens_glyph_dirty[slot] = 1
        }
    }
}

let g_lens_panning = false

// Capture only drags starting in the map; a press never moves the camera.
fn lens_pan_input(v: ref view, over_map: bool) {
    if v.mouse_pressed {
        g_lens_panning = over_map
    }
    if g_lens_view_mode == LENS_MODE_REF && g_lens_ref_drag >= 0 { g_lens_panning = false }
    if g_lens_panning && v.mouse_down && !v.mouse_pressed {
        g_lens_target_x = g_lens_target_x - (g_mouse_x - g_lens_drag_x) * g_lens_distance / 800.0
        g_lens_target_y = g_lens_target_y - (g_mouse_y - g_lens_drag_y) * g_lens_distance / 800.0
    }
    if v.mouse_released || !v.mouse_down {
        g_lens_panning = false
    }
    g_lens_drag_x = g_mouse_x
    g_lens_drag_y = g_mouse_y
}

fn lens_camera_moving(v: ref view) bool {
    if g_lens_ref_drag >= 0 || g_lens_panning || v.mouse_middle_down || v.scroll_y != 0.0 || view_gesture(v).zoom_factor != 1.0 {
        return true
    }
    let dx = g_lens_target_x - g_lens_center_x
    let dy = g_lens_target_y - g_lens_center_y
    let dz = g_lens_target_distance - g_lens_distance
    return dx * dx + dy * dy + dz * dz > 0.25
}

// Code stays inside the visible portion of its leaf even when its edges leave
// the viewport during a close zoom. This never creates a separate editor pane.
fn lens_leaf_content(leaf: lens_leaf_rect, x0: f64, y0: f64, x1: f64, y1: f64) lens_leaf_rect {
    let x = clamp(leaf.x + 1.0, x0 + 1.0, x1 - 1.0)
    let y = clamp(leaf.y + 1.0, y0, y1)
    let right = clamp(leaf.x + leaf.w - 1.0, x, x1 - 1.0)
    let bottom = clamp(leaf.y + leaf.h - 1.0, y, y1)
    return lens_leaf_rect(x, y, right - x, bottom - y, leaf.distance, leaf.scale, leaf.scale_y)
}
