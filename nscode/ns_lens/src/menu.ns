// The File menu and its shortcuts (Cmd+O open, Cmd+P search, Cmd+Enter
// commit; Open Recent and Push have none), Open Recent's submenu, the commit
// message dialog with its Commit, Commit Append and Commit & Push modes, the
// search box, and the bottom-left hints and activity row
// above the status bar. Input and drawing for the status bar's branch menu
// and its dialogs (branch.ns) are routed through here too.
use std
use os
use view
use ui

lit LENS_FILE_X = 12.0
lit LENS_FILE_W = 64.0
lit LENS_FILE_MENU_W = 220.0
lit LENS_FILE_ITEMS = 6
lit LENS_FILE_OPEN = 0
lit LENS_FILE_RECENT = 1
lit LENS_FILE_SEARCH = 2
lit LENS_FILE_COMMIT = 3
lit LENS_FILE_PUSH = 4
lit LENS_FILE_IGNORE = 5
// Open Recent's submenu opens to the right of the File popup, level with its
// row. Its project rows end in a separator, then Clear Recent.
lit LENS_RECENT_W = 420.0
lit LENS_RECENT_SEPARATOR_H = 9.0
lit LENS_RECENT_CLEAR = -2
// The top bar reads File, View, then the map mode menu.
lit LENS_VIEW_X = LENS_FILE_X + LENS_FILE_W + 8.0
lit LENS_VIEW_W = 64.0
lit LENS_VIEW_MENU_W = 150.0
lit LENS_VIEW_ITEMS = 2
lit LENS_SEARCH_W = 560.0
lit LENS_SEARCH_INPUT_H = 30.0
lit LENS_SEARCH_ROWS = 12
lit LENS_SEARCH_ROW_H = 22.0
lit LENS_COMMIT_W = 560.0
// The changed files sit under the message field, one tick box per row; past
// LENS_COMMIT_ROWS the wheel scrolls them.
lit LENS_COMMIT_LIST_Y = 84.0
lit LENS_COMMIT_ROW_H = 22.0
lit LENS_COMMIT_ROWS = 12
lit LENS_COMMIT_FILES = 4096
// The Commit button runs one of these modes; the arrow beside it opens a menu
// of them, which drops below the button.
lit LENS_COMMIT_MODES = 3
lit LENS_COMMIT_PLAIN = 0
lit LENS_COMMIT_APPEND = 1
lit LENS_COMMIT_PUSH = 2
lit LENS_COMMIT_BUTTON_W = 124.0
lit LENS_COMMIT_ARROW_W = 24.0
lit LENS_COMMIT_BUTTON_H = 26.0
lit LENS_COMMIT_MENU_W = 190.0
lit LENS_HINT_LINE_H = 15.0
lit LENS_HINT_COUNT = 8
lit LENS_ACTIVITY_H = 22.0

let g_lens_file_open = false
let g_lens_file_block = false
let g_lens_recent_open = false
let g_lens_recent_block = false
let g_lens_view_open = false
let g_lens_view_block = false
let g_lens_search_block = false
let g_lens_commit_open = false
let g_lens_commit_message = ""
// Changed files the dialog lists, or -1 while the worker lists them.
let g_lens_commit_changes: i32 = 0
// Each listed file's path relative to the workspace root, its Git state, and
// whether the commit takes it.
let g_lens_commit_path = [str](4096)
let g_lens_commit_kind = [i32](4096)
let g_lens_commit_checked = [bool](4096)
let g_lens_commit_scroll: i32 = 0
// The mode the Commit button and Enter run, kept for the session.
let g_lens_commit_mode: i32 = 0
let g_lens_commit_menu_open = false

fn lens_file_item_label(i: i32) str {
    if i == LENS_FILE_OPEN {
        return "Open..."
    }
    if i == LENS_FILE_RECENT {
        return "Open Recent"
    }
    if i == LENS_FILE_SEARCH {
        return "Search..."
    }
    if i == LENS_FILE_COMMIT {
        return "Commit..."
    }
    if i == LENS_FILE_PUSH { return "Push" }
    return "Ignore..."
}

// Open Recent shows its submenu arrow instead; Push has no shortcut.
fn lens_file_item_keys(i: i32) str {
    if i == LENS_FILE_OPEN {
        return "cmd+O"
    }
    if i == LENS_FILE_RECENT {
        return ">"
    }
    if i == LENS_FILE_SEARCH {
        return "cmd+P"
    }
    if i == LENS_FILE_COMMIT {
        return "cmd+enter"
    }
    return ""
}

fn lens_recent_x() f64 { return LENS_FILE_X + LENS_FILE_MENU_W }

fn lens_recent_y() f64 {
    return lens_mode_popup_y() + LENS_MODE_ITEM * (LENS_FILE_RECENT as f64)
}

// One row per listed project, or a single placeholder row when none is.
fn lens_recent_rows() i32 {
    return clamp_i(g_recent_count, 1, RECENT_KEEP)
}

fn lens_recent_clear_y() f64 {
    return lens_recent_y() + LENS_MODE_ITEM * (lens_recent_rows() as f64) + LENS_RECENT_SEPARATOR_H
}

fn lens_recent_h() f64 { return lens_recent_clear_y() + LENS_MODE_ITEM - lens_recent_y() }

// The submenu row at `y`: a project row, LENS_RECENT_CLEAR, or -1 on the
// separator.
fn lens_recent_row_at(y: f64) i32 {
    let clear_y = lens_recent_clear_y()
    if y >= clear_y {
        return LENS_RECENT_CLEAR
    }
    if y >= clear_y - LENS_RECENT_SEPARATOR_H {
        return -1
    }
    return clamp_i(((y - lens_recent_y()) / LENS_MODE_ITEM) as i32, 0, lens_recent_rows() - 1)
}

fn lens_view_item_label(i: i32) str {
    if i == 0 {
        return "Outline"
    }
    return "Terminal"
}

// A panel's toggle state, shown on the right of its menu row.
fn lens_view_item_on(i: i32) bool {
    if i == 0 {
        return outline_open()
    }
    return terminal_open()
}

fn lens_view_action(i: i32) {
    g_lens_view_open = false
    if i == 0 {
        outline_toggle()
    } else {
        terminal_toggle()
    }
}

fn lens_hint_keys(i: i32) str {
    if i == 0 { return "wheel/pinch" }
    if i == 1 { return "shift+wheel" }
    if i == 2 { return "left drag" }
    if i == 3 { return "right click" }
    if i == 4 { return "middle drag" }
    if i == 5 { return lens_file_item_keys(LENS_FILE_OPEN) }
    if i == 6 { return lens_file_item_keys(LENS_FILE_SEARCH) }
    return lens_file_item_keys(LENS_FILE_COMMIT)
}

fn lens_hint_action(i: i32) str {
    if i == 0 { return "zoom" }
    if i == 1 { return "scroll code" }
    if i == 2 && g_lens_view_mode == LENS_MODE_REF { return "move cell / pan" }
    if i == 2 { return "pan" }
    if i == 3 { return "select" }
    if i == 4 { return "tilt" }
    if i == 5 { return "open" }
    if i == 6 { return "search" }
    return "commit"
}

// Keys belong to the search box, the commit dialog, the branch dialogs, the
// ignore editor, an outline prompt or the terminal while any of them is open.
fn lens_typing() bool {
    return g_lens_ignore_open || g_lens_commit_open || g_lens_search_open || g_lens_branch_create_open || g_lens_remote_open || outline_prompt_active() || terminal_focused()
}

// Pointer input the map must not also take this frame. Floating panels block
// their own rectangles with their hit tests, so only popups belong here.
fn lens_menu_blocks() bool {
    return g_lens_ignore_open || g_lens_commit_open || g_lens_branch_create_open || g_lens_file_block || g_lens_recent_block || g_lens_view_open || g_lens_view_block || g_lens_search_block || g_lens_branch_block || g_lens_remote_block
}

fn cmd_down(v: ref view) bool {
    return view_is_key_pressed(v, 343) || view_is_key_pressed(v, 347) || view_is_key_pressed(v, 341) || view_is_key_pressed(v, 345)
}

fn lens_search_show() {
    lens_branch_hide()
    g_lens_search_open = true
    g_lens_commit_open = false
    g_lens_file_open = false
}

fn lens_commit_show() {
    lens_branch_hide()
    g_lens_commit_open = true
    g_lens_search_open = false
    g_lens_file_open = false
    g_lens_commit_message = ""
    g_lens_commit_menu_open = false
    // The change view's worker lists the files; its poll fills the list.
    g_lens_commit_changes = -1
    g_lens_commit_scroll = 0
    lens_changes_request(false)
}

// Take the files of a change-kinds listing Git returned with `status`, each
// one ticked; none when it failed.
fn lens_commit_list(listed: str, status: i32) {
    g_lens_commit_changes = 0
    g_lens_commit_scroll = 0
    if status != 0 {
        return
    }
    let start: i32 = 0
    for i in 0 to listed.len + 1 {
        if i == listed.len || ((listed[i] as i32) & 255) == 10 {
            if i > start + 2 && g_lens_commit_changes < LENS_COMMIT_FILES {
                let n = g_lens_commit_changes
                g_lens_commit_kind[n] = lens_git_kind((listed[start] as i32) & 255)
                g_lens_commit_path[n] = substr(listed, start + 2, i - start - 2)
                g_lens_commit_checked[n] = true
                g_lens_commit_changes = n + 1
            }
            start = i + 1
        }
    }
}

fn lens_commit_ticked() i32 {
    let count: i32 = 0
    for i in 0 to g_lens_commit_changes {
        if g_lens_commit_checked[i] {
            count = count + 1
        }
    }
    return count
}

// The title's box ticks every file, or unticks them all when all are ticked.
fn lens_commit_tick_all() {
    let on = lens_commit_ticked() < g_lens_commit_changes
    for i in 0 to g_lens_commit_changes {
        g_lens_commit_checked[i] = on
    }
}

fn lens_commit_toggle(i: i32) {
    if i >= 0 && i < g_lens_commit_changes {
        g_lens_commit_checked[i] = g_lens_commit_checked[i] == false
    }
}

fn lens_commit_mode_label(mode: i32) str {
    if mode == LENS_COMMIT_APPEND { return "Commit Append" }
    if mode == LENS_COMMIT_PUSH { return "Commit & Push" }
    return "Commit"
}

fn lens_commit_mode_job(mode: i32) i32 {
    if mode == LENS_COMMIT_APPEND { return LENS_JOB_AMEND }
    if mode == LENS_COMMIT_PUSH { return LENS_JOB_COMMIT_PUSH }
    return LENS_JOB_COMMIT
}

// With every listed file ticked the commit takes the whole work tree, as it
// did before the list arrived; otherwise only the ticked paths. Commit Append
// amends the last commit: an empty message keeps its message, and no ticked
// file only rewords it.
fn lens_commit_submit() {
    let append = g_lens_commit_mode == LENS_COMMIT_APPEND
    let message = lens_one_line(g_lens_commit_message)
    let ticked = lens_commit_ticked()
    if append {
        if message == "" && g_lens_commit_changes >= 0 && ticked == 0 {
            g_lens_message = "Enter a message or tick the files to append"
            return
        }
    } else if message == "" {
        g_lens_message = "Enter a commit message"
        return
    } else if g_lens_commit_changes > 0 && ticked == 0 {
        g_lens_message = "Tick the files to commit"
        return
    }
    g_lens_commit_open = false
    g_lens_commit_menu_open = false
    let kind = lens_commit_mode_job(g_lens_commit_mode)
    if g_lens_commit_changes <= 0 || ticked == g_lens_commit_changes {
        if append {
            lens_job_start(kind, lens_amend_steps(message))
        } else {
            lens_job_start(kind, lens_commit_steps(message))
        }
        return
    }
    let added = ""
    let chosen = ""
    for i in 0 to g_lens_commit_changes {
        if g_lens_commit_checked[i] {
            chosen = chosen + "\n" + g_lens_commit_path[i]
            if g_lens_commit_kind[i] == LENS_GIT_ADDED {
                added = added + "\n" + g_lens_commit_path[i]
            }
        }
    }
    if append {
        lens_job_start(kind, lens_amend_paths_steps(message, added, chosen))
    } else {
        lens_job_start(kind, lens_commit_paths_steps(message, added, chosen))
    }
}

fn lens_file_action(i: i32) {
    if i == LENS_FILE_RECENT {
        // Open Recent keeps the File menu up and shows its submenu.
        g_lens_recent_open = true
        return
    }
    g_lens_file_open = false
    if i == LENS_FILE_OPEN {
        lens_open_project()
    } else if i == LENS_FILE_SEARCH {
        lens_search_show()
    } else if i == LENS_FILE_COMMIT {
        lens_commit_show()
    } else if i == LENS_FILE_PUSH {
        lens_push()
    } else {
        lens_ignore_show()
    }
}

// Open Recent's `row`: map that project. The open project's row and the
// placeholder row of an empty list only close the menu.
fn lens_recent_action(row: i32) {
    g_lens_file_open = false
    g_lens_recent_open = false
    if row < 0 || row >= g_recent_count {
        return
    }
    let root = g_recent[row]
    if root != recent_normalize(g_workspace_root) {
        lens_open_root(root)
    }
}

// Open Recent's last row empties the list and closes the menu.
fn lens_recent_clear() {
    g_lens_file_open = false
    g_lens_recent_open = false
    recent_clear()
}

// One-line text entry from the latched keys: printable keys, Backspace and
// Cmd+V. The caret stays at the end.
fn lens_field_edit(v: ref view, text: str) str {
    let value = text
    if key_edge(v, 259) && value.len > 0 {
        let cut = value.len - 1
        loop cut > 0 && (lens_byte(value, cut) & 192) == 128 {
            cut = cut - 1
        }
        value = substr(value, 0, cut)
    }
    for k in 32 to 97 {
        if key_edge(v, k) {
            if key_event_cmd() {
                if k == 86 {
                    value = value + lens_one_line(view_get_clipboard(v))
                }
            } else {
                value = value + key_char(k, key_event_shift())
            }
        }
    }
    return value
}

// Runs before the editor, so neither the editor nor the map sees keys meant
// for the shortcuts, the search box or the commit dialog.
fn lens_menu_keys(v: ref view) {
    if g_lens_ignore_open {
        lens_ignore_keys(v)
        return
    }
    if g_lens_commit_open {
        // Escape closes the mode menu first; while it is open the arrow keys
        // move the mode Enter runs.
        if key_edge(v, 256) {
            if g_lens_commit_menu_open {
                g_lens_commit_menu_open = false
            } else {
                g_lens_commit_open = false
            }
            return
        }
        if key_edge(v, 257) || key_edge(v, 335) {
            lens_commit_submit()
            return
        }
        if g_lens_commit_menu_open {
            if key_edge(v, 264) {
                g_lens_commit_mode = clamp_i(g_lens_commit_mode + 1, 0, LENS_COMMIT_MODES - 1)
            }
            if key_edge(v, 265) {
                g_lens_commit_mode = clamp_i(g_lens_commit_mode - 1, 0, LENS_COMMIT_MODES - 1)
            }
        }
        g_lens_commit_message = lens_field_edit(v, g_lens_commit_message)
        return
    }
    if lens_branch_keys(v) {
        return
    }
    if g_lens_search_open {
        if key_edge(v, 256) || (cmd_down(v) && key_edge(v, 80)) {
            g_lens_search_open = false
            return
        }
        if key_edge(v, 257) || key_edge(v, 335) {
            lens_search_go(g_lens_search_selected)
            return
        }
        if key_edge(v, 264) {
            g_lens_search_selected = clamp_i(g_lens_search_selected + 1, 0, clamp_i(g_lens_hit_count - 1, 0, LENS_HIT_MAX))
        }
        if key_edge(v, 265) {
            g_lens_search_selected = clamp_i(g_lens_search_selected - 1, 0, LENS_HIT_MAX)
        }
        if g_lens_search_selected < g_lens_search_scroll {
            g_lens_search_scroll = g_lens_search_selected
        }
        if g_lens_search_selected >= g_lens_search_scroll + LENS_SEARCH_ROWS {
            g_lens_search_scroll = g_lens_search_selected - LENS_SEARCH_ROWS + 1
        }
        lens_search_set_query(lens_field_edit(v, g_lens_search_query))
        return
    }
    // The outline's name prompt and the terminal own every key while active.
    if outline_prompt_active() {
        outline_prompt_keys(v)
        return
    }
    if terminal_focused() {
        terminal_keys(v)
        return
    }
    // With no file open for editing, typing naturally belongs to an open
    // terminal even if a click on the outline or map cleared its focus.
    if terminal_open() && g_lens_editing == false && terminal_key_input(v) {
        g_terminal_focus = true
        terminal_keys(v)
        return
    }
    if cmd_down(v) {
        if key_edge(v, 79) {
            lens_open_project()
        } else if key_edge(v, 80) {
            lens_search_show()
        } else if key_edge(v, 257) || key_edge(v, 335) {
            lens_commit_show()
        } else {
            // Cmd+1..4 switch the map mode.
            lens_mode_shortcut_keys(v)
        }
    }
}

fn lens_search_x(w: f64) f64 {
    return clamp((w - LENS_SEARCH_W) * 0.5, 8.0, 100000.0)
}

fn lens_search_y() f64 { return lens_mode_y() + LENS_MODE_H + 8.0 }

fn lens_search_shown_rows() i32 {
    return clamp_i(g_lens_hit_count - g_lens_search_scroll, 0, LENS_SEARCH_ROWS)
}

fn lens_search_panel_h() f64 {
    return LENS_SEARCH_INPUT_H + (lens_search_shown_rows() as f64) * LENS_SEARCH_ROW_H + LENS_SEARCH_ROW_H
}

fn lens_commit_x(w: f64) f64 { return (w - LENS_COMMIT_W) * 0.5 }

// One row per listed file up to LENS_COMMIT_ROWS, and one for the note while
// the list is empty.
fn lens_commit_shown_rows() i32 {
    return clamp_i(g_lens_commit_changes, 1, LENS_COMMIT_ROWS)
}

fn lens_commit_scroll_max() i32 {
    return clamp_i(g_lens_commit_changes - LENS_COMMIT_ROWS, 0, LENS_COMMIT_FILES)
}

fn lens_commit_list_h() f64 {
    return (lens_commit_shown_rows() as f64) * LENS_COMMIT_ROW_H
}

// Title, message field, file list, then the key hint and the buttons.
fn lens_commit_h() f64 {
    return LENS_COMMIT_LIST_Y + lens_commit_list_h() + 76.0
}

fn lens_commit_y(h: f64) f64 {
    return clamp((h - lens_commit_h()) * 0.5, LENS_TOP_BAR_H + 4.0, 100000.0)
}

// The buttons' row: Cancel, then the Commit split button (the mode's label and
// its arrow) ending 16 px in from the dialog's right edge.
fn lens_commit_button_y(h: f64) f64 {
    return lens_commit_y(h) + lens_commit_h() - 42.0
}

fn lens_commit_button_x(w: f64) f64 {
    return lens_commit_x(w) + LENS_COMMIT_W - 16.0 - LENS_COMMIT_ARROW_W - LENS_COMMIT_BUTTON_W
}

fn lens_commit_arrow_x(w: f64) f64 {
    return lens_commit_button_x(w) + LENS_COMMIT_BUTTON_W
}

fn lens_commit_cancel_x(w: f64) f64 {
    return lens_commit_button_x(w) - 92.0
}

// The mode menu lines up with the split button's right edge.
fn lens_commit_menu_x(w: f64) f64 {
    return lens_commit_arrow_x(w) + LENS_COMMIT_ARROW_W - LENS_COMMIT_MENU_W
}

fn lens_commit_menu_h() f64 {
    return LENS_MODE_ITEM * (LENS_COMMIT_MODES as f64)
}

// Below the button, or above it when the status bar leaves no room below.
fn lens_commit_menu_y(h: f64) f64 {
    let below = lens_commit_button_y(h) + LENS_COMMIT_BUTTON_H + 2.0
    if below + lens_commit_menu_h() <= h - STATUS_BAR_H {
        return below
    }
    return lens_commit_button_y(h) - 2.0 - lens_commit_menu_h()
}

// Pointer input for the File menu, the search box, the commit dialog and the
// branch menu, ahead of the map. A click outside an open popup closes it.
fn lens_menu_mouse(v: ref view, w: f64, h: f64) {
    let pop_y = lens_mode_popup_y()
    let pop_h = LENS_MODE_ITEM * (LENS_FILE_ITEMS as f64)
    g_lens_file_block = g_lens_file_open && raw_hit(v, LENS_FILE_X, pop_y, LENS_FILE_MENU_W, pop_h)
    g_lens_recent_block = g_lens_file_open && g_lens_recent_open && raw_hit(v, lens_recent_x(), lens_recent_y(), LENS_RECENT_W, lens_recent_h())
    // Pointing at a File row shows Open Recent's submenu for its own row and
    // hides it for the others; leaving the popup keeps it as it is.
    if g_lens_file_block {
        g_lens_recent_open = clamp_i(((g_mouse_y - pop_y) / LENS_MODE_ITEM) as i32, 0, LENS_FILE_ITEMS - 1) == LENS_FILE_RECENT
    }
    let view_pop_h = LENS_MODE_ITEM * (LENS_VIEW_ITEMS as f64)
    g_lens_view_block = g_lens_view_open && raw_hit(v, LENS_VIEW_X, pop_y, LENS_VIEW_MENU_W, view_pop_h)
    let sx = lens_search_x(w)
    let sy = lens_search_y()
    g_lens_search_block = g_lens_search_open && raw_hit(v, sx, sy, LENS_SEARCH_W, lens_search_panel_h())
    if g_lens_search_block && v.scroll_y != 0.0 {
        let step: i32 = 1
        if v.scroll_y > 0.0 {
            step = -1
        }
        g_lens_search_scroll = clamp_i(g_lens_search_scroll + step, 0, clamp_i(g_lens_hit_count - LENS_SEARCH_ROWS, 0, LENS_HIT_MAX))
        v.scroll_y = 0.0
    }
    lens_branch_pointer(v, w, h)
    if g_lens_ignore_open {
        lens_ignore_mouse(v, w, h)
        return
    }
    if g_lens_commit_open && v.scroll_y != 0.0 && raw_hit(v, lens_commit_x(w), lens_commit_y(h), LENS_COMMIT_W, lens_commit_h()) {
        let step: i32 = 1
        if v.scroll_y > 0.0 {
            step = -1
        }
        g_lens_commit_scroll = clamp_i(g_lens_commit_scroll + step, 0, lens_commit_scroll_max())
        v.scroll_y = 0.0
    }
    if v.mouse_pressed == false {
        return
    }
    if g_lens_commit_open {
        let x = lens_commit_x(w)
        let y = lens_commit_y(h)
        let list_y = y + LENS_COMMIT_LIST_Y
        let button_y = lens_commit_button_y(h)
        if g_lens_commit_menu_open {
            // The open mode menu takes the click: a row picks its mode and
            // runs it, anywhere else only closes the menu.
            g_lens_commit_menu_open = false
            let menu_y = lens_commit_menu_y(h)
            if raw_hit(v, lens_commit_menu_x(w), menu_y, LENS_COMMIT_MENU_W, lens_commit_menu_h()) {
                g_lens_commit_mode = clamp_i(((g_mouse_y - menu_y) / LENS_MODE_ITEM) as i32, 0, LENS_COMMIT_MODES - 1)
                lens_commit_submit()
            }
            v.mouse_pressed = false
            return
        }
        if raw_hit(v, lens_commit_cancel_x(w), button_y, 84.0, LENS_COMMIT_BUTTON_H) {
            g_lens_commit_open = false
        } else if raw_hit(v, lens_commit_arrow_x(w), button_y, LENS_COMMIT_ARROW_W, LENS_COMMIT_BUTTON_H) {
            g_lens_commit_menu_open = true
        } else if raw_hit(v, lens_commit_button_x(w), button_y, LENS_COMMIT_BUTTON_W, LENS_COMMIT_BUTTON_H) {
            lens_commit_submit()
        } else if g_lens_commit_changes > 0 && raw_hit(v, x + 8.0, y + 10.0, 30.0, 28.0) {
            lens_commit_tick_all()
        } else if g_lens_commit_changes > 0 && raw_hit(v, x + 8.0, list_y, LENS_COMMIT_W - 16.0, lens_commit_list_h()) {
            // A click anywhere on a file's row ticks or unticks it.
            lens_commit_toggle(g_lens_commit_scroll + ((g_mouse_y - list_y) / LENS_COMMIT_ROW_H) as i32)
        }
        v.mouse_pressed = false
        return
    }
    if g_lens_branch_create_open {
        lens_branch_create_click(v, w, h)
        v.mouse_pressed = false
        return
    }
    if raw_hit(v, LENS_FILE_X, lens_mode_y(), LENS_FILE_W, LENS_MODE_H) {
        g_lens_file_open = g_lens_file_open == false
        g_lens_recent_open = false
        g_lens_branch_open = false
        if g_lens_file_open {
            recent_load()
        }
        // The map menu's popup opens where File's would cover it.
        g_lens_mode_open = false
        g_lens_view_open = false
        v.mouse_pressed = false
        return
    }
    if raw_hit(v, LENS_VIEW_X, lens_mode_y(), LENS_VIEW_W, LENS_MODE_H) {
        g_lens_view_open = g_lens_view_open == false
        g_lens_file_open = false
        g_lens_branch_open = false
        g_lens_mode_open = false
        v.mouse_pressed = false
        return
    }
    if g_lens_view_open {
        if g_lens_view_block {
            lens_view_action(clamp_i(((g_mouse_y - pop_y) / LENS_MODE_ITEM) as i32, 0, LENS_VIEW_ITEMS - 1))
        }
        g_lens_view_open = false
        v.mouse_pressed = false
        return
    }
    if g_lens_file_open {
        v.mouse_pressed = false
        if g_lens_recent_block {
            // A click on the separator leaves the menu open.
            let row = lens_recent_row_at(g_mouse_y)
            if row == LENS_RECENT_CLEAR {
                lens_recent_clear()
            } else if row >= 0 {
                lens_recent_action(row)
            }
            return
        }
        if g_lens_file_block {
            lens_file_action(clamp_i(((g_mouse_y - pop_y) / LENS_MODE_ITEM) as i32, 0, LENS_FILE_ITEMS - 1))
            return
        }
        g_lens_file_open = false
        return
    }
    if g_lens_branch_open {
        lens_branch_menu_click(h)
        v.mouse_pressed = false
        return
    }
    // The status bar's down arrow pulls, its up arrow pushes, and the branch
    // button opens the branch menu.
    let sync = lens_sync_button_at(g_mouse_x, g_mouse_y)
    if sync == LENS_JOB_PULL {
        lens_pull()
        v.mouse_pressed = false
        return
    }
    if sync == LENS_JOB_PUSH {
        lens_push()
        v.mouse_pressed = false
        return
    }
    if lens_branch_button_at(g_mouse_x, g_mouse_y) {
        lens_branch_show()
        v.mouse_pressed = false
        return
    }
    if g_lens_search_open {
        let rows_y = sy + LENS_SEARCH_INPUT_H
        if g_lens_search_block && g_mouse_y >= rows_y {
            let row = ((g_mouse_y - rows_y) / LENS_SEARCH_ROW_H) as i32
            if row < lens_search_shown_rows() {
                lens_search_go(g_lens_search_scroll + row)
            }
        } else if g_lens_search_block == false {
            g_lens_search_open = false
        }
        v.mouse_pressed = false
    }
    if g_lens_remote_open {
        lens_remote_click()
        v.mouse_pressed = false
    }
}

fn lens_draw_file_menu(r: ref ui_renderer, v: ref view) {
    let y = lens_mode_y()
    let border = col_muted()
    if g_lens_file_open {
        border = col_accent()
    }
    ui_fill_round_rect(r, LENS_FILE_X, y, LENS_FILE_W, LENS_MODE_H, 3.0, col_editor_panel(), 0.0)
    ui_stroke_round_rect(r, LENS_FILE_X, y, LENS_FILE_W, LENS_MODE_H, 3.0, 1.0, border, 0.0)
    let ty = ui_text_v_center_y(r, y, LENS_MODE_H, small_px(), FONT_MONO())
    draw_text_clipped(r, LENS_FILE_X + 10.0, ty, LENS_FILE_W - 28.0, LENS_MODE_H, "File", small_px(), col_text())
    draw_text_clipped(r, LENS_FILE_X + LENS_FILE_W - 16.0, ty, 12.0, LENS_MODE_H, "v", small_px(), col_muted())
    if g_lens_file_open == false {
        return
    }
    let pop_y = lens_mode_popup_y()
    let pop_h = LENS_MODE_ITEM * (LENS_FILE_ITEMS as f64)
    ui_fill_round_rect(r, LENS_FILE_X, pop_y, LENS_FILE_MENU_W, pop_h, 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, LENS_FILE_X, pop_y, LENS_FILE_MENU_W, pop_h, 3.0, 1.0, col_muted(), 0.0)
    for i in 0 to LENS_FILE_ITEMS {
        let iy = pop_y + (i as f64) * LENS_MODE_ITEM
        let parent = i == LENS_FILE_RECENT && g_lens_recent_open
        if parent || raw_hit(v, LENS_FILE_X, iy, LENS_FILE_MENU_W, LENS_MODE_ITEM) {
            ui_fill_rect(r, LENS_FILE_X + 1.0, iy, LENS_FILE_MENU_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
        let row_ty = ui_text_v_center_y(r, iy, LENS_MODE_ITEM, small_px(), FONT_MONO())
        draw_text_clipped(r, LENS_FILE_X + 10.0, row_ty, 110.0, LENS_MODE_ITEM, lens_file_item_label(i), small_px(), col_text())
        let keys = lens_file_item_keys(i)
        let kw = ui_text_width(r, keys, small_px(), FONT_MONO())
        draw_text_clipped(r, LENS_FILE_X + LENS_FILE_MENU_W - 10.0 - kw, row_ty, kw, LENS_MODE_ITEM, keys, small_px(), col_muted())
    }
    if g_lens_recent_open {
        lens_draw_recent_menu(r, v)
    }
}

// Each row names the project's folder, then the folder that holds it; the
// open project is marked on the right. Clear Recent follows a separator and
// is dimmed while the list is empty.
fn lens_draw_recent_menu(r: ref ui_renderer, v: ref view) {
    let x = lens_recent_x()
    let y = lens_recent_y()
    ui_fill_round_rect(r, x, y, LENS_RECENT_W, lens_recent_h(), 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, x, y, LENS_RECENT_W, lens_recent_h(), 3.0, 1.0, col_muted(), 0.0)
    let clear_y = lens_recent_clear_y()
    ui_fill_rect(r, x + 8.0, clear_y - LENS_RECENT_SEPARATOR_H * 0.5 - 0.5, LENS_RECENT_W - 16.0, 1.0, col_muted(), 0.0)
    let clear_color = col_muted()
    if g_recent_count > 0 {
        clear_color = col_text()
        if raw_hit(v, x, clear_y, LENS_RECENT_W, LENS_MODE_ITEM) {
            ui_fill_rect(r, x + 1.0, clear_y, LENS_RECENT_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
    }
    let clear_ty = ui_text_v_center_y(r, clear_y, LENS_MODE_ITEM, small_px(), FONT_MONO())
    draw_text_clipped(r, x + 10.0, clear_ty, LENS_RECENT_W - 20.0, LENS_MODE_ITEM, "Clear Recent", small_px(), clear_color)
    let count = g_recent_count
    if count == 0 {
        let ty = ui_text_v_center_y(r, y, LENS_MODE_ITEM, small_px(), FONT_MONO())
        draw_text_clipped(r, x + 10.0, ty, LENS_RECENT_W - 20.0, LENS_MODE_ITEM, "No recent projects", small_px(), col_muted())
        return
    }
    let open = recent_normalize(g_workspace_root)
    for i in 0 to count {
        let iy = y + (i as f64) * LENS_MODE_ITEM
        if raw_hit(v, x, iy, LENS_RECENT_W, LENS_MODE_ITEM) {
            ui_fill_rect(r, x + 1.0, iy, LENS_RECENT_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
        let path = g_recent[i]
        let name = recent_name(path)
        let row_ty = ui_text_v_center_y(r, iy, LENS_MODE_ITEM, small_px(), FONT_MONO())
        let nw = clamp(ui_text_width(r, name, small_px(), FONT_MONO()), 0.0, LENS_RECENT_W - 20.0)
        draw_text_clipped(r, x + 10.0, row_ty, nw, LENS_MODE_ITEM, name, small_px(), col_text())
        let px = x + 10.0 + nw + 16.0
        let right = x + LENS_RECENT_W - 10.0
        if path == open {
            let state = "open"
            let sw = ui_text_width(r, state, small_px(), FONT_MONO())
            right = right - sw
            draw_text_clipped(r, right, row_ty, sw, LENS_MODE_ITEM, state, small_px(), col_accent())
            right = right - 12.0
        }
        draw_text_clipped(r, px, row_ty, right - px, LENS_MODE_ITEM, recent_place(path), small_px(), col_muted())
    }
}

fn lens_draw_view_menu(r: ref ui_renderer, v: ref view) {
    let y = lens_mode_y()
    let border = col_muted()
    if g_lens_view_open {
        border = col_accent()
    }
    ui_fill_round_rect(r, LENS_VIEW_X, y, LENS_VIEW_W, LENS_MODE_H, 3.0, col_editor_panel(), 0.0)
    ui_stroke_round_rect(r, LENS_VIEW_X, y, LENS_VIEW_W, LENS_MODE_H, 3.0, 1.0, border, 0.0)
    let ty = ui_text_v_center_y(r, y, LENS_MODE_H, small_px(), FONT_MONO())
    draw_text_clipped(r, LENS_VIEW_X + 10.0, ty, LENS_VIEW_W - 28.0, LENS_MODE_H, "View", small_px(), col_text())
    draw_text_clipped(r, LENS_VIEW_X + LENS_VIEW_W - 16.0, ty, 12.0, LENS_MODE_H, "v", small_px(), col_muted())
    if g_lens_view_open == false {
        return
    }
    let pop_y = lens_mode_popup_y()
    let pop_h = LENS_MODE_ITEM * (LENS_VIEW_ITEMS as f64)
    ui_fill_round_rect(r, LENS_VIEW_X, pop_y, LENS_VIEW_MENU_W, pop_h, 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, LENS_VIEW_X, pop_y, LENS_VIEW_MENU_W, pop_h, 3.0, 1.0, col_muted(), 0.0)
    for i in 0 to LENS_VIEW_ITEMS {
        let iy = pop_y + (i as f64) * LENS_MODE_ITEM
        if raw_hit(v, LENS_VIEW_X, iy, LENS_VIEW_MENU_W, LENS_MODE_ITEM) {
            ui_fill_rect(r, LENS_VIEW_X + 1.0, iy, LENS_VIEW_MENU_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
        let row_ty = ui_text_v_center_y(r, iy, LENS_MODE_ITEM, small_px(), FONT_MONO())
        draw_text_clipped(r, LENS_VIEW_X + 10.0, row_ty, 100.0, LENS_MODE_ITEM, lens_view_item_label(i), small_px(), col_text())
        if lens_view_item_on(i) {
            let state = "on"
            let sw = ui_text_width(r, state, small_px(), FONT_MONO())
            draw_text_clipped(r, LENS_VIEW_X + LENS_VIEW_MENU_W - 10.0 - sw, row_ty, sw, LENS_MODE_ITEM, state, small_px(), col_accent())
        }
    }
}

// A one-line field: its text with the end kept in view, and a blinking caret.
// The popup behind it supplies the fill; a second translucent fill here would
// compound the alpha.
fn lens_draw_field(r: ref ui_renderer, x: f64, y: f64, w: f64, h: f64, text: str, placeholder: str) {
    ui_stroke_round_rect(r, x, y, w, h, 3.0, 1.0, col_accent(), 0.0)
    let ty = ui_text_v_center_y(r, y, h, small_px(), FONT_MONO())
    let tw = ui_text_width(r, text, small_px(), FONT_MONO())
    let room = w - 20.0
    let tx = x + 10.0 - clamp(tw - room, 0.0, 1000000.0)
    ui_push_clip(r, x + 4.0, y, w - 8.0, h)
    if text == "" {
        ui_draw_text(r, x + 10.0, ty, placeholder, small_px(), col_muted(), FONT_MONO())
    } else {
        ui_draw_text(r, tx, ty, text, small_px(), col_text(), FONT_MONO())
    }
    let blink = os_time() * 2.0
    if blink - ((blink as i64) as f64) < 0.6 {
        ui_fill_rect(r, tx + tw + 1.0, y + 7.0, 1.5, h - 14.0, col_editor_cursor(), 0.0)
    }
    ui_pop_clip(r)
}

fn lens_draw_search(r: ref ui_renderer, v: ref view, w: f64) {
    if g_lens_search_open == false {
        return
    }
    let x = lens_search_x(w)
    let y = lens_search_y()
    let panel_h = lens_search_panel_h()
    ui_fill_round_rect(r, x, y, LENS_SEARCH_W, panel_h, 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, x, y, LENS_SEARCH_W, panel_h, 3.0, 1.0, col_muted(), 0.0)
    lens_draw_field(r, x, y, LENS_SEARCH_W, LENS_SEARCH_INPUT_H, g_lens_search_query, "Search file names and contents")
    let rows = lens_search_shown_rows()
    for n in 0 to rows {
        let hit = g_lens_search_scroll + n
        let ry = y + LENS_SEARCH_INPUT_H + (n as f64) * LENS_SEARCH_ROW_H
        if hit == g_lens_search_selected || raw_hit(v, x, ry, LENS_SEARCH_W, LENS_SEARCH_ROW_H) {
            ui_fill_rect(r, x + 1.0, ry, LENS_SEARCH_W - 2.0, LENS_SEARCH_ROW_H, col_popup_hi(), 0.0)
        }
        let ty = ui_text_v_center_y(r, ry, LENS_SEARCH_ROW_H, small_px(), FONT_MONO())
        let place = lens_relative_path(os_entry_path(g_lens_hit_file[hit]))
        if g_lens_hit_line[hit] >= 0 {
            place = place + ":" + itos(g_lens_hit_line[hit] + 1)
        }
        let pw = ui_text_width(r, place, small_px(), FONT_MONO())
        draw_text_clipped(r, x + 10.0, ty, LENS_SEARCH_W - 20.0, LENS_SEARCH_ROW_H, place, small_px(), col_text())
        if g_lens_hit_text[hit] != "" {
            let sx = x + 10.0 + pw + 16.0
            draw_text_clipped(r, sx, ty, x + LENS_SEARCH_W - 10.0 - sx, LENS_SEARCH_ROW_H, g_lens_hit_text[hit], small_px(), col_muted())
        }
    }
    let fy = y + LENS_SEARCH_INPUT_H + (rows as f64) * LENS_SEARCH_ROW_H
    let note = ""
    if g_lens_search_running || g_lens_search_query != g_lens_search_done_query {
        note = "searching..."
    } else if g_lens_search_query != "" {
        note = itos(g_lens_hit_count) + " results"
        if g_lens_hit_count >= LENS_HIT_MAX {
            note = "first " + note
        }
    }
    let ty = ui_text_v_center_y(r, fy, LENS_SEARCH_ROW_H, small_px(), FONT_MONO())
    draw_text_clipped(r, x + 10.0, ty, LENS_SEARCH_W - 20.0, LENS_SEARCH_ROW_H, note, small_px(), col_muted())
}

fn lens_draw_button(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64, label: str, strong: bool) {
    let border = col_muted()
    if strong || raw_hit(v, x, y, w, h) {
        border = col_accent()
    }
    ui_fill_round_rect(r, x, y, w, h, 3.0, col_editor_panel_hi(), 0.0)
    ui_stroke_round_rect(r, x, y, w, h, 3.0, 1.0, border, 0.0)
    draw_centered_text(r, x, y, w, h, label, small_px(), col_text())
}

// A 14 px tick box: a tick when `checked`, a dash when only `partial`.
fn lens_draw_check(r: ref ui_renderer, x: f64, y: f64, checked: bool, partial: bool, color: u32) {
    ui_stroke_round_rect(r, x, y, 14.0, 14.0, 2.0, 1.0, color, 0.0)
    if checked {
        ui_stroke_line(r, x + 3.0, y + 7.5, x + 6.0, y + 10.5, 1.5, color, 0.5)
        ui_stroke_line(r, x + 6.0, y + 10.5, x + 11.0, y + 3.5, 1.5, color, 0.5)
    } else if partial {
        ui_fill_rect(r, x + 3.5, y + 6.25, 7.0, 1.5, color, 0.0)
    }
}

fn lens_commit_title() str {
    let count = g_lens_commit_changes
    if count < 0 {
        return "Commit changes"
    }
    let noun = " changed files"
    if count == 1 {
        noun = " changed file"
    }
    let ticked = lens_commit_ticked()
    if ticked < count {
        return "Commit " + itos(ticked) + " of " + itos(count) + noun
    }
    return "Commit " + itos(count) + noun
}

// One listed file: its tick box, its path in its Git state's color, dimmed
// while unticked, and the state's letter at the end of the row.
fn lens_draw_commit_row(r: ref ui_renderer, v: ref view, x: f64, y: f64, i: i32) {
    let row_w = LENS_COMMIT_W - 16.0
    if raw_hit(v, x + 8.0, y, row_w, LENS_COMMIT_ROW_H) {
        ui_fill_rect(r, x + 8.0, y, row_w, LENS_COMMIT_ROW_H, col_popup_hi(), 0.0)
    }
    let kind = g_lens_commit_kind[i]
    let color = col_git_kind(kind)
    let box = col_text()
    if g_lens_commit_checked[i] == false {
        color = (color & 0x00ffffffu) | 0x80000000u
        box = col_muted()
    }
    lens_draw_check(r, x + 16.0, y + 4.0, g_lens_commit_checked[i], false, box)
    let ty = ui_text_v_center_y(r, y, LENS_COMMIT_ROW_H, small_px(), FONT_MONO())
    let letter = lens_git_letter(kind)
    let lw = ui_text_width(r, letter, small_px(), FONT_MONO())
    let right = x + LENS_COMMIT_W - 24.0
    draw_text_clipped(r, x + 40.0, ty, right - lw - 12.0 - (x + 40.0), LENS_COMMIT_ROW_H, g_lens_commit_path[i], small_px(), color)
    draw_text_clipped(r, right - lw, ty, lw, LENS_COMMIT_ROW_H, letter, small_px(), color)
}

fn lens_draw_commit_list(r: ref ui_renderer, v: ref view, x: f64, y: f64) {
    let count = g_lens_commit_changes
    if count <= 0 {
        let note = "No changed files"
        if count < 0 {
            note = "Listing changed files..."
        }
        let ty = ui_text_v_center_y(r, y, LENS_COMMIT_ROW_H, small_px(), FONT_MONO())
        draw_text_clipped(r, x + 16.0, ty, LENS_COMMIT_W - 32.0, LENS_COMMIT_ROW_H, note, small_px(), col_muted())
        return
    }
    g_lens_commit_scroll = clamp_i(g_lens_commit_scroll, 0, lens_commit_scroll_max())
    for n in 0 to lens_commit_shown_rows() {
        let i = g_lens_commit_scroll + n
        if i < count {
            lens_draw_commit_row(r, v, x, y + (n as f64) * LENS_COMMIT_ROW_H, i)
        }
    }
    let max = lens_commit_scroll_max()
    if max > 0 {
        let list_h = lens_commit_list_h()
        let thumb_h = clamp(list_h * (LENS_COMMIT_ROWS as f64) / (count as f64), 18.0, list_h)
        let fraction = (g_lens_commit_scroll as f64) / (max as f64)
        let bar_x = x + LENS_COMMIT_W - 12.0
        ui_fill_rect(r, bar_x, y, 2.0, list_h, col_editor_sel(), 0.0)
        ui_fill_rect(r, bar_x, y + (list_h - thumb_h) * fraction, 2.0, thumb_h, col_muted(), 0.0)
    }
}

// The commit dialog floats over the map on the shared popup background; it
// keeps no dimming layer, so the code behind it stays visible.
fn lens_draw_commit(r: ref ui_renderer, v: ref view, w: f64, h: f64) {
    if g_lens_commit_open == false {
        return
    }
    let x = lens_commit_x(w)
    let y = lens_commit_y(h)
    let dialog_h = lens_commit_h()
    ui_fill_round_rect(r, x, y, LENS_COMMIT_W, dialog_h, 4.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, x, y, LENS_COMMIT_W, dialog_h, 4.0, 1.0, col_muted(), 0.0)
    let title_x = x + 16.0
    if g_lens_commit_changes > 0 {
        let ticked = lens_commit_ticked()
        lens_draw_check(r, x + 16.0, y + 17.0, ticked == g_lens_commit_changes, ticked > 0, col_text())
        title_x = x + 40.0
    }
    draw_text_clipped(r, title_x, y + 14.0, x + LENS_COMMIT_W - 16.0 - title_x, 20.0, lens_commit_title(), small_px(), col_text())
    let placeholder = "Commit message"
    if g_lens_commit_mode == LENS_COMMIT_APPEND {
        placeholder = "Commit message, or empty to keep the last one"
    }
    lens_draw_field(r, x + 16.0, y + 42.0, LENS_COMMIT_W - 32.0, 30.0, g_lens_commit_message, placeholder)
    let list_y = y + LENS_COMMIT_LIST_Y
    lens_draw_commit_list(r, v, x, list_y)
    let hint = "enter  " + lens_commit_mode_verb(g_lens_commit_mode) + "      esc  cancel      click  tick a file"
    draw_text_clipped(r, x + 16.0, list_y + lens_commit_list_h() + 8.0, LENS_COMMIT_W - 32.0, 20.0, hint, small_px(), col_muted())
    let button_y = lens_commit_button_y(h)
    lens_draw_button(r, v, lens_commit_cancel_x(w), button_y, 84.0, LENS_COMMIT_BUTTON_H, "Cancel", false)
    lens_draw_commit_button(r, v, lens_commit_button_x(w), button_y)
    if g_lens_commit_menu_open {
        lens_draw_commit_menu(r, v, lens_commit_menu_x(w), lens_commit_menu_y(h))
    }
}

fn lens_commit_mode_verb(mode: i32) str {
    if mode == LENS_COMMIT_APPEND { return "commit append" }
    if mode == LENS_COMMIT_PUSH { return "commit & push" }
    return "commit"
}

// The Commit split button: its label runs the chosen mode, and the arrow
// beside it opens the mode menu. The atlas has no arrow glyphs, so the arrow
// is a triangle, as on the status bar.
fn lens_draw_commit_button(r: ref ui_renderer, v: ref view, x: f64, y: f64) {
    let w = LENS_COMMIT_BUTTON_W + LENS_COMMIT_ARROW_W
    let ax = x + LENS_COMMIT_BUTTON_W
    ui_fill_round_rect(r, x, y, w, LENS_COMMIT_BUTTON_H, 3.0, col_editor_panel_hi(), 0.0)
    ui_stroke_round_rect(r, x, y, w, LENS_COMMIT_BUTTON_H, 3.0, 1.0, col_accent(), 0.0)
    ui_fill_rect(r, ax, y + 5.0, 1.0, LENS_COMMIT_BUTTON_H - 10.0, col_muted(), 0.0)
    draw_centered_text(r, x, y, LENS_COMMIT_BUTTON_W, LENS_COMMIT_BUTTON_H, lens_commit_mode_label(g_lens_commit_mode), small_px(), col_text())
    let arrow = col_muted()
    if g_lens_commit_menu_open || raw_hit(v, ax, y, LENS_COMMIT_ARROW_W, LENS_COMMIT_BUTTON_H) {
        arrow = col_accent()
    }
    let cx = ax + LENS_COMMIT_ARROW_W * 0.5
    let cy = y + LENS_COMMIT_BUTTON_H * 0.5
    ui_fill_triangle(r, cx - 4.0, cy - 2.0, cx + 4.0, cy - 2.0, cx, cy + 3.0, arrow, 0.5)
}

// One row per mode; the chosen one stays lit and names the key that runs it.
fn lens_draw_commit_menu(r: ref ui_renderer, v: ref view, x: f64, y: f64) {
    let menu_h = lens_commit_menu_h()
    ui_fill_round_rect(r, x, y, LENS_COMMIT_MENU_W, menu_h, 3.0, col_popup_bg(), 0.0)
    ui_stroke_round_rect(r, x, y, LENS_COMMIT_MENU_W, menu_h, 3.0, 1.0, col_muted(), 0.0)
    for i in 0 to LENS_COMMIT_MODES {
        let iy = y + (i as f64) * LENS_MODE_ITEM
        if i == g_lens_commit_mode || raw_hit(v, x, iy, LENS_COMMIT_MENU_W, LENS_MODE_ITEM) {
            ui_fill_rect(r, x + 1.0, iy, LENS_COMMIT_MENU_W - 2.0, LENS_MODE_ITEM, col_popup_hi(), 0.0)
        }
        let ty = ui_text_v_center_y(r, iy, LENS_MODE_ITEM, small_px(), FONT_MONO())
        draw_text_clipped(r, x + 10.0, ty, LENS_COMMIT_MENU_W - 70.0, LENS_MODE_ITEM, lens_commit_mode_label(i), small_px(), col_text())
        if i == g_lens_commit_mode {
            let keys = "enter"
            let kw = ui_text_width(r, keys, small_px(), FONT_MONO())
            draw_text_clipped(r, x + LENS_COMMIT_MENU_W - 10.0 - kw, ty, kw, LENS_MODE_ITEM, keys, small_px(), col_muted())
        }
    }
}

// Controls, one per line, stacked above the activity row.
fn lens_draw_hints(r: ref ui_renderer, bottom: f64) {
    for i in 0 to LENS_HINT_COUNT {
        let y = bottom - ((LENS_HINT_COUNT - i) as f64) * LENS_HINT_LINE_H
        ui_draw_text(r, 12.0, y, lens_hint_keys(i), small_px(), col_text(), FONT_MONO())
        ui_draw_text(r, 112.0, y, lens_hint_action(i), small_px(), col_muted(), FONT_MONO())
    }
}

// The running search, commit, push, pull or branch job with its progress,
// then the message.
// Work of unknown length shows a block sliding along the bar.
fn lens_draw_activity(r: ref ui_renderer, y: f64, w: f64) {
    let label = ""
    let fraction: f64 = -1.0
    if lens_job_visible() {
        label = lens_job_label(g_lens_job_kind)
        fraction = lens_job_fraction()
    } else if g_lens_search_running {
        label = "search"
        fraction = lens_search_fraction()
    }
    let ty = ui_text_v_center_y(r, y, LENS_ACTIVITY_H, small_px(), FONT_MONO())
    let x: f64 = 12.0
    if label != "" {
        lit bar_w = 140.0
        draw_text_clipped(r, x, ty, 60.0, LENS_ACTIVITY_H, label, small_px(), col_text())
        let bar_x = x + 64.0
        let bar_y = y + LENS_ACTIVITY_H * 0.5 - 3.0
        ui_fill_rect(r, bar_x, bar_y, bar_w, 6.0, col_editor_sel(), 0.0)
        if fraction >= 0.0 {
            ui_fill_rect(r, bar_x, bar_y, bar_w * clamp(fraction, 0.0, 1.0), 6.0, col_text(), 0.0)
            let percent = itos((clamp(fraction, 0.0, 1.0) * 100.0) as i32) + "%"
            draw_text_clipped(r, bar_x + bar_w + 8.0, ty, 40.0, LENS_ACTIVITY_H, percent, small_px(), col_muted())
        } else {
            let phase = os_time() * 0.8
            let t = phase - ((phase as i64) as f64)
            let swing = clamp(1.0 - 2.0 * t, -1.0, 1.0)
            if swing < 0.0 {
                swing = -swing
            }
            ui_fill_rect(r, bar_x + (bar_w - 36.0) * swing, bar_y, 36.0, 6.0, col_text(), 0.0)
        }
        x = bar_x + bar_w + 52.0
    }
    draw_text_clipped(r, x, ty, w - x - 12.0, LENS_ACTIVITY_H, g_lens_message, small_px(), col_muted())
}

// The bottom-left hints and activity row float over the map but under the
// panels, so a panel dragged over them stays readable.
fn lens_draw_overlay(r: ref ui_renderer, w: f64, h: f64) {
    let activity_y = h - 28.0 - LENS_ACTIVITY_H
    lens_draw_activity(r, activity_y, w)
    lens_draw_hints(r, activity_y - 4.0)
}

// Menu buttons and every popup, drawn after the panels so an open menu is
// always on top.
fn lens_draw_menus(r: ref ui_renderer, v: ref view, w: f64, h: f64) {
    lens_draw_file_menu(r, v)
    lens_draw_view_menu(r, v)
    lens_draw_search(r, v, w)
    lens_draw_commit(r, v, w, h)
    lens_draw_branch_popups(r, v, w, h)
    lens_draw_ignore(r, v, w, h)
}
