use std
use os
use view
use ui
use editor
use workspace

let g_setting_font_family: i32 = 1
let g_setting_font_size: i32 = 1
let g_ui_focus: i32 = 0
let g_mouse_x: f64 = 0.0 as f64
let g_mouse_y: f64 = 0.0 as f64
let g_code_drag = false
let g_code_scroll: f64 = 0.0 as f64
// Screen pixels per code-layout pixel. Lens sets it from the camera so the
// editor grows and shrinks with its leaf instead of keeping a fixed size.
let g_code_zoom: f64 = 1.0
// Vertical zoom: the map's tilt squashes rows but not glyph widths.
let g_code_zoom_y: f64 = 1.0
let g_code_draw_glyphs = true
let g_code_line_pitch: f64 = 0.0
let g_caret_follow = false
let g_setting_language: i32 = 0
let g_setting_theme: i32 = 0
let g_key_event_mods: i32 = 0
let g_last_click_time: f64 = 0.0 as f64
let g_last_click_line: i32 = -1
let g_click_streak: i32 = 0

fn col_editor_bg() u32 { return ui_pack_color("#121212") }

fn FONT_MONO() i32 { return g_setting_font_family }

// Clears the frame's edges and the platform's pointer event queue. A queue
// left full drops later pointer moves, and with them the frame each requests,
// so a drag would only redraw on Lens's own timer.
fn reset_view_input(v: ref view) {
    view_input_reset(v)
}

fn small_px() f64 {
    if g_setting_font_size == 2 {
        return 13.0
    }
    if g_setting_font_size == 0 {
        return 11.0
    }
    return 12.0
}

fn draw_centered_text(r: ref ui_renderer, x: f64, y: f64, w: f64, h: f64, text: str, px: f64, color: u32) {
    if w > 0.0 {
        if h > 0.0 {
            let tw = ui_text_width(r, text, px, FONT_MONO())
            if tw <= 0.0 {
                tw = text.len as f64 * px * 0.6
            }
            let tx = x + (w - tw) * 0.5
            let ty = ui_text_v_center_y(r, y, h, px, FONT_MONO())
            ui_push_clip(r, x, y, w, h)
            ui_draw_text(r, tx, ty, text, px, color, FONT_MONO())
            ui_pop_clip(r)
        }
    }
}

fn col_muted() u32 { return ui_pack_color("#909090") }

fn col_text() u32 { return ui_pack_color("#dddddd") }

fn col_accent() u32 { return ui_pack_color("#eeeeee") }

fn col_editor_panel_hi() u32 { return ui_pack_color("#202020") }

fn hit(v: ref view, x: f64, y: f64, w: f64, h: f64) bool {
    if g_ui_focus != UI_FOCUS_NONE() {
        return false
    }
    return raw_hit(v, x, y, w, h)
}

fn raw_hit(v: ref view, x: f64, y: f64, w: f64, h: f64) bool {
    if g_mouse_x < x {
        return false
    }
    if g_mouse_x >= (x + w) {
        return false
    }
    if g_mouse_y < y {
        return false
    }
    if g_mouse_y >= (y + h) {
        return false
    }
    return true
}

fn UI_FOCUS_NONE() i32 { return 0 }

// Floating panels resize from any edge and from a 16-point square in every
// corner, matching how a window frame behaves. The outline and the terminal
// share the mask and the geometry helper so the two panels behave alike.
lit PANEL_EDGE_NONE = 0
lit PANEL_EDGE_LEFT = 1
lit PANEL_EDGE_RIGHT = 2
lit PANEL_EDGE_TOP = 4
lit PANEL_EDGE_BOTTOM = 8
lit PANEL_EDGE_BAND = 8.0
lit PANEL_CORNER_BAND = 16.0

struct panel_rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64
}

fn panel_edge_mask(x: f64, y: f64, w: f64, h: f64) i32 {
    if g_mouse_x < x || g_mouse_x >= x + w || g_mouse_y < y || g_mouse_y >= y + h {
        return PANEL_EDGE_NONE
    }
    let mask = PANEL_EDGE_NONE
    if g_mouse_x < x + PANEL_EDGE_BAND {
        mask = mask | PANEL_EDGE_LEFT
    }
    if g_mouse_x >= x + w - PANEL_EDGE_BAND {
        mask = mask | PANEL_EDGE_RIGHT
    }
    if g_mouse_y < y + PANEL_EDGE_BAND {
        mask = mask | PANEL_EDGE_TOP
    }
    if g_mouse_y >= y + h - PANEL_EDGE_BAND {
        mask = mask | PANEL_EDGE_BOTTOM
    }
    if g_mouse_x < x + PANEL_CORNER_BAND {
        if g_mouse_y < y + PANEL_CORNER_BAND {
            mask = mask | PANEL_EDGE_LEFT | PANEL_EDGE_TOP
        }
        if g_mouse_y >= y + h - PANEL_CORNER_BAND {
            mask = mask | PANEL_EDGE_LEFT | PANEL_EDGE_BOTTOM
        }
    }
    if g_mouse_x >= x + w - PANEL_CORNER_BAND {
        if g_mouse_y < y + PANEL_CORNER_BAND {
            mask = mask | PANEL_EDGE_RIGHT | PANEL_EDGE_TOP
        }
        if g_mouse_y >= y + h - PANEL_CORNER_BAND {
            mask = mask | PANEL_EDGE_RIGHT | PANEL_EDGE_BOTTOM
        }
    }
    return mask
}

// Move the grabbed edges by (dx, dy), keeping the ungrabbed side fixed. The
// moving edge stops at the panel's minimum size and at the view's bounds, so a
// drag never pushes the opposite edge along with it.
fn panel_resized_rect(x: f64, y: f64, w: f64, h: f64, edges: i32, dx: f64, dy: f64, min_w: f64, min_h: f64, left: f64, top: f64, right: f64, bottom: f64) panel_rect {
    let nx = x
    let ny = y
    let nw = w
    let nh = h
    if (edges & PANEL_EDGE_LEFT) != 0 {
        nx = clamp(x + dx, left, x + w - min_w)
        nw = x + w - nx
    }
    if (edges & PANEL_EDGE_RIGHT) != 0 {
        nw = clamp(w + dx, min_w, right - x)
    }
    if (edges & PANEL_EDGE_TOP) != 0 {
        ny = clamp(y + dy, top, y + h - min_h)
        nh = y + h - ny
    }
    if (edges & PANEL_EDGE_BOTTOM) != 0 {
        nh = clamp(h + dy, min_h, bottom - y)
    }
    return panel_rect(nx, ny, nw, nh)
}

// Three short diagonal ticks in the lower-right corner mark the grip. They
// brighten only while the pointer is on that corner.
fn draw_panel_grip(r: ref ui_renderer, x: f64, y: f64, w: f64, h: f64) {
    let color = col_muted()
    let mask = panel_edge_mask(x, y, w, h)
    if (mask & PANEL_EDGE_RIGHT) != 0 && (mask & PANEL_EDGE_BOTTOM) != 0 {
        color = col_accent()
    }
    for i in 0 to 3 {
        let d = 6.0 + (i as f64) * 5.0
        ui_stroke_line(r, x + w - d, y + h - 3.0, x + w - 3.0, y + h - d, 1.0, color, 0.0)
    }
}

fn draw_text_clipped(r: ref ui_renderer, x: f64, y: f64, w: f64, h: f64, text: str, px: f64, color: u32) {
    if w > 0.0 {
        if h > 0.0 {
            ui_push_clip(r, x, y, w, h)
            ui_draw_text(r, x, y, text, px, color, FONT_MONO())
            ui_pop_clip(r)
        }
    }
}

fn col_blue() u32 { return ui_pack_color("#b0b0b0") }

fn render_frame(r: ref ui_renderer, v: ref view) {
    status_sample(os_time())
    ui_resize(r)
    g_mouse_x = ui_content_x(r, v.mouse_x)
    g_mouse_y = ui_content_y(r, v.mouse_y)
    let w = (ui_canvas_width(r) & 1048575) as f64
    let h = (ui_canvas_height(r) & 1048575) as f64
    render_lens(r, v, w, h)
}

lit STATUS_BAR_H = 28.0

fn draw_status_bar(r: ref ui_renderer, x: f64, y: f64, w: f64, detail: lens_detail) {
    ui_fill_rect(r, x, y, w, STATUS_BAR_H, col_bar(), 0.0)
    ui_push_clip(r, x, y, w, STATUS_BAR_H)
    let right = x + w - 12.0
    let bar_y = y + 14.0 - STATUS_METER_H * 0.5
    if w >= 320.0 {
        lit memory_bar_w = 64.0
        let bar_x = right - memory_bar_w
        draw_status_meter(r, bar_x, bar_y, memory_bar_w, status_memory_fraction(g_status_memory, g_status_memory_total))
        let label = status_memory_text(g_status_memory, g_status_memory_total)
        let label_w = ui_text_width(r, label, small_px(), FONT_MONO())
        right = bar_x - 8.0 - label_w
        draw_text_clipped(r, right, y + 5.0, label_w, 20.0, label, small_px(), col_muted())
        right = right - 16.0
    }
    if w >= 220.0 {
        if w >= 440.0 {
            lit fps_bar_w = 48.0
            right = right - fps_bar_w
            draw_status_meter(r, right, bar_y, fps_bar_w, status_fps_fraction(g_status_fps))
            right = right - 8.0
        }
        let fps = itos(g_status_fps) + " FPS"
        let fps_w = ui_text_width(r, fps, small_px(), FONT_MONO())
        right = right - fps_w
        draw_text_clipped(r, right, y + 5.0, fps_w, 20.0, fps, small_px(), col_muted())
        right = right - 16.0
    }
    if w >= 720.0 {
        lit bar_w = 128.0
        let label = lens_detail_text(detail)
        let label_w = ui_text_width(r, label, small_px(), FONT_MONO())
        if label_w < 88.0 {
            label_w = 88.0
        }
        let bar_x = right - bar_w
        right = bar_x - 8.0 - label_w
        draw_text_clipped(r, right, y + 5.0, label_w, 20.0, label, small_px(), col_muted())
        draw_status_meter(r, bar_x, bar_y, bar_w, lens_detail_fraction(detail))
        right = right - 16.0
    }
    let left = x + 12.0
    left = left + lens_draw_sync(r, left, y)
    left = left + lens_draw_branch(r, left, y)
    draw_text_clipped(r, left, y + 5.0, right - left, 20.0, g_workspace_root, small_px(), col_muted())
    ui_pop_clip(r)
}

fn col_editor_panel() u32 { return ui_pack_color("#191919") }

// Popups (menu dropdowns, the search box, the commit and ignore dialogs) float
// on the same background as the terminal and the outline prompt, so the map
// stays visible behind them.
fn col_popup_bg() u32 {
    return lens_float_color(col_editor_bg())
}

// A popup row highlight is a tint over that background, never an opaque fill
// that would hide the map behind the row.
fn col_popup_hi() u32 {
    return (col_editor_panel_hi() & 0x00ffffffu) | 0x66000000u
}

// The top bar and status bar float over the map, which shows through them.
fn col_bar() u32 { return (col_editor_panel() & 0x00ffffffu) | 0xb8000000u }

lit STATUS_METER_H = 10.0
lit STATUS_METER_INSET = 2.0

// A status bar meter: a dark rounded track with a one-point outline, and the
// filled share inset inside it with the corners rounded to match.
fn draw_status_meter(r: ref ui_renderer, x: f64, y: f64, w: f64, fraction: f64) {
    ui_fill_round_rect(r, x, y, w, STATUS_METER_H, LENS_CORNER_RADIUS, col_editor_bg(), 0.0)
    let fill = (w - STATUS_METER_INSET * 2.0) * clamp(fraction, 0.0, 1.0)
    if fill > 0.0 {
        ui_fill_round_rect(r, x + STATUS_METER_INSET, y + STATUS_METER_INSET, fill, STATUS_METER_H - STATUS_METER_INSET * 2.0, LENS_CORNER_RADIUS - 1.0, col_muted(), 0.0)
    }
    ui_stroke_round_rect(r, x + 0.5, y + 0.5, w - 1.0, STATUS_METER_H - 1.0, LENS_CORNER_RADIUS, 1.0, col_muted(), 0.0)
}

fn clamp(v: f64, lo: f64, hi: f64) f64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// Lines flow down a column of g_code_rows rows, then into the next column
// g_code_column_base layout pixels to the right, the same flow a Lens leaf's
// code batches use. A single tall column is g_code_rows = 0.
let g_code_rows: i32 = 0
let g_code_column_base: f64 = 0.0
// Bytes per display row of the drawn document; longer lines wrap onto the
// following rows, numbered only on their first. Zero keeps one row per line.
let g_code_wrap: i32 = 0
// The visible part of the flat map, so off-screen rows and columns are skipped.
let g_code_view_x0: f64 = 0.0
let g_code_view_x1: f64 = 100000.0
let g_code_view_y0: f64 = 42.0
let g_code_view_y1: f64 = 100000.0

fn code_rows_per_column(total: i32) i32 {
    if g_code_rows > 0 {
        return g_code_rows
    }
    return clamp_i(total, 1, 100000000)
}

fn code_wrap() i32 {
    if g_code_wrap > 0 {
        return g_code_wrap
    }
    return 100000000
}

// Display row of the caret. A caret just past the last byte of a full
// wrapped row stays at that row's end rather than opening an empty row.
fn code_caret_row() i32 {
    let row = g_lens_diff_source[cur_line()]
    let first = g_lens_wrap_first[row]
    return first + clamp_i(cur_col() / code_wrap(), 0, g_lens_wrap_first[row + 1] - first - 1)
}

fn code_column_w(w: f64) f64 {
    if g_code_column_base > 0.0 {
        return g_code_column_base * g_code_zoom
    }
    return w
}

fn draw_leaf_code(r: ref ui_renderer, v: ref view, x: f64, y: f64, w: f64, h: f64, editable: bool) {
    let line_h = code_line_h()
    let body_y = y
    let body_h = h
    let gutter_w = code_gutter_w()
    let clip_top = clamp(body_y, g_code_view_y0, g_code_view_y1)
    let clip_bottom = clamp(body_y + h, g_code_view_y0, g_code_view_y1)
    if clip_bottom <= clip_top {
        return
    }
    let char_w = ui_mono_char_width(r, code_font_px(), CODE_FONT())
    if char_w <= 0.0 {
        char_w = code_font_px() * 0.6
    }
    let col_w = code_column_w(w)
    let text_w = col_w - gutter_w - code_text_inset() - 8.0 * g_code_zoom
    lens_git_tick(lens_camera_moving(v))
    lens_wrap_sync(code_wrap())
    let total = g_lens_wrap_total
    let rows = code_rows_per_column(total)
    let max_scroll = scroll_max((clamp_i(total, 0, rows) as f64) * line_h + 40.0 * g_code_zoom_y, clip_bottom - clip_top)
    if editable {
        if hit(v, x, clip_top, w, clip_bottom - clip_top) || g_code_drag {
            process_code_mouse(v, x, body_y, w, body_h, line_h, char_w, rows, col_w)
        }
        process_code_keys(v)
        lens_git_tick(lens_camera_moving(v))
        lens_wrap_sync(code_wrap())
        total = g_lens_wrap_total
        rows = code_rows_per_column(total)
    }
    // Lines wrap, so there is no sideways scroll.
    if shift_down(v) && hit(v, x, clip_top, w, clip_bottom - clip_top) {
        g_code_scroll = clamp(g_code_scroll - v.scroll_y * code_wheel_scale(), 0.0, max_scroll)
    }
    if g_caret_follow && editable {
        g_caret_follow = false
        follow_caret(clip_bottom - clip_top, line_h, max_scroll, rows)
    }
    g_code_scroll = clamp(g_code_scroll, 0.0, max_scroll)
    let first = clamp_i(((g_code_scroll + clip_top - body_y - code_top_pad() - line_h) / line_h) as i32, 0, rows)
    let last = clamp_i(((g_code_scroll + clip_bottom - body_y - code_top_pad()) / line_h) as i32 + 2, first, rows)
    let columns = (total + rows - 1) / rows
    let first_col = clamp_i(((g_code_view_x0 - x) / col_w) as i32, 0, columns)
    let last_col = clamp_i(((g_code_view_x1 - x) / col_w) as i32 + 1, first_col, columns)

    let cursor_line = cur_line()
    let selected = has_selection()
    ui_push_clip(r, x, body_y, w, body_h)
    for c in first_col to last_col {
        let col_x = x + (c as f64) * col_w
        let text_x = col_x + gutter_w + code_text_inset()
        for row in first to last {
            let visual = c * rows + row
            if visual < total {
                let row_top = body_y + code_top_pad() + (row as f64) * line_h - g_code_scroll
                draw_code_row(r, visual, col_x, col_w, text_x, text_w, row_top, line_h, char_w, body_y, body_h, cursor_line, selected, editable)
            }
        }
    }
    if editable && g_code_draw_glyphs {
        draw_code_caret(r, x, body_y, line_h, char_w, rows)
    }
    ui_pop_clip(r)
}

fn draw_code_caret(r: ref ui_renderer, x: f64, body_y: f64, line_h: f64, char_w: f64, rows: i32) {
    let col_w = code_column_w(1.0)
    let gutter_w = code_gutter_w()
    let cursor_visual = code_caret_row()
    let segment = cursor_visual - g_lens_wrap_first[g_lens_diff_source[cur_line()]]
    let cursor_col_x = x + ((cursor_visual / rows) as f64) * col_w
    let cursor_x = cursor_col_x + gutter_w + code_text_inset() + ((cur_col() - segment * code_wrap()) as f64) * char_w
    let cursor_top = body_y + code_top_pad() + ((cursor_visual % rows) as f64) * line_h - g_code_scroll
    let inset = 2.0 * g_code_zoom_y
    ui_fill_rect(r, cursor_x, cursor_top + inset, clamp(2.0 * g_code_zoom, 1.0, 4.0), line_h - inset * 2.0, col_editor_cursor(), 0.0)
}

// One display row: a whole line, or one wrapped part of it. Byte c of a line
// sits on its wrapped row c / wrap, so `first` is the row's first byte.
fn draw_code_row(r: ref ui_renderer, visual: i32, col_x: f64, col_w: f64, text_x: f64, text_w: f64, row_top: f64, line_h: f64, char_w: f64, body_y: f64, body_h: f64, cursor_line: i32, selected: bool, editable: bool) {
    if row_top + line_h < body_y || row_top > body_y + body_h {
        return
    }
    let wrap = code_wrap()
    let row = lens_wrap_find(visual)
    let segment = visual - g_lens_wrap_first[row]
    let first = segment * wrap
    // A wrapped row ends after `wrap` bytes; the line's last row runs on.
    let limit: i32 = 2000000000
    if visual + 1 < g_lens_wrap_first[row + 1] {
        limit = first + wrap
    }
    let i = g_lens_diff_rows[row]
    if i < 0 {
        let deleted = -1 - i
        ui_fill_rect(r, col_x, row_top, col_w, line_h, ui_pack_color("#4b1e1e"), 0.0)
        if g_code_draw_glyphs && segment == 0 {
            draw_text_clipped(r, col_x + 24.0 * g_code_zoom, row_top + 2.0 * g_code_zoom_y, 20.0 * g_code_zoom, line_h, "-", code_number_px(), col_text())
        }
        let text = g_lens_diff_deleted[deleted]
        if g_code_draw_glyphs && first < text.len {
            let count = clamp_i(limit, first, text.len) - first
            ui_push_clip(r, text_x, body_y, text_w, body_h)
            draw_code_text(r, text_x, code_text_center_y(r, row_top, line_h, code_font_px()), substr(text, first, count), code_font_px(), col_text(), CODE_FONT())
            ui_pop_clip(r)
        }
        return
    }
    // Row rect (row_top, line_h) matches the mouse_line hit mapping; the text
    // y inside it comes from text_center_y so the glyphs sit mid-row.
    if g_lens_diff_added[i] != 0 {
        ui_fill_rect(r, col_x, row_top, col_w, line_h, ui_pack_color("#183e2b"), 0.0)
    } else if i == cursor_line && editable {
        ui_fill_rect(r, col_x, row_top, col_w, line_h, col_editor_panel(), 0.0)
    }
    if selected && editable {
        let sb = line_sel_begin(i)
        if sb >= 0 {
            let ss = sb
            if ss < first {
                ss = first
            }
            let ee = line_sel_end(i)
            if ee > limit {
                ee = limit
            }
            if ee > ss {
                ui_fill_rect(r, text_x + ((ss - first) as f64) * char_w, row_top, ((ee - ss) as f64) * char_w, line_h, col_editor_sel(), 0.0)
            }
        }
    }
    let num_color = col_muted()
    if i == cursor_line && editable {
        num_color = col_text()
    }
    if !g_code_draw_glyphs {
        return
    }
    if segment == 0 {
        let line_number = itos(i + 1)
        let line_number_x = code_line_number_x(r, col_x, line_number)
        draw_code_text(r, line_number_x, code_text_center_y(r, row_top, line_h, code_number_px()), line_number, code_number_px(), num_color, CODE_FONT())
    }
    ui_push_clip(r, text_x, body_y, text_w, body_h)
    draw_code_line(r, i, text_x, code_text_center_y(r, row_top, line_h, code_font_px()), char_w, first, limit - first)
    ui_pop_clip(r)
}

fn col_editor_cursor() u32 { return ui_pack_color("#eeeeee") }

// Live editor text uses the same base glyph geometry and x/y scaling as
// retained glyph batches, including the map's vertical perspective squeeze.
fn draw_code_text(r: ref ui_renderer, x: f64, y: f64, text: str, px: f64, color: u32, font: i32) {
    ui_draw_text_scaled(r, x, y, text, px / g_code_zoom, color, font, g_code_zoom, g_code_zoom_y)
}

fn code_text_center_y(r: ref ui_renderer, y: f64, h: f64, px: f64) f64 {
    return y + ui_text_v_center_y(r, 0.0, h / g_code_zoom_y, px / g_code_zoom, CODE_FONT()) * g_code_zoom_y
}

fn code_font_px() f64 { return code_base_font_px() * g_code_zoom }

// Code layout metrics at zoom 1; the zoomed accessors above and below scale them.
fn code_base_font_px() f64 {
    if g_setting_font_size == 0 {
        return 11.0
    }
    if g_setting_font_size == 2 {
        return 14.0
    }
    return 12.0
}

fn code_number_px() f64 { return small_px() * g_code_zoom }

fn code_top_pad() f64 { return code_base_top_pad() * g_code_zoom_y }

fn code_base_top_pad() f64 { return 18.0 }

// A zoom change keeps the same first line in view: the scroll offset is in
// screen pixels, so it scales with the line height.
fn set_code_zoom(zoom: f64, zoom_y: f64) {
    if zoom > 0.0 && zoom_y > 0.0 {
        g_code_scroll = g_code_scroll * zoom_y / g_code_zoom_y
        g_code_zoom = zoom
        g_code_zoom_y = zoom_y
    }
}

fn text_center_y(r: ref ui_renderer, y: f64, h: f64, px: f64) f64 {
    return ui_text_v_center_y(r, y, h, px, FONT_MONO())
}

fn draw_code_line(r: ref ui_renderer, li: i32, text_x: f64, row_y: f64, char_w: f64, first_col: i32, cols: i32) {
    let n = tokenize_line(li)
    let view_end = first_col + cols
    for t in 0 to n {
        let ts = token_start(t)
        let te = ts + token_len(t)
        if te > first_col {
            if ts < view_end {
                let ds = ts
                if ds < first_col {
                    ds = first_col
                }
                let de = te
                if de > view_end {
                    de = view_end
                }
                let tx = text_x + ((ds - first_col) as f64) * char_w
                draw_code_text(r, tx, row_y, token_text_part(t, ds - ts, de - ds), code_font_px(), token_color(token_kind(t)), CODE_FONT())
            }
        }
    }
}

fn CODE_FONT() i32 { return 1 }

fn token_color(kind: i32) u32 {
    if g_setting_language == 1 {
        if kind == TK_KEYWORD() {
            return col_blue()
        }
        if kind == TK_TYPE() {
            return ui_pack_color("#4ec9b0")
        }
        if kind == TK_STRING() {
            return ui_pack_color("#ce9178")
        }
        if kind == TK_COMMENT() {
            return ui_pack_color("#6a9955")
        }
        if kind == TK_NUMBER() {
            return ui_pack_color("#b5cea8")
        }
        if kind == TK_CALL() {
            return ui_pack_color("#dcdcaa")
        }
        return col_text()
    }
    if g_setting_language == 2 {
        if kind == TK_KEYWORD() {
            return col_yellow()
        }
        if kind == TK_TYPE() {
            return col_blue()
        }
        if kind == TK_STRING() {
            return ui_pack_color("#a8d08d")
        }
        if kind == TK_COMMENT() {
            return col_muted()
        }
        if kind == TK_NUMBER() {
            return ui_pack_color("#c6a0f6")
        }
        if kind == TK_CALL() {
            return ui_pack_color("#8aadf4")
        }
        return col_text()
    }
    return nanoscript_token_color(kind)
}

fn nanoscript_token_color(kind: i32) u32 {
    if kind == TK_KEYWORD() {
        return col_nanoscript_green_bright()
    }
    if kind == TK_TYPE() {
        return col_nanoscript_green()
    }
    if kind == TK_NUMBER() {
        return col_nanoscript_white()
    }
    if kind == TK_CONSTANT() {
        return col_nanoscript_white()
    }
    if kind == TK_STRING() {
        return col_nanoscript_yellow_green()
    }
    if kind == TK_COMMENT() {
        return col_nanoscript_white_deep()
    }
    if kind == TK_PUNCT() {
        return col_nanoscript_white_dim()
    }
    if kind == TK_CALL() {
        return col_nanoscript_white()
    }
    return col_nanoscript_white_dim()
}

fn col_nanoscript_white_dim() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#46515c")
    }
    return ui_pack_color("#a6a6a6")
}

fn col_nanoscript_white() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#202832")
    }
    return ui_pack_color("#e1e1e1")
}

fn col_nanoscript_white_deep() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#7a8490")
    }
    return ui_pack_color("#737373")
}

fn col_nanoscript_yellow_green() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#68751f")
    }
    return ui_pack_color("#b7dc6f")
}

fn col_nanoscript_green() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#087a4a")
    }
    return ui_pack_color("#61d394")
}

fn col_nanoscript_green_bright() u32 {
    if g_setting_theme == 1 {
        return ui_pack_color("#096b43")
    }
    return ui_pack_color("#6be8a3")
}

fn col_yellow() u32 { return ui_pack_color("#b0b0b0") }

fn code_line_number_x(r: ref ui_renderer, editor_x: f64, text: str) f64 {
    return editor_x + code_gutter_w() - 10.0 * g_code_zoom - ui_text_width(r, text, code_number_px(), FONT_MONO())
}

fn code_gutter_w() f64 { return code_base_gutter_w() * g_code_zoom }

fn code_base_gutter_w() f64 { return 52.0 }

fn col_editor_sel() u32 { return ui_pack_color("#444444") }

fn follow_caret(body_h: f64, line_h: f64, max_scroll: f64, rows: i32) {
    let top = ((code_caret_row() % rows) as f64) * line_h
    let bot = top + line_h + 26.0 * g_code_zoom_y
    if top < g_code_scroll {
        g_code_scroll = top
    }
    if bot > (g_code_scroll + body_h) {
        g_code_scroll = bot - body_h
    }
    g_code_scroll = clamp(g_code_scroll, 0.0, max_scroll)
}

fn code_wheel_scale() f64 { return 6.0 * g_code_zoom_y }

fn shift_down(v: ref view) bool {
    if view_is_key_pressed(v, 340) {
        return true
    }
    if view_is_key_pressed(v, 344) {
        return true
    }
    return false
}

fn process_code_keys(v: ref view) {
    set_shift(shift_down(v))

    // Structural and navigation keys: enter(257), backspace(259), delete(261),
    // arrows/home/end/page (262..269). Tab(258) and insert(260) are skipped.
    for k in 257 to 270 {
        if k != 258 {
            if k != 260 {
                if key_edge(v, k) {
                    if key_event_cmd() == false {
                        set_shift(key_event_shift())
                        process_view_key(k)
                        g_caret_follow = true
                    }
                }
            }
        }
    }

    if key_edge(v, 258) {
        if key_event_cmd() == false {
            insert_tab()
            g_caret_follow = true
        }
    }

    // Printable keys and shortcuts share the same latched event path. This is
    // what makes a fast Cmd+Z reliable even when both key transitions occur
    // between two rendered frames.
    for k in 32 to 97 {
        if key_edge(v, k) {
            let shifted = key_event_shift()
            if key_event_cmd() {
                if k == 90 {
                    if shifted {
                        redo()
                    } else {
                        undo()
                    }
                    g_caret_follow = true
                } else if k == 89 {
                    redo()
                    g_caret_follow = true
                } else if k == 65 {
                    select_all()
                } else if k == 67 {
                    if has_selection() {
                        view_set_clipboard(v, selected_text())
                    }
                } else if k == 88 {
                    if has_selection() {
                        view_set_clipboard(v, selected_text())
                        delete_selection()
                        g_caret_follow = true
                    }
                } else if k == 86 {
                    let clip = view_get_clipboard(v)
                    if clip != "" {
                        paste_str(clip)
                        g_caret_follow = true
                    }
                } else if k == 83 {
                    if g_lens_ignore_open {
                        lens_ignore_save()
                    } else {
                        workspace_save_active()
                    }
                } else if k == 87 {
                    if g_lens_ignore_open == false && g_workspace_active >= 0 {
                        workspace_close_tab(g_workspace_active)
                        g_caret_follow = true
                    }
                }
            } else {
                let c = key_char(k, shifted)
                if c != "" {
                    insert_str(c)
                    g_caret_follow = true
                }
            }
        }
    }
}

fn key_event_cmd() bool {
    if (g_key_event_mods & 2) != 0 {
        return true
    }
    return (g_key_event_mods & 8) != 0
}

fn key_event_shift() bool {
    return (g_key_event_mods & 1) != 0
}

fn key_edge(v: ref view, k: i32) bool {
    let mods = view_take_key_press(v, k)
    if mods >= 0 {
        g_key_event_mods = mods
        return true
    }
    return false
}

fn process_code_mouse(v: ref view, x: f64, body_y: f64, w: f64, body_h: f64, line_h: f64, char_w: f64, rows: i32, col_w: f64) {
    let column = mouse_column(x, col_w)
    let text_x = x + (column as f64) * col_w + code_gutter_w() + code_text_inset()
    if v.mouse_right_pressed {
        if hit(v, x, body_y, w, body_h) {
            let point = mouse_point(v, body_y, line_h, column, rows, text_x, char_w)
            let li = point.line
            let col = point.col
            let now = os_time()
            let streak: i32 = 1
            if (now - g_last_click_time) < 0.45 {
                if li == g_last_click_line {
                    streak = g_click_streak + 1
                }
            }
            g_click_streak = streak
            g_last_click_time = now
            g_last_click_line = li
            if streak >= 3 {
                select_line(li)
                g_code_drag = false
            } else if streak == 2 {
                select_word_at(li, col)
                g_code_drag = false
            } else {
                place_cursor(li, col, shift_down(v))
                g_code_drag = true
            }
        }
    }
    if g_code_drag {
        if v.mouse_right_down {
            let point = mouse_point(v, body_y, line_h, column, rows, text_x, char_w)
            place_cursor(point.line, point.col, true)
        }
    }
    if v.mouse_right_released {
        g_code_drag = false
    }
}

fn mouse_col(v: ref view, text_x: f64, char_w: f64) i32 {
    let fx = (g_mouse_x - text_x) / char_w + 0.5
    if fx < 0.0 {
        return 0
    }
    return fx as i32
}

fn mouse_column(x: f64, col_w: f64) i32 {
    let fx = (g_mouse_x - x) / col_w
    if fx < 0.0 {
        return 0
    }
    return fx as i32
}

struct code_point {
    line: i32,
    col: i32
}

// Source line and byte column under the pointer. Past the end of a wrapped
// row the column stays on that row instead of running into the next one.
fn mouse_point(v: ref view, body_y: f64, line_h: f64, column: i32, rows: i32, text_x: f64, char_w: f64) code_point {
    let fy = (g_mouse_y - body_y - code_top_pad() + g_code_scroll) / line_h
    let row: i32 = 0
    if fy > 0.0 {
        row = clamp_i(fy as i32, 0, rows - 1)
    }
    let visual = clamp_i(column * rows + row, 0, clamp_i(g_lens_wrap_total - 1, 0, 2000000000))
    let diff = lens_wrap_find(visual)
    let wrap = code_wrap()
    let x = mouse_col(v, text_x, char_w)
    if visual + 1 < g_lens_wrap_first[diff + 1] {
        x = clamp_i(x, 0, wrap - 1)
    }
    return code_point(lens_diff_source_row(diff), (visual - g_lens_wrap_first[diff]) * wrap + x)
}

fn scroll_max(content_h: f64, body_h: f64) f64 {
    if content_h > body_h {
        return content_h - body_h
    }
    return 0.0
}

fn code_text_inset() f64 { return code_base_text_inset() * g_code_zoom }

fn code_base_text_inset() f64 { return 12.0 }

fn code_line_h() f64 {
    if g_code_line_pitch > 0.0 {
        return g_code_line_pitch * g_code_zoom_y
    }
    return code_base_line_h() * g_code_zoom_y
}

fn code_base_line_h() f64 {
    if g_setting_font_size == 0 {
        return 18.0
    }
    if g_setting_font_size == 2 {
        return 24.0
    }
    return 20.0
}

fn col_surface() u32 { return ui_pack_color("#080808") }

fn main_menu_h() f64 { return 0.0 }
