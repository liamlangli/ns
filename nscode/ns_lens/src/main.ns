use std
use os
use view
use gpu
use ui

fn main() {
    g_workspace_streaming = true
    g_workspace_root = os_env("NS_ARG0")
    // A launched app bundle starts inside its own resource directory, so
    // without an argument the shell's directory is the project to map.
    if g_workspace_root == "" {
        g_workspace_root = os_env("PWD")
    }
    if g_workspace_root == "" {
        g_workspace_root = os_cwd()
    }
    // Opened from Finder or the Dock, that is the app's own resource
    // directory: no project is open, and the window asks for a folder.
    if recent_is_app_default(g_workspace_root) {
        g_workspace_root = ""
    } else {
        workspace_init()
        if g_workspace_count >= 0 {
            recent_add(g_workspace_root)
        }
    }
    panel_state_load()
    let v = view_create("ns_lens", 1280, 800)
    if gpu_request_device(v) {
        let r = ui_renderer_create(v)
        v.on_frame({ frame in
            ui_begin_frame(r)
            render_frame(r, frame)
            ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
            reset_view_input(frame)
        })
        v.on_terminate({ dead in
            // Save before shutdown clears the terminal's open flag.
            panel_state_save()
            os_watch_stop()
            terminal_shutdown()
            ui_renderer_destroy(r)
        })
        panel_state_restore()
        view_run(v)
    } else {
        print("ns_lens: GPU backend unavailable\n")
    }
}
