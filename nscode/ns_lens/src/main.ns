use std
use os
use view
use gpu
use ui

fn main() {
    g_workspace_streaming = true
    // A launched app bundle starts inside its own resource directory, so
    // without an argument the shell's directory is the project to map; opened
    // from Finder or the Dock, the most recent project opens again.
    g_workspace_root = recent_startup_root(os_env("NS_ARG0"), os_env("PWD"), os_cwd())
    if g_workspace_root != "" {
        workspace_init()
        if g_workspace_count >= 0 {
            recent_add(g_workspace_root)
        } else if g_recent_restored {
            // The remembered project is gone: forget it and open empty.
            recent_remove(g_workspace_root)
            lens_close_root()
        }
    }
    panel_state_load()
    window_size_load()
    let v = view_create(lens_window_title_text(), g_window_size_w, g_window_size_h)
    if gpu_request_device(v) {
        let r = ui_renderer_create(v)
        view_set_dock_menu(v, lens_dock_menu_items())
        v.on_frame({ frame in
            lens_dock_menu(frame)
            lens_window_title(frame)
            window_size_tick(frame.width, frame.height, os_time())
            ui_begin_frame(r)
            render_frame(r, frame)
            ui_flush(r, ui_color_rgba { r: 0.071, g: 0.071, b: 0.071, a: 1.0 })
            reset_view_input(frame)
        })
        v.on_terminate({ dead in
            // Save before shutdown clears the terminal's open flag.
            panel_state_save()
            window_size_save(dead.width, dead.height)
            os_watch_stop()
            terminal_shutdown()
            ui_renderer_destroy(r)
        })
        panel_state_restore()
        view_run(v)
    } else {
        print("ns_lens: GPU backend unavailable\n")
    }
}
