// Window state, kept beside the outline's fold state under the opened
// project's bin/ns_lens/. It records whether the outline and terminal are open
// and where each panel sits, and the map itself: the camera's offset, zoom,
// tilt and spin, the map mode, the scoped folder, the selected file and the outline's
// scroll. A later launch, or reopening the project, comes back to the view
// the user left. A missing or unreadable file keeps the built-in defaults.
use std
use os

// Tests that scan a real project can turn this off without disabling the
// outline's own expanded-folder state.
let g_panel_state = true
// The view as last written, and when an idle frame next compares it.
let g_panel_view_saved = ""
let g_panel_view_check: f64 = 0.0
// Set while a load read any view key; the view is then adopted at once.
let g_panel_view_loaded = false

fn panel_state_path() str {
    return workspace_join_root("bin/ns_lens/layout")
}

fn panel_state_save_allowed() bool {
    if g_panel_state == false || g_workspace_state == false {
        return false
    }
    return g_workspace_root != ""
}

fn panel_state_flag(open: bool) str {
    if open {
        return "1"
    }
    return "0"
}

// Project-relative path of `path`, "" outside the project.
fn panel_state_relative(path: str) str {
    if path == "" {
        return ""
    }
    return workspace_relative_path(path)
}

// The scanned entry's path for a project-relative `relative`, "" when the
// project no longer has it.
fn panel_state_entry_path(relative: str) str {
    if relative == "" {
        return ""
    }
    for i in 0 to g_workspace_count {
        if workspace_relative_path(os_entry_path(i)) == relative {
            return os_entry_path(i)
        }
    }
    return ""
}

// The map's lines of the state file. The camera is its target, where the
// smoothed camera settles.
fn panel_state_view_text() str {
    // History mode is not restored: the map it returns to is saved instead.
    let mode = g_lens_view_mode
    let x = g_lens_target_x
    let y = g_lens_target_y
    let distance = g_lens_target_distance
    if mode == LENS_MODE_HISTORY {
        mode = g_lens_history_return_mode
        x = g_lens_history_return_x
        y = g_lens_history_return_y
        distance = g_lens_history_return_distance
    }
    let text = "view.mode=" + itos(mode) + "\n"
    text = text + "view.x=" + ftos(x) + "\n"
    text = text + "view.y=" + ftos(y) + "\n"
    text = text + "view.distance=" + ftos(distance) + "\n"
    text = text + "view.tilt=" + ftos(g_lens_tilt) + "\n"
    text = text + "view.spin=" + ftos(g_lens_spin) + "\n"
    text = text + "render.dof=" + panel_state_flag(g_render_dof) + "\n"
    text = text + "render.blur=" + ftos(g_render_blur) + "\n"
    text = text + "render.band=" + ftos(g_render_band) + "\n"
    text = text + "render.fringe=" + ftos(g_render_fringe) + "\n"
    text = text + "view.scope=" + panel_state_relative(g_lens_scope_path) + "\n"
    text = text + "view.selected=" + panel_state_relative(g_lens_selected_path) + "\n"
    if mode == LENS_MODE_REF {
        // Ref mode lays out around its root file and returns to the map's
        // own camera when left.
        text = text + "view.ref_root=" + panel_state_relative(g_lens_ref_root) + "\n"
        text = text + "view.ref_x=" + ftos(g_lens_ref_return_x) + "\n"
        text = text + "view.ref_y=" + ftos(g_lens_ref_return_y) + "\n"
        text = text + "view.ref_distance=" + ftos(g_lens_ref_return_distance) + "\n"
    }
    text = text + "history.list_w=" + ftos(g_lens_history_list_w) + "\n"
    text = text + "outline.scroll=" + ftos(g_outline_scroll) + "\n"
    text = text + "outline.selected=" + panel_state_relative(g_outline_selected_path) + "\n"
    return text
}

fn panel_state_save() {
    if panel_state_save_allowed() == false {
        return
    }
    if os_make_dirs(workspace_join_root("bin/ns_lens")) == 0 {
        return
    }
    let view = panel_state_view_text()
    g_panel_view_saved = view
    let text = "outline.open=" + panel_state_flag(g_outline_open) + "\n"
    text = text + "hints.open=" + panel_state_flag(lens_hints_shown()) + "\n"
    // Geometry is written only after a panel has actually been shown. A panel
    // that was never opened keeps its built-in placement, so a fresh project
    // with only the outline open does not pin the terminal to the outline's
    // placeholder coordinates.
    if g_outline_ready {
        text = text + "outline.x=" + ftos(g_outline_x) + "\n"
        text = text + "outline.y=" + ftos(g_outline_y) + "\n"
        text = text + "outline.w=" + ftos(g_outline_w) + "\n"
        text = text + "outline.h=" + ftos(g_outline_h) + "\n"
    }
    text = text + "terminal.open=" + panel_state_flag(g_terminal_open) + "\n"
    if g_terminal_ready {
        text = text + "terminal.x=" + ftos(g_terminal_x) + "\n"
        text = text + "terminal.y=" + ftos(g_terminal_y) + "\n"
        text = text + "terminal.w=" + ftos(g_terminal_w) + "\n"
        text = text + "terminal.h=" + ftos(g_terminal_h) + "\n"
    }
    os_write_file_atomic(panel_state_path(), text + view)
}

// Each frame: once the camera rests, write the view if it moved since the
// last write, so a view survives even an app that never closes cleanly.
fn panel_state_tick(moving: bool) {
    let now = os_time()
    if moving || now < g_panel_view_check || panel_state_save_allowed() == false {
        return
    }
    g_panel_view_check = now + 1.0
    if panel_state_view_text() != g_panel_view_saved {
        panel_state_save()
    }
}

// Apply one "key=value" line. Unknown keys are ignored so a newer file still
// opens in an older build.
fn panel_state_apply(key: str, value: str) {
    let n = stof(value)
    if key == "hints.open" {
        g_lens_hints_ready = true
        g_lens_hints_open = n != 0.0
    } else if key == "outline.open" {
        g_outline_open = n != 0.0
    } else if key == "outline.x" {
        g_outline_x = n
        g_outline_ready = true
    } else if key == "outline.y" {
        g_outline_y = n
        g_outline_ready = true
    } else if key == "outline.w" {
        if n >= OUTLINE_MIN_W {
            g_outline_w = n
            g_outline_ready = true
        }
    } else if key == "outline.h" {
        if n >= OUTLINE_MIN_H {
            g_outline_h = n
            g_outline_ready = true
        }
    } else if key == "terminal.open" {
        g_terminal_open = n != 0.0
    } else if key == "terminal.x" {
        g_terminal_x = n
        g_terminal_ready = true
    } else if key == "terminal.y" {
        g_terminal_y = n
        g_terminal_ready = true
    } else if key == "terminal.w" {
        if n >= TERM_MIN_W {
            g_terminal_w = n
            g_terminal_ready = true
        }
    } else if key == "terminal.h" {
        if n >= TERM_MIN_H {
            g_terminal_h = n
            g_terminal_ready = true
        }
    } else if key == "view.mode" {
        g_panel_view_loaded = true
        let mode = n as i32
        if mode >= LENS_MODE_CODE && mode <= LENS_MODE_REF {
            g_lens_view_mode = mode
        }
    } else if key == "view.x" {
        g_panel_view_loaded = true
        g_lens_target_x = n
    } else if key == "view.y" {
        g_panel_view_loaded = true
        g_lens_target_y = n
    } else if key == "view.distance" {
        g_panel_view_loaded = true
        if n >= LENS_DISTANCE_MIN && n <= LENS_DISTANCE_LIMIT {
            g_lens_target_distance = n
        }
    } else if key == "view.tilt" {
        g_lens_tilt = clamp(n, -LENS_MAX_TILT, LENS_MAX_TILT)
    } else if key == "view.spin" {
        g_lens_spin = clamp(n, -LENS_PI, LENS_PI)
    } else if key == "render.dof" {
        g_render_dof = value == "1"
    } else if key == "render.blur" {
        g_render_blur = clamp(n, 0.0, RENDER_BLUR_MAX)
    } else if key == "render.band" {
        g_render_band = clamp(n, 0.0, RENDER_BAND_MAX)
    } else if key == "render.fringe" {
        g_render_fringe = clamp(n, 0.0, RENDER_FRINGE_MAX)
    } else if key == "view.scope" {
        g_lens_scope_path = panel_state_entry_path(value)
        g_lens_scope = -1
    } else if key == "view.selected" {
        g_lens_selected_path = panel_state_entry_path(value)
    } else if key == "view.ref_root" {
        g_lens_ref_root = panel_state_entry_path(value)
    } else if key == "view.ref_x" {
        g_lens_ref_return_x = n
    } else if key == "view.ref_y" {
        g_lens_ref_return_y = n
    } else if key == "view.ref_distance" {
        if n >= LENS_DISTANCE_MIN && n <= LENS_DISTANCE_LIMIT {
            g_lens_ref_return_distance = n
        }
    } else if key == "history.list_w" {
        if n >= LENS_HISTORY_LIST_MIN_W { g_lens_history_list_w = n }
    } else if key == "outline.scroll" {
        g_outline_scroll = clamp(n, 0.0, 100000000.0)
    } else if key == "outline.selected" {
        g_outline_selected_path = panel_state_entry_path(value)
    }
}

// Adopt a loaded view: the camera starts where it was left rather than
// gliding there, and a Ref view whose root file is gone falls back to the
// code map at the camera Ref mode would have returned to.
fn panel_state_view_finish() {
    if g_lens_view_mode == LENS_MODE_REF && g_lens_ref_root == "" {
        g_lens_view_mode = LENS_MODE_CODE
        g_lens_target_x = g_lens_ref_return_x
        g_lens_target_y = g_lens_ref_return_y
        g_lens_target_distance = g_lens_ref_return_distance
    }
    g_lens_center_x = g_lens_target_x
    g_lens_center_y = g_lens_target_y
    g_lens_distance = g_lens_target_distance
    g_outline_generation = -1
    g_panel_view_saved = panel_state_view_text()
}

fn panel_state_load() {
    g_panel_view_loaded = false
    if panel_state_save_allowed() == false {
        return
    }
    let text = os_read_file(panel_state_path())
    if text == "" {
        return
    }
    let start: i32 = 0
    for i in 0 to text.len + 1 {
        let c: i32 = 10
        if i < text.len {
            c = (text[i] as i32) & 255
        }
        if i == text.len || c == 10 {
            let end = i
            if end > start && ((text[end - 1] as i32) & 255) == 13 {
                end = end - 1
            }
            if end > start {
                let eq: i32 = -1
                for j in start to end {
                    if eq < 0 && ((text[j] as i32) & 255) == 61 {
                        eq = j
                    }
                }
                if eq > start {
                    panel_state_apply(substr(text, start, eq - start), substr(text, eq + 1, end - eq - 1))
                }
            }
            start = i + 1
        }
    }
    if g_panel_view_loaded {
        panel_state_view_finish()
    }
}

// Reopen the panels the saved layout marked open. The outline takes pointer
// input only; a restored terminal does not steal the keyboard from the map.
fn panel_state_restore() {
    if g_panel_state == false {
        return
    }
    if g_outline_open {
        outline_show()
    }
    if g_terminal_open {
        terminal_show()
        g_terminal_focus = false
        g_lens_input_dirty = true
    }
}
