use os

struct vision_font {
    texture: u32,
    size: f32,
    width: f32,
    height: f32,
    line_height: f32,
    glyphs: [f32],
    index: [i32: i32]
}
let g_font_main: ref vision_font = nil
let g_font_alternate: ref vision_font = nil
let g_font_cjk: ref vision_font = nil

fn split_lines(text: str) [str] {
    let total = 0
    for i in 0 to text.len {
        if text[i] == 10 { total = total + 1 }
    }
    if text.len > 0 && text[text.len - 1] != 10 { total = total + 1 }
    let lines = [str](total)
    let start = 0
    let count = 0
    for i in 0 to text.len {
        if text[i] == 10 {
            let length = i - start
            if length > 0 && text[i - 1] == 13 {
                length = length - 1
            }
            lines[count] = substr(text, start, length)
            count = count + 1
            start = i + 1
        }
    }
    if start < text.len {
        lines[count] = substr(text, start, text.len - start)
    }
    return lines
}

fn numbers(text: str) [f32] {
    let total = 0
    let in_word = false
    for i in 0 to text.len {
        let space = text[i] == 32 || text[i] == 9 || text[i] == 13
        if !space && !in_word { total = total + 1 }
        in_word = !space
    }
    let out = [f32](total)
    let i = 0
    let count = 0
    loop i < text.len {
        loop i < text.len && (text[i] == 32 || text[i] == 9 || text[i] == 13) {
            i = i + 1
        }
        let start = i
        loop i < text.len && text[i] != 32 && text[i] != 9 && text[i] != 13 {
            i = i + 1
        }
        if i > start {
            out[count] = stof(substr(text, start, i - start)) as f32
            count = count + 1
        }
    }
    return out
}

fn font_load(name: str) ref vision_font {
    let font = ref vision_font {
        texture: load_texture(`assets/{name}.png`), size: 32.0, width: 1.0, height: 1.0, line_height: 40.0, glyphs: [f32](32768), index: [i32: i32](16384)
    }
    let lines = split_lines(os_read_file(`assets/{name}.glyphs`))
    if lines.len == 0 {
        return font
    }
    let meta = numbers(lines[0])
    if meta.len < 4 {
        return font
    }
    font.size = meta[0]
    font.width = meta[1]
    font.height = meta[2]
    font.line_height = meta[3]
    let count = 0
    for i in 1 to lines.len {
        let values = numbers(lines[i])
        if values.len == 8 {
            font.index[values[0] as i32] = count
            for j in 0 to 8 {
                font.glyphs[count * 8 + j] = values[j]
            }
            count = count + 1
        }
    }
    return font
}

fn active_font() ref vision_font {
    if g_font_choice == 1 {
        return g_font_alternate
    }
    return g_font_main
}

fn codepoint(text: str, at: i32) float2 {
    let c = text[at]
    if c < 128 {
        return float2 {
            c as f32, 1.0
        }
    }
    if c < 224 && at + 1 < text.len {
        return float2 {
            ((c & 31) * 64 + (text[at + 1] & 63)) as f32, 2.0
        }
    }
    if c < 240 && at + 2 < text.len {
        return float2 {
            ((c & 15) * 4096 + (text[at + 1] & 63) * 64 + (text[at + 2] & 63)) as f32, 3.0
        }
    }
    if at + 3 < text.len {
        return float2 {
            ((c & 7) * 262144 + (text[at + 1] & 63) * 4096 + (text[at + 2] & 63) * 64 + (text[at + 3] & 63)) as f32, 4.0
        }
    }
    return float2 {
        63, 1
    }
}

fn text_width(text: str, size: f32) f32 {
    let width: f32 = 0.0
    let i = 0
    loop i < text.len {
        let cp = codepoint(text, i)
        i = i + cp.y as i32
        let font = active_font()
        if !has(font.index, cp.x as i32) {
            font = g_font_cjk
        }
        if has(font.index, cp.x as i32) {
            width = width + font.glyphs[font.index[cp.x as i32] * 8 + 5] * size / font.size
        } else {
            width = width + size * 0.5
        }
    }
    return width
}

fn label(text: str, x: f32, y: f32, size: f32, rgba: float4) {
    let cursor = x
    let i = 0
    loop i < text.len {
        let cp = codepoint(text, i)
        i = i + cp.y as i32
        let font = active_font()
        if !has(font.index, cp.x as i32) {
            font = g_font_cjk
        }
        if !has(font.index, cp.x as i32) {
            cursor = cursor + size * 0.5
            continue
        }
        let offset = font.index[cp.x as i32] * 8
        let scale = size / font.size
        let width = font.glyphs[offset + 1]
        let height = font.glyphs[offset + 2]
        let gx = font.glyphs[offset + 6]
        let gy = font.glyphs[offset + 7]
        if width > 0.0 && height > 0.0 {
            draw_quad(3, font.texture, cursor + font.glyphs[offset + 3] * scale, y + font.glyphs[offset + 4] * scale, width * scale, height * scale, 0.0, rgba, 0.0, float4 {
                gx / font.width, gy / font.height, (gx + width) / font.width, (gy + height) / font.height
            })
        }
        cursor = cursor + font.glyphs[offset + 5] * scale
    }
}

fn centered_label(text: str, x: f32, y: f32, size: f32, rgba: float4) {
    label(text, x - text_width(text, size) * 0.5, y, size, rgba)
}

// One glyph centred on (x, y) by its own ink box in the active font, for a
// symbol such as "+" that must sit in the middle of a shape whatever the
// font's baseline and padding.
fn centered_mark(text: str, x: f32, y: f32, size: f32, rgba: float4) {
    let font = active_font()
    let cp = codepoint(text, 0).x as i32
    if !has(font.index, cp) {
        centered_label(text, x, y - size * 0.5, size, rgba)
        return
    }
    let offset = font.index[cp] * 8
    let scale = size / font.size
    let left = x - (font.glyphs[offset + 3] + font.glyphs[offset + 1] * 0.5) * scale
    let top = y - (font.glyphs[offset + 4] + font.glyphs[offset + 2] * 0.5) * scale
    label(text, left, top, size, rgba)
}

fn short_title(text: str, maximum: i32) str {
    let i = 0
    let count = 0
    loop i < text.len && count < maximum {
        let cp = codepoint(text, i)
        i = i + cp.y as i32
        count = count + 1
    }
    if i < text.len {
        return substr(text, 0, i) + "..."
    }
    return text
}
