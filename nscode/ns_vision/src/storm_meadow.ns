// All distances are in metres around the dome's fixed eye.
lit STORM_EYE_HEIGHT: f32 = 1.88
// The default view looks along +z, with +x to the right.
// Back-left to front-right wind with a gentle rightward sweep.
lit STORM_WIND_X: f32 = 0.50
lit STORM_WIND_Z: f32 = 0.8660254
lit STORM_GRASS_ROOT_AO: f32 = 0.24

fn storm_grass_root_color() float3 {
    return env_rgb(0.016, 0.032, 0.013)
}

fn storm_wind_space(x: f32, z: f32) float2 {
    return float2 { x * STORM_WIND_X + z * STORM_WIND_Z, x * STORM_WIND_Z - z * STORM_WIND_X }
}

fn storm_wind_heading(turn: f32) float2 {
    return normalize(float2 { STORM_WIND_X + turn * STORM_WIND_Z, STORM_WIND_Z - turn * STORM_WIND_X })
}

fn storm_light_dir() float3 {
    return float3 { -0.5625939, 0.3616675, 0.7434277 }
}

// Fast rational exp(-x) for x >= 0 across CPU and all shader targets.
fn storm_exp_neg(x: f32) f32 {
    let t = maxf(x, 0.0)
    return 1.0 / (1.0 + t + 0.48 * t * t + 0.235 * t * t * t)
}

fn storm_hash(x: f32, z: f32) f32 {
    let a = env_fract(x * 0.1031)
    let b = env_fract(z * 0.1030)
    let c = env_fract((x + z) * 0.0973)
    let stir = a * (b + 33.33) + b * (c + 33.33) + c * (a + 33.33)
    return env_fract((a + b + 2.0 * stir) * (c + stir))
}

fn storm_noise(x: f32, z: f32) f32 {
    let u = env_fract(x)
    let v = env_fract(z)
    let ix = x - u
    let iz = z - v
    let a = u * u * (3.0 - 2.0 * u)
    let b = v * v * (3.0 - 2.0 * v)
    let near = mixf(storm_hash(ix, iz), storm_hash(ix + 1.0, iz), a)
    let far = mixf(storm_hash(ix, iz + 1.0), storm_hash(ix + 1.0, iz + 1.0), a)
    return mixf(near, far, b)
}

fn storm_cloud_shell_dist(elevation: f32, alt: f32) f32 {
    let r: f32 = 34.0
    let e = maxf(elevation, 0.0)
    return sqrt(r * r * e * e + 2.0 * r * alt + alt * alt) as f32 - r * e
}

fn storm_cloud_fbm4(x: f32, z: f32) f32 {
    let n0 = storm_noise(x, z)
    let x1 = (0.80 * x - 0.60 * z) * 2.08 + 7.3
    let z1 = (0.60 * x + 0.80 * z) * 2.08 - 4.1
    let n1 = storm_noise(x1, z1)
    let x2 = (0.80 * x1 - 0.60 * z1) * 2.08 + 5.1
    let z2 = (0.60 * x1 + 0.80 * z1) * 2.08 + 8.7
    let n2 = storm_noise(x2, z2)
    let x3 = (0.80 * x2 - 0.60 * z2) * 2.08 - 6.4
    let z3 = (0.60 * x2 + 0.80 * z2) * 2.08 + 2.9
    let n3 = storm_noise(x3, z3)
    return 0.46 * n0 + 0.27 * n1 + 0.16 * n2 + 0.11 * n3
}

fn storm_cloud_billow3(x: f32, z: f32) f32 {
    let b0 = 1.0 - absf(storm_noise(x, z) * 2.0 - 1.0)
    let x1 = (0.80 * x - 0.60 * z) * 2.18 - 5.2
    let z1 = (0.60 * x + 0.80 * z) * 2.18 + 3.9
    let b1 = 1.0 - absf(storm_noise(x1, z1) * 2.0 - 1.0)
    let x2 = (0.80 * x1 - 0.60 * z1) * 2.18 + 6.7
    let z2 = (0.60 * x1 + 0.80 * z1) * 2.18 - 8.4
    let b2 = 1.0 - absf(storm_noise(x2, z2) * 2.0 - 1.0)
    return 0.50 * b0 + 0.31 * b1 + 0.19 * b2
}

fn storm_cloud_micro3(x: f32, z: f32) f32 {
    let sx = x * 16.0
    let sz = z * 16.0
    let m0 = storm_noise(sx + 1.9, sz - 3.4)
    let x1 = (0.80 * sx - 0.60 * sz) * 2.125 - 4.7
    let z1 = (0.60 * sx + 0.80 * sz) * 2.125 + 6.2
    let m1 = storm_noise(x1, z1)
    let x2 = (0.80 * x1 - 0.60 * z1) * 2.118 + 8.3
    let z2 = (0.60 * x1 + 0.80 * z1) * 2.118 - 2.5
    let m2 = storm_noise(x2, z2)
    return 0.48 * m0 + 0.32 * m1 + 0.20 * m2
}

fn storm_cloud_light_fbm(x: f32, z: f32) f32 {
    let l0 = storm_noise(x, z)
    let x1 = (0.80 * x - 0.60 * z) * 2.15 + 3.1
    let z1 = (0.60 * x + 0.80 * z) * 2.15 - 5.9
    let l1 = storm_noise(x1, z1)
    let x2 = (0.80 * x1 - 0.60 * z1) * 2.163 - 7.2
    let z2 = (0.60 * x1 + 0.80 * z1) * 2.163 + 1.8
    let l2 = storm_noise(x2, z2)
    return 0.52 * l0 + 0.30 * l1 + 0.18 * l2
}

fn storm_cloud_density(x: f32, z: f32, detail_fade: f32) f32 {
    let wx = storm_cloud_light_fbm(x * 0.52 + 4.3, z * 0.52 - 6.1) - 0.5
    let wz = storm_cloud_light_fbm(x * 0.52 - 3.8, z * 0.52 + 5.7) - 0.5
    let fx = storm_noise(x * 2.4 + wx * 1.8 - 1.2, z * 2.4 + wz * 1.8 + 3.6) - 0.5
    let fz = storm_noise(x * 2.4 + wz * 1.8 + 4.9, z * 2.4 - wx * 1.8 - 2.3) - 0.5
    let px = x + wx * 1.35 + fx * 0.22 * detail_fade
    let pz = z + wz * 1.35 + fz * 0.22 * detail_fade
    let macro = storm_cloud_fbm4(px, pz)
    let billow = storm_cloud_billow3(px * 1.28 + 3.4, pz * 1.28 - 2.1)
    let micro = storm_cloud_micro3(px, pz)
    let mass = macro * 0.64 + billow * 0.36
    let edge_mask = 1.0 - env_smooth(0.46, 0.78, mass)
    let micro_detail = (micro - 0.50) * (0.14 + 0.16 * edge_mask) * detail_fade
    return clampf(mass + micro_detail, 0.0, 1.2)
}

fn storm_terrain_raw(x: f32, z: f32) f32 {
    let h0 = sin(x * 0.042 + z * 0.025 + 0.6) as f32 * 0.85
    let h1 = cos(x * 0.019 - z * 0.038 - 0.9) as f32 * 1.05
    let h2 = sin(x * 0.115 - z * 0.092 + 1.4) as f32 * 0.22
    return h0 + h1 + h2
}

fn storm_terrain_height(x: f32, z: f32) f32 {
    let radius = sqrt(x * x + z * z) as f32
    if radius <= 0.0001 {
        return 0.0
    }
    let delta = storm_terrain_raw(x, z) - storm_terrain_raw(0.0, 0.0)
    return delta * env_smooth(0.0, 4.5, radius)
}

fn storm_terrain_normal(x: f32, z: f32) float3 {
    let radius = sqrt(x * x + z * z) as f32
    let ramp = env_smooth(0.0, 4.5, radius)
    let c0 = cos(x * 0.042 + z * 0.025 + 0.6) as f32
    let s1 = sin(x * 0.019 - z * 0.038 - 0.9) as f32
    let c2 = cos(x * 0.115 - z * 0.092 + 1.4) as f32
    let dhx = (0.0357 * c0 - 0.01995 * s1 + 0.0253 * c2) * ramp
    let dhz = (0.02125 * c0 + 0.0399 * s1 - 0.02024 * c2) * ramp
    return normalize(float3 { -dhx, 1.0, -dhz })
}

// The same advected wind field drives blade bending, ribbons, and the meadow.
fn storm_wind(x: f32, z: f32, time: f32) float2 {
    let local = storm_wind_space(x, z)
    let along = local.x
    let across = local.y
    let warp = storm_noise(along * 0.045 - time * 0.18, across * 0.032) * 3.8
    let surge = 0.5 + 0.5 * sin((along - 7.4 * time) * 0.22 + warp) as f32
    let sweep = storm_noise((along - 6.8 * time) * 0.095, across * 0.034)
    let billows = storm_noise((along - 9.2 * time) * 0.22 + 20.1, across * 0.095 - time * 0.14)
    let gust = env_smooth(0.14, 0.86, surge * 0.46 + sweep * 0.38 + billows * 0.16)
    return float2 { 0.34 + gust * 0.66, (billows - 0.5) * 0.44 }
}

fn storm_cloud_shadow(x: f32, z: f32, time: f32) f32 {
    let local = storm_wind_space(x, z)
    let broad = storm_noise((local.x - 3.2 * time) * 0.036 + 11.4, local.y * 0.028 - 4.2)
    let break_up = storm_noise((local.x - 4.4 * time) * 0.085 - 3.7, local.y * 0.070 + 8.9)
    let sun_patch = env_smooth(0.24, 0.76, broad * 0.68 + break_up * 0.32)
    return mixf(0.38, 1.0, sun_patch)
}

fn storm_fog_color(d: float3) float3 {
    let sun_align = maxf(dot3(normalize(d), storm_light_dir()), 0.0)
    let base = env_rgb(0.22, 0.25, 0.26)
    let silver_glow = env_rgb(0.35, 0.38, 0.36)
    return env_mix(base, silver_glow, sun_align * sun_align * 0.58)
}

fn storm_fog_amount(distance: f32) f32 {
    let dist = maxf(distance - 18.0, 0.0)
    let exp_fog = 1.0 - storm_exp_neg(dist * 0.0072)
    let horizon_fade = env_smooth(340.0, 480.0, distance)
    return clampf(mixf(exp_fog, 1.0, horizon_fade), 0.0, 1.0)
}

fn storm_apply_fog(color: float3, d: float3, distance: f32) float3 {
    return env_mix(color, storm_fog_color(d), storm_fog_amount(distance))
}

fn storm_sky(d: float3, time: f32) float3 {
    let dir = normalize(d)
    let elevation = maxf(0.0, dir.y)
    let mist = storm_fog_color(dir)
    let zenith = env_mix(mist, env_rgb(0.35, 0.40, 0.44), env_smooth(0.02, 0.55, elevation))
    let light = storm_light_dir()
    let sun_dot = maxf(dot3(dir, light), 0.0)
    let sun_break = pow(sun_dot, 8.0) as f32 * 0.38 + pow(sun_dot, 36.0) as f32 * 0.25
    let sky_glow = env_add(zenith, env_scale3(env_rgb(0.75, 0.76, 0.68), sun_break * (1.0 - elevation * 0.4)))

    // Curved upper storm deck drifting along the wind heading with fine wispy detail.
    let plane = storm_cloud_shell_dist(elevation, 1.25)
    let drift = time * 0.048
    let x = (dir.x * plane - drift * STORM_WIND_X) * 0.46 + 2.3
    let z = (dir.z * plane - drift * STORM_WIND_Z) * 0.46 + 7.2
    let detail_fade = env_smooth(0.012, 0.13, elevation)
    let density = storm_cloud_density(x, z, detail_fade)

    let lx = light.x
    let lz = light.z
    let d_fine = storm_cloud_light_fbm(x + lx * 0.055, z + lz * 0.055) + (storm_cloud_micro3(x + lx * 0.024, z + lz * 0.024) - 0.5) * 0.16 * detail_fade
    let d_mid = storm_cloud_light_fbm(x + lx * 0.24, z + lz * 0.24)
    let d_far = storm_cloud_light_fbm(x + lx * 0.72, z + lz * 0.72)

    let cover = env_smooth(0.32, 0.64, density)
    let optical = maxf(density - 0.30, 0.0) * 3.4
    let fine_slope = clampf((density - d_fine) * 4.8 + 0.5, 0.0, 1.0)
    let sun_path = maxf(d_fine - 0.34, 0.0) * 0.35 + maxf(d_mid - 0.34, 0.0) * 0.50 + maxf(d_far - 0.34, 0.0) * 0.75
    let beer = storm_exp_neg(sun_path * 1.45)
    let powder = 1.0 - storm_exp_neg(optical * 1.9 + 0.15) * 0.52
    let hg = pow(sun_dot, 6.0) as f32 * 0.42 + pow(sun_dot, 24.0) as f32 * 0.35
    let silver = hg * storm_exp_neg(optical * 0.65) * fine_slope
    let direct_lit = clampf(beer * powder * 0.85 + fine_slope * 0.32 + silver, 0.0, 1.15)

    let deep_belly = env_rgb(0.050, 0.062, 0.074)
    let storm_belly = env_mix(deep_belly, env_rgb(0.115, 0.132, 0.145), env_smooth(0.15, 0.85, fine_slope))
    let sunlit_top = env_mix(env_rgb(0.38, 0.41, 0.42), env_rgb(0.58, 0.60, 0.56), sun_dot * sun_dot)
    let cloud_col = env_mix(storm_belly, sunlit_top, direct_lit)
    let base_sky = env_mix(sky_glow, cloud_col, cover)

    // Fast low-altitude wind-stretched ragged scud wisps underneath the main storm deck.
    let scud_dist = storm_cloud_shell_dist(elevation, 0.72)
    let sx_w = dir.x * scud_dist - drift * 1.65 * STORM_WIND_X
    let sz_w = dir.z * scud_dist - drift * 1.65 * STORM_WIND_Z
    let scud_wind = storm_wind_space(sx_w, sz_w)
    let su = scud_wind.x * 0.52 + 11.4
    let sv = scud_wind.y * 1.05 - 6.8
    let scud_raw = storm_cloud_light_fbm(su, sv) + (storm_cloud_micro3(su * 0.35, sv * 0.35) - 0.5) * 0.20 * detail_fade
    let scud_lit = storm_cloud_light_fbm(su + 0.09 * STORM_WIND_X, sv + 0.09 * STORM_WIND_Z)
    let scud_edge = clampf((scud_raw - scud_lit) * 3.8 + 0.5, 0.0, 1.0)
    let scud_alpha = env_smooth(0.54, 0.78, scud_raw) * 0.58 * env_smooth(0.03, 0.22, elevation)
    let scud_col = env_mix(env_rgb(0.065, 0.078, 0.090), env_rgb(0.30, 0.33, 0.34), scud_edge * (0.45 + 0.55 * sun_dot))
    let combined = env_mix(base_sky, scud_col, scud_alpha)
    return env_mix(mist, combined, env_smooth(0.0, 0.12, elevation))
}

fn storm_ground_ray(d: float3) f32 {
    if d.y > 0.12 {
        return -1.0
    }
    let t: f32 = 0.5
    let prev_t: f32 = 0.5
    for step in 0 to 22 {
        let dt = 0.65 + t * 0.27
        let next_t = t + dt
        let ray_y = d.y * next_t
        let ground_y = -STORM_EYE_HEIGHT + storm_terrain_height(d.x * next_t, d.z * next_t)
        if ray_y <= ground_y {
            let low = prev_t
            let high = next_t
            for refine in 0 to 4 {
                let mid = (low + high) * 0.5
                if d.y * mid <= -STORM_EYE_HEIGHT + storm_terrain_height(d.x * mid, d.z * mid) {
                    high = mid
                } else {
                    low = mid
                }
            }
            return (low + high) * 0.5
        }
        prev_t = next_t
        t = next_t
        if t > 480.0 {
            return -1.0
        }
    }
    return -1.0
}

fn storm_ground(d: float3, distance: f32, time: f32) float3 {
    let x = d.x * distance
    let z = d.z * distance
    let normal = storm_terrain_normal(x, z)
    let wind = float2 { 0.30, 0.0 }
    if distance < 260.0 {
        wind = storm_wind(x, z, time)
    }
    let shadow = storm_cloud_shadow(x, z, time)
    let light_dir = storm_light_dir()
    let broad = storm_noise(x * 0.09 + 1.3, z * 0.09 - 2.4)
    let dry_patch = env_smooth(0.45, 0.85, storm_noise(x * 0.18 - 5.1, z * 0.18 + 3.7))
    let wave = wind.x * (1.0 - env_smooth(90.0, 260.0, distance))

    let root_base = env_mix(storm_grass_root_color(), env_rgb(0.030, 0.044, 0.018), broad * 0.45)
    let root_tinted = env_mix(root_base, env_rgb(0.042, 0.040, 0.022), dry_patch * 0.22)
    let root_albedo = env_scale3(root_tinted, STORM_GRASS_ROOT_AO)
    let far_lush = env_mix(env_rgb(0.020, 0.036, 0.014), env_rgb(0.052, 0.082, 0.031), broad * 0.55 + wave * 0.45)
    let far_albedo = env_mix(far_lush, env_rgb(0.095, 0.088, 0.046), dry_patch * 0.32)
    let base_albedo = env_mix(root_albedo, far_albedo, env_smooth(26.0, 54.0, distance))

    let sky_lit = mixf(0.18, 0.46, clampf(normal.y * 0.5 + 0.5, 0.0, 1.0))
    let direct = (absf(dot3(normal, light_dir)) * 0.55 + 0.25) * 0.42 * shadow
    let light = sky_lit + direct
    let color = env_scale3(base_albedo, light)

    let detail = 1.0 - env_smooth(12.0, 42.0, distance)
    if detail > 0.0 {
        let local = storm_wind_space(x, z)
        let along = local.x
        let across = local.y
        let lay = across + wind.y * 0.055 * sin(along * 1.65) as f32
        let coarse = storm_noise(along * 6.3 + lay * 1.7, lay * 38.0 + along * 4.1)
        let fine = storm_noise(along * 10.2 - lay * 4.8 + 11.2, lay * 57.0 - along * 15.8)
        let strand = maxf(env_smooth(0.27, 0.76, coarse), env_smooth(0.32, 0.80, fine) * 0.82)
        let canopy = env_scale3(color, 0.82 + strand * 0.36)
        color = env_mix(color, canopy, detail)
    }
    return storm_apply_fog(color, d, distance)
}

fn storm_meadow(d: float3, time: f32) float3 {
    let dir = normalize(d)
    let hit = storm_ground_ray(dir)
    if hit > 0.0 {
        return storm_ground(dir, hit, time)
    }
    return storm_sky(dir, time)
}

fn storm_tile_noise(u: f32, v: f32, period: f32) f32 {
    let x = env_fract(u) * period
    let z = env_fract(v) * period
    let fx = env_fract(x)
    let fz = env_fract(z)
    let ix0 = x - fx
    let iz0 = z - fz
    let ix1 = ix0 + 1.0
    if ix1 >= period {
        ix1 = ix1 - period
    }
    let iz1 = iz0 + 1.0
    if iz1 >= period {
        iz1 = iz1 - period
    }
    let a = fx * fx * (3.0 - 2.0 * fx)
    let b = fz * fz * (3.0 - 2.0 * fz)
    let near = mixf(storm_hash(ix0, iz0), storm_hash(ix1, iz0), a)
    let far = mixf(storm_hash(ix0, iz1), storm_hash(ix1, iz1), a)
    return mixf(near, far, b)
}

// One-time bake into a 513x513 RGBA8 texture whose 512th row/column repeats
// texel 0 so hardware linear clamp_to_edge sampling wraps seamlessly.
fn fs_storm_noise_bake(input: vision_vertex) float4 {
    let px = env_floor(input.uv.x * 513.0)
    let py = env_floor(input.uv.y * 513.0)
    if px >= 512.0 {
        px = px - 512.0
    }
    if py >= 512.0 {
        py = py - 512.0
    }
    let u = px / 512.0
    let v = py / 512.0
    let r = 0.46 * storm_tile_noise(u, v, 8.0) +
        0.27 * storm_tile_noise(u, v, 16.0) +
        0.16 * storm_tile_noise(u, v, 32.0) +
        0.11 * storm_tile_noise(u, v, 64.0)
    let g0 = 1.0 - absf(storm_tile_noise(u + 0.37, v + 0.71, 10.0) * 2.0 - 1.0)
    let g1 = 1.0 - absf(storm_tile_noise(u + 0.37, v + 0.71, 20.0) * 2.0 - 1.0)
    let g2 = 1.0 - absf(storm_tile_noise(u + 0.37, v + 0.71, 40.0) * 2.0 - 1.0)
    let g = 0.50 * g0 + 0.31 * g1 + 0.19 * g2
    let b = 0.48 * storm_tile_noise(u + 0.61, v + 0.19, 16.0) +
        0.32 * storm_tile_noise(u + 0.61, v + 0.19, 32.0) +
        0.20 * storm_tile_noise(u + 0.61, v + 0.19, 64.0)
    let a = storm_tile_noise(u + 0.17, v + 0.83, 16.0)
    return float4 { r, g, b, a }
}

fn storm_noise_sample(x: f32, z: f32) float4 {
    let u = (env_fract(x * 0.125) * 512.0 + 0.5) / 513.0
    let v = (env_fract(z * 0.125) * 512.0 + 0.5) / 513.0
    return shader_sample_texture(float2 { u, v })
}

fn storm_sky_gpu(d: float3, time: f32) float3 {
    let dir = normalize(d)
    let elevation = maxf(0.0, dir.y)
    let mist = storm_fog_color(dir)
    let zenith = env_mix(mist, env_rgb(0.35, 0.40, 0.44), env_smooth(0.02, 0.55, elevation))
    let light = storm_light_dir()
    let sun_dot = maxf(dot3(dir, light), 0.0)
    let s2 = sun_dot * sun_dot
    let s4 = s2 * s2
    let s6 = s4 * s2
    let s8 = s4 * s4
    let s24 = s8 * s8 * s8
    let s36 = s24 * s8 * s4
    let sun_break = s8 * 0.38 + s36 * 0.25
    let sky_glow = env_add(zenith, env_scale3(env_rgb(0.75, 0.76, 0.68), sun_break * (1.0 - elevation * 0.4)))

    let plane = storm_cloud_shell_dist(elevation, 1.25)
    let drift = time * 0.048
    let x = (dir.x * plane - drift * STORM_WIND_X) * 0.46 + 2.3
    let z = (dir.z * plane - drift * STORM_WIND_Z) * 0.46 + 7.2
    let detail_fade = env_smooth(0.012, 0.13, elevation)

    let w0 = storm_noise_sample(x * 0.52 + 4.3, z * 0.52 - 6.1)
    let w1 = storm_noise_sample(x * 0.52 - 3.8, z * 0.52 + 5.7)
    let wx = w0.x - 0.5
    let wz = w1.x - 0.5
    let fine_w = storm_noise_sample(x * 1.2 + wx * 0.9 - 0.6, z * 1.2 + wz * 0.9 + 1.8)
    let px = x + wx * 1.35 + (fine_w.w - 0.5) * 0.22 * detail_fade
    let pz = z + wz * 1.35 + (fine_w.z - 0.5) * 0.22 * detail_fade

    let main_s = storm_noise_sample(px, pz)
    let micro_s = storm_noise_sample(px * 8.0, pz * 8.0)
    let mass = main_s.x * 0.64 + main_s.y * 0.36
    let edge_mask = 1.0 - env_smooth(0.46, 0.78, mass)
    let micro_detail = (micro_s.z - 0.50) * (0.14 + 0.16 * edge_mask) * detail_fade
    let density = clampf(mass + micro_detail, 0.0, 1.2)

    let lx = light.x
    let lz = light.z
    let d_fine_s = storm_noise_sample(x + lx * 0.055, z + lz * 0.055)
    let d_mid_s = storm_noise_sample(x + lx * 0.24, z + lz * 0.24)
    let d_far_s = storm_noise_sample(x + lx * 0.72, z + lz * 0.72)
    let d_fine = d_fine_s.x + (d_fine_s.z - 0.5) * 0.16 * detail_fade

    let cover = env_smooth(0.32, 0.64, density)
    let optical = maxf(density - 0.30, 0.0) * 3.4
    let fine_slope = clampf((density - d_fine) * 4.8 + 0.5, 0.0, 1.0)
    let sun_path = maxf(d_fine - 0.34, 0.0) * 0.35 + maxf(d_mid_s.x - 0.34, 0.0) * 0.50 + maxf(d_far_s.x - 0.34, 0.0) * 0.75
    let beer = storm_exp_neg(sun_path * 1.45)
    let powder = 1.0 - storm_exp_neg(optical * 1.9 + 0.15) * 0.52
    let hg = s6 * 0.42 + s24 * 0.35
    let silver = hg * storm_exp_neg(optical * 0.65) * fine_slope
    let direct_lit = clampf(beer * powder * 0.85 + fine_slope * 0.32 + silver, 0.0, 1.15)

    let deep_belly = env_rgb(0.050, 0.062, 0.074)
    let storm_belly = env_mix(deep_belly, env_rgb(0.115, 0.132, 0.145), env_smooth(0.15, 0.85, fine_slope))
    let sunlit_top = env_mix(env_rgb(0.38, 0.41, 0.42), env_rgb(0.58, 0.60, 0.56), s2)
    let cloud_col = env_mix(storm_belly, sunlit_top, direct_lit)
    let base_sky = env_mix(sky_glow, cloud_col, cover)

    let scud_dist = storm_cloud_shell_dist(elevation, 0.72)
    let sx_w = dir.x * scud_dist - drift * 1.65 * STORM_WIND_X
    let sz_w = dir.z * scud_dist - drift * 1.65 * STORM_WIND_Z
    let scud_wind = storm_wind_space(sx_w, sz_w)
    let su = scud_wind.x * 0.52 + 11.4
    let sv = scud_wind.y * 1.05 - 6.8
    let scud_s = storm_noise_sample(su, sv)
    let scud_lit_s = storm_noise_sample(su + 0.09 * STORM_WIND_X, sv + 0.09 * STORM_WIND_Z)
    let scud_raw = scud_s.x + (scud_s.z - 0.5) * 0.20 * detail_fade
    let scud_edge = clampf((scud_raw - scud_lit_s.x) * 3.8 + 0.5, 0.0, 1.0)
    let scud_alpha = env_smooth(0.54, 0.78, scud_raw) * 0.58 * env_smooth(0.03, 0.22, elevation)
    let scud_col = env_mix(env_rgb(0.065, 0.078, 0.090), env_rgb(0.30, 0.33, 0.34), scud_edge * (0.45 + 0.55 * sun_dot))
    let combined = env_mix(base_sky, scud_col, scud_alpha)
    return env_mix(mist, combined, env_smooth(0.0, 0.12, elevation))
}

fn storm_ground_gpu(d: float3, distance: f32, time: f32) float3 {
    let x = d.x * distance
    let z = d.z * distance
    let normal = storm_terrain_normal(x, z)
    let local = storm_wind_space(x, z)
    let wave_x: f32 = 0.30
    let wave_y: f32 = 0.0
    if distance < 260.0 {
        let along = local.x
        let across = local.y
        let w_warp = storm_noise_sample(along * 0.0225 - time * 0.09, across * 0.016).w * 3.8
        let surge = 0.5 + 0.5 * sin((along - 7.4 * time) * 0.22 + w_warp) as f32
        let sweep = storm_noise_sample((along - 6.8 * time) * 0.0475, across * 0.017).w
        let billows = storm_noise_sample((along - 9.2 * time) * 0.11 + 10.05, across * 0.0475 - time * 0.07).w
        let gust = env_smooth(0.14, 0.86, surge * 0.46 + sweep * 0.38 + billows * 0.16)
        wave_x = 0.34 + gust * 0.66
        wave_y = (billows - 0.5) * 0.44
    }
    let sh_broad = storm_noise_sample((local.x - 3.2 * time) * 0.018 + 5.7, local.y * 0.014 - 2.1).w
    let sh_break = storm_noise_sample((local.x - 4.4 * time) * 0.0425 - 1.85, local.y * 0.035 + 4.45).w
    let shadow = mixf(0.38, 1.0, env_smooth(0.24, 0.76, sh_broad * 0.68 + sh_break * 0.32))
    let light_dir = storm_light_dir()
    let broad = storm_noise_sample(x * 0.045 + 0.65, z * 0.045 - 1.2).w
    let dry_patch = env_smooth(0.45, 0.85, storm_noise_sample(x * 0.09 - 2.55, z * 0.09 + 1.85).w)
    let wave = wave_x * (1.0 - env_smooth(90.0, 260.0, distance))

    let root_base = env_mix(storm_grass_root_color(), env_rgb(0.030, 0.044, 0.018), broad * 0.45)
    let root_tinted = env_mix(root_base, env_rgb(0.042, 0.040, 0.022), dry_patch * 0.22)
    let root_albedo = env_scale3(root_tinted, STORM_GRASS_ROOT_AO)
    let far_lush = env_mix(env_rgb(0.020, 0.036, 0.014), env_rgb(0.052, 0.082, 0.031), broad * 0.55 + wave * 0.45)
    let far_albedo = env_mix(far_lush, env_rgb(0.095, 0.088, 0.046), dry_patch * 0.32)
    let base_albedo = env_mix(root_albedo, far_albedo, env_smooth(26.0, 54.0, distance))

    let sky_lit = mixf(0.18, 0.46, clampf(normal.y * 0.5 + 0.5, 0.0, 1.0))
    let direct = (absf(dot3(normal, light_dir)) * 0.55 + 0.25) * 0.42 * shadow
    let color = env_scale3(base_albedo, sky_lit + direct)

    let detail = 1.0 - env_smooth(12.0, 42.0, distance)
    if detail > 0.0 {
        let along = local.x
        let across = local.y
        let lay = across + wave_y * 0.055 * sin(along * 1.65) as f32
        let coarse = storm_noise_sample(along * 3.15 + lay * 0.85, lay * 19.0 + along * 2.05).w
        let fine = storm_noise_sample(along * 5.1 - lay * 2.4 + 5.6, lay * 28.5 - along * 7.9).w
        let strand = maxf(env_smooth(0.27, 0.76, coarse), env_smooth(0.32, 0.80, fine) * 0.82)
        let canopy = env_scale3(color, 0.82 + strand * 0.36)
        color = env_mix(color, canopy, detail)
    }
    return storm_apply_fog(color, d, distance)
}

fn fs_storm_bg(input: vision_vertex) float4 {
    let dir = camera_ray(input.uv.x, input.uv.y, shader_root_f32(16), shader_root_f32(17), shader_root_f32(18), shader_root_f32(19))
    let time = shader_root_f32(35)
    let hit = storm_ground_ray(dir)
    let c = storm_sky_gpu(dir, time)
    if hit > 0.0 {
        c = storm_ground_gpu(dir, hit, time)
    }
    return float4 { c.x, c.y, c.z, 1.0 }
}

fn fs_storm_blit(input: vision_vertex) float4 {
    let bg = shader_sample_texture(input.uv)
    let n = environment_dither(input.uv.x * shader_root_f32(32) * shader_root_f32(2) / shader_root_f32(33), input.uv.y * shader_root_f32(2)) * 0.006
    return float4 { bg.x + n, bg.y + n, bg.z + n, shader_root_f32(3) }
}
