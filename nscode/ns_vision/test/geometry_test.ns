use std

fn test_panel(a: f32, e: f32, radius: f32, arc: f32, x: f32, y: f32) {
    let bend = curve_radius(arc)
    let curved = curve_point(x, bend)
    let n = dome_normal(a, e)
    let right = dome_right(a)
    let up = dome_up(a, e)
    let z = radius + curved.y
    let p = float3 { n.x * z + right.x * curved.x + up.x * y, n.y * z + up.y * y, n.z * z + right.z * curved.x + up.z * y }
    let length = sqrt(dot3(p, p)) as f32
    let ray = float3 { p.x / length, p.y / length, p.z / length }
    let hit = panel_hit(ray, a, e, radius, 1010.0, 700.0, bend)
    assert hit.w == 1.0
    assert absf(hit.x - (x + 505.0)) < 0.06
    assert absf(hit.y - (350.0 - y)) < 0.06
    assert absf(hit.z - length) < 0.06
}

fn main() {
    for ri in 0 to 4 {
        let radius: f32 = 300.0
        if ri == 1 { radius = 900.0 }
        if ri == 2 { radius = 2400.0 }
        if ri == 3 { radius = 7200.0 }
        for ci in 0 to 3 {
            let arc = ci as f32 * 30.0 * DEG
            for ai in 0 to 5 {
                let a = (ai as f32 - 2.0) * 1.4
                for ei in 0 to 3 {
                    let e = (ei as f32 - 1.0) * 1.2
                    for xi in 0 to 5 {
                        let x = (xi as f32 - 2.0) * 250.0
                        test_panel(a, e, radius, arc, x, 0.0)
                        test_panel(a, e, radius, arc, x, 340.0)
                    }
                }
            }
        }
    }
    assert reverse_z_depth(1.0, 1.0) == 1.0
    assert reverse_z_depth(7200.0, 1.0) > 0.0
    assert reverse_z_depth(7200.0, 1.0) < reverse_z_depth(300.0, 1.0)
    for i in 0 to 37 {
        let p = hex_position(i)
        for j in 0 to i {
            let q = hex_position(j)
            assert absf(p.x - q.x) + absf(p.y - q.y) > 0.1
        }
    }
    let lines = split_lines("one\r\ntwo\nthree")
    assert lines.len == 3
    assert lines[0] == "one" && lines[2] == "three"
    assert split_lines("").len == 0
    assert split_lines("one\n").len == 1
    let values = numbers(" -1.5  2\t3 ")
    assert values.len == 3 && values[0] == -1.5 && values[2] == 3.0
    let utf = codepoint("中文", 0)
    assert utf.x == 20013.0 && utf.y == 3.0
    print("vision: curved picking sweep, reverse-Z, honeycomb, parsing passed\n")
}
