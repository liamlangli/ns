use std
use os
use io

let cook_commands = "set -eu\n"

struct cook_rule {
    format: str,
    max_size: i32,
    srgb: bool,
    quality: str,
    include: [str],
    exclude: [str],
    assets: [str],
    include_count: i32,
    exclude_count: i32,
    asset_count: i32,
    enabled: bool
}

fn cook_fail(message: str) {
    print(`texture cook: {message}\n`)
    assert false
}

fn cook_quote(value: str) str {
    let result = "'"
    for i in 0 to value.len {
        if value[i] == 39 { result = result + "'\"'\"'" } else { result = result + substr(value, i, 1) }
    }
    return result + "'"
}

fn cook_command(command: str) {
    cook_commands = cook_commands + command + "\n"
}

fn cook_trim(text: str) str {
    let first = 0
    let last = text.len
    loop first < last && text[first] <= 32 { first += 1 }
    loop last > first && text[last - 1] <= 32 { last -= 1 }
    return substr(text, first, last - first)
}

fn cook_find(text: str, code: i32) i32 {
    for i in 0 to text.len { if text[i] == code { return i } }
    return -1
}

fn cook_string(text: str) str {
    let value = cook_trim(text)
    if value.len < 2 || value[0] != 34 || value[value.len - 1] != 34 { cook_fail(`expected quoted string: {text}`) }
    return unescape(substr(value, 1, value.len - 2))
}

// This reader accepts one-line arrays. Reject unsupported syntax rather
// than silently compressing a different asset set.
fn cook_strings(text: str, values: [str]) i32 {
    let value = cook_trim(text)
    if value.len < 2 || value[0] != 91 || value[value.len - 1] != 93 { cook_fail("expected a one-line string array") }
    let count = 0
    let at = 1
    loop at < value.len - 1 {
        loop at < value.len - 1 && value[at] <= 32 { at += 1 }
        if at == value.len - 1 { break }
        if value[at] != 34 { cook_fail("expected array string") }
        let start = at
        at += 1
        loop at < value.len - 1 && value[at] != 34 {
            if value[at] == 92 { at += 1 }
            at += 1
        }
        if at >= value.len - 1 || count >= values.len { cook_fail("invalid or oversized string array") }
        values[count] = cook_string(substr(value, start, at - start + 1))
        count += 1
        at += 1
        loop at < value.len - 1 && value[at] <= 32 { at += 1 }
        if at < value.len - 1 {
            if value[at] != 44 { cook_fail("expected array comma") }
            at += 1
        }
    }
    return count
}

fn cook_glob(text: str, pattern: str) bool {
    let at = 0
    let p = 0
    let star = -1
    let retry = 0
    loop at < text.len {
        if p < pattern.len && (pattern[p] == 63 || pattern[p] == text[at]) {
            p += 1
            at += 1
        } else {
            if p < pattern.len && pattern[p] == 42 {
                star = p
                p += 1
                retry = at
            } else {
                if star < 0 { return false }
                retry += 1
                at = retry
                p = star + 1
            }
        }
    }
    loop p < pattern.len && pattern[p] == 42 { p += 1 }
    return p == pattern.len
}

fn cook_matches(path: str, patterns: [str], count: i32) bool {
    for i in 0 to count { if cook_glob(path, patterns[i]) { return true } }
    return false
}

fn cook_parse(text: str, platform: str) cook_rule {
    let rule = cook_rule { "astc_4x4", 0, false, "medium", [str](64), [str](64), [str](64), 1, 0, 2, false }
    rule.include[0] = "*"
    rule.assets[0] = "assets"
    rule.assets[1] = "src/assets"
    let explicit_assets = false
    if platform == "ios" { rule.max_size = 512 }
    let section = ""
    let start = 0
    for at in 0 to text.len + 1 {
        if at < text.len && text[at] != 10 { continue }
        let line = cook_trim(substr(text, start, at - start))
        start = at + 1
        // Strip comments outside strings, including escaped quotes.
        let quoted = false
        let escaped = false
        let end = line.len
        for i in 0 to line.len {
            if !quoted && line[i] == 35 { end = i
                break }
            if line[i] == 34 && !escaped { quoted = !quoted }
            if line[i] == 92 && !escaped { escaped = true } else { escaped = false }
        }
        line = cook_trim(substr(line, 0, end))
        if line.len == 0 { continue }
        if line[0] == 91 {
            section = line
            if line == `[cook.{platform}]` { rule.enabled = true }
            continue
        }
        let equal = cook_find(line, 61)
        if equal < 0 { continue }
        let key = cook_trim(substr(line, 0, equal))
        let value = cook_trim(substr(line, equal + 1, line.len - equal - 1))
        if section == "" && key == "assets" {
            rule.asset_count = cook_strings(value, rule.assets)
            explicit_assets = true
        }
        if section == "" && key == "source" && !explicit_assets { rule.assets[1] = cook_string(value) + "/assets" }
        if section != `[cook.{platform}]` { continue }
        if key == "format" { rule.format = cook_string(value) } else {
            if key == "max_size" {
                let number = 0
                if value.len == 0 { cook_fail("empty max_size") }
                for i in 0 to value.len {
                    if value[i] < 48 || value[i] > 57 || number > 16384 { cook_fail("max_size must be 0..16384") }
                    number = number * 10 + value[i] - 48
                }
                if number > 16384 { cook_fail("max_size must be 0..16384") }
                rule.max_size = number
            } else {
                if key == "include" { rule.include_count = cook_strings(value, rule.include) } else {
                    if key == "exclude" { rule.exclude_count = cook_strings(value, rule.exclude) } else {
                        if key == "srgb" {
                            if value != "true" && value != "false" { cook_fail("srgb must be boolean") }
                            rule.srgb = value == "true"
                        } else {
                            if key == "quality" { rule.quality = cook_string(value) } else { cook_fail(`unknown cook option: {key}`) }
                        }
                    }
                }
            }
        }
    }
    if rule.format != "astc_4x4" && rule.format != "astc_6x6" { cook_fail(`unsupported Apple format: {rule.format}`) }
    if rule.quality != "fastest" && rule.quality != "fast" && rule.quality != "medium" && rule.quality != "thorough" && rule.quality != "exhaustive" { cook_fail("invalid quality") }
    return rule
}

fn cook_u32(data: [u8], at: i32) i32 {
    return (data[at] as i32) | ((data[at + 1] as i32) << 8) | ((data[at + 2] as i32) << 16) | ((data[at + 3] as i32) << 24)
}

fn cook_put_u32(data: [u8], at: i32, value: i32) {
    for i in 0 to 4 { data[at + i] = ((value >> (i * 8)) & 255) as u8 }
}

// Convert a single-mip KTX1 from Apple's encoder to the runtime's NSTX v1.
fn cook_pack(ktx: [u8], size: i32, rule: cook_rule, original_width: i32, original_height: i32) [u8] {
    if size < 68 { cook_fail("truncated KTX") }
    let magic = [u8](12)
    magic[0] = 171 as u8
    magic[1] = 75 as u8
    magic[2] = 84 as u8
    magic[3] = 88 as u8
    magic[4] = 32 as u8
    magic[5] = 49 as u8
    magic[6] = 49 as u8
    magic[7] = 187 as u8
    magic[8] = 13 as u8
    magic[9] = 10 as u8
    magic[10] = 26 as u8
    magic[11] = 10 as u8
    for i in 0 to 12 { if ktx[i] != magic[i] { cook_fail("invalid KTX magic") } }
    let block = 4
    let format = 68
    let internal = 37808
    if rule.format == "astc_6x6" { block = 6
        format = 70
        internal = 37812 }
    if rule.srgb { format += 1
        internal += 32 }
    let width = cook_u32(ktx, 36)
    let height = cook_u32(ktx, 40)
    let metadata = cook_u32(ktx, 60)
    if cook_u32(ktx, 12) != 67305985 || cook_u32(ktx, 16) != 0 || cook_u32(ktx, 20) != 1 || cook_u32(ktx, 24) != 0 || cook_u32(ktx, 28) != internal || cook_u32(ktx, 44) != 0 || cook_u32(ktx, 48) != 0 || cook_u32(ktx, 52) != 1 || cook_u32(ktx, 56) != 1 { cook_fail("unexpected KTX layout or format") }
    if width < 1 || height < 1 || width > original_width || height > original_height || metadata < 0 || metadata > size - 68 || metadata % 4 != 0 { cook_fail("invalid KTX dimensions or metadata") }
    let expected = ((width + block - 1) / block) * ((height + block - 1) / block) * 16
    let offset = 68 + metadata
    if cook_u32(ktx, offset - 4) != expected || size - offset != expected { cook_fail("invalid KTX payload size") }
    let result = [u8](32 + expected)
    cook_put_u32(result, 0, 1481921358)
    cook_put_u32(result, 4, 1)
    cook_put_u32(result, 8, format)
    cook_put_u32(result, 12, width)
    cook_put_u32(result, 16, height)
    cook_put_u32(result, 20, original_width)
    cook_put_u32(result, 24, original_height)
    cook_put_u32(result, 28, expected)
    for i in 0 to expected { result[32 + i] = ktx[offset + i] }
    return result
}

fn cook_prefix(text: str, prefix: str) bool {
    return text.len >= prefix.len && substr(text, 0, prefix.len) == prefix
}

fn cook_relative(path: str) bool {
    return path.len > 0 && path[0] != 47 && !cook_glob(path, "../*") && !cook_glob(path, "*/../*") && !cook_glob(path, "*/..") && path != ".."
}

fn cook_read_bytes(path: str) [u8] {
    let size = os_file_size(path)
    if size < 1 || size > 268435456 { cook_fail(`invalid file size: {path}`) }
    let bytes = [u8](size as i32)
    if os_read_file_bytes(path, bytes, size as i32) != size { cook_fail(`cannot read: {path}`) }
    return bytes
}

fn cook_image(path: str) bool {
    return cook_glob(path, "*.png") || cook_glob(path, "*.jpg") || cook_glob(path, "*.jpeg") || cook_glob(path, "*.webp") || cook_glob(path, "*.tga") || cook_glob(path, "*.bmp")
}

fn cook_one(root: str, output: str, relative: str, rule: cook_rule, cache_root: str, identity: str, encoder: str) {
    if !cook_relative(relative) { cook_fail(`unsafe asset path: {relative}`) }
    let source = root + "/" + relative
    let destination = output + "/" + relative + ".nstex"
    let original = output + "/" + relative
    for i in 0 to relative.len {
        if relative[i] == 47 {
            let directory = output + "/" + substr(relative, 0, i)
            cook_command("[ ! -L " + cook_quote(directory) + " ] || { echo 'texture cook: symlink in output path' >&2; exit 1; }")
        }
    }
    if !cook_image(relative) || !cook_matches(relative, rule.include, rule.include_count) || cook_matches(relative, rule.exclude, rule.exclude_count) {
        cook_command("/bin/rm -f " + cook_quote(destination))
        return
    }
    let digest = os_file_hash(source)
    if digest == "" { cook_fail(`cannot hash: {source}`) }
    let key = os_text_hash(identity + digest)
    let cached = cache_root + "/" + key + ".nstex"
    if os_file_size(cached) < 32 {
        let image = io_load_image(source)
        let width = image.width
        let height = image.height
        io_image_destroy(image)
        if width <= 0 || height <= 0 || width > 16384 || height > 16384 { cook_fail(`invalid image: {source}`) }
        // Data PNGs must keep their original integer samples.
        let png_header = [u8](26)
        let header_size = os_read_file_bytes(source, png_header, 26)
        if header_size == 26 && png_header[0] == 137 && png_header[1] == 80 && png_header[24] == 16 { cook_fail(`exclude 16-bit data image: {relative}`) }
        let format = "ASTC4x4"
        if rule.format == "astc_6x6" { format = "ASTC6x6" }
        let quality = "Normal"
        if rule.quality == "fastest" || rule.quality == "fast" { quality = "Fastest" }
        if rule.quality == "thorough" { quality = "Production" }
        if rule.quality == "exhaustive" { quality = "Highest" }
        let limit = 16384
        if rule.max_size > 0 { limit = rule.max_size }
        let temporary = cache_root + "/" + key + "." + os_env("NS_TEX_ID") + ".ktx"
        let command = cook_quote(encoder) + " --compression_format=" + format + " --compression_quality=" + quality + " --alpha_mode=Preserve --gamma_in=1 --gamma_out=1 --max_mipmaps=1 --max_extent=" + `{limit}`
        if rule.srgb { command = command + " --srgb_format" }
        cook_command(command + " --output=" + cook_quote(temporary) + " " + cook_quote(source))
        let ns = os_env("NS_TEX_NS")
        let tool = os_env("NS_TEX_ROOT")
        let srgb = "false"
        if rule.srgb { srgb = "true" }
        cook_command(cook_quote(ns) + " run " + cook_quote(tool) + " --pack " + cook_quote(temporary) + " " + cook_quote(cached) + " " + rule.format + ` {srgb} {width} {height}`)
        cook_command("/bin/rm -f " + cook_quote(temporary))
        print(`cook: {relative} -> {rule.format}\n`)
    }
    let parent = destination.len - 1
    loop parent > 0 && destination[parent] != 47 { parent -= 1 }
    cook_command("/bin/mkdir -p " + cook_quote(substr(destination, 0, parent)))
    // Atomic publication before removing the packaged source. Never modify
    // the source asset; failure leaves the bundle's original available.
    let staging = destination + "." + os_env("NS_TEX_ID") + ".tmp"
    cook_command("/bin/cp " + cook_quote(cached) + " " + cook_quote(staging))
    cook_command("/bin/mv -f " + cook_quote(staging) + " " + cook_quote(destination))
    cook_command("/bin/rm -f " + cook_quote(original))
}

fn cook_run(root: str, platform: str, output: str) {
    if root.len == 0 || root[0] != 47 || output.len == 0 || output[0] != 47 || !cook_relative(substr(root, 1, root.len - 1)) || !cook_relative(substr(output, 1, output.len - 1)) { cook_fail("root and output must be absolute paths without parent traversal") }
    if cook_prefix(root + "/", output + "/") || (cook_prefix(output + "/", root + "/") && !cook_prefix(output, root + "/bin/")) { cook_fail("output must be a separate generated resource directory") }
    let manifest = os_read_file(root + "/ns.mod")
    if manifest == "" { cook_fail("cannot read ns.mod") }
    let rule = cook_parse(manifest, platform)
    if !rule.enabled { return }
    let cache_root = root + "/bin/.ns-tex/" + platform
    if os_make_dirs(cache_root) == 0 { cook_fail("cannot create cache") }
    let encoder = os_env("NS_TEX_ENCODER")
    if encoder == "" { cook_fail("run this tool through ns_tex") }
    let tool = os_env("NS_TEX_ROOT")
    let identity = manifest + os_file_hash(tool + "/src/cook.ns") + os_file_hash(tool + "/src/main.ns") + os_file_hash(encoder)
    for asset_index in 0 to rule.asset_count {
        let asset = rule.assets[asset_index]
        if !cook_relative(asset) { cook_fail(`unsafe asset root: {asset}`) }
        let path = root + "/" + asset
        let count = os_dir_scan(path)
        if count < 0 {
            if os_file_size(path) < 0 { continue }
            cook_one(root, output, asset, rule, cache_root, identity, encoder)
        } else {
            for i in 0 to count {
                if os_entry_is_dir(i) != 0 { continue }
                let full = os_entry_path(i)
                if !cook_prefix(full, root + "/") { cook_fail("asset scan escaped project") }
                cook_one(root, output, substr(full, root.len + 1, full.len - root.len - 1), rule, cache_root, identity, encoder)
            }
        }
    }
    if os_write_file_atomic(os_env("NS_TEX_PLAN"), cook_commands) == 0 { cook_fail("cannot write task plan") }
}
